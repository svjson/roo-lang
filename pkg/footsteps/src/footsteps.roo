(ns footsteps
  (:require [footsteps.estimate :as estimate-api]
            [footsteps.progress :as progress-api]
            [footsteps.queue :as queue-api]
            [footsteps.work :as work-api]))

(def append-strategy queue-api/append-strategy)

(def make work-api/make)

(def advance work-api/advance)

(defun run [work & opts &rest]
  (work-api/run work (or opts {})))

(def complete? work-api/complete?)

(def progress progress-api/value)

(def progress-report progress-api/report)

(def project-progress progress-api/project)

(defun estimate [value & ctx &rest]
  (estimate-api/value value (or ctx {})))
