(ns footsteps.estimate)

(defun value* [candidate ctx]
  (cond
    (fn? candidate) (candidate ctx)
    (nil? candidate) nil
    :default candidate))

(defun value
  "Resolve a literal, function, or step-map estimate.

  Args:
  - `candidate`: Literal estimate, function estimate, or step map containing `:estimate`, `:estimated-duration-ms`, `:progress-estimate`, or `:progress-max`.
  - `ctx`: Context map passed to estimate functions.

  Returns:
  The resolved estimate value. Step maps without estimate metadata return `1`."
  [candidate ctx]
  (if (map? candidate)
    (or (value* (:estimate candidate) ctx)
        (value* (:estimated-duration-ms candidate) ctx)
        (value* (:progress-estimate candidate) ctx)
        (:progress-max candidate)
        1)
    (value* candidate ctx)))
