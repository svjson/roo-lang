(ns voodoo.session-test
  (:require proof.core
            [proof.syntax :as p]
            [roo.tty :as tty]
            [voodoo.session :as session]))



;; voodoo.session/total-height

(deftest total-height/sums-single-line-widgets-as-one-each
  (p/given
    (session/make {:tty? false}))

  (p/when [widget-session]
    {:h1 (session/add! widget-session {:type :label :text "first"})
     :h2 (session/add! widget-session {:type :label :text "second"})
     :session widget-session})

  (p/then [{:keys [h1 h2 session]}]
    (is (= 2 (session/total-height session [h1 h2])))))

(deftest total-height/counts-a-multi-line-widgets-embedded-rows
  (p/given
    (session/make {:tty? false}))

  (p/when [widget-session]
    {:h1 (session/add! widget-session
                       {:type :status
                        :text "FAIL - checkout-total\n    - Expected 1, got 2."})
     :h2 (session/add! widget-session {:type :label :text "second"})
     :session widget-session})

  (p/then [{:keys [h1 h2 session]}]
    (is (= 3 (session/total-height session [h1 h2])))))

(deftest cursor-baseline-distance/counts-the-focused-row-and-later-widgets
  (let [widget-session (session/make {:tty? false})
        handle (session/add! widget-session
                             {:type :field
                              :text "first\nsecond"
                              :cursor {:row 1
                                       :text-before "sec"}})]
    (session/add! widget-session
                  {:type :label
                   :text "below\nlast"})
    (is (= 3
           (session/cursor-baseline-distance widget-session
                                             handle
                                             {:row 1
                                              :text-before "sec"})))))



;; voodoo.session/make

(deftest make/zero-arg-creates-a-fresh-empty-session
  (is (= {:tty? (tty/tty?)
          :widgets {}
          :order []
          :focus nil
          :id-seq 0}
         (session/make))))

(deftest make/empty-map-arg-creates-a-fresh-empty-session
  (is (= {:tty? (tty/tty?)
          :widgets {}
          :order []
          :focus nil
          :id-seq 0}
         (session/make {}))))

(deftest make/provided-tty?-value-is-respected
  (p/when []
    {:tty-enabled-session (session/make {:tty? true})
     :tty-disabled-session (session/make {:tty? false})})

  (p/then [sessions]
    (is (= true
           (-> sessions :tty-enabled-session :tty?)))
    (is (= false
           (-> sessions :tty-disabled-session :tty?)))))

(deftest make/tty-capability-auto-detects-via-roo-tty-when-omitted
  (is (= (tty/tty?) (:tty? (session/make)))))



;; voodoo.session/add!

(deftest add!/returns-a-handle-and-stores-the-rendered-widget
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    {:widget (session/add! session {:type :label
                                    :text "Discovering proof tests..."})
     :session session})

  (p/then [{:keys [widget session]}]
    (is (= {:tty? false
            :widgets {:voodoo/1 {:id :voodoo/1
                                 :spec {:type :label
                                        :text "Discovering proof tests..."}
                                 :text "Discovering proof tests..."}}
            :order [:voodoo/1]
            :focus nil
            :id-seq 1}
           session))))

(deftest add!/stores-a-widgets-degrade-policy-like-any-other-spec-field
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    {:widget (session/add! session {:type :status
                                    :text "RUNNING checkout-total"
                                    :degrade {:on-add :hidden
                                              :on-update :hidden
                                              :on-remove :hidden}})
     :session session})

  (p/then [{:keys [widget session]}]
    (is (= {:tty? false
            :widgets {:voodoo/1 {:id :voodoo/1
                                 :spec {:type :status
                                        :text "RUNNING checkout-total"
                                        :degrade {:on-add :hidden
                                                  :on-update :hidden
                                                  :on-remove :hidden}}
                                 :text "RUNNING checkout-total"}}
            :order [:voodoo/1]
            :focus nil
            :id-seq 1}
           session))))

(deftest add!/does-not-track-an-untracked-widget-in-append-mode
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    {:widget (session/add! session {:type :status
                                    :text "RUNNING checkout-total"
                                    :degrade {:on-add :untracked
                                              :on-update :hidden
                                              :on-remove :hidden}})
     :session session})

  (p/then [{:keys [widget session]}]
    (is (= {:tty? false
            :widgets {}
            :order []
            :focus nil
            :id-seq 1}
           session))
    (is (some? widget))))

(deftest add!/always-tracks-an-untracked-widget-in-tty-mode
  (p/given
    (session/make {:tty? true}))

  (p/when [session]
    {:widget (session/add! session {:type :status
                                    :text "RUNNING checkout-total"
                                    :degrade {:on-add :untracked
                                              :on-update :hidden
                                              :on-remove :hidden}})
     :session session})

  (p/then [{:keys [widget session]}]
    (is (contains? (:widgets session) widget))
    (is (= [widget] (:order session)))))

(deftest add!/assigns-distinct-handles-to-successive-widgets
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    {:h1 (session/add! session {:type :label :text "first"})
     :h2 (session/add! session {:type :label :text "second"})
     :session session})

  (p/then [{:keys [h1 h2 session]}]
    (is (not= h1 h2))
    (is (= [h1 h2] (:order session)))))



;; voodoo.session/update!

(deftest update!/replaces-a-widgets-spec-and-rendered-text
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    (session/add! session {:type :label :text "Discovering proof tests..."})
    (session/update! session :voodoo/1 {:type :label :text "Discovering proof tests... (42 found)"})
    session)

  (p/then [session]
    (is (= {:spec {:type :label :text "Discovering proof tests... (42 found)"}
            :text "Discovering proof tests... (42 found)"}
           (get (:widgets session) :voodoo/1 nil)))))

(deftest update!/is-a-no-op-for-an-untracked-handle
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    {:widget (session/add! session {:type :status
                                    :text "RUNNING checkout-total"
                                    :degrade {:on-add :untracked
                                              :on-update :hidden
                                              :on-remove :hidden}})
     :session session})

  (p/then [{:keys [widget session]}]
    (is (= widget (session/update! session widget {:text "PASS checkout-total"})))
    (is (= {:tty? false
            :widgets {}
            :order []
            :focus nil
            :id-seq 1}
           session))))

(deftest update!/replaces-a-single-line-widget-with-a-multi-line-one
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    (session/add! session {:type :status :text "RUNNING checkout-total"})
    (session/update! session
                     :voodoo/1
                     {:type :status
                      :text "FAIL - checkout-total\n    - Expected 1, got 2."})
    session)

  (p/then [session]
    (is (= {:spec {:type :status
                   :text "FAIL - checkout-total\n    - Expected 1, got 2."}
            :text "FAIL - checkout-total\n    - Expected 1, got 2."}
           (get (:widgets session) :voodoo/1 nil)))))

(deftest update!/returns-the-handle-unchanged
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    (session/add! session {:type :label :text "first"})
    (session/update! session :voodoo/1 {:type :label :text "second"}))

  (p/then [result]
    (is (= :voodoo/1 result))))



;; voodoo.session/focus! and dispatch!

(deftest focus!/focuses-only-a-tracked-widget
  (let [widget-session (session/make {:tty? false})
        handle (session/add! widget-session
                             {:type :field
                              :text "before"})]
    (session/focus! widget-session handle)
    (is (= handle (:focus widget-session)))
    (session/focus! widget-session :voodoo/missing)
    (is (= handle (:focus widget-session)))))

(deftest dispatch!/updates-the-focused-widget-and-returns-its-actions
  (let [widget-session (session/make {:tty? false})
        handle (session/add! widget-session
                             {:type :field
                              :text "before"
                              :degrade {:on-add :hidden
                                        :on-update :hidden
                                        :on-remove :hidden}
                              :on-event (fn [widget event]
                                          {:widget (assoc widget :text (:text event))
                                           :actions
                                           [{:type :changed
                                             :value (:text event)}]})})]
    (session/focus! widget-session handle)
    (is (= [{:type :changed
             :value "after"}]
           (session/dispatch! widget-session
                              {:type :text
                               :text "after"})))
    (is (= "after" (get-in widget-session [:widgets handle :text])))))

(deftest dispatch!/does-nothing-without-a-focused-event-widget
  (let [widget-session (session/make {:tty? false})
        handle (session/add! widget-session
                             {:type :label
                              :text "label"})]
    (is (= [] (session/dispatch! widget-session
                                 {:type :text
                                  :text "ignored"})))
    (session/focus! widget-session handle)
    (is (= [] (session/dispatch! widget-session
                                 {:type :text
                                  :text "ignored"})))))



;; voodoo.session/remove!

(deftest remove!/deletes-the-widget-from-session-state
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    (session/add! session {:type :label :text "Discovering proof tests..."})
    (session/remove! session :voodoo/1)
    session)

  (p/then [session]
    (is (= {:tty? false
            :widgets {}
            :order []
            :focus nil
            :id-seq 1}
           session))))

(deftest remove!/preserves-remaining-widgets-and-their-order
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    (session/add! session {:type :label :text "first"})
    (session/add! session {:type :label :text "second"})
    (session/remove! session :voodoo/1)
    session)

  (p/then [session]
    (is (= {:tty? false
            :widgets {:voodoo/2 {:id :voodoo/2
                                 :spec {:type :label :text "second"}
                                 :text "second"}}
            :order [:voodoo/2]
            :focus nil
            :id-seq 2}
           session))))

(deftest remove!/is-a-no-op-for-an-untracked-handle
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    {:widget (session/add! session {:type :status
                                    :text "RUNNING checkout-total"
                                    :degrade {:on-add :untracked
                                              :on-update :hidden
                                              :on-remove :hidden}})
     :session session})

  (p/then [{:keys [widget session]}]
    (is (= widget (session/remove! session widget)))
    (is (= {:tty? false
            :widgets {}
            :order []
            :focus nil
            :id-seq 1}
           session))))

(deftest remove!/returns-the-handle
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    (session/add! session {:type :label :text "first"})
    (session/remove! session :voodoo/1))

  (p/then [result]
    (is (= :voodoo/1 result))))



;; voodoo.session/evict!

(deftest evict!/deletes-the-widget-from-session-state
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    (session/add! session {:type :label :text "Discovering proof tests..."})
    (session/evict! session :voodoo/1)
    session)

  (p/then [session]
    (is (= {:tty? false
            :widgets {}
            :order []
            :focus nil
            :id-seq 1}
           session))))

(deftest evict!/clears-focus-when-evicting-the-focused-widget
  (let [widget-session (session/make {:tty? false})
        handle (session/add! widget-session
                             {:type :label
                              :text "first"})]
    (session/focus! widget-session handle)
    (session/evict! widget-session handle)
    (is (nil? (:focus widget-session)))))

(deftest evict!/preserves-remaining-widgets-and-their-order
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    (session/add! session {:type :label :text "first"})
    (session/add! session {:type :label :text "second"})
    (session/evict! session :voodoo/1)
    session)

  (p/then [session]
    (is (= {:tty? false
            :widgets {:voodoo/2 {:id :voodoo/2
                                 :spec {:type :label :text "second"}
                                 :text "second"}}
            :order [:voodoo/2]
            :focus nil
            :id-seq 2}
           session))))

(deftest evict!/returns-the-handle
  (p/given
    (session/make {:tty? false}))

  (p/when [session]
    (session/add! session {:type :label :text "first"})
    (session/evict! session :voodoo/1))

  (p/then [result]
    (is (= :voodoo/1 result))))
