(ns voodoo.text.buffer-test
  (:require proof.core
            [proof.scenario :as p]
            [voodoo.text.buffer :as buffer]))



;; voodoo.text.buffer/make and text

(deftest make/places-the-cursor-after-complete-unicode-scalars
  (let [text-buffer (buffer/make "ä猫🙂")]
    (is (= {:buffer {:before ["a" "̈" "猫" "🙂"]
                     :after []}
            :text "ä猫🙂"
            :position 4}
           {:buffer text-buffer
            :text (buffer/text text-buffer)
            :position (buffer/position text-buffer)}))))



;; Editing

(deftest insert/adds-text-at-the-cursor
  (is (= "a猫b"
         (-> (buffer/make "ab")
             buffer/move-left
             (buffer/insert "猫")
             buffer/text))))

(deftest backspace/removes-the-scalar-before-the-cursor
  (is (= "a🙂"
         (-> (buffer/make "a猫🙂")
             buffer/move-left
             buffer/backspace
             buffer/text))))

(deftest delete/removes-the-scalar-after-the-cursor
  (is (= "a🙂"
         (-> (buffer/make "a猫🙂")
             buffer/move-start
             buffer/move-right
             buffer/delete
             buffer/text))))

(deftest delete-to-end/removes-everything-after-the-cursor
  (is (= {:before ["a"]
          :after []}
         (-> (buffer/make "a猫🙂")
             buffer/move-start
             buffer/move-right
             buffer/delete-to-end))))

(deftest editing/does-nothing-past-the-buffer-boundaries
  (is (= (buffer/make "")
         (-> (buffer/make "")
             buffer/move-left
             buffer/move-right
             buffer/backspace
             buffer/delete))))



;; Cursor movement

(deftest move-left-and-right/move-one-complete-scalar
  (let [moved-left (buffer/move-left (buffer/make "a🙂"))]
    (is (= {:moved-left {:before ["a"]
                         :after ["🙂"]}
            :moved-right {:before ["a" "🙂"]
                          :after []}}
           {:moved-left moved-left
            :moved-right (buffer/move-right moved-left)}))))

(deftest move-start-and-end/preserve-text
  (let [at-start (buffer/move-start (buffer/make "abc"))]
    (is (= {:at-start {:before []
                       :after ["a" "b" "c"]}
            :at-end {:before ["a" "b" "c"]
                     :after []}}
           {:at-start at-start
            :at-end (buffer/move-end at-start)}))))

(deftest move-word-left-and-right/use-whitespace-delimited-words
  (p/given
    (buffer/move-start (buffer/make "one  two three")))

  (p/when [at-start]
    (let [after-second-word (-> at-start
                                buffer/move-word-right
                                buffer/move-word-right)]
      {:after-second-word after-second-word
       :before-second-word (buffer/move-word-left after-second-word)}))

  (p/then [result]
    (is (= {:after-second-word {:before ["o" "n" "e" " " " " "t" "w" "o"]
                                :after [" " "t" "h" "r" "e" "e"]}
            :before-second-word {:before ["o" "n" "e" " " " "]
                                 :after ["t" "w" "o" " " "t" "h" "r" "e" "e"]}}
           result))))

(deftest move-word-left-and-right/stop-at-buffer-boundaries
  (is (= {:at-start {:before []
                     :after ["o" "n" "e"]}
          :at-end {:before ["o" "n" "e"]
                   :after []}}
         {:at-start (buffer/move-word-left
                      (buffer/move-start (buffer/make "one")))
          :at-end (buffer/move-word-right (buffer/make "one"))})))
