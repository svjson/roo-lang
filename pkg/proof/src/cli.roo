(ns proof.cli
  (:require [cli-trooper :as cli-trooper]
            [proof.runner :as runner]))

(def application
  "Proof's supplied cli-trooper application declaration."
  {:application "roo proof"
   :description "run Roo tests"
   :features {:help {:default? false}
              :version false}
   :execute! runner/execute!
   :flags {["n" "namespace"] {:type :string
                                 :name "namespace"
                                 :repeatable? true
                                 :default nil}
           ["test-root" "test-roots"] {:type :path
                                          :name "path"
                                          :repeatable? true
                                          :destination :test-roots
                                          :default ["test"]}
           "filter" {:type :string
                      :name "pattern"
                      :default nil}
           "reporter" {:type :enum
                       :values ["simple" "tree"]
                       :default :simple}
           "fixture-root" {:type :path
                           :default "test/fixtures"}
           "durations" {:type :boolean
                        :optional-value? true
                        :destination :durations?
                        :default false}
           "no-durations" {:type :flag
                           :destination :durations?
                           :value false
                           :default false}
           "include-sub-namespaces" {:type :boolean
                                     :optional-value? true
                                     :destination :include-sub-namespaces?
                                     :default false}
           "no-include-sub-namespaces" {:type :flag
                                        :destination :include-sub-namespaces?
                                        :value false
                                        :default false}}
   :positional [{:type :path
                 :name "test-path"
                 :destination :test-roots
                 :repeatable? true
                 :optional? true
                 :default ["test"]}]})

(defun main
  "Run Proof through its direct command-line entrypoint.

  Args:
  - `args`: Command-line argument vector.

  Returns:
  Process status `0` for a passing run or help, `1` for a failing or errored
  test run, or `2` for invalid command-line input."
  [args]
  (cli-trooper/run! application {:args args}))
