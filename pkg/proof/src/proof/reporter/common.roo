(ns proof.reporter.common
  (:require [soot :as soot]))

(def dark-red (soot/custom-style "38;5;88" "39"))

(defun status-label [status]
  (let [label (upper-case (name status))]
    (case status
      :pass (soot/green label)
      :fail (soot/paint :bright-red label)
      :error (soot/paint dark-red label)
      :default label)))

(defun tree-parent-label [label]
  (soot/bold label))

(defun report-result-details [result]
  (case (:status result)
    :fail (for [failure (:failures result)]
            (prn "    -" (:message failure)))
    :error (prn "    -" (:message result)))
  result)

(defun duration-args [options result]
  (if (:durations? options)
    [(str "(" (get result :elapsed-ms 0) "ms)")]
    []))

(defun test-display-file [test]
  (if (nil? (:display-file test))
    (if (nil? (:file test))
      (if (nil? (:namespace test))
        "<inline>"
        (str (:namespace test)))
      (:file test))
    (:display-file test)))
