(ns proof.core
  (:require proof.syntax
            [proof.reporter :as reporter]
            [roo.string :as string]))

(def tests [])
(def current-failures [])

(def deftest proof.syntax/deftest)
(def is proof.syntax/is)
(def should proof.syntax/should)
(def assert proof.syntax/assert)
(def expect proof.syntax/expect)
(def run-test-body proof.syntax/run-test-body)
(def declared-namespace proof.syntax/declared-namespace)

(defun clear! []
  (set! [tests] [])
  (set! [current-failures] [])
  tests)

(defun register-test! [name body & namespace]
  (append! tests {:name name :namespace namespace :body body})
  name)

(defun annotate-test [metadata-by-namespace test]
  (if-let [metadata (get metadata-by-namespace (:namespace test) nil)]
    (merge test metadata)
    test))

(defun annotate-tests! [metadata-by-namespace]
  (set! [tests]
        (map tests
             (fn [test]
               (annotate-test metadata-by-namespace test))))
  tests)

(defun sub-namespace? [parent namespace]
  (and (string? namespace)
       (string/starts-with? namespace (str parent "."))))

(defun qualified-test-name [test]
  (str (if-let [ns (:namespace test)]
         (str ns "/")
         "")
       (-> test :name str)))

(defun wildcard-match-from? [pattern pattern-index text text-index]
  (if (= pattern-index (count pattern))
    (= text-index (count text))
    (let [pattern-char (str (nth pattern pattern-index))]
      (case pattern-char
        "*" (or (wildcard-match-from? pattern (+ pattern-index 1) text text-index)
                (and (< text-index (count text))
                     (wildcard-match-from? pattern pattern-index text (+ text-index 1))))
        :default (and (< text-index (count text))
                      (= pattern-char (str (nth text text-index)))
                      (wildcard-match-from? pattern
                                            (+ pattern-index 1)
                                            text
                                            (+ text-index 1)))))))

(defun wildcard-match? [pattern text]
  (wildcard-match-from? (str pattern) 0 (str text) 0))

(defun test-name-matches? [options test]
  (if-let [pattern (:filter options)]
    (or (wildcard-match? pattern (-> test :name str))
        (wildcard-match? pattern (qualified-test-name test)))
    true))

(defun test-namespace-matches? [options test]
  (if-let [namespace (:namespace options)]
    (let [test-namespace (:namespace test)
          namespaces (if (sequential? namespace) namespace [namespace])]
      (any? namespaces
            (fn [selected-namespace]
              (let [namespace-text (str selected-namespace)]
                (if (:include-sub-namespaces? options)
                  (or (= namespace-text test-namespace)
                      (sub-namespace? namespace-text test-namespace))
                  (= namespace-text test-namespace))))))
    true))

(defun test-selected? [options test]
  (and (test-namespace-matches? options test)
       (test-name-matches? options test)))

(defun selected-tests [options]
  (filter tests
          (fn [test] (test-selected? options test))))

(defun record-failure! [message]
  (let [failure {:message message}]
    (append! current-failures failure)
    failure))

(defun run-test [test]
  (set! [current-failures] [])
  (let [test-timing {:start-ms (epoch-ms)}
        body-result (run-test-body (:body test))
        test-result {:name (:name test)
                     :status (cond
                               (= (:status body-result) :error) :error
                               (not-empty? current-failures) :fail
                               true :pass)
                     :elapsed-ms (max 0 (- (epoch-ms) (:start-ms test-timing)))}]
    (merge test-result
           (case (:status test-result)
             :fail {:message (:message (head current-failures))
                    :failures current-failures}
             :error {:message (:message body-result)}))))

(defun report-test-result [reporter test result options]
  (assoc reporter
         :state ((:reporter reporter) (:state reporter) test result options)))

(defun run-and-report-selected-test [run-state test]
  (let [result (run-test test)]
    (assoc run-state
           :reporter (report-test-result (:reporter run-state)
                                         test
                                         result
                                         (:options run-state))
           :results (append! (:results run-state) result))))

(defun run-selected [options]
  (let [tests-to-run (selected-tests options)
        run-timing {:start-ms (epoch-ms)}
        run-state (reduce tests-to-run
                          {:results []
                           :options options
                           :reporter (reporter/make options tests-to-run)}
                          run-and-report-selected-test)]
    (-> run-state
        :results
        reporter/result-summary
        (assoc :elapsed-ms (max 0 (- (epoch-ms) (:start-ms run-timing))))
        reporter/print!)
    (:results run-state)))

(defun run []
  (run-selected {}))
