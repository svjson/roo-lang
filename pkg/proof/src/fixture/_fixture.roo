(ns proof.fixture
  (:require proof.syntax.fixture
            [proof.fixture.cache :as cache]
            [proof.fixture.persistent :as persistent]))

(def fixtures
  "Declared fixtures keyed by fixture symbol."
  {})

(def deffixture
  "Declares a named fixture provider.

  Usage:

  ```roo
  (deffixture commonborn-bootstrap
    {:storage :persistent
     :path \"backend/commonborn-bootstrap.edn\"
     :version 1}
    (expensive-bootstrap))
  ```

  The options map is required. `:storage` may be `:cache` or `:persistent`, and
  defaults to `:cache`."
  proof.syntax.fixture/deffixture)

(def using-fixtures
  "Binds declared fixture values for the scope of the body.

  Usage:

  ```roo
  (using-fixtures [[bootstrap commonborn-bootstrap]
                   simple-fixture]
    body...)
  ```

  Each fixture spec may be a fixture symbol, `[binding fixture]`, or
  `[binding fixture opts]`."
  proof.syntax.fixture/using-fixtures)

(def using-cache-fixture
  "Binds an in-process cache fixture value for the scope of the body.

  Usage:

  ```roo
  (using-cache-fixture [value \"bootstrap/commonborn\" generate]
    body...)
  ```

  The binding vector is `[binding key generator]` or
  `[binding key generator opts]`. `opts` may contain `:paths`."
  proof.syntax.fixture/using-cache-fixture)

(def using-persistent-fixture
  "Binds a persistent fixture value for the scope of the body.

  Usage:

  ```roo
  (using-persistent-fixture [value \"bootstrap/commonborn.edn\" generate]
    body...)
  ```

  The binding vector is `[binding relative-path generator]` or
  `[binding relative-path generator opts]`. `opts` may contain `:version`,
  `:refresh?`, and `:paths`."
  proof.syntax.fixture/using-persistent-fixture)

(def cache-fixture-value
  "Returns the value used by `using-cache-fixture`."
  cache/value)

(def persistent-fixture-value
  "Returns the value used by `using-persistent-fixture`."
  persistent/value)

(def clear!
  "Clears in-process fixture cache state."
  cache/clear!)

(def configure!
  "Configures persistent fixture storage."
  persistent/configure!)

(def fixture-path
  "Returns the active persistent fixture path for a relative fixture path."
  persistent/fixture-path)

(defun register-fixture!
  "Registers a named fixture provider.

  `name` is the fixture symbol. `generate` is a zero-argument function.
  `opts` controls storage and projection behavior. Returns `name`."
  [name generate opts]
  (set! [fixtures]
        (assoc fixtures
               name
               (assoc opts
                      :name name
                      :generate generate)))
  name)

(defun fixture-value
  "Returns the value for a declared fixture.

  Per-use `opts` override declaration options. A fixture with `:storage
  :persistent` is backed by the persistent fixture store; other fixtures use the
  in-process cache fixture store."
  [name & opts &rest]
  (let [opts (merge (get fixtures name nil) opts)
        generate (:generate opts)]
    (case (get opts :storage :cache)
      :persistent (persistent/value (or (:path opts) (str name ".edn")) generate opts)
      :default (cache/value name generate opts))))
