(ns proof.runner-test
  (:require proof.core
            [proof.runner :as runner]))

(deftest normalizes-windows-style-display-paths
  (is (= "test/app/checkout-test.roo"
         (runner/relative-package-path
           {:package-root "D:\\a\\roo-lang\\roo-lang"}
           "D:\\a\\roo-lang\\roo-lang\\test\\app\\checkout-test.roo"))))

(deftest parses-fixture-root-cli-option
  (is (= "tmp/fixtures"
         (:fixture-root
          (runner/configured-proof {:args ["--fixture-root" "tmp/fixtures"]}))))
  (is (= "tmp/fixtures"
         (:fixture-root
          (runner/configured-proof {:args ["--fixture-root=tmp/fixtures"]})))))

(deftest parses-repeated-namespace-cli-options
  (is (= ["app.checkout-test" "app.profile-test"]
         (:namespace
          (runner/configured-proof {:args ["-n" "app.checkout-test"
                                           "--namespace=app.profile-test"]})))))

(deftest resolves-relative-fixture-root-under-package-root
  (is (= "/repo/app/test/fixtures"
         (runner/absolute-fixture-root {:package-root "/repo/app"} "test/fixtures")))
  (is (= "/tmp/proof-fixtures"
         (runner/absolute-fixture-root {:package-root "/repo/app"}
                                       "/tmp/proof-fixtures"))))
