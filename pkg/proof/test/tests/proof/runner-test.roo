(ns proof.runner-test
  (:require proof.core
            [proof.runner :as runner]))



;; proof.runner/relative-package-path

(deftest relative-package-path/normalizes-windows-style-display-paths
  (is (= "test/app/checkout-test.roo"
         (runner/relative-package-path
           {:package-root "D:\\a\\roo-lang\\roo-lang"}
           "D:\\a\\roo-lang\\roo-lang\\test\\app\\checkout-test.roo"))))



;; proof.runner/absolute-fixture-root

(deftest absolute-fixture-root/resolves-paths-against-the-package-root
  (is (= ["/repo/app/test/fixtures"
          "/tmp/proof-fixtures"]
         [(runner/absolute-fixture-root {:package-root "/repo/app"}
                                        "test/fixtures")
          (runner/absolute-fixture-root {:package-root "/repo/app"}
                                        "/tmp/proof-fixtures")])))
