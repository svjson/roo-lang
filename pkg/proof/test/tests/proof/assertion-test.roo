(ns proof.assertion-test
  (:require proof.core
            [proof.assertion :as assertion]
            [soot.core :as soot-core]))

(def esc
  "ANSI escape character used by soot."
  soot-core/esc)

(deftest keeps-single-line-equality-message
  (is (= "Expected 5, got 4."
         (assertion/format-failure-message :equality "(= 5 4)" 5 4))))

(deftest formats-multiline-equality-diff
  (is (= (str "Expected {:a 1 :b [1 2]}, got {:a 1 :b [1 3]}.\n\n"
              "Diff:\n"
              "  {\n"
              "    :a 1\n"
              "    :b [\n"
              "      1\n"
              esc "[31m-     2" esc "[39m\n"
              esc "[32m+     3" esc "[39m\n"
              "    ]\n"
              "  }")
         (assertion/format-failure-message
           :equality
           "(= expected actual)"
           {:a 1 :b [1 2]}
           {:a 1 :b [1 3]}))))
