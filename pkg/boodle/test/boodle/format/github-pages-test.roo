(ns boodle.format.github-pages-test
  (:require proof.core
            [boodle.format.github-pages :as github-pages]
            [boodle.model :as model]
            [roo.string :as string]))

(def sample-catalog
  "Catalog used by GitHub Pages rendering tests."
  (model/catalog
    [(model/package
       {:id "roo"
        :name "roo"
        :version "0.1.0"
        :summary "Roo standard library."
        :namespaces [(model/namespace
                       {:name "roo"
                        :summary "Implicit runtime namespace."
                        :entries [(model/entry
                                    {:id "roo/+"
                                     :name "+"
                                     :qualified-name "roo/+"
                                     :namespace "roo"
                                     :entry-kind :function
                                     :summary "Add numbers."
                                     :body "Returns the numeric sum."
                                     :signatures [{:display "(+ numbers...)"
                                                   :params [{:name "numbers"
                                                             :display "numbers..."
                                                             :doc "Numbers to add."}]
                                                   :returns {:doc "The sum."}}]
                                     :doc {:examples [{:format :roo
                                                       :source "(+ 1 2)\n=> 3"}]}})]})]})
     (model/package
       {:id "loom"
        :name "loom"
        :version "0.1.0"
        :summary "Roo package manager."})
     (model/package
       {:id "proof"
        :name "proof"
        :version "0.1.0"
        :summary "Roo test framework."})
     (model/package
       {:id "zoology"
        :name "zoology"
        :version "0.1.0"
        :summary "Schema validation."})]))

(deftest renders-github-pages-files
  (let [files (github-pages/files sample-catalog)
        paths (map files (fn [file] (:path file)))
        layout-file (find-first files
                                (fn [file]
                                  (= "_layouts/reference.html" (:path file))))
        stylesheet-file (find-first files
                                    (fn [file]
                                      (= "assets/boodle.css" (:path file))))
        index-page (find-first files
                               (fn [file]
                                 (= "index.md" (:path file))))
        package-index-page (find-first files
                                      (fn [file]
                                        (= "packages/roo/index.md"
                                           (:path file))))
        package-page (find-first files
                                (fn [file]
                                  (= "packages/roo/versions/0.1.0/index.md"
                                     (:path file))))
        namespace-page (find-first files
                                   (fn [file]
                                     (= "packages/roo/versions/0.1.0/namespaces/roo.md"
                                        (:path file))))
        symbol-page (find-first files
                                (fn [file]
                                  (= "packages/roo/versions/0.1.0/namespaces/roo/plus.md"
                                     (:path file))))]
    (is (= ["_config.yml"
            "_layouts/reference.html"
            "assets/boodle.css"
            "index.md"
            "packages/roo/index.md"
            "packages/roo/versions/0.1.0/index.md"
            "packages/roo/versions/0.1.0/namespaces/roo.md"
            "packages/roo/versions/0.1.0/namespaces/roo/plus.md"
            "packages/loom/index.md"
            "packages/loom/versions/0.1.0/index.md"
            "packages/proof/index.md"
            "packages/proof/versions/0.1.0/index.md"
            "packages/zoology/index.md"
            "packages/zoology/versions/0.1.0/index.md"]
           paths))
    (is (= (str "title: Reference\n"
                "markdown: kramdown\n"
                "kramdown:\n"
                "  syntax_highlighter_opts:\n"
                "    formatter: HTML\n")
           (:content (head files))))
    (is (string/starts-with? (:content layout-file) "<!doctype html>\n"))
    (is (string/starts-with?
          (:content stylesheet-file)
          (str ":root { color-scheme: light; }\n"
               "body { margin: 0; color: #1f2937; font: 16px/1.55 system-ui, sans-serif; }\n"
               "a { color: #0f5f8f; text-decoration: none; }\n"
               "a:hover { text-decoration: underline; }\n"
               ".site-header { border-bottom: 1px solid #d7dde5; padding: 12px 24px; font-weight: 700; }\n"
               ".site-header a { color: #111827; }\n"
               "body > h1, body > h2, body > p, body > table { margin-left: auto; margin-right: auto; max-width: 960px; }\n"
               "body > h1 { padding: 0 24px; margin-top: 32px; }\n"
               "body > h2 { padding: 0 24px; margin-top: 28px; }\n"
               "body > .reference-breadcrumbs, body > .reference-up, body > .version-context { box-sizing: border-box; margin-left: auto; margin-right: auto; margin-top: 32px; max-width: 1008px; padding-left: 24px; padding-right: 24px; }\n"
               "body > .reference-breadcrumbs + .version-context, body > .reference-up + .version-context { margin-top: 0; }\n")))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: Reference\n"
                "---\n\n"
                "# Reference\n\n"
                "| Package                                     | Versions | Description           |\n"
                "| ------------------------------------------- | -------- | --------------------- |\n"
                "| [roo](packages/roo/versions/0.1.0/)         | 0.1.0    | Roo standard library. |\n"
                "| [loom](packages/loom/versions/0.1.0/)       | 0.1.0    | Roo package manager.  |\n"
                "| [proof](packages/proof/versions/0.1.0/)     | 0.1.0    | Roo test framework.   |\n"
                "| [zoology](packages/zoology/versions/0.1.0/) | 0.1.0    | Schema validation.    |"
                "\n")
           (:content index-page)))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo\n"
                "---\n\n"
                "<meta http-equiv=\"refresh\" content=\"0; url=versions/0.1.0/\">\n"
                "[roo 0.1.0](versions/0.1.0/)"
                "\n")
           (:content package-index-page)))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo 0.1.0\n"
                "---\n\n"
                "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">roo 0.1.0</span>\n"
                "</nav>\n"
                "<div class=\"version-context\">\n"
                "<span class=\"version-package\">roo</span>\n"
                "<label class=\"version-select-label\">Version "
                "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
                "<option value=\"../0.1.0/\" selected>0.1.0</option>\n"
                "</select></label>\n"
                "</div>\n"
                "# roo 0.1.0\n\n"
                "Roo standard library.\n\n"
                "| Namespace                  | Symbols |\n"
                "| -------------------------- | ------- |\n"
                "| [roo](namespaces/roo.html) | 1       |"
                "\n")
           (:content package-page)))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo\n"
                "---\n\n"
                "<div class=\"reference-page\">\n"
                "<nav class=\"reference-sidebar\">\n"
                "<a class=\"namespace-link active\" href=\"roo.html\">roo</a>\n"
                "<ol>\n"
                "<li><a href=\"roo/plus.html\">+</a></li>\n"
                "</ol>\n"
                "</nav>\n"
                "<main class=\"reference-content\" markdown=\"block\">\n\n"
                "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../\">roo 0.1.0</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">roo</span>\n"
                "</nav>\n"
                "<div class=\"version-context\">\n"
                "<span class=\"version-package\">roo</span>\n"
                "<label class=\"version-select-label\">Version "
                "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
                "<option value=\"../../0.1.0/namespaces/roo.html\" selected>0.1.0</option>\n"
                "</select></label>\n"
                "</div>\n"
                "# roo\n\n"
                "Implicit runtime namespace.\n\n"
                "| Symbol               | Summary      |\n"
                "| -------------------- | ------------ |\n"
                "| [`+`](roo/plus.html) | Add numbers. |"
                "\n\n</main>\n"
                "</div>\n")
           (:content namespace-page)))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo/+\n"
                "---\n\n"
                "<div class=\"reference-page\">\n"
                "<nav class=\"reference-sidebar\">\n"
                "<a class=\"namespace-link\" href=\"../roo.html\">roo</a>\n"
                "<ol>\n"
                "<li><a class=\"active\" href=\"plus.html\">+</a></li>\n"
                "</ol>\n"
                "</nav>\n"
                "<main class=\"reference-content\" markdown=\"block\">\n\n"
                "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../../\">roo 0.1.0</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../roo.html\">roo</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">+</span>\n"
                "</nav>\n"
                "<div class=\"version-context\">\n"
                "<span class=\"version-package\">roo</span>\n"
                "<label class=\"version-select-label\">Version "
                "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
                "<option value=\"../../../0.1.0/namespaces/roo/plus.html\" selected>0.1.0</option>\n"
                "</select></label>\n"
                "</div>\n"
                "# `+`\n\n"
                "Add numbers.\n\n"
                "Returns the numeric sum.\n\n"
                "```roo\n"
                "(+ numbers...)\n"
                "```\n\n"
                "| Arg        | Description     |\n"
                "| ---------- | --------------- |\n"
                "| numbers... | Numbers to add. |\n\n"
                "Returns: The sum.\n\n"
                "## Examples\n\n"
                "```roo\n"
                "(+ 1 2)\n"
                "=> 3\n"
                "```\n"
                "\n</main>\n"
                "</div>\n")
           (:content symbol-page)))))


(deftest renders-hierarchy-navigation-strategies
  (let [package (head (:packages sample-catalog))
        namespace (head (:namespaces package))
        entry (head (:entries namespace))
        page {:kind :symbol
              :catalog sample-catalog
              :package package
              :namespace namespace
              :entry entry}]
    (is (= (str "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../../\">roo 0.1.0</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../roo.html\">roo</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">+</span>\n"
                "</nav>\n")
           (github-pages/navigation-html page)))
    (is (= "<nav class=\"reference-up\" aria-label=\"Up\"><a href=\"../roo.html\">Up to roo</a></nav>\n"
           (github-pages/navigation-html
             (assoc page
                    :catalog
                    (assoc sample-catalog :navigation-style :up)))))
    (is (= ""
           (github-pages/navigation-html
             (assoc page
                    :catalog
                    (assoc sample-catalog :navigation-style :none)))))))

(deftest renders-grouped-root-package-index
  (let [catalog (assoc sample-catalog
                       :package-groups
                       [(model/package-group {:title "The Roo Language"
                                             :package-ids ["roo"]})
                        (model/package-group {:title "Core Libraries"
                                             :package-ids ["loom" "proof"]})
                        (model/package-group {:title "Packages"
                                             :package-ids ["zoology"]})])
        files (github-pages/files catalog)
        index-page (find-first files
                               (fn [file]
                                 (= "index.md" (:path file))))]
    (is (= (str "---\n"
                "layout: reference\n"
                "title: Reference\n"
                "---\n\n"
                "# Reference\n\n"
                "## The Roo Language\n\n"
                "| Package                             | Versions | Description           |\n"
                "| ----------------------------------- | -------- | --------------------- |\n"
                "| [roo](packages/roo/versions/0.1.0/) | 0.1.0    | Roo standard library. |\n\n"
                "## Core Libraries\n\n"
                "| Package                                 | Versions | Description          |\n"
                "| --------------------------------------- | -------- | -------------------- |\n"
                "| [loom](packages/loom/versions/0.1.0/)   | 0.1.0    | Roo package manager. |\n"
                "| [proof](packages/proof/versions/0.1.0/) | 0.1.0    | Roo test framework.  |\n\n"
                "## Packages\n\n"
                "| Package                                     | Versions | Description        |\n"
                "| ------------------------------------------- | -------- | ------------------ |\n"
                "| [zoology](packages/zoology/versions/0.1.0/) | 0.1.0    | Schema validation. |"
                "\n")
           (:content index-page)))))
