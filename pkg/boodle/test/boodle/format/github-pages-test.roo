(ns boodle.format.github-pages-test
  (:require proof.core
            [boodle.format.github-pages :as github-pages]
            [boodle.model :as model]
            [moordown.render :as markdown]
            [roo.string :as string]))

(def sample-catalog
  "Catalog used by GitHub Pages rendering tests."
  (model/catalog
    [(model/package
       {:id "roo"
        :name "roo"
        :version "0.1.0"
        :summary "Roo standard library."
        :namespaces [(model/namespace
                       {:name "roo"
                        :summary "Implicit runtime namespace."
                        :content [{:kind :text
                                   :content "Implicit runtime namespace."}
                                  {:kind :text
                                   :content "Provides Roo's fundamental operations."}
                                  {:kind :header
                                   :content "Examples:"}
                                  {:kind :code
                                   :content "(+ 1 2)"}]
                        :entries [(model/entry
                                    {:id "roo/+"
                                     :name "+"
                                     :qualified-name "roo/+"
                                     :namespace "roo"
                                     :entry-kind :function
                                     :summary "Add numbers."
                                     :content [{:kind :text :content "Add numbers."}
                                               {:kind :text
                                                :content "Returns the numeric sum."}
                                               {:kind :sig-args :index 0}
                                               {:kind :sig-ret :index 0}
                                               {:kind :header :content "Examples:"}
                                               {:kind :code
                                                :content "(+ 1 2)\n=> 3"}]
                                     :signatures [{:display "(+ numbers...)"
                                                   :params [{:name "numbers"
                                                             :display "numbers..."
                                                             :content [{:kind :text
                                                                        :content "Numbers to add."}]}]
                                                   :returns {:content [{:kind :text
                                                                       :content "The sum."}]}}]})]})]})
     (model/package
       {:id "loom"
        :name "loom"
        :version "0.1.0"
        :summary "Roo package manager."})
     (model/package
       {:id "proof"
        :name "proof"
        :version "0.1.0"
        :summary "Roo test framework."})
     (model/package
       {:id "zoology"
        :name "zoology"
        :version "0.1.0"
        :summary "Schema validation."})]))

(deftest renders-github-pages-files
  (let [files (github-pages/files sample-catalog)
        paths (for [file files] (:path file))
        layout-file (find-first files
                                (fn [file]
                                  (= "_layouts/reference.html" (:path file))))
        stylesheet-file (find-first files
                                    (fn [file]
                                      (= "assets/boodle.css" (:path file))))
        publication-data-file (find-first files
                                          (fn [file]
                                            (= "_data/publications.yml"
                                               (:path file))))
        index-page (find-first files
                               (fn [file]
                                 (= "index.md" (:path file))))
        package-index-page (find-first files
                                      (fn [file]
                                        (= "packages/roo/index.md"
                                           (:path file))))
        package-page (find-first files
                                (fn [file]
                                  (= "packages/roo/versions/0.1.0/index.md"
                                     (:path file))))
        namespace-page (find-first files
                                   (fn [file]
                                     (= "packages/roo/versions/0.1.0/namespaces/roo.md"
                                        (:path file))))
        symbol-page (find-first files
                                (fn [file]
                                  (= "packages/roo/versions/0.1.0/namespaces/roo/plus.md"
                                     (:path file))))]
    (is (= ["_config.yml"
            "_layouts/reference.html"
            "assets/boodle.css"
            "_data/publications.yml"
            "index.md"
            "packages/roo/index.md"
            "packages/roo/versions/0.1.0/index.md"
            "packages/roo/versions/0.1.0/namespaces/roo.md"
            "packages/roo/versions/0.1.0/namespaces/roo/plus.md"
            "packages/loom/index.md"
            "packages/loom/versions/0.1.0/index.md"
            "packages/proof/index.md"
            "packages/proof/versions/0.1.0/index.md"
            "packages/zoology/index.md"
            "packages/zoology/versions/0.1.0/index.md"]
           paths))
    (is (= (str "packages:\n"
                "  \"roo\":\n"
                "    default: \"0.1.0\"\n"
                "    publications:\n"
                "      - identity: \"0.1.0\"\n"
                "        mode: \"stable\"\n"
                "  \"loom\":\n"
                "    default: \"0.1.0\"\n"
                "    publications:\n"
                "      - identity: \"0.1.0\"\n"
                "        mode: \"stable\"\n"
                "  \"proof\":\n"
                "    default: \"0.1.0\"\n"
                "    publications:\n"
                "      - identity: \"0.1.0\"\n"
                "        mode: \"stable\"\n"
                "  \"zoology\":\n"
                "    default: \"0.1.0\"\n"
                "    publications:\n"
                "      - identity: \"0.1.0\"\n"
                "        mode: \"stable\"\n")
           (:content publication-data-file)))
    (is (= (str "title: roo-lang - Reference\n"
                "markdown: kramdown\n"
                "kramdown:\n"
                "  syntax_highlighter_opts:\n"
                "    formatter: HTML\n")
           (:content (head files))))
    (is (string/starts-with? (:content layout-file) "<!doctype html>\n"))
    (is (contains? (split (:content layout-file) "\n")
                   "  <header class=\"site-header\"><a href=\"{{ '/' | relative_url }}\">roo-lang - Reference</a></header>"))
    (is (string/starts-with?
          (:content stylesheet-file)
          (str ":root { color-scheme: light; }\n"
               "body { margin: 0; color: #1f2937; font: 16px/1.55 system-ui, sans-serif; }\n"
               "a { color: #0f5f8f; text-decoration: none; }\n"
               "a:hover { text-decoration: underline; }\n"
               ".site-header { border-bottom: 1px solid #d7dde5; padding: 12px 24px; font-weight: 700; }\n"
               ".site-header a { color: #111827; }\n"
               "body > h1, body > h2, body > p, body > table { margin-left: auto; margin-right: auto; max-width: 960px; }\n"
               "body > h1 { padding: 0 24px; margin-top: 32px; }\n"
               "body > h2 { padding: 0 24px; margin-top: 28px; }\n"
               "body > .reference-breadcrumbs, body > .reference-up, body > .version-context { box-sizing: border-box; margin-left: auto; margin-right: auto; margin-top: 32px; max-width: 1008px; padding-left: 24px; padding-right: 24px; }\n"
               "body > .reference-breadcrumbs + .version-context, body > .reference-up + .version-context { margin-top: 0; }\n")))
    (is (contains? (split (:content stylesheet-file) "\n")
                   ".symbol-heading { margin: 0 0 24px; }"))
    (is (contains? (split (:content stylesheet-file) "\n")
                   ".version-context + .symbol-heading { border-top: 1px solid #d7dde5; padding-top: 12px; }"))
    (is (contains? (split (:content stylesheet-file) "\n")
                   ".symbol-heading + p { font-size: 1.125rem; line-height: 1.5; }"))
    (is (contains? (split (:content stylesheet-file) "\n")
                   ".symbol-heading h1 { line-height: 1.1; margin: 0; }"))
    (is (contains? (split (:content stylesheet-file) "\n")
                   ".symbol-namespace { color: #6b7280; font-size: 13px; line-height: 1; overflow-wrap: anywhere; }"))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: Reference\n"
                "---\n\n"
                "# roo-lang - Reference\n\n"
                "| Package                                     | Versions | Description           |\n"
                "| ------------------------------------------- | -------- | --------------------- |\n"
                "| [roo](packages/roo/versions/0.1.0/)         | 0.1.0    | Roo standard library. |\n"
                "| [loom](packages/loom/versions/0.1.0/)       | 0.1.0    | Roo package manager.  |\n"
                "| [proof](packages/proof/versions/0.1.0/)     | 0.1.0    | Roo test framework.   |\n"
                "| [zoology](packages/zoology/versions/0.1.0/) | 0.1.0    | Schema validation.    |"
                "\n")
           (:content index-page)))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo\n"
                "---\n\n"
                "<meta http-equiv=\"refresh\" content=\"0; url=versions/0.1.0/\">\n"
                "[roo 0.1.0](versions/0.1.0/)"
                "\n")
           (:content package-index-page)))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo 0.1.0\n"
                "---\n\n"
                "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">roo 0.1.0</span>\n"
                "</nav>\n"
                "<div class=\"version-context\">\n"
                "<span class=\"version-package\">roo</span>\n"
                "<label class=\"version-select-label\">Version "
                "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
                "{% assign package_publications = site.data.publications.packages[\"roo\"].publications %}\n"
                "{% for publication in package_publications %}\n"
                "<option value=\"../{{ publication.identity }}/\"{% if publication.identity == \"0.1.0\" %} selected{% endif %}>{{ publication.identity }}</option>\n"
                "{% endfor %}\n"
                "</select></label>\n"
                "</div>\n"
                "# roo 0.1.0\n\n"
                "Roo standard library.\n\n"
                "| Namespace                  | Symbols |\n"
                "| -------------------------- | ------- |\n"
                "| [roo](namespaces/roo.html) | 1       |"
                "\n")
           (:content package-page)))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo\n"
                "---\n\n"
                "<div class=\"reference-page\">\n"
                "<nav class=\"reference-sidebar\">\n"
                "<a class=\"namespace-link active\" href=\"roo.html\">roo</a>\n"
                "<ol>\n"
                "<li><a href=\"roo/plus.html\">+</a></li>\n"
                "</ol>\n"
                "</nav>\n"
                "<main class=\"reference-content\" markdown=\"block\">\n\n"
                "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../\">roo 0.1.0</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">roo</span>\n"
                "</nav>\n"
                "<div class=\"version-context\">\n"
                "<span class=\"version-package\">roo</span>\n"
                "<label class=\"version-select-label\">Version "
                "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
                "{% assign package_publications = site.data.publications.packages[\"roo\"].publications %}\n"
                "{% for publication in package_publications %}\n"
                "<option value=\"../../{{ publication.identity }}/namespaces/roo.html\"{% if publication.identity == \"0.1.0\" %} selected{% endif %}>{{ publication.identity }}</option>\n"
                "{% endfor %}\n"
                "</select></label>\n"
                "</div>\n"
                "# roo\n\n"
                "Implicit runtime namespace.\n\n"
                "Provides Roo's fundamental operations.\n\n"
                "### Examples:\n\n"
                "```roo\n"
                "(+ 1 2)\n"
                "```\n\n"
                "| Symbol               | Summary      |\n"
                "| -------------------- | ------------ |\n"
                "| [`+`](roo/plus.html) | Add numbers. |"
                "\n\n</main>\n"
                "</div>\n")
           (:content namespace-page)))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo/+\n"
                "---\n\n"
                "<div class=\"reference-page\">\n"
                "<nav class=\"reference-sidebar\">\n"
                "<a class=\"namespace-link\" href=\"../roo.html\">roo</a>\n"
                "<ol>\n"
                "<li><a class=\"active\" href=\"plus.html\">+</a></li>\n"
                "</ol>\n"
                "</nav>\n"
                "<main class=\"reference-content\" markdown=\"block\">\n\n"
                "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../../\">roo 0.1.0</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../roo.html\">roo</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">+</span>\n"
                "</nav>\n"
                "<div class=\"version-context\">\n"
                "<span class=\"version-package\">roo</span>\n"
                "<label class=\"version-select-label\">Version "
                "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
                "{% assign package_publications = site.data.publications.packages[\"roo\"].publications %}\n"
                "{% for publication in package_publications %}\n"
                "<option value=\"../../../{{ publication.identity }}/namespaces/roo/plus.html\"{% if publication.identity == \"0.1.0\" %} selected{% endif %}>{{ publication.identity }}</option>\n"
                "{% endfor %}\n"
                "</select></label>\n"
                "</div>\n"
                "<header class=\"symbol-heading\">\n"
                "<div class=\"symbol-namespace\"><a href=\"../roo.html\">roo</a>/</div>\n"
                "<h1><code>+</code></h1>\n"
                "</header>\n\n"
                "Add numbers.\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "```roo\n"
                "(+ numbers...)\n"
                "```\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "Returns the numeric sum.\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "## Signature:\n\n"
                "```roo\n"
                "(+ numbers...)\n"
                "```\n\n"
                "| Arg        | Description     |\n"
                "| ---------- | --------------- |\n"
                "| numbers... | Numbers to add. |\n\n"
                "### Returns:\n\n"
                "The sum.\n\n"
                "### Examples:\n\n"
                "```roo\n"
                "(+ 1 2)\n"
                "=> 3\n"
                "```\n"
                "\n</main>\n"
                "</div>\n")
           (:content symbol-page)))))


(deftest renders-hierarchy-navigation-strategies
  (let [package (head (:packages sample-catalog))
        namespace (head (:namespaces package))
        entry (head (:entries namespace))
        page {:kind :symbol
              :catalog sample-catalog
              :package package
              :namespace namespace
              :entry entry}]
    (is (= (str "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../../\">roo 0.1.0</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<a href=\"../roo.html\">roo</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">+</span>\n"
                "</nav>\n")
           (github-pages/navigation-html page)))
    (is (= "<nav class=\"reference-up\" aria-label=\"Up\"><a href=\"../roo.html\">Up to roo</a></nav>\n"
           (github-pages/navigation-html
             (assoc page
                    :catalog
                    (assoc sample-catalog :navigation-style :up)))))
    (is (= ""
           (github-pages/navigation-html
             (assoc page
                    :catalog
                    (assoc sample-catalog :navigation-style :none)))))))

(deftest renders-ordered-documentation-blocks
  (let [entry (model/entry {:name "sample"
                            :namespace "sample"
                            :summary "Opening text."
                            :since "0.1.0"
                            :deprecated "Use `replacement` instead."
                            :see ["other" "sample/related"]
                            :content [{:kind :text
                                       :content "Opening text."}
                                      {:kind :code
                                       :language :shell
                                       :content "roo run sample.roo"}
                                      {:kind :text
                                       :content "Text after code."}
                                      {:kind :code
                                       :content "(first)"}
                                      {:kind :code
                                       :content "(second)"}
                                      {:kind :sig-args
                                       :index 0}
                                      {:kind :sig-ret
                                       :index 0}]
                            :signatures [{:display "(sample)"
                                          :params []
                                          :returns {:content [{:kind :text
                                                              :content "Result text."}
                                                             {:kind :code
                                                              :content "{:ok true}"}]}}]})
        page {:namespace (model/namespace {:name "sample"})
              :entry entry}]
    (is (= (str "<header class=\"symbol-heading\">\n"
                "<div class=\"symbol-namespace\"><a href=\"../sample.html\">sample</a>/</div>\n"
                "<h1><code>sample</code></h1>\n"
                "<div class=\"symbol-metadata\"><span>Since <code>0.1.0</code></span> "
                "<span class=\"symbol-metadata-separator\" aria-hidden=\"true\">·</span> "
                "<span>Deprecated: Use `replacement` instead.</span> "
                "<span class=\"symbol-metadata-separator\" aria-hidden=\"true\">·</span> "
                "<span>See also: <code>other</code>, <code>sample/related</code></span></div>\n"
                "</header>\n\n"
                "Opening text.\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "```roo\n"
                "(sample)\n"
                "```\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "```shell\n"
                "roo run sample.roo\n"
                "```\n\n"
                "Text after code.\n\n"
                "```roo\n"
                "(first)\n"
                "```\n\n"
                "```roo\n"
                "(second)\n"
                "```\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "## Signature:\n\n"
                "```roo\n"
                "(sample)\n"
                "```\n\n"
                "### Returns:\n\n"
                "Result text.\n\n"
                "```roo\n"
                "{:ok true}\n"
                "```\n")
           (markdown/render-block (github-pages/symbol-document page))))))

(deftest preserves-signature-and-return-occurrence-order
  (let [returns {:content [{:kind :text
                            :content "The opened resource."}]}
        entry (model/entry {:name "open"
                            :namespace "sample"
                            :summary "Open a resource."
                            :content [{:kind :text
                                       :content "Open a resource."}
                                      {:kind :sig-args
                                       :index 0}
                                      {:kind :text
                                       :content "An explicit mode may also be supplied."}
                                      {:kind :sig-args
                                       :index 1}
                                      {:kind :sig-ret
                                       :index 1}]
                            :signatures [{:display "(open path)"
                                          :params []
                                          :returns returns}
                                         {:display "(open path mode)"
                                          :params []
                                          :returns returns}]})
        page {:namespace (model/namespace {:name "sample"})
              :entry entry}]
    (is (= (str "<header class=\"symbol-heading\">\n"
                "<div class=\"symbol-namespace\"><a href=\"../sample.html\">sample</a>/</div>\n"
                "<h1><code>open</code></h1>\n"
                "</header>\n\n"
                "Open a resource.\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "```roo\n"
                "(open path)\n"
                "(open path mode)\n"
                "```\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "## Signature:\n\n"
                "```roo\n"
                "(open path)\n"
                "```\n\n"
                "### Returns:\n\n"
                "The opened resource.\n\n"
                "An explicit mode may also be supplied.\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "## Signature:\n\n"
                "```roo\n"
                "(open path mode)\n"
                "```\n\n"
                "### Returns:\n\n"
                "The opened resource.\n")
           (markdown/render-block (github-pages/symbol-document page))))))

(deftest duplicates-nonadjacent-return-after-signature
  (let [entry (model/entry {:name "open"
                            :namespace "sample"
                            :summary "Open a resource."
                            :content [{:kind :sig-args
                                       :index 0}
                                      {:kind :text
                                       :content "Details between declarations."}
                                      {:kind :sig-ret
                                       :index 0}]
                            :signatures [{:display "(open path)"
                                          :params []
                                          :returns {:content [{:kind :text
                                                              :content "The opened resource."}]}}]})
        page {:namespace (model/namespace {:name "sample"})
              :entry entry}]
    (is (= (str "<header class=\"symbol-heading\">\n"
                "<div class=\"symbol-namespace\"><a href=\"../sample.html\">sample</a>/</div>\n"
                "<h1><code>open</code></h1>\n"
                "</header>\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "```roo\n"
                "(open path)\n"
                "```\n\n"
                "<hr class=\"signature-divider\">\n\n"
                "## Signature:\n\n"
                "```roo\n"
                "(open path)\n"
                "```\n\n"
                "### Returns:\n\n"
                "The opened resource.\n\n"
                "Details between declarations.\n\n"
                "### Returns:\n\n"
                "The opened resource.\n")
           (markdown/render-block (github-pages/symbol-document page))))))

(deftest renders-grouped-root-package-index
  (let [catalog (assoc sample-catalog
                       :package-groups
                       [(model/package-group {:title "The Roo Language"
                                             :package-ids ["roo"]})
                        (model/package-group {:title "Core Libraries"
                                             :package-ids ["loom" "proof"]})
                        (model/package-group {:title "Packages"
                                             :package-ids ["zoology"]})])
        files (github-pages/files catalog)
        index-page (find-first files
                               (fn [file]
                                 (= "index.md" (:path file))))]
    (is (= (str "---\n"
                "layout: reference\n"
                "title: Reference\n"
                "---\n\n"
                "# roo-lang - Reference\n\n"
                "## The Roo Language\n\n"
                "| Package                             | Versions | Description           |\n"
                "| ----------------------------------- | -------- | --------------------- |\n"
                "| [roo](packages/roo/versions/0.1.0/) | 0.1.0    | Roo standard library. |\n\n"
                "## Core Libraries\n\n"
                "| Package                                 | Versions | Description          |\n"
                "| --------------------------------------- | -------- | -------------------- |\n"
                "| [loom](packages/loom/versions/0.1.0/)   | 0.1.0    | Roo package manager. |\n"
                "| [proof](packages/proof/versions/0.1.0/) | 0.1.0    | Roo test framework.  |\n\n"
                "## Packages\n\n"
                "| Package                                     | Versions | Description        |\n"
                "| ------------------------------------------- | -------- | ------------------ |\n"
                "| [zoology](packages/zoology/versions/0.1.0/) | 0.1.0    | Schema validation. |"
                "\n")
           (:content index-page)))))
