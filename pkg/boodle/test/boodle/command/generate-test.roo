(ns boodle.command.generate-test
  (:require proof.core
            [boodle.command.generate :as generate]
            [boodle.model :as model]
            [roo.io :as io]))

(def lookup-index
  "Lookup index fixture used by Boodle generate command tests."
  {:format :roo/symbol-index
   :version 1
   :package {:name "roo"
             :version "0.1.0"
             :description "Roo standard library."}
   :namespaces [{:name "roo"
                 :doc {:summary "Implicit runtime namespace."}}]
   :symbols [{:id "roo/+"
              :name "+"
              :qualified-name "roo/+"
              :namespace "roo"
              :kind :function
              :origin :native
              :doc {:summary "Add numbers."}
              :signatures [{:display "(+ numbers...)"
                            :params [{:name "numbers"
                                      :display "numbers..."
                                      :doc "Numbers to add."}]
                            :returns {:doc "The sum."}}]}]})

(deftest parses-generate-options
  (is (= {:format :github-pages
          :out "build/docs"
          :navigation-style :breadcrumbs
          :package-groups []
          :indexes ["roo.edn" "zoology.edn"]
          :errors []}
         (generate/parse-args ["--format" "github-pages"
                               "--out" "build/docs"
                               "roo.edn"
                               "zoology.edn"]))))

(deftest parses-package-group-options
  (is (= {:format :github-pages
          :out "build/docs"
          :navigation-style :breadcrumbs
          :package-groups [(model/package-group {:title "The Roo Language"
                                                :package-ids ["roo"]})
                           (model/package-group {:title "Packages"
                                                :package-ids ["*"]})]
          :indexes ["roo.edn"]
          :errors []}
         (generate/parse-args ["--out" "build/docs"
                               "--package-group" "The Roo Language:roo"
                               "--package-group" "Packages:*"
                               "roo.edn"]))))

(deftest parses-navigation-options
  (is (= {:format :github-pages
          :out "build/docs"
          :navigation-style :up
          :package-groups []
          :indexes ["roo.edn"]
          :errors []}
         (generate/parse-args ["--out" "build/docs"
                               "--navigation" "up"
                               "roo.edn"]))))

(deftest reports-generate-argument-errors
  (is (= {:format :github-pages
          :out nil
          :navigation-style :breadcrumbs
          :package-groups []
          :indexes []
          :errors ["Unknown output format: html"
                   "Missing output directory"
                   "Missing lookup index file"]}
         (generate/parse-args ["--format" "html"])))
  (is (= {:format :github-pages
          :out "build/docs"
          :navigation-style :breadcrumbs
          :package-groups []
          :indexes ["roo.edn"]
          :errors ["Unknown navigation style: trail"]}
         (generate/parse-args ["--out" "build/docs"
                               "--navigation" "trail"
                               "roo.edn"]))))

(deftest expands-package-group-wildcards
  (let [catalog (model/catalog
                  [(model/package {:id "roo" :name "roo"})
                   (model/package {:id "loom" :name "loom"})
                   (model/package {:id "proof" :name "proof"})
                   (model/package {:id "zoology" :name "zoology"})])
        grouped (generate/catalog-with-package-groups
                  catalog
                  [(model/package-group {:title "The Roo Language"
                                        :package-ids ["roo"]})
                   (model/package-group {:title "Core Libraries"
                                        :package-ids ["loom" "proof"]})
                   (model/package-group {:title "Packages"
                                        :package-ids ["*"]})])]
    (is (= [(model/package-group {:title "The Roo Language"
                                 :package-ids ["roo"]})
            (model/package-group {:title "Core Libraries"
                                 :package-ids ["loom" "proof"]})
            (model/package-group {:title "Packages"
                                 :package-ids ["zoology"]})]
           (:package-groups grouped)))))

(deftest generates-github-pages-files
  (let [root "boodle-generate-test"
        index-file (io/join-path root "roo.edn")
        output-dir (io/join-path root "docs")]
    (when (io/exists? root)
      (io/remove-tree! root))
    (io/spit-edn! index-file lookup-index)
    (let [result (generate/run! ["--out" output-dir index-file])]
      (is (= :text (:format result)))
      (is (= ["boodle: wrote 8 files to boodle-generate-test/docs"]
             (:output result)))
      (is (= "---\nlayout: "
             (substr (io/slurp! (io/join-path output-dir "packages/roo/versions/0.1.0/index.md"))
                     0
                     12))))
    (io/remove-tree! root)))

(deftest includes-materialized-package-versions
  (let [root "boodle-generate-versions-test"
        index-file (io/join-path root "roo.edn")
        output-dir (io/join-path root "docs")
        old-version-page (io/join-path output-dir
                                       "packages/roo/versions/0.0.9/index.md")
        package-page (io/join-path output-dir
                                   "packages/roo/versions/0.1.0/index.md")]
    (when (io/exists? root)
      (io/remove-tree! root))
    (io/spit! old-version-page "old version")
    (io/spit-edn! index-file lookup-index)
    (generate/run! ["--out" output-dir index-file])
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo 0.1.0\n"
                "---\n\n"
                "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">roo 0.1.0</span>\n"
                "</nav>\n"
                "<div class=\"version-context\">\n"
                "<span class=\"version-package\">roo</span>\n"
                "<label class=\"version-select-label\">Version "
                "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
                "<option value=\"../0.0.9/\">0.0.9</option>\n"
                "<option value=\"../0.1.0/\" selected>0.1.0</option>\n"
                "</select></label>\n"
                "</div>\n"
                "# roo 0.1.0\n\n"
                "Roo standard library.\n\n"
                "| Namespace                  | Symbols |\n"
                "| -------------------------- | ------- |\n"
                "| [roo](namespaces/roo.html) | 1       |"
                "\n")
           (io/slurp! package-page)))
    (io/remove-tree! root)))
