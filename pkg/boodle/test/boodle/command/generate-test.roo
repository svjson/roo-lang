(ns boodle.command.generate-test
  (:require proof.core
            [proof.syntax :as p]
            [boodle.command.generate :as generate]
            [boodle.model :as model]
            [roo.io :as io]))

(def lookup-index
  "Lookup index fixture used by Boodle generate command tests."
  {:format :roo/symbol-index
   :version 1
   :package {:name "roo"
             :version "0.1.0"
             :description "Roo standard library."}
   :namespaces [{:name "roo"
                 :doc {:summary "Implicit runtime namespace."}}]
   :symbols [{:id "roo/+"
              :name "+"
              :qualified-name "roo/+"
              :namespace "roo"
              :kind :function
              :origin :native
              :doc {:summary "Add numbers."}
              :signatures [{:display "(+ numbers...)"
                            :params [{:name "numbers"
                                      :display "numbers..."
                                      :doc "Numbers to add."}]
                            :returns {:doc "The sum."}}]}]})


;; boodle.command.generate/parse-package-group

(deftest parse-package-group/parses-title-and-package-ids
  (is (= {:value (model/package-group
                   {:title "The Roo Language"
                    :package-ids ["roo" "lookup"]})}
         (generate/parse-package-group
          ["The Roo Language:roo" "lookup"]))))

(deftest parse-package-group/reports-an-invalid-value
  (is (= {:error {:kind :invalid-package-group
                  :value "roo,lookup"
                  :expected "title:id[,id]"}}
         (generate/parse-package-group ["roo" "lookup"]))))



;; boodle.command.generate/catalog-with-package-groups

(deftest catalog-with-package-groups/expands-wildcards
  (p/when []
    (generate/catalog-with-package-groups
     (model/catalog
      [(model/package {:id "roo" :name "roo"})
       (model/package {:id "loom" :name "loom"})
       (model/package {:id "proof" :name "proof"})
       (model/package {:id "zoology" :name "zoology"})])
     [(model/package-group {:title "The Roo Language"
                            :package-ids ["roo"]})
      (model/package-group {:title "Core Libraries"
                            :package-ids ["loom" "proof"]})
      (model/package-group {:title "Packages"
                            :package-ids ["*"]})]))

  (p/then [catalog]
    (is (= [(model/package-group {:title "The Roo Language"
                                 :package-ids ["roo"]})
            (model/package-group {:title "Core Libraries"
                                  :package-ids ["loom" "proof"]})
            (model/package-group {:title "Packages"
                                  :package-ids ["zoology"]})]
           (:package-groups catalog)))))



;; boodle.command.generate/execute!

(deftest execute!/generates-github-pages-files
  (p/given
    (let [root "boodle-generate-test"
          index-file (io/join-path root "roo.edn")]
      (when (io/exists? root)
        (io/remove-tree! root))
      (io/spit-edn! index-file lookup-index)
      {:root root
       :index-file index-file
       :output-dir (io/join-path root "docs")}))

  (p/when [{:keys [root index-file output-dir]}]
    {:root root
     :result (select-keys
              (generate/execute!
               {:cli-trooper/print! (fn [line] nil)}
               {:format :github-pages
                :out output-dir
                :navigation-style :breadcrumbs
                :package-groups []
                :indexes [index-file]})
              [:format :output])
     :package-page-prefix
     (substr (io/slurp! (io/join-path
                         output-dir
                         "packages/roo/versions/0.1.0/index.md"))
             0
             12)})

  (p/then [{:keys [root result package-page-prefix]}]
    (is (= {:format :text
            :output ["boodle: wrote 8 files to boodle-generate-test/docs"]}
           result))
    (is (= "---\nlayout: " package-page-prefix))
    (io/remove-tree! root)))

(deftest execute!/includes-materialized-package-versions
  (p/given
    (let [root "boodle-generate-versions-test"
          index-file (io/join-path root "roo.edn")
          output-dir (io/join-path root "docs")]
      (when (io/exists? root)
        (io/remove-tree! root))
      (io/spit! (io/join-path output-dir
                              "packages/roo/versions/0.0.9/index.md")
                "old version")
      (io/spit-edn! index-file lookup-index)
      {:root root
       :index-file index-file
       :output-dir output-dir}))

  (p/when [{:keys [root index-file output-dir]}]
    (generate/execute!
     {:cli-trooper/print! (fn [line] nil)}
     {:format :github-pages
      :out output-dir
      :navigation-style :breadcrumbs
      :package-groups []
      :indexes [index-file]})
    {:root root
     :package-page
     (io/slurp! (io/join-path output-dir
                              "packages/roo/versions/0.1.0/index.md"))})

  (p/then [{:keys [root package-page]}]
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo 0.1.0\n"
                "---\n\n"
                "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">roo 0.1.0</span>\n"
                "</nav>\n"
                "<div class=\"version-context\">\n"
                "<span class=\"version-package\">roo</span>\n"
                "<label class=\"version-select-label\">Version "
                "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
                "<option value=\"../0.0.9/\">0.0.9</option>\n"
                "<option value=\"../0.1.0/\" selected>0.1.0</option>\n"
                "</select></label>\n"
                "</div>\n"
                "# roo 0.1.0\n\n"
                "Roo standard library.\n\n"
                "| Namespace                  | Symbols |\n"
                "| -------------------------- | ------- |\n"
                "| [roo](namespaces/roo.html) | 1       |"
                "\n")
           package-page))
    (io/remove-tree! root)))
