(ns boodle.command.generate-test
  (:require proof.core
            [proof.syntax :as p]
            [boodle.command.generate :as generate]
            [boodle.model :as model]
            [roo.io :as io]))

(def lookup-index
  "Lookup index fixture used by Boodle generate command tests."
  {:format :roo/symbol-index
   :version 1
   :package {:name "roo"
             :version "0.1.0"
             :description "Roo standard library."}
   :namespaces [{:name "roo"
                 :summary "Implicit runtime namespace."
                 :content [{:kind :text
                            :content "Implicit runtime namespace."}]}]
   :symbols [{:id "roo/+"
              :name "+"
              :qualified-name "roo/+"
              :namespace "roo"
              :kind :function
              :origin :native
              :summary "Add numbers."
              :content [{:kind :text :content "Add numbers."}
                        {:kind :sig-args :index 0}
                        {:kind :sig-ret :index 0}]
              :signatures [{:display "(+ numbers...)"
                            :params [{:name "numbers"
                                      :display "numbers..."
                                      :content [{:kind :text
                                                 :content "Numbers to add."}]}]
                            :returns {:content [{:kind :text
                                                :content "The sum."}]}}]}]})


;; boodle.command.generate/parse-package-group

(deftest parse-package-group/parses-title-and-package-ids
  (is (= {:value (model/package-group
                   {:title "The Roo Language"
                    :package-ids ["roo" "lookup"]})}
         (generate/parse-package-group
          ["The Roo Language:roo" "lookup"]))))

(deftest parse-package-group/reports-an-invalid-value
  (is (= {:error {:kind :invalid-package-group
                  :value "roo,lookup"
                  :expected "title:id[,id]"}}
         (generate/parse-package-group ["roo" "lookup"]))))



;; boodle.command.generate/catalog-with-package-groups

(deftest catalog-with-package-groups/expands-wildcards
  (p/when []
    (generate/catalog-with-package-groups
     (model/catalog
      [(model/package {:id "roo" :name "roo"})
       (model/package {:id "loom" :name "loom"})
       (model/package {:id "proof" :name "proof"})
       (model/package {:id "zoology" :name "zoology"})])
     [(model/package-group {:title "The Roo Language"
                            :package-ids ["roo"]})
      (model/package-group {:title "Core Libraries"
                            :package-ids ["loom" "proof"]})
      (model/package-group {:title "Packages"
                            :package-ids ["*"]})]))

  (p/then [catalog]
    (is (= [(model/package-group {:title "The Roo Language"
                                 :package-ids ["roo"]})
            (model/package-group {:title "Core Libraries"
                                  :package-ids ["loom" "proof"]})
            (model/package-group {:title "Packages"
                                  :package-ids ["zoology"]})]
           (:package-groups catalog)))))



;; boodle.command.generate/execute!

(deftest execute!/generates-github-pages-files
  (p/given
    (let [root "boodle-generate-test"
          index-file (io/join-path root "roo.edn")]
      (when (io/exists? root)
        (io/remove-tree! root))
      (io/spit-edn! index-file lookup-index)
      {:root root
       :index-file index-file
       :output-dir (io/join-path root "docs")}))

  (p/when [{:keys [root index-file output-dir]}]
    {:root root
     :result (select-keys
              (generate/execute!
               {:cli-trooper/print! (fn [line] nil)}
               {:format :github-pages
                :out output-dir
                :navigation-style :breadcrumbs
                :publication-mode :development
                :publication-identity "next"
                :package-groups []
                :indexes [index-file]})
              [:format :output])
     :package-page-prefix
     (substr (io/slurp! (io/join-path
                         output-dir
                         "packages/roo/versions/next/index.md"))
             0
             12)
     :package-index (io/slurp! (io/join-path output-dir
                                             "packages/roo/index.md"))
     :root-index (io/slurp! (io/join-path output-dir "index.md"))
     :publication-data (io/slurp! (io/join-path output-dir
                                                "_data/publications.yml"))
     :declared-version-path?
     (io/exists? (io/join-path output-dir
                               "packages/roo/versions/0.1.0"))})

  (p/then [{:keys [root result package-page-prefix package-index root-index publication-data
                   declared-version-path?]}]
    (is (= {:format :text
            :output ["boodle: wrote 9 files to boodle-generate-test/docs"]}
           result))
    (is (= "---\nlayout: " package-page-prefix))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo\n"
                "---\n\n"
                "<meta http-equiv=\"refresh\" content=\"0; url=versions/next/\">\n"
                "[roo next](versions/next/)\n")
           package-index))
    (is (contains? (split root-index "\n")
                   "| [roo](packages/roo/) | next     | Roo standard library. |"))
    (is (= (str "packages:\n"
                "  \"roo\":\n"
                "    default: \"next\"\n"
                "    publications:\n"
                "      - identity: \"next\"\n"
                "        mode: \"development\"\n")
           publication-data))
    (is (= false declared-version-path?))
    (io/remove-tree! root)))

(deftest execute!/includes-materialized-package-versions
  (p/given
    (let [root "boodle-generate-versions-test"
          index-file (io/join-path root "roo.edn")
          output-dir (io/join-path root "docs")]
      (when (io/exists? root)
        (io/remove-tree! root))
      (io/spit! (io/join-path output-dir
                              "packages/roo/versions/0.0.9/index.md")
                "old version")
      (io/spit-edn! index-file lookup-index)
      {:root root
       :index-file index-file
       :output-dir output-dir}))

  (p/when [{:keys [root index-file output-dir]}]
    (generate/execute!
     {:cli-trooper/print! (fn [line] nil)}
     {:format :github-pages
      :out output-dir
      :navigation-style :breadcrumbs
      :publication-mode :development
      :publication-identity "next"
      :package-groups []
      :indexes [index-file]})
    {:root root
     :package-page
     (io/slurp! (io/join-path output-dir
                              "packages/roo/versions/next/index.md"))
     :package-index (io/slurp! (io/join-path output-dir
                                             "packages/roo/index.md"))})

  (p/then [{:keys [root package-page package-index]}]
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo next\n"
                "---\n\n"
                "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
                "<a href=\"../../../../\">Reference</a>\n"
                "<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                "<span aria-current=\"page\">roo next</span>\n"
                "</nav>\n"
                "<div class=\"version-context\">\n"
                "<span class=\"version-package\">roo</span>\n"
                "<label class=\"version-select-label\">Version "
                "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
                "{% assign package_publications = site.data.publications.packages[\"roo\"].publications %}\n"
                "{% for publication in package_publications %}\n"
                "<option value=\"../{{ publication.identity }}/\"{% if publication.identity == \"next\" %} selected{% endif %}>{{ publication.identity }}</option>\n"
                "{% endfor %}\n"
                "</select></label>\n"
                "</div>\n"
                "# roo next\n\n"
                "Roo standard library.\n\n"
                "| Namespace                  | Symbols |\n"
                "| -------------------------- | ------- |\n"
                "| [roo](namespaces/roo.html) | 1       |"
                "\n")
           package-page))
    (is (= (str "---\n"
                "layout: reference\n"
                "title: roo\n"
                "---\n\n"
                "<meta http-equiv=\"refresh\" content=\"0; url=versions/0.0.9/\">\n"
                "[roo 0.0.9](versions/0.0.9/)\n")
           package-index))
    (io/remove-tree! root)))

(deftest execute!/replaces-the-retained-prerelease
  (p/given
    (let [root "boodle-generate-prerelease-test"
          index-file (io/join-path root "roo.edn")
          output-dir (io/join-path root "docs")
          versions-dir (io/join-path output-dir "packages/roo/versions")]
      (when (io/exists? root)
        (io/remove-tree! root))
      (doseq [identity ["0.1.0" "0.2.0-alpha.1" "next"]]
        (io/spit! (io/join-path (io/join-path versions-dir identity) "index.md")
                  identity))
      (io/spit-edn! index-file lookup-index)
      {:root root
       :index-file index-file
       :output-dir output-dir
       :versions-dir versions-dir}))

  (p/when [{:keys [root index-file output-dir versions-dir]}]
    (generate/execute! {:cli-trooper/print! (fn [line] nil)}
                       {:format :github-pages
                        :out output-dir
                        :navigation-style :breadcrumbs
                        :publication-mode :prerelease
                        :publication-identity "0.2.0-beta.1"
                        :package-groups []
                        :indexes [index-file]})
    {:root root
     :paths {:stable (io/exists? (io/join-path versions-dir "0.1.0"))
             :old-prerelease (io/exists? (io/join-path versions-dir
                                                       "0.2.0-alpha.1"))
             :prerelease (io/exists? (io/join-path versions-dir
                                                   "0.2.0-beta.1"))
             :development (io/exists? (io/join-path versions-dir "next"))}
     :package-index (io/slurp! (io/join-path output-dir
                                             "packages/roo/index.md"))})

  (p/then [{:keys [root paths package-index]}]
    (is (= {:stable true
            :old-prerelease false
            :prerelease true
            :development true}
           paths))
    (is (contains? (split package-index "\n")
                   "<meta http-equiv=\"refresh\" content=\"0; url=versions/0.1.0/\">"))
    (io/remove-tree! root)))

(deftest execute!/removes-a-prerelease-when-its-stable-version-is-published
  (p/given
    (let [root "boodle-generate-stable-test"
          index-file (io/join-path root "roo.edn")
          output-dir (io/join-path root "docs")
          versions-dir (io/join-path output-dir "packages/roo/versions")]
      (when (io/exists? root)
        (io/remove-tree! root))
      (doseq [identity ["0.1.0" "0.2.0-rc.1" "next"]]
        (io/spit! (io/join-path (io/join-path versions-dir identity) "index.md")
                  identity))
      (io/spit-edn! index-file lookup-index)
      {:root root
       :index-file index-file
       :output-dir output-dir
       :versions-dir versions-dir}))

  (p/when [{:keys [root index-file output-dir versions-dir]}]
    (generate/execute! {:cli-trooper/print! (fn [line] nil)}
                       {:format :github-pages
                        :out output-dir
                        :navigation-style :breadcrumbs
                        :publication-mode :stable
                        :publication-identity "0.2.0"
                        :package-groups []
                        :indexes [index-file]})
    {:root root
     :paths {:previous-stable (io/exists? (io/join-path versions-dir "0.1.0"))
             :prerelease (io/exists? (io/join-path versions-dir "0.2.0-rc.1"))
             :stable (io/exists? (io/join-path versions-dir "0.2.0"))
             :development (io/exists? (io/join-path versions-dir "next"))}
     :package-index (io/slurp! (io/join-path output-dir
                                             "packages/roo/index.md"))})

  (p/then [{:keys [root paths package-index]}]
    (is (= {:previous-stable true
            :prerelease false
            :stable true
            :development true}
           paths))
    (is (contains? (split package-index "\n")
                   "<meta http-equiv=\"refresh\" content=\"0; url=versions/0.2.0/\">"))
    (io/remove-tree! root)))
