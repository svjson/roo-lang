(ns boodle.topology.reference-test
  (:require proof.core
            [boodle.model :as model]
            [boodle.topology.reference :as reference]))

(def sample-catalog
  "Catalog used by reference topology tests."
  (model/catalog
    [(model/package
       {:id "roo"
        :name "roo"
        :version "0.1.0"
        :namespaces [(model/namespace
                       {:name "roo.string"
                        :entries [(model/entry
                                    {:id "roo.string/replace"
                                     :name "replace"
                                     :qualified-name "roo.string/replace"
                                     :namespace "roo.string"})]})
                     (model/namespace {:name "roo.io"})]})]))

(deftest slugs-symbolic-names
  (is (= "minus" (reference/slug-text "-")))
  (is (= "minus-greater-than" (reference/slug-text "->")))
  (is (= "greater-than" (reference/slug-text ">")))
  (is (= "assoc-in" (reference/slug-text "assoc-in"))))

(deftest creates-reference-pages
  (let [package (head (:packages sample-catalog))
        string-namespace (head (:namespaces package))
        string-entry (head (:entries string-namespace))
        io-namespace (nth (:namespaces package) 1)]
    (is (= [{:kind :index
             :path "index.md"
             :catalog sample-catalog}
            {:kind :package-index
             :path "packages/roo/index.md"
             :package package}
            {:kind :package
             :path "packages/roo/versions/0.1.0/index.md"
             :package package}
            {:kind :namespace
             :path "packages/roo/versions/0.1.0/namespaces/roo.string.md"
             :package package
             :namespace string-namespace}
            {:kind :symbol
             :path "packages/roo/versions/0.1.0/namespaces/roo.string/replace.md"
             :package package
             :namespace string-namespace
             :entry string-entry}
            {:kind :namespace
             :path "packages/roo/versions/0.1.0/namespaces/roo.io.md"
             :package package
             :namespace io-namespace}]
           (reference/pages sample-catalog)))))

(deftest creates-hierarchy-navigation
  (let [package (head (:packages sample-catalog))
        namespace (head (:namespaces package))
        entry (head (:entries namespace))
        package-page {:kind :package
                      :package package}
        namespace-page {:kind :namespace
                        :package package
                        :namespace namespace}
        symbol-page {:kind :symbol
                     :package package
                     :namespace namespace
                     :entry entry}]
    (is (= :breadcrumbs (reference/navigation-style {})))
    (is (= [{:label "Reference"
             :url "../../../../"}
            {:label "roo 0.1.0"}]
           (reference/breadcrumbs package-page)))
    (is (= [{:label "Reference"
             :url "../../../../../"}
            {:label "roo 0.1.0"
             :url "../"}
            {:label "roo.string"}]
           (reference/breadcrumbs namespace-page)))
    (is (= [{:label "Reference"
             :url "../../../../../../"}
            {:label "roo 0.1.0"
             :url "../../"}
            {:label "roo.string"
             :url "../roo.string.html"}
            {:label "replace"}]
           (reference/breadcrumbs symbol-page)))
    (is (= {:label "Up to Reference"
            :url "../../../../"}
           (reference/up-item package-page)))
    (is (= {:label "Up to roo 0.1.0"
            :url "../"}
           (reference/up-item namespace-page)))
    (is (= {:label "Up to roo.string"
            :url "../roo.string.html"}
           (reference/up-item symbol-page)))))
