(ns boodle.format.github-pages
  (:require [boodle.publication :as publication]
            [boodle.topology.reference :as reference]
            [moordown.ast :as md]
            [moordown.render :as markdown]
            [roo.string :as string]))

(defun package-title
  "Return the display title for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  Package name with version when available."
  [package]
  (reference/package-title package))

(defun package-version
  "Return the version label for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  Package version, or `unversioned` when no version is available."
  [package]
  (reference/package-version package))

(defun package-publications
  "Return known publications for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  Classified publication maps in public navigation order."
  [package]
  (if (not-empty? (:publications package))
    (:publications package)
    (publication/ordered
      (concat [(package-version package)] (:versions package)))))

(defun yaml-text
  "Quote TEXT for the generated publication-data YAML.

  Args:
  - `text`: Scalar text to quote.

  Returns:
  A double-quoted YAML scalar."
  [text]
  (str "\""
       (-> text
           (string/replace "\\" "\\\\")
           (string/replace "\"" "\\\""))
       "\""))

(defun publication-data-content
  "Render the shared publication catalog as Jekyll data.

  Args:
  - `catalog`: Boodle catalog with classified package publications.

  Returns:
  YAML containing ordered publications and automatic selections by package."
  [catalog]
  (str "packages:\n"
       (apply join
              (concat [""]
                      (for [package (:packages catalog)]
                        (let [publications (package-publications package)
                              selected (or (:default-publication package)
                                           (publication/automatic publications))]
                          (str "  " (yaml-text (:id package)) ":\n"
                               "    default: "
                               (if selected (yaml-text (:identity selected)) "null")
                               "\n"
                               "    publications:\n"
                               (apply join
                                      (concat [""]
                                              (for [entry publications]
                                                (str "      - identity: "
                                                     (yaml-text (:identity entry))
                                                     "\n"
                                                     "        mode: "
                                                     (yaml-text (name (:mode entry)))
                                                     "\n")))))))))))

(defun front-matter
  "Return Jekyll front matter for TITLE.

  Args:
  - `title`: Page title.

  Returns:
  YAML front matter that marks a Markdown file for Jekyll processing."
  [title]
  (str "---\n"
       "layout: reference\n"
       "title: " title "\n"
       "---\n\n"))

(defun html-text
  "Escape VALUE for generated HTML.

  Args:
  - `value`: Text value to include in HTML.

  Returns:
  HTML-safe text."
  [value]
  (-> (str value)
      (string/replace "&" "&amp;")
      (string/replace "<" "&lt;")
      (string/replace ">" "&gt;")
      (string/replace "\"" "&quot;")))

(defun documentation-text
  "Return block content as text for compact documentation contexts.

  Args:
  - `blocks`: Ordered documentation blocks.

  Returns:
  Nonempty block content joined by blank lines."
  [blocks]
  (apply join
         (concat ["\n\n"]
                 (keep blocks
                       (fn [block]
                         (when-let [content (:content block)]
                           (unless (blank? content) content)))))))

(defun signature-params
  "Return a Markdown parameter table for SIGNATURE when it has parameters.

  Args:
  - `signature`: Lookup-style signature map.

  Returns:
  A one-element block vector, or an empty vector when no parameters are present."
  [signature]
  (if (empty? (:params signature))
    []
    [(md/table ["Arg" "Description"]
               (for [param (:params signature)]
                 [(or (:display param) (:name param))
                  (documentation-text (:content param))]))]))

(defun signature-args-blocks
  "Return Markdown blocks for a signature's argument declaration.

  Args:
  - `signature`: Lookup-style signature map.

  Returns:
  Blocks containing a Signature heading, rendered call shape, and parameter
  table."
  [signature]
  (concat [(md/heading 2 "Signature:")
           (md/code-block "roo" (:display signature))]
          (signature-params signature)))

(defun signature-return-blocks
  "Return Markdown blocks for a signature's documented return value.

  Args:
  - `entry`: Boodle entry containing the signature.
  - `signature`: Lookup-style signature map.

  Returns:
  A Returns heading and its ordered content, or an empty vector."
  [entry signature]
  (if-let [returns (:returns signature)]
    (concat [(md/heading 3 "Returns:")]
            (content-blocks entry (:content returns)))
    []))

(defun content-blocks
  "Convert ordered documentation blocks to Moordown blocks.

  Args:
  - `entry`: Boodle entry or namespace containing any referenced signatures.
  - `blocks`: Ordered documentation blocks.

  Returns:
  Moordown blocks in source order."
  [entry blocks]
  (flat-map (range 0 (- (count blocks) 1))
            (fn [position]
              (let [block (nth blocks position)
                    following (when (< position (- (count blocks) 1))
                                (nth blocks (+ position 1)))]
                (case (:kind block)
                  :text [(md/paragraph (:content block))]
                  :header [(md/heading 3 (:content block))]
                  :code [(md/code-block (name (or (:language block) :roo))
                                        (:content block))]
                  :sig-args
                  (when (< (:index block) (count (:signatures entry)))
                    (let [signature (nth (:signatures entry) (:index block))]
                      (concat ["<hr class=\"signature-divider\">"]
                              (signature-args-blocks signature)
                              (if (and (= :sig-ret (:kind following))
                                       (= (:index block) (:index following)))
                                []
                                (signature-return-blocks entry signature)))))
                  :sig-ret
                  (when (< (:index block) (count (:signatures entry)))
                    (signature-return-blocks entry
                                             (nth (:signatures entry) (:index block))))
                  :default [])))))

(defun unplaced-signature-blocks
  "Render signature arguments that have no source occurrence block.

  Args:
  - `entry`: Boodle entry with signatures and ordered content.

  Returns:
  Moordown blocks for signatures not selected by any `:sig-args` block."
  [entry]
  (let [placed (keep (:content entry)
                     (fn [block]
                       (when (= :sig-args (:kind block)) (:index block))))
        signatures (:signatures entry)]
    (unless (empty? signatures)
      (flat-map (range 0 (- (count signatures) 1))
                (fn [index]
                  (unless (contains? placed index)
                    (let [signature (nth signatures index)]
                      (concat ["<hr class=\"signature-divider\">"]
                              (signature-args-blocks signature)
                              (signature-return-blocks entry signature)))))))))

(defun entry-title
  "Return the display title for ENTRY.

  Args:
  - `entry`: Boodle entry map.

  Returns:
  Local symbol name when available, otherwise the qualified name."
  [entry]
  (or (:name entry) (:qualified-name entry)))

(defun entry-title-code
  "Return ENTRY display title as Markdown inline code text.

  Args:
  - `entry`: Boodle entry map.

  Returns:
  Markdown code span text for the local symbol name."
  [entry]
  (str "`" (entry-title entry) "`"))

(defun symbol-heading-html
  "Return the symbol heading and compact metadata for PAGE.

  Args:
  - `page`: Boodle symbol page map.

  Returns:
  HTML containing a linked namespace eyebrow, symbol title, and any `:since`
  or `:see` metadata."
  [{:keys [entry namespace]}]
  (let [metadata (keep [(when-let [since (:since entry)]
                          (str "<span>Since <code>"
                               (html-text since)
                               "</code></span>"))
                        (when-let [deprecated (:deprecated entry)]
                          (str "<span>Deprecated: "
                               (html-text deprecated)
                               "</span>"))
                        (unless (empty? (:see entry))
                          (str "<span>See also: "
                               (apply join
                                      (concat [", "]
                                              (for [reference (:see entry)]
                                                (str "<code>"
                                                     (html-text reference)
                                                     "</code>"))))
                               "</span>"))]
                       identity)]
    (str "<header class=\"symbol-heading\">\n"
         "<div class=\"symbol-namespace\"><a href=\"../"
         (html-text (:name namespace))
         ".html\">"
         (html-text (:name namespace))
         "</a>/</div>\n"
         "<h1><code>"
         (html-text (entry-title entry))
         "</code></h1>\n"
         (if (empty? metadata)
           ""
           (str "<div class=\"symbol-metadata\">"
                (apply join
                       (concat [" <span class=\"symbol-metadata-separator\" aria-hidden=\"true\">·</span> "]
                               metadata))
                "</div>\n"))
         "</header>")))

(defun package-url
  "Return the root index URL for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  URL to the package entrypoint for publication-aware catalogs, otherwise the
  directly rendered package version."
  [package]
  (if (:publication package)
    (str "packages/" (:id package) "/")
    (str "packages/" (:id package) "/versions/" (package-version package) "/")))

(defun package-row
  "Return the root index table row for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  A Markdown table row vector."
  [package]
  [(md/link (:name package) (package-url package))
   (apply join (concat [", "]
                       (map (package-publications package) :identity)))
   (:summary package)])

(defun package-table
  "Return a package table block for PACKAGES.

  Args:
  - `packages`: Boodle package maps.

  Returns:
  A Moordown table block."
  [packages]
  (md/table ["Package" "Versions" "Description"]
            (map packages package-row)))

(defun package-with-id
  "Return the package with ID from PACKAGES.

  Args:
  - `packages`: Boodle package maps.
  - `id`: Package id to find.

  Returns:
  Matching package map, or nil."
  [packages id]
  (find-first packages
              (fn [package]
                (= id (:id package)))))

(defun packages-with-ids
  "Return PACKAGES matching IDS in IDS order.

  Args:
  - `packages`: Boodle package maps.
  - `ids`: Package ids to include.

  Returns:
  Matching packages."
  [packages ids]
  (keep ids
        (fn [id]
          (package-with-id packages id))))

(defun package-section-blocks
  "Return root index blocks for TITLE and PACKAGES.

  Args:
  - `title`: Section heading text.
  - `packages`: Boodle package maps.

  Returns:
  Heading and package table blocks, or an empty vector when PACKAGES is empty."
  [title packages]
  (unless (empty? packages)
    [(md/heading 2 title)
     (package-table packages)]))

(defun package-group-blocks
  "Return root index blocks for GROUP.

  Args:
  - `packages`: Catalog package maps.
  - `group`: Package group map.

  Returns:
  Heading and package table blocks for the packages named by GROUP."
  [packages group]
  (package-section-blocks (:title group)
                          (packages-with-ids packages (:package-ids group))))

(defun package-index-blocks
  "Return package blocks for the root index.

  Args:
  - `packages`: Catalog package maps.
  - `groups`: Optional package group maps.

  Returns:
  Either grouped package sections or one flat package table."
  [packages groups]
  (if (or (nil? groups) (empty? groups))
    [(package-table packages)]
    (flat-map groups
              (fn [group]
                (package-group-blocks packages group)))))

(defun index-document
  "Return the GitHub Pages index document for PAGE.

  Args:
  - `page`: Boodle index page map.

  Returns:
  A Moordown document."
  [{:keys [catalog]}]
  (md/document
    (concat [(md/heading 1 "roo-lang - Reference")]
            (package-index-blocks (:packages catalog)
                                  (:package-groups catalog)))))

(defun package-index-url
  "Return the current-version URL from a package index redirect page.

  Args:
  - `package`: Boodle package map.

  Returns:
  Relative URL to the automatically selected package version page, or nil."
  [package]
  (if (:publication package)
    (when-let [selected (:default-publication package)]
      (str "versions/" (:identity selected) "/"))
    (str "versions/" (package-version package) "/")))

(defun package-index-document
  "Return the GitHub Pages package redirect document for PAGE.

  Args:
  - `page`: Boodle package index page map.

  Returns:
  A redirect fallback linking to the selected release, or a neutral development
  landing page when no release exists."
  [{:keys [package]}]
  (if-let [url (package-index-url package)]
    (let [selected (:default-publication package)]
      (md/document [(md/paragraph
                       (md/link (if selected
                                  (str (:name package) " " (:identity selected))
                                  (package-title package))
                                url))]))
    (let [development (find-first (:publications package)
                                  (fn [publication]
                                    (= :development (:mode publication))))]
      (md/document (concat [(md/heading 1 (:name package))
                            (md/paragraph
                              "No stable or prerelease documentation has been published.")]
                           (when development
                             [(md/paragraph
                                (md/link "View next development documentation"
                                         (str "versions/"
                                              (:identity development)
                                              "/")))]))))))

(defun package-document
  "Return the GitHub Pages package document for PAGE.

  Args:
  - `page`: Boodle package page map.

  Returns:
  A Moordown document."
  [{:keys [package]}]
  (md/document
    (concat [(md/heading 1 (package-title package))]
            (if-let [summary (:summary package)]
              [(md/paragraph summary)]
              [])
            [(md/table ["Namespace" "Symbols"]
                       (for [namespace (:namespaces package)]
                         [(md/link (:name namespace)
                                   (str "namespaces/"
                                        (:name namespace)
                                        ".html"))
                          (count (:entries namespace))]))])))

(defun namespace-symbol-url
  "Return the symbol page URL from a namespace overview page.

  Args:
  - `namespace`: Boodle namespace map.
  - `entry`: Boodle entry map.

  Returns:
  Relative URL from the namespace overview page to the symbol page."
  [namespace entry]
  (str (:name namespace) "/" (reference/slug-text (:name entry)) ".html"))

(defun namespace-document
  "Return the GitHub Pages namespace document for PAGE.

  Args:
  - `page`: Boodle namespace page map.

  Returns:
  A Moordown document."
  [{:keys [namespace]}]
  (md/document
    (concat [(md/heading 1 (:name namespace))]
            (content-blocks namespace (:content namespace))
            [(md/table ["Symbol" "Summary"]
                       (for [entry (:entries namespace)]
                         [(md/link (entry-title-code entry)
                                   (namespace-symbol-url namespace entry))
                          (:summary entry)]))])))

(defun symbol-document
  "Return the GitHub Pages symbol document for PAGE.

  Args:
  - `page`: Boodle symbol page map.

  Returns:
  A Moordown document."
  [{:keys [entry] :as page}]
  (let [content (:content entry)
        first-block (head content)
        signature-overview (unless (empty? (:signatures entry))
                             ["<hr class=\"signature-divider\">"
                              (md/code-block "roo"
                                             (apply join
                                                    (concat ["\n"]
                                                            (for [signature (:signatures entry)]
                                                              (:display signature)))))
                              "<hr class=\"signature-divider\">"])
        blocks (if (and (= :text (:kind first-block))
                        (= (:summary entry) (:content first-block)))
                 (concat [(symbol-heading-html page)]
                         (content-blocks entry [first-block])
                         signature-overview
                         (content-blocks entry (tail content))
                         (unplaced-signature-blocks entry))
                 (concat [(symbol-heading-html page)]
                         signature-overview
                         (content-blocks entry content)
                         (unplaced-signature-blocks entry)))]
    (md/document (reduce blocks
                         []
                         (fn [document block]
                           (if (and (= "<hr class=\"signature-divider\">" block)
                                    (= "<hr class=\"signature-divider\">" (last document)))
                             document
                             (append document block)))))))

(defun page-document
  "Return the Moordown document for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  A Moordown document for GitHub Pages flavored Markdown."
  [page]
  (case (:kind page)
    :index (index-document page)
    :package-index (package-index-document page)
    :package (package-document page)
    :namespace (namespace-document page)
    :symbol (symbol-document page)))

(defun page-title
  "Return the HTML page title for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Title text for Jekyll front matter."
  [page]
  (case (:kind page)
    :index "Reference"
    :package-index (:name (:package page))
    :package (package-title (:package page))
    :namespace (:name (:namespace page))
    :symbol (:qualified-name (:entry page))))

(defun namespace-overview-url
  "Return the namespace overview URL from PAGE.

  Args:
  - `page`: Boodle namespace or symbol page.

  Returns:
  Relative URL to the namespace overview page."
  [page]
  (case (:kind page)
    :namespace (str (:name (:namespace page)) ".html")
    :symbol (str "../" (:name (:namespace page)) ".html")))

(defun sidebar-symbol-url
  "Return the URL for ENTRY from PAGE.

  Args:
  - `page`: Boodle namespace or symbol page.
  - `entry`: Boodle entry map.

  Returns:
  Relative URL to `entry`."
  [page entry]
  (case (:kind page)
    :namespace (namespace-symbol-url (:namespace page) entry)
    :symbol (str (reference/slug-text (:name entry)) ".html")))

(defun sidebar-symbol-link
  "Return a sidebar link for ENTRY from PAGE.

  Args:
  - `page`: Boodle namespace or symbol page.
  - `entry`: Boodle entry map.

  Returns:
  HTML list item for one sidebar symbol link."
  [page entry]
  (str "<li><a"
       (if (= (:id entry) (:id (:entry page)))
         " class=\"active\""
         "")
       " href=\""
       (sidebar-symbol-url page entry)
       "\">"
       (html-text (:name entry))
       "</a></li>\n"))

(defun sidebar-html
  "Return namespace sidebar HTML for PAGE.

  Args:
  - `page`: Boodle namespace or symbol page.

  Returns:
  HTML navigation listing all symbols in the page namespace."
  [{:keys [namespace] :as page}]
  (str "<nav class=\"reference-sidebar\">\n"
         "<a class=\""
         (case (:kind page)
           :namespace "namespace-link active"
           :default "namespace-link")
         "\" href=\""
         (namespace-overview-url page)
         "\">"
         (html-text (:name namespace))
         "</a>\n"
         "<ol>\n"
         (apply join (concat [""]
                             (for [entry (:entries namespace)]
                               (sidebar-symbol-link page entry))))
         "</ol>\n"
         "</nav>\n"))

(defun navigation-link-html
  "Return an HTML link for navigation ITEM.

  Args:
  - `item`: Navigation item map.

  Returns:
  Escaped HTML link."
  [item]
  (str "<a href=\""
       (html-text (:url item))
       "\">"
       (html-text (:label item))
       "</a>"))

(defun breadcrumb-item-html
  "Return breadcrumb HTML for ITEM.

  Args:
  - `item`: Breadcrumb item map.

  Returns:
  HTML for a linked or current breadcrumb item."
  [item]
  (if (:url item)
    (navigation-link-html item)
    (str "<span aria-current=\"page\">"
         (html-text (:label item))
         "</span>")))

(defun breadcrumb-items-html
  "Return HTML for breadcrumb ITEMS.

  Args:
  - `items`: Breadcrumb item maps.

  Returns:
  HTML for breadcrumb items separated by hierarchy marks."
  [items]
  (if (empty? items)
    ""
    (str (breadcrumb-item-html (head items))
         (if (empty? (tail items))
           ""
           (str "\n<span class=\"breadcrumb-separator\" aria-hidden=\"true\">/</span>\n"
                (breadcrumb-items-html (tail items)))))))

(defun breadcrumbs-html
  "Return breadcrumb navigation HTML for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Breadcrumb navigation markup, or an empty string."
  [page]
  (let [items (reference/breadcrumbs page)]
    (if (empty? items)
      ""
      (str "<nav class=\"reference-breadcrumbs\" aria-label=\"Breadcrumbs\">\n"
           (breadcrumb-items-html items)
           "\n</nav>\n"))))

(defun up-navigation-html
  "Return upward navigation HTML for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Upward navigation markup, or an empty string."
  [page]
  (if-let [item (reference/up-item page)]
    (str "<nav class=\"reference-up\" aria-label=\"Up\">"
         (navigation-link-html item)
         "</nav>\n")
    ""))

(defun navigation-html
  "Return hierarchy navigation HTML for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Navigation markup selected by the catalog navigation style."
  [page]
  (case (reference/navigation-style (:catalog page))
    :none ""
    :up (up-navigation-html page)
    :breadcrumbs (breadcrumbs-html page)
    :default (breadcrumbs-html page)))

(defun version-page-url
  "Return the URL for VERSION from PAGE.

  Args:
  - `page`: Boodle versioned reference page.
  - `version`: Package version label.

  Returns:
  Relative URL to the matching page in VERSION."
  [page version]
  (case (:kind page)
    :package (str "../" version "/")
    :namespace (str "../../"
                    version
                    "/namespaces/"
                    (:name (:namespace page))
                    ".html")
    :symbol (str "../../../"
                 version
                 "/namespaces/"
                 (:name (:namespace page))
                 "/"
                 (reference/slug-text (:name (:entry page)))
                 ".html")))

(defun version-selector-html
  "Return package version selector HTML for PAGE.

  Args:
  - `page`: Boodle versioned reference page.

  Returns:
  HTML allowing navigation between materialized package versions."
  [{:keys [package] :as page}]
  (str "<div class=\"version-context\">\n"
       "<span class=\"version-package\">"
       (html-text (:name package))
       "</span>\n"
       "<label class=\"version-select-label\">Version "
       "<select class=\"version-select\" onchange=\"if (this.value) window.location.href = this.value;\">\n"
       "{% assign package_publications = site.data.publications.packages[\""
       (html-text (:id package))
       "\"].publications %}\n"
       "{% for publication in package_publications %}\n"
       "<option value=\""
       (html-text (version-page-url page "{{ publication.identity }}"))
       "\"{% if publication.identity == \""
       (html-text (package-version package))
       "\" %} selected{% endif %}>{{ publication.identity }}</option>\n"
       "{% endfor %}\n"
       "</select></label>\n"
       "</div>\n"))

(defun version-context-html
  "Return visible package version context for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  HTML context for versioned package pages, or an empty string."
  [page]
  (if (contains? [:package :namespace :symbol] (:kind page))
    (version-selector-html page)
    ""))

(defun package-index-redirect-html
  "Return redirect markup for PAGE.

  Args:
  - `page`: Boodle package index page.

  Returns:
  HTML and fallback Markdown linking to the current package version."
  [page]
  (if-let [url (package-index-url (:package page))]
    (str "<meta http-equiv=\"refresh\" content=\"0; url="
         (html-text url)
         "\">\n"
         (markdown/render-block (page-document page)))
    (markdown/render-block (page-document page))))

(defun reference-content
  "Return rendered content for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Markdown or HTML/Markdown content for the page body."
  [page]
  (let [content (case (:kind page)
                  :package-index (package-index-redirect-html page)
                  :default (str (navigation-html page)
                                (version-context-html page)
                                (markdown/render-block (page-document page))))]
    (if (contains? [:namespace :symbol] (:kind page))
      (str "<div class=\"reference-page\">\n"
           (sidebar-html page)
           "<main class=\"reference-content\" markdown=\"block\">\n\n"
           content
           "\n</main>\n"
           "</div>\n")
      content)))

(defun render-page
  "Render PAGE as Jekyll-processable Markdown.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Markdown source with YAML front matter."
  [page]
  (str (front-matter (page-title page))
       (reference-content page)))

(def layout-content
  "Jekyll layout used by generated reference pages."
  (str "<!doctype html>\n"
       "<html lang=\"en\">\n"
       "<head>\n"
       "  <meta charset=\"utf-8\">\n"
       "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
       "  <title>{{ page.title }} | {{ site.title }}</title>\n"
       "  <link rel=\"stylesheet\" href=\"{{ '/assets/boodle.css' | relative_url }}\">\n"
       "</head>\n"
       "<body>\n"
       "  <header class=\"site-header\"><a href=\"{{ '/' | relative_url }}\">roo-lang - Reference</a></header>\n"
       "  {{ content }}\n"
       "</body>\n"
       "</html>\n"))

(def stylesheet-content
  "CSS used by generated reference pages."
  (str ":root { color-scheme: light; }\n"
       "body { margin: 0; color: #1f2937; font: 16px/1.55 system-ui, sans-serif; }\n"
       "a { color: #0f5f8f; text-decoration: none; }\n"
       "a:hover { text-decoration: underline; }\n"
       ".site-header { border-bottom: 1px solid #d7dde5; padding: 12px 24px; font-weight: 700; }\n"
       ".site-header a { color: #111827; }\n"
       "body > h1, body > h2, body > p, body > table { margin-left: auto; margin-right: auto; max-width: 960px; }\n"
       "body > h1 { padding: 0 24px; margin-top: 32px; }\n"
       "body > h2 { padding: 0 24px; margin-top: 28px; }\n"
       "body > .reference-breadcrumbs, body > .reference-up, body > .version-context { box-sizing: border-box; margin-left: auto; margin-right: auto; margin-top: 32px; max-width: 1008px; padding-left: 24px; padding-right: 24px; }\n"
       "body > .reference-breadcrumbs + .version-context, body > .reference-up + .version-context { margin-top: 0; }\n"
       "body > p, body > table { margin-top: 16px; }\n"
       "table { border-collapse: collapse; width: calc(100% - 48px); }\n"
       "th, td { border-bottom: 1px solid #e5e7eb; padding: 8px 10px; text-align: left; vertical-align: top; }\n"
       "th { background: #f5f7fa; font-weight: 700; }\n"
       "pre { overflow: auto; border: 1px solid #d7dde5; background: #f8fafc; padding: 12px; }\n"
       ".reference-page { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 32px; max-width: 1180px; margin: 0 auto; padding: 24px; }\n"
       ".reference-sidebar { align-self: start; position: sticky; top: 16px; max-height: calc(100vh - 32px); overflow: auto; border-right: 1px solid #d7dde5; padding-right: 16px; }\n"
       ".reference-sidebar ol { list-style: none; margin: 12px 0 0; padding: 0; }\n"
       ".reference-sidebar li { margin: 0; }\n"
       ".reference-sidebar a { display: block; padding: 4px 6px; border-radius: 4px; color: #374151; }\n"
       ".reference-sidebar a.active { background: #e8f2fb; color: #0f5f8f; font-weight: 700; }\n"
       ".namespace-link { font-weight: 700; }\n"
       ".reference-breadcrumbs, .reference-up { align-items: center; color: #6b7280; display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; font-weight: 700; margin-bottom: 12px; }\n"
       ".reference-breadcrumbs a, .reference-up a { color: #4b5563; }\n"
       ".breadcrumb-separator { color: #9ca3af; }\n"
       ".version-context { align-items: center; color: #6b7280; display: flex; flex-wrap: wrap; gap: 8px 12px; font-size: 14px; font-weight: 700; margin-bottom: 12px; }\n"
       ".version-package { color: #374151; }\n"
       ".version-select-label { align-items: center; display: inline-flex; gap: 6px; }\n"
       ".version-select { border: 1px solid #cbd5e1; border-radius: 4px; color: #1f2937; font: inherit; font-weight: 600; padding: 2px 24px 2px 6px; }\n"
       ".reference-content { min-width: 0; }\n"
       ".reference-content h1 { margin-top: 0; }\n"
       ".reference-content table { width: 100%; }\n"
       ".symbol-heading { margin: 0 0 24px; }\n"
       ".version-context + .symbol-heading { border-top: 1px solid #d7dde5; padding-top: 12px; }\n"
       ".symbol-heading + p { font-size: 1.125rem; line-height: 1.5; }\n"
       ".symbol-heading h1 { line-height: 1.1; margin: 0; }\n"
       ".symbol-namespace { color: #6b7280; font-size: 13px; line-height: 1; overflow-wrap: anywhere; }\n"
       ".symbol-namespace a { color: inherit; }\n"
       ".symbol-metadata { color: #6b7280; font-size: 14px; margin-top: 8px; }\n"
       ".symbol-metadata-separator { color: #9ca3af; }\n"
       ".signature-divider { border: 0; border-top: 1px solid #d7dde5; margin: 32px 0 20px; }\n"
       "@media (max-width: 760px) {\n"
       "  .reference-page { display: block; padding: 16px; }\n"
       "  .reference-sidebar { position: static; max-height: none; border-right: 0; border-bottom: 1px solid #d7dde5; padding: 0 0 16px; margin-bottom: 24px; }\n"
       "}\n"))

(defun files
  "Render CATALOG as GitHub Pages Markdown files.

  Args:
  - `catalog`: Boodle catalog map.

  Returns:
  File maps with `:path` and Markdown `:content`."
  [catalog]
  (concat [{:path "_config.yml"
            :content (str "title: roo-lang - Reference\n"
                          "markdown: kramdown\n"
                          "kramdown:\n"
                          "  syntax_highlighter_opts:\n"
                          "    formatter: HTML\n")}
           {:path "_layouts/reference.html"
            :content layout-content}
           {:path "assets/boodle.css"
            :content stylesheet-content}
           {:path "_data/publications.yml"
            :content (publication-data-content catalog)}]
          (for [source-page (reference/pages catalog)]
            (let [page (assoc source-page :catalog catalog)]
              {:path (:path page)
               :content (render-page page)}))))
