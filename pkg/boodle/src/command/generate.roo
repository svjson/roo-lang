(ns boodle.command.generate
  (:require [boodle.format.github-pages :as github-pages]
            [boodle.format.lookup :as lookup]
            [boodle.model :as model]
            [boodle.output.files :as files]
            [boodle.topology.reference :as reference]
            [roo.io :as io]))

(def usage-line
  "Usage line for the `boodle generate` command."
  "       boodle generate [-f|--format github-pages] [--navigation breadcrumbs|up|none] [--package-group <title>:<id>[,<id>]] -o|--out <dir> <index-file>...")

(defun split-package-ids
  "Split a comma-separated package id list.

  Args:
  - `text`: Comma-separated package ids.

  Returns:
  A vector of trimmed package ids."
  [text]
  (if-let [separator (find-index text
                                 (fn [ch]
                                   (= "," (str ch))))]
    (concat [(trim (substr text 0 separator))]
            (split-package-ids (substr text (+ separator 1) (count text))))
    [(trim text)]))

(defun parse-package-group
  "Parse a package group command line value.

  Args:
  - `text`: Group value formatted as `title:id,id`.

  Returns:
  A Boodle package group, or nil when TEXT is invalid."
  [text]
  (when-let [separator (find-index text
                                   (fn [ch]
                                     (= ":" (str ch))))]
    (let [title (trim (substr text 0 separator))
          package-ids (remove (split-package-ids (substr text
                                                        (+ separator 1)
                                                        (count text)))
                              blank?)]
      (unless (or (blank? title) (empty? package-ids))
        (model/package-group {:title title
                              :package-ids package-ids})))))

(defun add-package-group-option
  "Parse and append a package group option.

  Args:
  - `args`: Current argument list.
  - `options`: Accumulated options map.

  Returns:
  Updated options map after consuming `--package-group` and its value."
  [args options]
  (let [spec (nth args 1)
        group (when spec
                (parse-package-group spec))]
    (cond
      (nil? spec)
      (assoc options :errors (append (:errors options)
                                     "Missing package group after --package-group"))

      group
      (parse-args-step (tail (tail args))
                       (assoc options
                              :package-groups
                              (append (:package-groups options) group)))

      true
      (parse-args-step (tail (tail args))
                       (assoc options
                              :errors
                              (append (:errors options)
                                      (str "Invalid package group: " spec)))))))

(defun navigation-style-option
  "Return the navigation style keyword for TEXT.

  Args:
  - `text`: Command line navigation style value.

  Returns:
  Navigation style keyword, or nil when TEXT is unknown."
  [text]
  (case text
    "breadcrumbs" :breadcrumbs
    "up" :up
    "none" :none
    :default nil))

(defun add-navigation-option
  "Parse and set a navigation style option.

  Args:
  - `args`: Current argument list.
  - `options`: Accumulated options map.

  Returns:
  Updated options map after consuming `--navigation` and its value."
  [args options]
  (let [style (nth args 1)
        navigation-style (when style
                           (navigation-style-option style))]
    (cond
      (nil? style)
      (assoc options :errors (append (:errors options)
                                     "Missing navigation style after --navigation"))

      navigation-style
      (parse-args-step (tail (tail args))
                       (assoc options :navigation-style navigation-style))

      true
      (parse-args-step (tail (tail args))
                       (assoc options
                              :errors
                              (append (:errors options)
                                      (str "Unknown navigation style: " style)))))))

(defun parse-args-step
  "Parse Boodle generate arguments.

  Args:
  - `args`: Remaining command arguments.
  - `options`: Accumulated options map.

  Returns:
  Updated options map."
  [args options]
  (let [arg (head args)]
    (cond

      (nil? arg)
      options

      (or (= arg "-f")
          (= arg "--format"))
      (let [format (nth args 1)]
        (cond
          (nil? format)
          (assoc options :errors (append (:errors options)
                                         (str "Missing format after " arg)))

          (= format "github-pages")
          (parse-args-step (tail (tail args))
                           (assoc options :format :github-pages))

          true
          (parse-args-step (tail (tail args))
                           (assoc options
                                  :errors
                                  (append (:errors options)
                                          (str "Unknown output format: "
                                               format))))))

      (or (= arg "-o")
          (= arg "--out"))
      (let [out (nth args 1)]
        (if (nil? out)
          (assoc options :errors (append (:errors options)
                                         (str "Missing directory after " arg)))
          (parse-args-step (tail (tail args))
                           (assoc options :out out))))

      (= arg "--package-group")
      (add-package-group-option args options)

      (= arg "--navigation")
      (add-navigation-option args options)

      (= "-" (substr arg 0 1))
      (parse-args-step (tail args)
                       (assoc options
                              :errors
                              (append (:errors options)
                                      (str "Unknown generate option: " arg))))

      true
      (parse-args-step (tail args)
                       (assoc options
                              :indexes
                              (append (:indexes options) arg))))))

(defun parse-args
  "Parse arguments for the `boodle generate` command.

  Args:
  - `args`: Arguments after the `generate` command name.

  Returns:
  An options map containing `:format`, `:out`, `:indexes`, and `:errors`."
  [args]
  (let [options (parse-args-step args
                                 {:format :github-pages
                                  :out nil
                                  :navigation-style :breadcrumbs
                                  :package-groups []
                                  :indexes []
                                  :errors []})
        options (if (nil? (:out options))
                  (assoc options :errors (append (:errors options)
                                                 "Missing output directory"))
                  options)]
    (if (empty? (:indexes options))
      (assoc options :errors (append (:errors options)
                                     "Missing lookup index file"))
      options)))

(defun read-catalog
  "Read lookup indexes into a Boodle catalog.

  Args:
  - `paths`: Lookup index EDN file paths.

  Returns:
  A Boodle catalog map."
  [paths]
  (lookup/catalog (map paths io/slurp-edn!)))

(defun directory-entry?
  "Return non-nil when ENTRY describes a directory.

  Args:
  - `entry`: Directory listing entry map.

  Returns:
  True when `entry` is a directory."
  [entry]
  (= (:type entry) :directory))

(defun versions-dir
  "Return the materialized versions directory for PACKAGE in OUTPUT-DIR.

  Args:
  - `output-dir`: Documentation output directory.
  - `package`: Boodle package map.

  Returns:
  Filesystem path containing package version directories."
  [output-dir package]
  (io/join-path
    (io/join-path
      (io/join-path output-dir "packages")
      (:id package))
    "versions"))

(defun existing-package-versions
  "Return already materialized documentation versions for PACKAGE.

  Args:
  - `output-dir`: Documentation output directory.
  - `package`: Boodle package map.

  Returns:
  Sorted version directory names."
  [output-dir package]
  (let [dir (versions-dir output-dir package)]
    (if (io/directory? dir)
      (sort (map (filter (io/list-directory! dir) directory-entry?) :name) <)
      [])))

(defun package-with-known-versions
  "Return PACKAGE with generated and materialized versions attached.

  Args:
  - `output-dir`: Documentation output directory.
  - `package`: Boodle package map.

  Returns:
  Package map with `:versions` containing known version names."
  [output-dir package]
  (assoc package
         :versions
         (sort (reduce (concat [(reference/package-version package)]
                               (existing-package-versions output-dir package))
                       []
                       (fn [versions version]
                         (if (contains? versions version)
                           versions
                           (append versions version))))
               <)))

(defun catalog-with-known-versions
  "Return CATALOG annotated with already materialized versions.

  Args:
  - `output-dir`: Documentation output directory.
  - `catalog`: Boodle catalog map.

  Returns:
  Catalog with package `:versions` metadata."
  [output-dir catalog]
  (assoc catalog
         :packages
         (map (:packages catalog)
              (fn [package]
                (package-with-known-versions output-dir package)))))

(defun catalog-package-ids
  "Return package ids in CATALOG order.

  Args:
  - `catalog`: Boodle catalog map.

  Returns:
  Package ids from the catalog."
  [catalog]
  (map (:packages catalog) :id))

(defun append-package-id-once
  "Append ID to IDS when it is not already present.

  Args:
  - `ids`: Accumulated package ids.
  - `id`: Package id to append.

  Returns:
  IDS with ID appended once."
  [ids id]
  (if (or (= id "*") (contains? ids id))
    ids
    (append ids id)))

(defun explicit-package-group-ids
  "Return non-wildcard package ids mentioned by GROUPS.

  Args:
  - `groups`: Package group maps.

  Returns:
  Unique package ids in group order."
  [groups]
  (reduce groups
          []
          (fn [ids group]
            (reduce (:package-ids group) ids append-package-id-once))))

(defun remaining-package-ids
  "Return package ids not explicitly assigned to a package group.

  Args:
  - `catalog`: Boodle catalog map.
  - `explicit-ids`: Package ids already assigned by exact group entries.

  Returns:
  Package ids not found in EXPLICIT-IDS."
  [catalog explicit-ids]
  (filter (catalog-package-ids catalog)
          (fn [id]
            (not (contains? explicit-ids id)))))

(defun expand-package-group
  "Expand wildcard package ids in GROUP.

  Args:
  - `catalog`: Boodle catalog map.
  - `explicit-ids`: Non-wildcard package ids from all groups.
  - `group`: Package group map.

  Returns:
  GROUP with `*` replaced by remaining catalog package ids."
  [catalog explicit-ids group]
  (if (contains? (:package-ids group) "*")
    (assoc group :package-ids (remaining-package-ids catalog explicit-ids))
    group))

(defun catalog-with-package-groups
  "Attach expanded package groups to CATALOG.

  Args:
  - `catalog`: Boodle catalog map.
  - `groups`: Package groups from command line options.

  Returns:
  Catalog with `:package-groups` when groups were provided."
  [catalog groups]
  (if (empty? groups)
    catalog
    (let [explicit-ids (explicit-package-group-ids groups)]
      (assoc catalog
             :package-groups
             (map groups
                  (fn [group]
                    (expand-package-group catalog explicit-ids group)))))))

(defun catalog-with-navigation-style
  "Attach navigation style metadata to CATALOG.

  Args:
  - `catalog`: Boodle catalog map.
  - `style`: Navigation style keyword.

  Returns:
  Catalog with `:navigation-style` metadata."
  [catalog style]
  (assoc catalog :navigation-style style))

(defun generated-files
  "Return documentation files for OPTIONS.

  Args:
  - `options`: Parsed generate options.

  Returns:
  File maps for the selected output format."
  [options]
  (let [catalog (catalog-with-known-versions (:out options)
                                             (read-catalog (:indexes options)))
        catalog (catalog-with-package-groups catalog
                                             (:package-groups options))
        catalog (catalog-with-navigation-style catalog
                                               (:navigation-style options))]
    (case (:format options)
      :github-pages (github-pages/files catalog))))

(defun run!
  "Run the `boodle generate` command.

  Args:
  - `args`: Arguments after the `generate` command name.

  Returns:
  A result map containing parse errors or generated output details."
  [args]
  (let [options (parse-args args)]
    (if (not-empty? (:errors options))
      {:errors (:errors options)}
      (let [written (files/write! (:out options) (generated-files options))]
        {:format :text
         :output [(str "boodle: wrote " (count written) " files to " (:out options))]
         :files written}))))
