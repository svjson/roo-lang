(ns boodle.command.generate
  (:require [boodle.format.github-pages :as github-pages]
            [boodle.format.lookup :as lookup]
            [boodle.model :as model]
            [boodle.output.files :as files]
            [boodle.publication :as publication]
            [roo.io :as io]))

(defun parse-package-group
  "Parse one Boodle package-group option value.

  Args:
  - `parts`: Package-group segments split at the configured comma delimiter.

  Returns:
  A cli-trooper conversion result containing a Boodle package-group map, or an
  `:invalid-package-group` diagnostic."
  [parts]
  (let [raw (apply join (concat "," parts))
        first-part (head parts)]
    (if-let [separator (find-index first-part
                                   (fn [ch]
                                     (= ":" (str ch))))]
      (let [title (trim (substr first-part 0 separator))
            first-id (trim (substr first-part
                                   (+ separator 1)
                                   (count first-part)))
            package-ids (remove (concat [first-id]
                                        (for [id (tail parts)]
                                          (trim id)))
                                blank?)]
        (if (or (blank? title) (empty? package-ids))
          {:error {:kind :invalid-package-group
                   :value raw
                   :expected "title:id[,id]"}}
          {:value (model/package-group {:title title
                                        :package-ids package-ids})}))
      {:error {:kind :invalid-package-group
               :value raw
               :expected "title:id[,id]"}})))

(defun read-catalog
  "Read lookup indexes into a Boodle catalog.

  Args:
  - `paths`: Lookup index EDN file paths.

  Returns:
  A Boodle catalog map."
  [paths]
  (lookup/catalog (map paths io/slurp-edn!)))

(defun directory-entry?
  "Return non-nil when ENTRY describes a directory.

  Args:
  - `entry`: Directory listing entry map.

  Returns:
  True when `entry` is a directory."
  [entry]
  (= (:type entry) :directory))

(defun versions-dir
  "Return the materialized versions directory for PACKAGE in OUTPUT-DIR.

  Args:
  - `output-dir`: Documentation output directory.
  - `package`: Boodle package map.

  Returns:
  Filesystem path containing package version directories."
  [output-dir package]
  (io/join-path
    (io/join-path
      (io/join-path output-dir "packages")
      (:id package))
    "versions"))

(defun existing-package-identities
  "Return already materialized documentation identities for PACKAGE.

  Args:
  - `output-dir`: Documentation output directory.
  - `package`: Boodle package map.

  Returns:
  Sorted version-directory names."
  [output-dir package]
  (let [dir (versions-dir output-dir package)]
    (if (io/directory? dir)
      (sort (keep (io/list-directory! dir)
                  (fn [entry] (when (directory-entry? entry)
                                (:name entry))))
            <)
      [])))

(defun package-with-known-publications
  "Return PACKAGE with generated and materialized publications attached.

  Args:
  - `output-dir`: Documentation output directory.
  - `package`: Boodle package map.

  Returns:
  Package map with classified publications and its automatic release selection."
  [output-dir package]
  (let [publications (publication/ordered
                       (concat [(:identity (:publication package))]
                               (existing-package-identities output-dir package)))]
    (assoc package
           :publications publications
           :default-publication (publication/automatic publications))))

(defun catalog-with-known-publications
  "Return CATALOG annotated with already materialized publications.

  Args:
  - `output-dir`: Documentation output directory.
  - `catalog`: Boodle catalog map.

  Returns:
  Catalog with classified package publication metadata."
  [output-dir catalog]
  (assoc catalog
         :packages
         (for [package (:packages catalog)]
           (package-with-known-publications output-dir package))))

(defun catalog-package-ids
  "Return package ids in CATALOG order.

  Args:
  - `catalog`: Boodle catalog map.

  Returns:
  Package ids from the catalog."
  [catalog]
  (map (:packages catalog) :id))

(defun append-package-id-once
  "Append ID to IDS when it is not already present.

  Args:
  - `ids`: Accumulated package ids.
  - `id`: Package id to append.

  Returns:
  IDS with ID appended once."
  [ids id]
  (if (or (= id "*") (contains? ids id))
    ids
    (append ids id)))

(defun explicit-package-group-ids
  "Return non-wildcard package ids mentioned by GROUPS.

  Args:
  - `groups`: Package group maps.

  Returns:
  Unique package ids in group order."
  [groups]
  (reduce groups
          []
          (fn [ids group]
            (reduce (:package-ids group) ids append-package-id-once))))

(defun remaining-package-ids
  "Return package ids not explicitly assigned to a package group.

  Args:
  - `catalog`: Boodle catalog map.
  - `explicit-ids`: Package ids already assigned by exact group entries.

  Returns:
  Package ids not found in EXPLICIT-IDS."
  [catalog explicit-ids]
  (filter (catalog-package-ids catalog)
          (fn [id]
            (not (contains? explicit-ids id)))))

(defun expand-package-group
  "Expand wildcard package ids in GROUP.

  Args:
  - `catalog`: Boodle catalog map.
  - `explicit-ids`: Non-wildcard package ids from all groups.
  - `group`: Package group map.

  Returns:
  GROUP with `*` replaced by remaining catalog package ids."
  [catalog explicit-ids group]
  (cond-> group

          (contains? (:package-ids group) "*")
          (assoc :package-ids (remaining-package-ids catalog explicit-ids))))

(defun catalog-with-package-groups
  "Attach expanded package groups to CATALOG.

  Args:
  - `catalog`: Boodle catalog map.
  - `groups`: Package groups from command line options.

  Returns:
  Catalog with `:package-groups` when groups were provided."
  [catalog groups]
  (if (empty? groups)
    catalog
    (let [explicit-ids (explicit-package-group-ids groups)]
      (assoc catalog
             :package-groups
             (for [group groups]
               (expand-package-group catalog explicit-ids group))))))

(defun catalog-with-navigation-style
  "Attach navigation style metadata to CATALOG.

  Args:
  - `catalog`: Boodle catalog map.
  - `style`: Navigation style keyword.

  Returns:
  Catalog with `:navigation-style` metadata."
  [catalog style]
  (assoc catalog :navigation-style style))

(defun apply-retention!
  "Remove publication directories made obsolete by PUBLICATION.

  Args:
  - `output-dir`: Documentation output directory.
  - `catalog`: Imported Boodle catalog.
  - `publication`: Validated publication being generated.

  Returns:
  Nil after validating the transition and removing obsolete prereleases."
  [output-dir catalog publication]
  (let [packages (for [package (:packages catalog)]
                   {:package package
                    :identities (existing-package-identities output-dir package)})
        errors (flat-map packages
                         (fn [package]
                           (publication/retention-errors publication
                                                         (:identities package))))]
    (when-let [error (head errors)]
      (raise (:message error)))
    (doseq [package packages]
      (doseq [identity (publication/obsolete-identities publication
                                                        (:identities package))]
        (io/remove-tree! (io/join-path
                           (versions-dir output-dir (:package package))
                           identity))))))

(defun generated-files
  "Return documentation files for OPTIONS.

  Args:
  - `options`: Parsed generate options.
  - `catalog`: Imported Boodle catalog.
  - `publication`: Validated publication being generated.

  Returns:
  File maps for the selected output format."
  [options catalog publication]
  (let [catalog (publication/apply-to-catalog catalog publication)
        catalog (catalog-with-known-publications (:out options) catalog)
        catalog (catalog-with-package-groups catalog
                                             (:package-groups options))
        catalog (catalog-with-navigation-style catalog
                                               (:navigation-style options))]
    (case (:format options)
      :github-pages (github-pages/files catalog))))

(defun execute!
  "Generate Boodle documentation from fully parsed command options.

  Args:
  - `context`: The cli-trooper invocation context. An optional
    `:cli-trooper/print!` function replaces the default output printer.
  - `options`: Parsed Boodle generate options.

  Returns:
  A result map containing the output line and written file maps."
  [context options]
  (let [catalog (read-catalog (:indexes options))
        publication (publication/make (:publication-mode options)
                                      (:publication-identity options))]
    (apply-retention! (:out options) catalog publication)
    (let [written (files/write! (:out options)
                                (generated-files options catalog publication))
          output (str "boodle: wrote " (count written) " files to " (:out options))
          print! (get context :cli-trooper/print! prn!)]
      (print! output)
      {:format :text
       :output [output]
       :files written})))

(def command
  "cli-trooper declaration for Boodle's `generate` command."
  {:description "Generate reference documentation."
   :execute! execute!
   :validate publication/validation-errors
   :flags {["f" "format"] {:type :enum
                              :values ["github-pages"]
                              :default :github-pages}
           "navigation" {:type :enum
                          :values ["breadcrumbs" "up" "none"]
                          :destination :navigation-style
                          :default :breadcrumbs}
           "package-group" {:type :package-group
                            :name "title:id[,id]"
                            :delimiter ","
                            :parse parse-package-group
                            :repeatable? true
                            :destination :package-groups}
           "publication-mode" {:type :enum
                                :values ["development" "prerelease" "stable"]
                                :required? true}
           "publication-identity" {:type :string
                                    :name "identity"
                                    :required? true}
           ["o" "out"] {:type :dir
                          :required? true}}
   :positional [{:type :file
                 :name "index-file"
                 :destination :indexes
                 :repeatable? true}]})
