(ns boodle.cli
  (:require [boodle.command.generate :as generate]
            [cli-trooper :as cli-trooper]))

(def version
  "Boodle command version."
  "0.1.0")

(def application
  "Boodle's supplied cli-trooper application declaration."
  {:application "boodle"
   :version version
   :description "generate reference documentation"
   :commands {"generate" generate/command}})

(defun main
  "Run the Boodle command line entry point.

  Args:
  - `args`: Command line argument vector.

  Returns:
  Process exit code `0` after help, version, or successful command execution,
  or `2` after a command-line configuration or argument error."
  [args]
  (cli-trooper/run! application {:args args}))
