(ns boodle.topology.reference
  (:require [roo.string :as string]))

(def symbolic-slugs
  "Path-safe slugs for symbol names that kebab-case would erase or collide."
  {"-" "minus"
   "->" "minus-greater-than"})

(def slug-replacements
  "Character replacements used when building symbol page paths."
  [["+" " plus "]
   ["*" " star "]
   ["/" " slash "]
   ["=" " equals "]
   ["<" " less than "]
   [">" " greater than "]
   ["!" " bang "]
   ["?" " p "]])

(defun slug-text
  "Return path-safe text for VALUE.

  Args:
  - `value`: Text value to use in a generated path segment.

  Returns:
  Kebab-case path text with common Roo symbolic characters spelled out."
  [value]
  (let [text (str value)]
    (if-let [slug (get symbolic-slugs text)]
      slug
      (kebab-case
        (reduce slug-replacements
                text
                (fn [text replacement]
                  (string/replace text
                                  (head replacement)
                                  (nth replacement 1))))))))

(defun package-title
  "Return the display title for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  Package name with version when available."
  [package]
  (if (:version package)
    (str (:name package) " " (:version package))
    (:name package)))

(defun navigation-style
  "Return the reference navigation style for CATALOG.

  Args:
  - `catalog`: Boodle catalog map.

  Returns:
  Navigation strategy keyword."
  [catalog]
  (or (:navigation-style catalog) :breadcrumbs))

(defun root-url
  "Return the root reference URL from PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Relative URL to the reference root, or nil from the root itself."
  [page]
  (case (:kind page)
    :package-index "../../"
    :package "../../../../"
    :namespace "../../../../../"
    :symbol "../../../../../../"
    :default nil))

(defun package-page-url
  "Return the package page URL from PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Relative URL to the current package page."
  [page]
  (case (:kind page)
    :package-index (str "versions/" (package-version (:package page)) "/")
    :namespace "../"
    :symbol "../../"
    :default nil))

(defun namespace-page-url
  "Return the namespace page URL from PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Relative URL to the current namespace page."
  [page]
  (case (:kind page)
    :symbol (str "../" (:name (:namespace page)) ".html")
    :default nil))

(defun root-breadcrumb
  "Return the root breadcrumb item for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Root breadcrumb item, or nil on the root page."
  [page]
  (when-let [url (root-url page)]
    {:label "Reference"
     :url url}))

(defun package-breadcrumb
  "Return the package breadcrumb item for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Package breadcrumb item, or nil when PAGE has no package."
  [page]
  (when-let [package (:package page)]
    (if-let [url (package-page-url page)]
      {:label (package-title package)
       :url url}
      {:label (package-title package)})))

(defun namespace-breadcrumb
  "Return the namespace breadcrumb item for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Namespace breadcrumb item, or nil when PAGE has no namespace."
  [page]
  (when-let [namespace (:namespace page)]
    (if-let [url (namespace-page-url page)]
      {:label (:name namespace)
       :url url}
      {:label (:name namespace)})))

(defun symbol-breadcrumb
  "Return the symbol breadcrumb item for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Symbol breadcrumb item, or nil when PAGE has no symbol entry."
  [page]
  (when-let [entry (:entry page)]
    {:label (:qualified-name entry)}))

(defun breadcrumbs
  "Return hierarchy breadcrumbs for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  Breadcrumb item maps in root-to-page order."
  [page]
  (keep [(root-breadcrumb page)
         (package-breadcrumb page)
         (namespace-breadcrumb page)
         (symbol-breadcrumb page)]
        identity))

(defun up-item
  "Return the immediate parent navigation item for PAGE.

  Args:
  - `page`: Boodle reference topology page.

  Returns:
  A navigation item pointing one level up, or nil."
  [page]
  (let [items (breadcrumbs page)]
    (when (> (count items) 1)
      (let [parent (nth items (- (count items) 2))]
        {:label (str "Up to " (:label parent))
         :url (:url parent)}))))

(defun package-version
  "Return the version label for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  Package version, or `unversioned` when no version is available."
  [package]
  (or (:version package) "unversioned"))

(defun package-index-path
  "Return the compatibility package index path for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  Relative Markdown path for the package redirect page."
  [package]
  (str "packages/" (:id package) "/index.md"))

(defun package-version-root
  "Return the versioned reference root path for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  Relative path for the package version documentation root."
  [package]
  (str "packages/" (:id package) "/versions/" (package-version package)))

(defun package-path
  "Return the versioned reference page path for PACKAGE.

  Args:
  - `package`: Boodle package map.

  Returns:
  Relative Markdown path for the package version overview page."
  [package]
  (str (package-version-root package) "/index.md"))

(defun namespace-path
  "Return the reference page path for NAMESPACE in PACKAGE.

  Args:
  - `package`: Boodle package map.
  - `namespace`: Boodle namespace map.

  Returns:
  Relative Markdown path for the namespace reference page."
  [package namespace]
  (str (package-version-root package) "/namespaces/" (:name namespace) ".md"))

(defun symbol-path
  "Return the reference page path for ENTRY in NAMESPACE.

  Args:
  - `package`: Boodle package map.
  - `namespace`: Boodle namespace map.
  - `entry`: Boodle symbol entry map.

  Returns:
  Relative Markdown path for the symbol reference page."
  [package namespace entry]
  (str (package-version-root package)
       "/namespaces/"
       (:name namespace)
       "/"
       (slug-text (:name entry))
       ".md"))

(defun pages
  "Return reference documentation pages for CATALOG.

  Args:
  - `catalog`: Boodle catalog map.

  Returns:
  Page maps describing the output topology. The first page is `index.md`,
  followed by package redirect pages, package pages, namespace pages, and symbol
  pages."
  [catalog]
  (concat [{:kind :index
            :path "index.md"
            :catalog catalog}]
          (flat-map (:packages catalog)
                    (fn [package]
                      (concat
                        [{:kind :package-index
                          :path (package-index-path package)
                          :package package}
                         {:kind :package
                          :path (package-path package)
                          :package package}]
                        (flat-map (:namespaces package)
                                  (fn [namespace]
                                    (concat
                                      [{:kind :namespace
                                        :path (namespace-path package namespace)
                                        :package package
                                        :namespace namespace}]
                                      (map (:entries namespace)
                                           (fn [entry]
                                             {:kind :symbol
                                              :path (symbol-path package namespace entry)
                                              :package package
                                              :namespace namespace
                                              :entry entry}))))))))))
