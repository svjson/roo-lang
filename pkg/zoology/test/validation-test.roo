(ns zoology.validation-test
  (:require proof.core
            [zoology.validation :as validation]))

(def person-schema
  {:field/name {:type :text
                :required true}
   :field/age {:type :integer
               :required true
               :min 0
               :max 130}
   :field/city {:type :text
                :path [:profile :city]}})

(deftest validate-reports-required-and-range-errors
  (let [result (validation/validate person-schema
                                    {:field/name ""
                                     :field/age -1
                                     :profile {:city "London"}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :field/name])))
    (is (= [{:rule :min
             :min 0
             :actual -1}]
           (get-in result [:errors :field/age])))
    (is (nil? (get-in result [:errors :field/city])))))

(deftest validate-accepts-valid-values-and-field-paths
  (let [result (validation/validate person-schema
                                    {:field/name "Ada"
                                     :field/age 36
                                     :profile {:city "London"}})]
    (is (= true (:valid? result)))
    (is (= {} (:errors result)))))

(deftest validate-rejects-values-outside-fixed-valid-values
  (let [role-schema {:field/role {:type :keyword
                                  :valid-values
                                  [:role/stable-lad
                                   :role/stable-master]}}
        result (validation/validate role-schema
                                    {:field/role :role/smith})]
    (is (= false (:valid? result)))
    (is (= [{:rule :valid-values
             :allowed [:role/stable-lad
                       :role/stable-master]
             :actual :role/smith}]
           (get-in result [:errors :field/role])))))

(deftest validate-with-context-resolves-source-backed-valid-values
  (let [schema {:field/place {:type :keyword
                              :valid-values
                              {:from [:vocabularies :places]
                               :value-path [:id]}}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :name "Dawnkeep Stables"}
                           {:id :place/dawnkeep-smithy
                            :name "Dawnkeep Smithy"}]}}
        valid-result (validation/validate-with-context
                      schema
                      {:field/place :place/dawnkeep-stables}
                      context)
        invalid-result (validation/validate-with-context
                        schema
                        {:field/place :place/dawnkeep-market}
                        context)]
    (is (= true (:valid? valid-result)))
    (is (= false (:valid? invalid-result)))
    (is (= [{:rule :valid-values
             :allowed [:place/dawnkeep-stables
                       :place/dawnkeep-smithy]
             :actual :place/dawnkeep-market}]
           (get-in invalid-result [:errors :field/place])))))

(deftest validation-uses-active-discriminated-union-variant
  (let [schema-doc {:definitions
                    {:rule-base
                     {:type :object
                      :fields {:type {:type :keyword
                                      :required true
                                      :valid-values [:preferred-position
                                                     :edge]}}}
                     :preferred-position-rule
                     {:extends :rule-base
                      :fields {:point {:type :number
                                       :required true}}}
                     :edge-rule
                     {:extends :rule-base
                      :fields {:target {:type :keyword
                                        :required true}}}}
                    :schema {:type :union
                             :discriminator :type
                             :base {:ref :rule-base}
                             :variants
                             {:preferred-position
                              {:ref :preferred-position-rule}
                              :edge {:ref :edge-rule}}}}]
    (is (= true
           (:valid? (validation/validate
                     schema-doc
                     {:type :preferred-position
                      :point 10}))))
    (is (= true
           (:valid? (validation/validate
                     schema-doc
                     {:type :edge
                      :target :forest}))))
    (is (= {:target [{:rule :required}]}
           (:errors (validation/validate
                     schema-doc
                     {:type :edge}))))
    (is (= {:type [{:rule :valid-values
                    :allowed [:preferred-position :edge]
                    :actual :unknown}]}
           (:errors (validation/validate
                     schema-doc
                     {:type :unknown}))))))

(deftest validation-rejects-union-variants-outside-reference-use-site
  (let [schema-doc {:definitions
                    {:rule-base
                     {:type :object
                      :fields {:type {:type :keyword
                                      :required true
                                      :valid-values
                                      {:values [:edge
                                                :inside-area
                                                :distance-range]}}}}
                     :edge-rule
                     {:extends :rule-base
                      :fields {:target {:type :keyword
                                        :required true}}}
                     :inside-area-rule
                     {:extends :rule-base
                      :fields {:area {:type :keyword
                                      :required true}}}
                     :distance-range-rule
                     {:extends :rule-base
                      :fields {:distance {:type :number
                                          :required true}}}
                     :placement-rule
                     {:type :union
                      :discriminator :type
                      :base {:ref :rule-base}
                      :variants {:edge {:ref :edge-rule}
                                 :inside-area {:ref :inside-area-rule}
                                 :distance-range
                                 {:ref :distance-range-rule}}}}
                    :schema
                    {:type :array
                     :items {:ref :placement-rule
                             :variants {:except [:distance-range]}}}}
        valid-result (validation/validate
                      schema-doc
                      [{:type :edge
                        :target :forest-border}])
        invalid-result (validation/validate
                        schema-doc
                        [{:type :distance-range
                          :distance 3}])]
    (is (= true (:valid? valid-result)))
    (is (= false (:valid? invalid-result)))
    (is (= {:value
            [{:rule :array
              :errors {0 {:type [{:rule :valid-values
                                  :allowed [:edge :inside-area]
                                  :actual :distance-range}]}}}]}
           (:errors invalid-result)))))

(deftest validate-resolves-field-definition-references
  (let [schema-doc {:definitions
                    {:stable-role
                     {:type :keyword
                      :valid-values [:role/stable-lad
                                     :role/stable-master]}}
                    :schema
                    {:field/role {:ref :stable-role}}}
        result (validation/validate schema-doc
                                    {:field/role :role/smith})]
    (is (= false (:valid? result)))
    (is (= [{:rule :valid-values
             :allowed [:role/stable-lad
                       :role/stable-master]
             :actual :role/smith}]
           (get-in result [:errors :field/role])))))

(deftest validate-validates-object-root-fields
  (let [schema-doc {:schema {:type :object
                             :fields {:relation
                                      {:type :keyword
                                       :required true}
                                      :priority
                                      {:type :integer
                                       :min 1}}}}
        result (validation/validate schema-doc
                                    {:relation ""
                                     :priority 0})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :relation])))
    (is (= [{:rule :min
             :min 1
             :actual 0}]
           (get-in result [:errors :priority])))))

(deftest validate-validates-nested-object-fields
  (let [schema-doc {:field/location
                    {:type :object
                     :fields {:place-id {:type :keyword
                                         :required true}
                              :anchor {:type :keyword}}}}
        result (validation/validate schema-doc
                                    {:field/location
                                     {:place-id ""
                                      :anchor :stable/aisle}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :object
             :errors {:place-id [{:rule :required}]}}]
           (get-in result [:errors :field/location])))))

(deftest validate-validates-root-array-items
  (let [schema-doc {:schema {:type :array
                             :items {:type :object
                                     :fields {:relation
                                              {:type :keyword
                                               :required true}
                                              :priority
                                              {:type :integer
                                               :min 1}}}}}
        result (validation/validate schema-doc
                                    [{:relation ""
                                      :priority 0}])]
    (is (= false (:valid? result)))
    (is (= {:value
            [{:rule :array
              :errors {0 {:relation [{:rule :required}]
                          :priority [{:rule :min
                                      :min 1
                                      :actual 0}]}}}]}
           (:errors result)))))

(deftest validate-validates-nested-array-items
  (let [schema-doc {:field/relations
                    {:type :array
                     :items {:type :object
                             :fields {:place-id {:type :keyword
                                                 :required true}}}}}
        result (validation/validate
                schema-doc
                {:field/relations
                 [{:place-id :place/dawnkeep-stables}
                  {:place-id ""}]})]
    (is (= false (:valid? result)))
    (is (= [{:rule :array
             :errors {1 {:place-id [{:rule :required}]}}}]
           (get-in result [:errors :field/relations])))))
