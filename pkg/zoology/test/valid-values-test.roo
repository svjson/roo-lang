(ns zoology.valid-values-test
  (:require proof.core
            [zoology.valid-values :as valid-values]))

(deftest valid-value-options-resolve-labels-and-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]
                       :label-path [:label]}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :label "Dawnkeep Stables"}]}}]
    (is (= [{:value :place/dawnkeep-stables
             :label "Dawnkeep Stables"}]
           (valid-values/valid-value-options context field-schema)))))

(deftest valid-value-options-can-depend-on-sibling-field-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from {:field [:source]
                              :sources {:landmarks [:landmarks]
                                        :terrain [:terrain]}}
                       :value-path [:value]
                       :label-path [:label]}}
        context {:landmarks [{:value :dawnkeep
                              :label "Dawnkeep"}]
                 :terrain [{:value :blackmere
                            :label "Blackmere"}]}]
    (is (= [{:value :blackmere
             :label "Blackmere"}]
           (valid-values/valid-value-options-for-value
            context
            field-schema
            {:source :terrain})))))
