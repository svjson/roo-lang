(ns zoology.valid-values-test
  (:require proof.core
            [zoology.valid-values :as valid-values]))

(deftest valid-value-items-resolve-context-backed-entries
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :name "Dawnkeep Stables"}]}}]
    (is (= [{:id :place/dawnkeep-stables
             :name "Dawnkeep Stables"}]
           (valid-values/valid-values-items
            context
            (:valid-values field-schema)
            nil)))
    (is (= [:place/dawnkeep-stables]
           (valid-values/valid-value-values context field-schema nil)))))

(deftest valid-value-items-can-depend-on-sibling-field-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from {:field [:source]
                              :sources {:landmarks [:landmarks]
                                        :terrain [:terrain]}}
                       :value-path [:value]}}
        context {:landmarks [{:value :dawnkeep
                              :name "Dawnkeep"}]
                 :terrain [{:value :blackmere
                            :name "Blackmere"}]}]
    (is (= [{:value :blackmere
             :name "Blackmere"}]
           (valid-values/valid-values-items
            context
            (:valid-values field-schema)
            {:source :terrain})))
    (is (= [:blackmere]
           (valid-values/valid-value-values
            context
            field-schema
            {:source :terrain})))))
