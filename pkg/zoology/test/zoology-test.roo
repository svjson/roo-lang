(ns zoology-test
  (:require proof.core
            [zoology :as schema]))

(def person-schema
  {:field/name {:type :text
                :required true}
   :field/age {:type :integer
               :required true
               :min 0
               :max 130}
   :field/city {:type :text
                :path [:profile :city]}})


(deftest validate-reports-required-and-range-errors
  (let [result (schema/validate person-schema
                                {:field/name ""
                                 :field/age -1
                                 :profile {:city "London"}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :field/name])))
    (is (= [{:rule :min
             :min 0
             :actual -1}]
           (get-in result [:errors :field/age])))
    (is (nil? (get-in result [:errors :field/city])))))

(deftest validate-accepts-valid-values-and-field-paths
  (let [result (schema/validate person-schema
                                {:field/name "Ada"
                                 :field/age 36
                                 :profile {:city "London"}})]
    (is (= true (:valid? result)))
    (is (= {} (:errors result)))))

(deftest validate-rejects-values-outside-fixed-valid-values
  (let [role-schema {:field/role {:type :keyword
                                  :valid-values
                                  [:role/stable-lad
                                   :role/stable-master]}}
        result (schema/validate role-schema
                                {:field/role :role/smith})]
    (is (= false (:valid? result)))
    (is (= [{:rule :valid-values
             :allowed [:role/stable-lad
                       :role/stable-master]
             :actual :role/smith}]
           (get-in result [:errors :field/role])))))

(deftest validate-with-context-resolves-source-backed-valid-values
  (let [schema {:field/place {:type :keyword
                              :valid-values
                              {:from [:vocabularies :places]
                               :value-path [:id]
                               :label-path [:label]}}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :label "Dawnkeep Stables"}
                           {:id :place/dawnkeep-smithy
                            :label "Dawnkeep Smithy"}]}}
        valid-result (schema/validate-with-context
                      schema
                      {:field/place :place/dawnkeep-stables}
                      context)
        invalid-result (schema/validate-with-context
                        schema
                        {:field/place :place/dawnkeep-market}
                        context)]
    (is (= true (:valid? valid-result)))
    (is (= false (:valid? invalid-result)))
    (is (= [{:rule :valid-values
             :allowed [:place/dawnkeep-stables
                       :place/dawnkeep-smithy]
             :actual :place/dawnkeep-market}]
           (get-in invalid-result [:errors :field/place])))))

(deftest valid-value-options-resolve-labels-and-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]
                       :label-path [:label]}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :label "Dawnkeep Stables"}]}}]
    (is (= [{:value :place/dawnkeep-stables
             :label "Dawnkeep Stables"}]
           (schema/valid-value-options context field-schema)))))

(deftest valid-value-options-can-depend-on-sibling-field-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from {:field [:source]
                              :sources {:landmarks [:landmarks]
                                        :terrain [:terrain]}}
                       :value-path [:value]
                       :label-path [:label]}}
        context {:landmarks [{:value :dawnkeep
                              :label "Dawnkeep"}]
                 :terrain [{:value :blackmere
                            :label "Blackmere"}]}]
    (is (= [{:value :blackmere
             :label "Blackmere"}]
           (schema/valid-value-options-for-value
            context
            field-schema
            {:source :terrain})))))

(deftest schema-resolves-object-definition-extensions
  (let [schema-doc {:definitions
                    {:base-rule
                     {:type :object
                      :fields {:type {:type :keyword}
                               :id {:type :keyword}}}
                     :point-rule
                     {:extends :base-rule
                      :fields {:point {:type :number}}}}
                    :schema {:ref :point-rule}}]
    (is (= [:type :id :point]
           (schema/schema-field-ids schema-doc)))))

(deftest validation-uses-active-discriminated-union-variant
  (let [schema-doc {:definitions
                    {:rule-base
                     {:type :object
                      :fields {:type {:type :keyword
                                      :required true
                                      :valid-values [:preferred-position
                                                     :edge]}}}
                     :preferred-position-rule
                     {:extends :rule-base
                      :fields {:point {:type :number
                                       :required true}}}
                     :edge-rule
                     {:extends :rule-base
                      :fields {:target {:type :keyword
                                        :required true}}}}
                    :schema {:type :union
                             :discriminator :type
                             :base {:ref :rule-base}
                             :variants
                             {:preferred-position
                              {:ref :preferred-position-rule}
                              :edge {:ref :edge-rule}}}}]
    (is (= true
           (:valid? (schema/validate
                     schema-doc
                     {:type :preferred-position
                      :point 10}))))
    (is (= true
           (:valid? (schema/validate
                     schema-doc
                     {:type :edge
                      :target :forest}))))
    (is (= {:target [{:rule :required}]}
           (:errors (schema/validate
                     schema-doc
                     {:type :edge}))))
    (is (= {:type [{:rule :valid-values
                    :allowed [:preferred-position :edge]
                    :actual :unknown}]}
           (:errors (schema/validate
                     schema-doc
                     {:type :unknown}))))))

(deftest canonical-value-discards-invalid-number-text
  (is (= {:count nil
          :weight nil
          :blank nil}
         (schema/canonical-value
          {:type :object
           :fields {:count {:type :integer}
                    :weight {:type :number}
                    :blank {:type :number}}}
          {:count "12.5"
           :weight "--1"
           :blank ""}))))

(deftest canonical-value-supports-shorthand-field-map-schemas
  (is (= {:id :terrain/forest
          :count 12}
         (schema/canonical-value
          {:id {:type :keyword}
           :count {:type :integer}}
          {:id "terrain/forest"
           :count "12"}))))

(deftest schema-resolves-named-field-definition-references
  (let [schema-doc {:definitions
                    {:stable-role
                     {:type :keyword
                      :valid-values [:role/stable-lad
                                     :role/stable-master]}}
                    :schema
                    {:field/role {:ref :stable-role
                                  :required true}}}]
    (is (= {:type :keyword
            :valid-values [:role/stable-lad
                           :role/stable-master]
            :required true
            :zoology/ref :stable-role}
           (schema/resolved-field-schema schema-doc :field/role)))))

(deftest schema-resolves-nested-definition-references
  (let [schema-doc {:definitions
                    {:place-relation
                     {:type :object
                      :fields {:relation {:type :keyword}
                               :place-id {:ref :place-id}}}
                     :place-id
                     {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]
                       :label-path [:label]}}}
                    :schema
                    {:type :array
                     :items {:ref :place-relation}}}]
    (is (= {:type :array
            :items {:type :object
                    :fields {:relation {:type :keyword}
                             :place-id
                             {:type :keyword
                              :valid-values
                              {:from [:vocabularies :places]
                               :value-path [:id]
                               :label-path [:label]}
                              :zoology/ref :place-id}}
                    :zoology/ref :place-relation}}
           (schema/resolved-root-schema schema-doc)))))

(deftest prepared-schema-preserves-schema-behavior
  (let [schema-doc {:definitions
                    {:base {:type :object
                            :fields {:type {:type :keyword
                                            :valid-values
                                            {:values [:simple :detailed]}}}}
                     :simple {:extends :base
                              :fields {:name {:type :text}}}
                     :detailed {:extends :base
                                :fields {:name {:type :text}
                                         :note {:type :text}}}}
                    :schema {:type :union
                             :discriminator :type
                             :base {:ref :base}
                             :variants {:simple {:ref :simple}
                                        :detailed {:ref :detailed}}}}
        prepared (schema/prepare-schema schema-doc)
        value {:type :detailed
               :name "Name"
               :note "Note"}]
    (is (= (schema/resolved-root-schema schema-doc)
           (schema/resolved-root-schema prepared)))
    (is (= (schema/resolved-field-schema schema-doc :name)
           (schema/resolved-field-schema prepared :name)))
    (is (= (schema/active-schema-field-ids schema-doc value)
           (schema/active-schema-field-ids prepared value)))
    (is (schema/field-visible? prepared :note value))))

(deftest prepared-schema-leaves-reentrant-references-unresolved
  (let [schema-doc {:definitions
                    {:node {:type :object
                            :fields {:name {:type :text}
                                     :children {:type :array
                                                :items {:ref :node}}}}}
                    :schema {:ref :node}}
        prepared (schema/prepare-schema schema-doc)]
    (is (= true (schema/prepared-schema? prepared)))
    (is (= {:type :object
            :fields {:name {:type :text}
                     :children {:type :array
                                :items {:ref :node}}}
            :zoology/ref :node}
           (schema/resolved-root-schema prepared)))))

(deftest prepared-schema-supports-shorthand-type-field
  (let [schema-doc {:definitions
                    {:rule-type {:type :keyword
                                 :valid-values
                                 [:preferred-position :edge]}}
                    :schema {:type {:ref :rule-type}
                             :name {:type :text}}}
        prepared (schema/prepare-schema schema-doc)]
    (is (= {:type :keyword
            :valid-values [:preferred-position :edge]
            :zoology/ref :rule-type}
           (schema/resolved-field-schema prepared :type)))
    (is (= [:type :name]
           (schema/schema-field-ids prepared)))))

(deftest validate-resolves-field-definition-references
  (let [schema-doc {:definitions
                    {:stable-role
                     {:type :keyword
                      :valid-values [:role/stable-lad
                                     :role/stable-master]}}
                    :schema
                    {:field/role {:ref :stable-role}}}
        result (schema/validate schema-doc
                                {:field/role :role/smith})]
    (is (= false (:valid? result)))
    (is (= [{:rule :valid-values
             :allowed [:role/stable-lad
                       :role/stable-master]
             :actual :role/smith}]
           (get-in result [:errors :field/role])))))

(deftest schema-field-ids-use-object-root-fields
  (let [schema-doc {:schema {:type :object
                             :fields {:relation {:type :keyword}
                                      :place-id {:type :keyword}}}}]
    (is (= [:relation :place-id]
           (schema/schema-field-ids schema-doc)))))

(deftest validate-validates-object-root-fields
  (let [schema-doc {:schema {:type :object
                             :fields {:relation
                                      {:type :keyword
                                       :required true}
                                      :priority
                                      {:type :integer
                                       :min 1}}}}
        result (schema/validate schema-doc
                                {:relation ""
                                 :priority 0})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :relation])))
    (is (= [{:rule :min
             :min 1
             :actual 0}]
           (get-in result [:errors :priority])))))

(deftest validate-validates-nested-object-fields
  (let [schema-doc {:field/location
                    {:type :object
                     :fields {:place-id {:type :keyword
                                         :required true}
                              :anchor {:type :keyword}}}}
        result (schema/validate schema-doc
                                {:field/location
                                 {:place-id ""
                                  :anchor :stable/aisle}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :object
             :errors {:place-id [{:rule :required}]}}]
           (get-in result [:errors :field/location])))))

(deftest validate-validates-root-array-items
  (let [schema-doc {:schema {:type :array
                             :items {:type :object
                                     :fields {:relation
                                              {:type :keyword
                                               :required true}
                                              :priority
                                              {:type :integer
                                               :min 1}}}}}
        result (schema/validate schema-doc
                                [{:relation ""
                                  :priority 0}])]
    (is (= false (:valid? result)))
    (is (= {:value
            [{:rule :array
              :errors {0 {:relation [{:rule :required}]
                          :priority [{:rule :min
                                      :min 1
                                      :actual 0}]}}}]}
           (:errors result)))))

(deftest validate-validates-nested-array-items
  (let [schema-doc {:field/relations
                    {:type :array
                     :items {:type :object
                             :fields {:place-id {:type :keyword
                                                 :required true}}}}}
        result (schema/validate schema-doc
                                {:field/relations
                                 [{:place-id :place/dawnkeep-stables}
                                  {:place-id ""}]})]
    (is (= false (:valid? result)))
    (is (= [{:rule :array
             :errors {1 {:place-id [{:rule :required}]}}}]
           (get-in result [:errors :field/relations])))))
