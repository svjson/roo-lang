(ns zoology.core-test
  (:require proof.core
            [zoology.core :as core]))

(deftest blank-value-recognizes-nil-and-empty-text
  (is (= true (core/blank-value? nil)))
  (is (= true (core/blank-value? "")))
  (is (= false (core/blank-value? "Ada"))))

(deftest field-path-resolves-field-storage-path
  (is (= [:field/name]
         (core/field-path :field/name {})))
  (is (= [:profile :city]
         (core/field-path :field/city {:path [:profile :city]})))
  (is (= [:city]
         (core/field-path :field/city {:path :city}))))

(deftest field-value-uses-field-path
  (is (= "London"
         (core/field-value {:profile {:city "London"}}
                           :field/city
                           {:path [:profile :city]}))))

(deftest path-value-resolves-map-paths
  (is (= {:profile {:city "London"}}
         (core/path-value {:profile {:city "London"}} nil)))
  (is (= "London"
         (core/path-value {:profile {:city "London"}}
                          [:profile :city])))
  (is (= "London"
         (core/path-value {:city "London"} :city))))

(deftest path-present-distinguishes-present-nil-from-missing
  (is (= true
         (core/path-present? {:profile {:city nil}}
                             [:profile :city])))
  (is (= false
         (core/path-present? {:profile {}}
                             [:profile :city]))))
