(ns zoology.schema-test
  (:require proof.core
            [zoology.schema :as schema]))

(deftest field-path-resolves-field-storage-path
  (is (= [:field/name]
         (schema/field-path :field/name {})))
  (is (= [:profile :city]
         (schema/field-path :field/city {:path [:profile :city]})))
  (is (= [:city]
         (schema/field-path :field/city {:path :city}))))

(deftest field-value-uses-field-path
  (is (= "London"
         (schema/field-value {:profile {:city "London"}}
                             :field/city
                             {:path [:profile :city]}))))

(deftest path-value-resolves-map-paths
  (is (= {:profile {:city "London"}}
         (schema/path-value {:profile {:city "London"}} nil)))
  (is (= "London"
         (schema/path-value {:profile {:city "London"}}
                            [:profile :city])))
  (is (= "London"
         (schema/path-value {:city "London"} :city))))

(deftest path-present-distinguishes-present-nil-from-missing
  (is (= true
         (schema/path-present? {:profile {:city nil}}
                               [:profile :city])))
  (is (= false
         (schema/path-present? {:profile {}}
                               [:profile :city]))))

(deftest schema-resolves-object-definition-extensions
  (let [schema-doc {:definitions
                    {:base-rule
                     {:type :object
                      :fields {:type {:type :keyword}
                               :id {:type :keyword}}}
                     :point-rule
                     {:extends :base-rule
                      :fields {:point {:type :number}}}}
                    :schema {:ref :point-rule}}]
    (is (= [:type :id :point]
           (schema/schema-field-ids schema-doc)))))

(deftest schema-resolves-named-field-definition-references
  (let [schema-doc {:definitions
                    {:stable-role
                     {:type :keyword
                      :valid-values [:role/stable-lad
                                     :role/stable-master]}}
                    :schema
                    {:field/role {:ref :stable-role
                                  :required true}}}]
    (is (= {:type :keyword
            :valid-values [:role/stable-lad
                           :role/stable-master]
            :required true
            :zoology/ref :stable-role}
           (schema/resolved-field-schema schema-doc :field/role)))))

(deftest schema-resolves-nested-definition-references
  (let [schema-doc {:definitions
                    {:place-relation
                     {:type :object
                      :fields {:relation {:type :keyword}
                               :place-id {:ref :place-id}}}
                     :place-id
                     {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]}}}
                    :schema
                    {:type :array
                     :items {:ref :place-relation}}}]
    (is (= {:type :array
            :items {:type :object
                    :fields {:relation {:type :keyword}
                             :place-id
                             {:type :keyword
                              :valid-values
                              {:from [:vocabularies :places]
                               :value-path [:id]}
                              :zoology/ref :place-id}}
                    :zoology/ref :place-relation}}
           (schema/resolved-root-schema schema-doc)))))

(deftest schema-narrows-union-variants-at-reference-use-site
  (let [schema-doc {:definitions
                    {:rule-base
                     {:type :object
                      :fields {:type {:type :keyword
                                      :valid-values
                                      {:values [:edge
                                                :inside-area
                                                :distance-range]}}
                               :id {:type :keyword}}}
                     :edge-rule
                     {:extends :rule-base
                      :fields {:target {:type :keyword}}}
                     :inside-area-rule
                     {:extends :rule-base
                      :fields {:area {:type :keyword}}}
                     :distance-range-rule
                     {:extends :rule-base
                      :fields {:distance {:type :number}}}
                     :placement-rule
                     {:type :union
                      :discriminator :type
                      :base {:ref :rule-base}
                      :variants {:edge {:ref :edge-rule}
                                 :inside-area {:ref :inside-area-rule}
                                 :distance-range
                                 {:ref :distance-range-rule}}}}
                    :schema
                    {:type :array
                     :items {:ref :placement-rule
                             :variants [:edge :inside-area]}}}
        only-schema-doc (assoc-in schema-doc
                                  [:schema :items :variants]
                                  {:only [:inside-area
                                          :distance-range]})
        except-schema-doc (assoc-in schema-doc
                                    [:schema :items :variants]
                                    {:except [:distance-range]})
        root (schema/resolved-root-schema schema-doc)
        item-schema (:items root)
        item-document (schema/schema-document-with-root schema-doc item-schema)
        only-item-schema (:items (schema/resolved-root-schema
                                  only-schema-doc))
        except-item-schema (:items (schema/resolved-root-schema
                                    except-schema-doc))]
    (is (= [:edge :inside-area]
           (keys (:variants item-schema))))
    (is (= {:values [:edge :inside-area]}
           (get-in item-schema [:base :fields :type :valid-values])))
    (is (= {:values [:edge :inside-area]}
           (get-in item-schema
                   [:variants :edge :fields :type :valid-values])))
    (is (= [:type :id :target]
           (schema/active-schema-field-ids item-document
                                           {:type :edge})))
    (is (= [:type :id]
           (schema/active-schema-field-ids item-document
                                           {:type :distance-range})))
    (is (= [:inside-area :distance-range]
           (keys (:variants only-item-schema))))
    (is (= {:values [:inside-area :distance-range]}
           (get-in only-item-schema [:base :fields :type :valid-values])))
    (is (= [:edge :inside-area]
           (keys (:variants except-item-schema))))
    (is (= {:values [:edge :inside-area]}
           (get-in except-item-schema
                   [:base :fields :type :valid-values])))))

(deftest prepared-schema-preserves-schema-behavior
  (let [schema-doc {:definitions
                    {:base {:type :object
                            :fields {:type {:type :keyword
                                            :valid-values
                                            {:values [:simple :detailed]}}}}
                     :simple {:extends :base
                              :fields {:name {:type :text}}}
                     :detailed {:extends :base
                                :fields {:name {:type :text}
                                         :note {:type :text}}}}
                    :schema {:type :union
                             :discriminator :type
                             :base {:ref :base}
                             :variants {:simple {:ref :simple}
                                        :detailed {:ref :detailed}}}}
        prepared (schema/prepare-schema schema-doc)
        value {:type :detailed
               :name "Name"
               :note "Note"}]
    (is (= (schema/resolved-root-schema schema-doc)
           (schema/resolved-root-schema prepared)))
    (is (= (schema/resolved-field-schema schema-doc :name)
           (schema/resolved-field-schema prepared :name)))
    (is (= (schema/active-schema-field-ids schema-doc value)
           (schema/active-schema-field-ids prepared value)))
    (is (schema/field-visible? prepared :note value))))

(deftest prepared-schema-leaves-reentrant-references-unresolved
  (let [schema-doc {:definitions
                    {:node {:type :object
                            :fields {:name {:type :text}
                                     :children {:type :array
                                                :items {:ref :node}}}}}
                    :schema {:ref :node}}
        prepared (schema/prepare-schema schema-doc)]
    (is (:zoology/prepared? prepared))
    (is (= {:type :object
            :fields {:name {:type :text}
                     :children {:type :array
                                :items {:ref :node}}}
            :zoology/ref :node}
           (schema/resolved-root-schema prepared)))))

(deftest prepared-schema-supports-shorthand-type-field
  (let [schema-doc {:definitions
                    {:rule-type {:type :keyword
                                 :valid-values
                                 [:preferred-position :edge]}}
                    :schema {:type {:ref :rule-type}
                             :name {:type :text}}}
        prepared (schema/prepare-schema schema-doc)]
    (is (= {:type :keyword
            :valid-values [:preferred-position :edge]
            :zoology/ref :rule-type}
           (schema/resolved-field-schema prepared :type)))
    (is (= [:type :name]
           (schema/schema-field-ids prepared)))))

(deftest schema-field-ids-use-object-root-fields
  (let [schema-doc {:schema {:type :object
                             :fields {:relation {:type :keyword}
                                      :place-id {:type :keyword}}}}]
    (is (= [:relation :place-id]
           (schema/schema-field-ids schema-doc)))))
