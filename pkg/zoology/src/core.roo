(ns zoology.core)

(defun field-path [field-id field-schema]
  (let [path (:path field-schema)]
    (cond
      (nil? path) [field-id]
      (sequential? path) path
      :default [path])))

(defun field-value [value field-id field-schema]
  (get-in value (field-path field-id field-schema)))

(defun path-value [value path]
  (cond
    (nil? path) value
    (sequential? path) (get-in value path)
    :default (get value path)))

(defun path-present-at? [value path index]
  (cond
    (>= index (count (or path []))) true

    (and (map? value)
         (contains? value (nth path index)))
    (path-present-at? (get value (nth path index))
                      path
                      (inc index))

    :default false))

(defun path-present? [value path]
  (path-present-at? value path 0))
