(ns zoology.valid-values
  (:require [zoology.schema :as schema]))

(defun valid-values-source-items [context value source]
  (cond
    (sequential? source)
    (get-in context source [])

    (map? source)
    (let [source-key (schema/path-value value (or (:field source)
                                                  (:path source)))
          source-path (get (:sources source) source-key)]
      (if source-path
        (get-in context source-path [])
        []))

    :default []))

(defun valid-values-items [context valid-values value]
  (cond
    (nil? valid-values)
    []

    (sequential? valid-values)
    valid-values

    (map? valid-values)
    (if (contains? valid-values :from)
      (valid-values-source-items context value (:from valid-values))
      (get valid-values :values []))

    :default []))

(defun valid-value-item-value [item {:keys [value-path] :as valid-values}]
  (cond
    value-path
    (get-in item value-path)

    (map? item)
    (if (contains? item :value)
      (:value item)
      (:id item))

    :default item))

(defun valid-value-values [context
                           {:keys [valid-values] :as field-schema}
                           value]
  (for [item  (valid-values-items context valid-values value)]
    (valid-value-item-value item valid-values)))
