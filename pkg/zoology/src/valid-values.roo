(ns zoology.valid-values
  (:require [zoology.core :as core]))

(defun valid-values-source-items [context value source]
  (cond
    (= (type-of source) "vector")
    (or (get-in context source) [])

    (= (type-of source) "map")
    (let [source-key (core/path-value value (or (:field source)
                                                (:path source)))
          source-path (get (:sources source) source-key)]
      (if source-path
        (or (get-in context source-path) [])
        []))

    :default []))

(defun valid-values-items [context valid-values value]
  (cond
    (nil? valid-values)
    []

    (= (type-of valid-values) "vector")
    valid-values

    (= (type-of valid-values) "map")
    (if (contains? valid-values :from)
      (valid-values-source-items context value (:from valid-values))
      (get valid-values :values []))

    :default []))

(defun valid-value-item-value [item valid-values]
  (let [value-path (:value-path valid-values)]
    (cond
      value-path
      (get-in item value-path)

      (= (type-of item) "map")
      (if (contains? item :value)
        (:value item)
        (:id item))

      :default item)))

(defun valid-value-values [context field-schema value]
  (let [valid-values (:valid-values field-schema)]
    (map (valid-values-items context valid-values value)
         (fn [item]
           (valid-value-item-value item valid-values)))))
