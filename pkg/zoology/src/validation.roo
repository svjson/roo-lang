(ns zoology.validation
  (:require [zoology.schema :as schema]
            [zoology.valid-values :as valid-values]))

(defun append-error [errors error]
  (if error
    (concat errors [error])
    errors))

(defun required-error [value field-schema]
  (when (and (= (:required field-schema) true)
             (or (nil? value)
                 (and (string? value)
                      (blank? value))))
    {:rule :required}))

(defun min-error [value field-schema]
  (let [min-value (:min field-schema)]
    (when (and (not (nil? min-value))
               (number? value)
               (< value min-value))
      {:rule :min
       :min min-value
       :actual value})))

(defun max-error [value field-schema]
  (let [max-value (:max field-schema)]
    (when (and (not (nil? max-value))
               (number? value)
               (> value max-value))
      {:rule :max
       :max max-value
       :actual value})))

(defun valid-value-error [context parent-value value field-schema]
  (let [valid-values (:valid-values field-schema)
        allowed (valid-values/valid-value-values context field-schema parent-value)]
    (when (and valid-values
               (not (or (nil? value)
                        (and (string? value)
                             (blank? value))))
               (not (contains? allowed value)))
      {:rule :valid-values
       :allowed allowed
       :actual value})))

(defun object-field-error [schema context value field-schema]
  (when (and (= (:type field-schema) :object)
             (not (or (nil? value)
                      (and (string? value)
                           (blank? value)))))
    (let [errors (validation-errors-with-context
                  (schema/schema-document-with-root schema field-schema)
                  value
                  context)]
      (when (not-empty? (keys errors))
        {:rule :object
         :errors errors}))))

(defun array-item-errors [schema context value field-schema]
  (let [item-schema (schema/schema-document-with-root schema (:items field-schema))]
    (reduce (if (empty? value) [] (range 0 (dec (count value))))
            {}
            (fn [errors index]
              (let [item-errors (validation-errors-with-context
                                 item-schema
                                 (nth value index)
                                 context)]
                (if (empty? (keys item-errors))
                  errors
                  (assoc errors index item-errors)))))))

(defun array-value-error [schema context value field-schema]
  (when (and (= (:type field-schema) :array)
             (not (or (nil? value)
                      (and (string? value)
                           (blank? value)))))
    (let [errors (array-item-errors schema context value field-schema)]
      (when (not-empty? (keys errors))
        {:rule :array
         :errors errors}))))

(defun validate-field-with-context [schema value field-id context]
  (let [field-schema (schema/resolved-field-schema schema field-id)
        field-value (schema/field-value value field-id field-schema)
        errors (append-error [] (required-error field-value field-schema))
        errors (append-error errors (min-error field-value field-schema))
        errors (append-error errors (max-error field-value field-schema))
        errors (append-error errors
                             (valid-value-error context
                                                value
                                                field-value
                                                field-schema))
        errors (append-error errors
                             (object-field-error schema
                                                 context
                                                 field-value
                                                 field-schema))
        errors (append-error errors
                             (array-value-error schema
                                                context
                                                field-value
                                                field-schema))]
    errors))

(defun validate-field [schema value field-id]
  (validate-field-with-context schema value field-id {}))

(defun validation-errors-with-context [schema value context]
  (let [root (schema/resolved-root-schema schema)]
    (case (:type root)
      :array (if-let [error (array-value-error schema context value root)]
               {:value [error]}
               {})
      :default (reduce-kv (schema/active-schema-fields schema value)
                          {}
                          (fn [errors field-id field-schema]
                            (let [field-errors (validate-field-with-context schema
                                                                            value
                                                                            field-id
                                                                            context)]
                              (cond
                                (empty? field-errors)
                                errors

                                true
                                (assoc errors field-id field-errors))))))))

(defun validation-errors [schema value]
  (validation-errors-with-context schema value {}))

(defun validate-with-context [schema value context]
  (let [errors (validation-errors-with-context schema value context)]
    {:valid? (empty? (keys errors))
     :errors errors}))

(defun validate [schema value]
  (validate-with-context schema value {}))
