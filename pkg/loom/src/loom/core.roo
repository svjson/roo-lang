(ns loom.core
  (:require [loom.command.deps :as deps]
            [loom.command.info :as info]
            [loom.command.init :as init]
            [loom.command.install :as install]
            [loom.command.link :as link]
            [loom.command.list :as list]
            [loom.command.uninstall :as uninstall]
            [loom.common.args :as args]
            [loom.common.package-spec :as package-spec]
            [loom.common.repository :as repository]))

(defun usage []
  (prn "Usage: loom init [package-dir] [--name <name>] [--version <version>]")
  (prn "       loom install <package-dir> [--repo <dir>]")
  (prn "       loom link <package-dir> [--repo <dir>]")
  (prn "       loom uninstall <package@version> [--repo <dir>]")
  (prn "       loom list [--repo <dir>]")
  (prn "       loom info <package@version> [--repo <dir>]")
  (prn "       loom deps <package-dir> [--repo <dir>] [--flat] [--show-repeated]"))

(defun option? [arg]
  (cond
    (nil? arg) false
    (empty? arg) false
    :default (= "-" (str (head arg)))))

(defun init-package-dir [argv]
  (let [first-arg (args/arg-at argv 1)]
    (unless (option? first-arg)
      first-arg)))

(defun init-command [argv]
  (let [package-dir (init-package-dir argv)]
    (init/init! package-dir
                (args/option-from argv 1 "--name" nil)
                (args/option-from argv 1 "--version" nil))))

(defun install-command [argv]
  (if-let [package-dir (args/arg-at argv 1)]
    (let [repo-root (args/option-from argv 2 "--repo"
                                      (repository/default-repository-root))]
      (if (args/flag-from? argv 2 "--link")
        (link/link! package-dir repo-root)
        (install/install! package-dir
                          repo-root
                          (args/flag-from? argv 2 "--force"))))
    (usage)))

(defun link-command [argv]
  (if-let [package-dir (args/arg-at argv 1)]
    (link/link! package-dir
                (args/option-from argv 2 "--repo"
                                  (repository/default-repository-root)))
    (usage)))

(defun uninstall-command [argv]
  (if-let [spec (package-spec/parse (args/arg-at argv 1) (args/arg-at argv 2))]
    (uninstall/uninstall! (args/option-from argv 1 "--repo"
                                            (repository/default-repository-root))
                          (:name spec)
                          (:version spec))
    (usage)))

(defun list-command [argv]
  (list/list! (args/option-from argv 1 "--repo"
                                (repository/default-repository-root))))

(defun info-command [argv]
  (if-let [spec (package-spec/parse (args/arg-at argv 1) (args/arg-at argv 2))]
    (info/info! (args/option-from argv 1 "--repo"
                                  (repository/default-repository-root))
                (:name spec)
                (:version spec))
    (usage)))

(defun deps-command [argv]
  (if-let [package-dir (args/arg-at argv 1)]
    (deps/deps! package-dir
                (args/option-from argv 1 "--repo"
                                  (repository/default-repository-root))
                (args/flag-from? argv 1 "--show-repeated")
                (args/flag-from? argv 1 "--flat"))
    (usage)))

(defun main [args]
  (case (args/arg-at args 0)
    "init" (init-command args)
    "install" (install-command args)
    "link" (link-command args)
    "uninstall" (uninstall-command args)
    "list" (list-command args)
    "info" (info-command args)
    "deps" (deps-command args)
    :default (usage)))
