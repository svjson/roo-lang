(ns loom.core
  (:require [roo.io :as io]
            [loom.command.deps :as deps]
            [loom.command.bootstrap :as bootstrap]
            [loom.command.info :as info]
            [loom.command.init :as init]
            [loom.command.install :as install]
            [loom.command.link :as link]
            [loom.command.list :as list]
            [loom.command.uninstall :as uninstall]
            [loom.common.args :as args]
            [loom.common.package-spec :as package-spec]
            [loom.common.repository :as repository]))

(defun usage []
  (prn "Usage: loom init [package-dir] [--name <name>] [--version <version>]")
  (prn "       loom bootstrap <package-dir> [--source-root <dir>] [-R|--package-repository <dir>]")
  (prn "       loom install <package-dir> [-R|--package-repository <dir>]")
  (prn "       loom link <package-dir> [-R|--package-repository <dir>]")
  (prn "       loom uninstall <package@version> [-R|--package-repository <dir>]")
  (prn "       loom list [-R|--package-repository <dir>]")
  (prn "       loom info <package@version> [-R|--package-repository <dir>]")
  (prn "       loom deps <package-dir> [-R|--package-repository <dir>] [--flat] [--show-repeated]"))

(defun option? [arg]
  (cond
    (nil? arg) false
    (empty? arg) false
    :default (= "-" (str (head arg)))))

(defun init-package-dir [argv]
  (let [first-arg (nth argv 1)]
    (unless (option? first-arg)
      first-arg)))

(defun init-command [argv]
  (let [package-dir (init-package-dir argv)]
    (init/init! package-dir
                (args/option-from argv 1 "--name" nil)
                (args/option-from argv 1 "--version" nil))))

(defun package-repository-from [argv index]
  (args/option-from argv
                    index
                    "--package-repository"
                    (args/option-from argv
                                      index
                                      "-R"
                                      (repository/default-repository-root))))

(defun install-command [argv]
  (if-let [package-dir (nth argv 1)]
    (let [repo-root (package-repository-from argv 2)]
      (if (args/flag-from? argv 2 "--link")
        (link/link! package-dir repo-root)
        (install/install! package-dir
                          repo-root
                          (args/flag-from? argv 2 "--force"))))
    (usage)))

(defun bootstrap-command
  "Run the bootstrap command described by ARGV.

  Args:
  - `argv`: Command-line arguments beginning with `bootstrap`.

  Returns:
  Zero on success, one on bootstrap failure, or the usage result when no package
  is supplied."
  [argv]
  (if-let [package-dir (nth argv 1)]
    (if (nil? (bootstrap/bootstrap!
                package-dir
                (args/option-from argv 2
                                  "--source-root"
                                  (io/parent-path package-dir))
                (args/option-from argv 2
                                  "--package-repository"
                                  (repository/default-repository-root))))
      1
      0)
    (usage)))

(defun link-command [argv]
  (if-let [package-dir (nth argv 1)]
    (link/link! package-dir
                (package-repository-from argv 2))
    (usage)))

(defun uninstall-command [argv]
  (if-let [spec (package-spec/parse (nth argv 1) (nth argv 2))]
    (uninstall/uninstall! (package-repository-from argv 1)
                          (:name spec)
                          (:version spec))
    (usage)))

(defun list-command [argv]
  (list/list! (package-repository-from argv 1)))

(defun info-command [argv]
  (if-let [spec (package-spec/parse (nth argv 1) (nth argv 2))]
    (info/info! (package-repository-from argv 1)
                (:name spec)
                (:version spec))
    (usage)))

(defun deps-command [argv]
  (if-let [package-dir (nth argv 1)]
    (deps/deps! package-dir
                (package-repository-from argv 1)
                (args/flag-from? argv 1 "--show-repeated")
                (args/flag-from? argv 1 "--flat"))
    (usage)))

(defun main [args]
  (case (nth args 0)
    "bootstrap" (bootstrap-command args)
    "init" (init-command args)
    "install" (install-command args)
    "link" (link-command args)
    "uninstall" (uninstall-command args)
    "list" (list-command args)
    "info" (info-command args)
    "deps" (deps-command args)
    :default (usage)))
