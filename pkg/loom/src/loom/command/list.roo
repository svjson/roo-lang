(ns loom.command.list
  (:require [roo.io :as io]
            [loom.common.repository :as repository]))

(defun directory-entry? [entry]
  (= (:type entry) :directory))

(defun installed-version-id [package-entry version-entry]
  (let [name (:name package-entry)
        version (:name version-entry)]
    (if (io/exists? (io/join-path (:path version-entry) "package.edn"))
      (repository/package-id name version)
      nil)))

(defun installed-package-ids-for [package-entry]
  (keep (filter (io/list-directory! (:path package-entry)) directory-entry?)
        (fn [version-entry]
          (installed-version-id package-entry version-entry))))

(defun installed-package-ids [repo-root]
  (if (io/directory? repo-root)
    (sort
      (flatten
        (map (filter (io/list-directory! repo-root) directory-entry?)
             installed-package-ids-for))
      <)
    []))

(defun list! [repo-root]
  (let [ids (installed-package-ids repo-root)]
    (map ids prn)
    ids))
