(ns loom.command.deps
  (:require [loom.common.dependency-graph :as graph]))

(defun repeated-label [repeated? show-repeated?]
  (if repeated?
    (if show-repeated?
      " (*)"
      "")
    ""))

(defun node-label [node repeated? show-repeated?]
  (str (:id node)
       (if (:missing? node) " (! missing)" "")
       (if (:cycle? node) " (! cycle)" "")
       (repeated-label repeated? show-repeated?)))

(defun child-branch [last?]
  (if last?
    "└── "
    "├── "))

(defun child-prefix [last?]
  (if last?
    "    "
    "│   "))

(defun append-child-lines! [lines children prefix seen show-repeated?]
  (let [index 0]
    (while (< index (count children))
      (let [child (nth children index)
            last? (= index (- (count children) 1))
            id (:id child)
            repeated? (contains? seen id)]
        (append! lines
                 (str prefix
                      (child-branch last?)
                      (node-label child repeated? show-repeated?)))
        (unless repeated?
          (append! seen id)
          (append-child-lines! lines
                               (:dependencies child)
                               (str prefix (child-prefix last?))
                               seen
                               show-repeated?))
        (set! [index] (+ index 1))))))

(defun tree-lines [root show-repeated?]
  (let [lines [(node-label root false show-repeated?)]
        seen [(:id root)]]
    (append-child-lines! lines (:dependencies root) "" seen show-repeated?)
    lines))

(defun append-flat-ids! [ids seen node]
  (let [id (:id node)]
    (unless (contains? seen id)
      (append! seen id)
      (append! ids id)
      (map (:dependencies node)
           (fn [child]
             (append-flat-ids! ids seen child))))))

(defun flat-lines [root]
  (let [ids []
        seen [(:id root)]]
    (map (:dependencies root)
         (fn [child]
           (append-flat-ids! ids seen child)))
    (sort ids <)))

(defun print-lines! [lines]
  (map lines prn)
  lines)

(defun deps! [package-dir repo-root show-repeated? flat?]
  (let [root (graph/root-node! package-dir repo-root)]
    (unless (nil? root)
      (if flat?
        (print-lines! (flat-lines root))
        (print-lines! (tree-lines root show-repeated?))))))
