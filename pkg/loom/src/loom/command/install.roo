(ns loom.command.install
  (:require [roo.io :as io]
            [loom.command.uninstall :as uninstall]
            [loom.common.files :as files]
            [loom.common.manifest :as manifest]
            [loom.common.repository :as repository]
            [loom.package.preflight :as preflight]))

(defun copy-load-roots! [package-dir target-dir roots]
  (for [root roots]
    (files/copy-path-if-present! (io/join-path package-dir root)
                                 (io/join-path target-dir root))))

(defun copy-native-library! [package-dir target-dir library]
  (when-let [path (:path library)]
    (files/copy-path-if-present! (io/join-path package-dir path)
                                 (io/join-path target-dir path))))

(defun copy-native-libraries! [package-dir target-dir libraries]
  (for [lib libraries]
    (copy-native-library! package-dir target-dir lib)))

(defun report-preflight-failure! [package-dir diagnostics]
  (prn! "Cannot install" (str package-dir ": package preflight failed."))
  (for [diagnostic diagnostics]
    (prn! " " (pretty-str diagnostic))))

(defun install! [package-dir repo-root force?]
  (let [result (preflight/check package-dir)]
    (if (:ok? result)
      (let [package-manifest (:manifest result)
            manifest-path (manifest/manifest-path package-dir)
            name (manifest/package-name package-manifest)
            version (manifest/package-version package-manifest)
            package-id (manifest/package-id package-manifest)
            target-dir (repository/package-target-dir repo-root name version)]
        (when (io/exists? target-dir)
          (uninstall/uninstall! repo-root name version))
        (io/copy-file! manifest-path (io/join-path target-dir "package.edn"))
        (copy-load-roots! package-dir target-dir (manifest/load-roots package-manifest))
        (copy-native-libraries! package-dir
                                target-dir
                                (manifest/native-libraries package-manifest))
        (io/spit! (io/join-path target-dir "symbols.edn") (:symbols result))
        (prn! (str "Installed " package-id " to " target-dir))
        target-dir)
      (do
        (report-preflight-failure! package-dir (:diagnostics result))
        nil))))
