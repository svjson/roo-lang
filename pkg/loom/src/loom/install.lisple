(ns loom.install
  (:require [lisple.io :as io]))

(defun default-repository-root []
  (io/join-path (io/join-path (io/join-path (io/home-directory!) ".local") "share")
                (io/join-path "lisple" "pkg")))

(defun arg-at [args index]
  (if (< index (count args))
    (nth args index)
    nil))

(defun flag-from? [args index flag]
  (if (< index (count args))
    (if (= (nth args index) flag)
      true
      (flag-from? args (+ index 1) flag))
    false))

(defun option-from [args index option default]
  (if (< index (count args))
    (if (= (nth args index) option)
      (arg-at args (+ index 1))
      (option-from args (+ index 1) option default))
    default))

(defun copy-tree! [source target]
  (if (io/file? source)
    (io/copy-file! source target)
    (if (io/directory? source)
      (map (io/list-directory! source {:hidden? true})
           (fn [entry]
             (copy-tree! (:path entry) (io/join-path target (:name entry)))))
      nil)))

(defun copy-path-if-present! [source target]
  (if (io/exists? source)
    (copy-tree! source target)
    nil))

(defun copy-load-roots! [package-dir target-dir roots]
  (if (nil? roots)
    nil
    (map roots
         (fn [root]
           (copy-path-if-present! (io/join-path package-dir root)
                                  (io/join-path target-dir root))))))

(defun copy-native-library! [package-dir target-dir library]
  (let [path (:path library)]
    (if (nil? path)
      nil
      (copy-path-if-present! (io/join-path package-dir path)
                             (io/join-path target-dir path)))))

(defun copy-native-libraries! [package-dir target-dir libraries]
  (if (nil? libraries)
    nil
    (map libraries
         (fn [library]
           (copy-native-library! package-dir target-dir library)))))

(defun install! [package-dir repo-root force?]
  (let [manifest-path (io/join-path package-dir "package.edn")
        manifest (io/slurp-edn! manifest-path)
        name (str (:name manifest))
        version (str (:version manifest))
        target-dir (io/join-path (io/join-path repo-root name) version)]
    (if (if (io/exists? target-dir) (not force?) false)
      (do
        (prn (str "loom: package already installed: " target-dir))
        nil)
      (do
        (if (io/exists? target-dir)
          (io/remove-tree! target-dir)
          nil)
        (io/copy-file! manifest-path (io/join-path target-dir "package.edn"))
        (copy-load-roots! package-dir target-dir (:load-roots manifest))
        (copy-native-libraries! package-dir target-dir (:native-libraries manifest))
        (prn (str "Installed " name " " version " to " target-dir))
        target-dir))))
