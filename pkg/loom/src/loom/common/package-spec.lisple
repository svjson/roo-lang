(ns loom.common.package-spec)

(defun separator-index [package-id]
  (find-index package-id (fn [c] (= (str c) "@"))))

(defun parse [package-id version]
  (if (nil? package-id)
    nil
    (let [separator (separator-index package-id)]
      (if (nil? separator)
        (if (nil? version)
          nil
          (if (= version "--repo")
            nil
            {:name package-id :version version}))
        (if (= "" (substr package-id 0 separator))
          nil
          (if (= "" (substr package-id (+ separator 1)))
            nil
            {:name (substr package-id 0 separator)
             :version (substr package-id (+ separator 1))}))))))
