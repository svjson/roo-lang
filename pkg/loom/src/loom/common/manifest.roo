(ns loom.common.manifest
  (:require [roo.io :as io]
            [roo.string :as string]
            [loom.common.repository :as repository]))

(defun manifest-path [package-dir]
  (io/join-path package-dir "package.edn"))

(defun atom? [value]
  (let [kind (type-of value)]
    (case kind
      "string" true
      "symbol" true
      "keyword" true
      :default false)))

(defun package-name [manifest]
  (str (:name manifest)))

(defun package-version [manifest]
  (str (:version manifest)))

(defun package-id [manifest]
  (repository/package-id (package-name manifest) (package-version manifest)))

(defun load-roots
  "Return the effective production source roots declared by a manifest.

  Args:
  - `manifest`: Parsed package manifest map.

  Returns:
  An ordered vector containing explicit load roots and uncovered namespace-root paths."
  [manifest]
  (let [roots (map (:load-roots manifest) io/normalize-path)
        namespace-roots (flat-map (vals (:namespace-roots manifest))
                                  (fn [value]
                                    (map (case (type-of value)
                                           "vector" value
                                           :default [value])
                                         io/normalize-path)))]
    (reduce namespace-roots
            roots
            (fn [roots path]
              (if (any? roots
                        (fn [root]
                          (or (= "." root)
                              (= root path)
                              (string/starts-with? path (str root "/")))))
                roots
                (append roots path))))))

(defun native-libraries [manifest]
  (:native-libraries manifest))

(defun field-text [value]
  (cond
    (nil? value) "none"
    (empty? value) "none"
    :default (str value)))

(defun add-required-atom-error! [errors manifest field label]
  (if-let [value (get manifest field)]
    (unless (atom? value)
      (append! errors (str label " must be a string, symbol, or keyword")))
    (append! errors (str "missing required field " label))))

(defun add-load-roots-error! [errors manifest]
  (if-let [roots (:load-roots manifest)]
    (case (type-of roots)
      "vector" (let [invalid-roots (filter roots (fn [root] (not (string? root))))]
                 (unless (empty? invalid-roots)
                   (append! errors ":load-roots must contain only strings")))
      :default (append! errors ":load-roots must be a vector"))
    (when (empty? (:namespace-roots manifest))
      (append! errors "missing required field :load-roots"))))

(defun add-namespace-roots-errors! [errors manifest]
  (when-let [roots (:namespace-roots manifest)]
    (case (type-of roots)
      "map" (reduce-kv roots
                       nil
                       (fn [result prefix paths]
                         (unless (atom? prefix)
                           (append! errors ":namespace-roots keys must be strings, symbols, or keywords"))
                         (case (type-of paths)
                           "vector" (unless (empty? (filter paths (fn [path] (not (string? path)))))
                                      (append! errors ":namespace-roots paths must be strings"))
                           :default (unless (string? paths)
                                      (append! errors ":namespace-roots paths must be strings")))))
      :default (append! errors ":namespace-roots must be a map"))))

(defun validation-errors [manifest]
  (let [errors []]
    (case (type-of manifest)
      "map" (do
              (add-required-atom-error! errors manifest :name ":name")
              (add-required-atom-error! errors manifest :version ":version")
              (add-load-roots-error! errors manifest)
              (add-namespace-roots-errors! errors manifest))
      :default (append! errors "package.edn must contain a map"))
    errors))

(defun report-errors! [manifest-path errors]
  (prn (str "loom: invalid package manifest: " manifest-path))
  (for [error errors]
    (prn (str "loom: " error))))

(defun validate! [manifest manifest-path]
  (let [errors (validation-errors manifest)]
    (if (empty? errors)
      manifest
      (do
        (report-errors! manifest-path errors)
        nil))))

(defun read! [package-dir]
  (let [path (manifest-path package-dir)]
    (if (io/exists? path)
      (validate! (io/slurp-edn! path) path)
      (do
        (prn (str "loom: missing package manifest: " path))
        nil))))
