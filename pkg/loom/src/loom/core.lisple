(ns loom.core
  (:require [loom.command.info :as info]
            [loom.command.install :as install]
            [loom.command.list :as list]
            [loom.command.uninstall :as uninstall]
            [loom.common.args :as args]
            [loom.common.repository :as repository]))

(defun usage []
  (prn "Usage: loom install <package-dir> [--repo <dir>]")
  (prn "       loom uninstall <name> <version> [--repo <dir>]")
  (prn "       loom list [--repo <dir>]")
  (prn "       loom info <package@version> [--repo <dir>]"))

(defun install-command [argv]
  (let [package-dir (args/arg-at argv 1)]
    (if (nil? package-dir)
      (usage)
      (install/install! package-dir
                        (args/option-from argv 2 "--repo"
                                          (repository/default-repository-root))
                        (args/flag-from? argv 2 "--force")))))

(defun uninstall-command [argv]
  (let [name (args/arg-at argv 1)
        version (args/arg-at argv 2)]
    (if (nil? name)
      (usage)
      (if (nil? version)
        (usage)
        (uninstall/uninstall! (args/option-from argv 3 "--repo"
                                                (repository/default-repository-root))
                              name
                              version)))))

(defun list-command [argv]
  (list/list! (args/option-from argv 1 "--repo"
                                (repository/default-repository-root))))

(defun package-spec [package-id version]
  (if (nil? package-id)
    nil
    (let [separator (find-index package-id (fn [c] (= (str c) "@")))]
      (if (nil? separator)
        (if (nil? version)
          nil
          (if (= version "--repo")
            nil
            {:name package-id :version version}))
        (if (= "" (substr package-id 0 separator))
          nil
          (if (= "" (substr package-id (+ separator 1)))
            nil
            {:name (substr package-id 0 separator)
             :version (substr package-id (+ separator 1))}))))))

(defun info-command [argv]
  (let [spec (package-spec (args/arg-at argv 1) (args/arg-at argv 2))]
    (if (nil? spec)
      (usage)
      (info/info! (args/option-from argv 1 "--repo"
                                    (repository/default-repository-root))
                  (:name spec)
                  (:version spec)))))

(defun main [args]
  (let [command (args/arg-at args 0)]
    (if (= command "install")
      (install-command args)
      (if (= command "uninstall")
        (uninstall-command args)
        (if (= command "list")
          (list-command args)
          (if (= command "info")
            (info-command args)
            (usage)))))))
