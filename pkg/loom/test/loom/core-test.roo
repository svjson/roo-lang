(ns loom.core-test
  (:require proof.core
            [loom.core :as core]
            [loom.test-support :as support]))

(deftest dispatches-list-command
  (given
    ["list" "--repo" (support/fresh-repo! "loom-proof-core-list")])

  (when [list-argv]
    (core/main list-argv))

  (then [list-result]
    (is (= [] list-result))))
