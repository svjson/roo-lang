(ns loom.common.args-test
  (:require proof.core
            [loom.common.args :as args]))

(deftest finds-arguments-by-index
  (given
    ["install" "pkg/loom"])

  (when [index-argv]
    {:index-command (args/arg-at index-argv 0)
     :missing-index-arg (args/arg-at index-argv 3)})

  (then [{:keys [index-command missing-index-arg]}]
    (is (= "install" index-command))
    (is (nil? missing-index-arg))))

(deftest finds-options-and-flags-from-offset
  (given
    ["install" "pkg/loom" "--repo" "build/repo" "--force"])

  (when [options-argv]
    {:option-repo (args/option-from options-argv 2 "--repo" "default-repo")
     :force-option? (args/flag-from? options-argv 2 "--force")
     :dry-run-option? (args/flag-from? options-argv 2 "--dry-run")})

  (then [{:keys [option-repo force-option? dry-run-option?]}]
    (is (= "build/repo" option-repo))
    (is force-option?)
    (is (= false dry-run-option?))))
