(ns loom.common.args-test
  (:require proof.core
            [proof.syntax :as s]
            [loom.common.args :as args]))

(deftest finds-options-and-flags-from-offset
  (s/given
    ["install" "pkg/loom" "--repo" "build/repo" "--force"])

  (s/when [options-argv]
    {:option-repo (args/option-from options-argv 2 "--repo" "default-repo")
     :force-option? (args/flag-from? options-argv 2 "--force")
     :dry-run-option? (args/flag-from? options-argv 2 "--dry-run")})

  (s/then [{:keys [option-repo force-option? dry-run-option?]}]
    (is (= "build/repo" option-repo))
    (is force-option?)
    (is (= false dry-run-option?))))
