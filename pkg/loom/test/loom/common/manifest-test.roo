(ns loom.common.manifest-test
  (:require proof.core
            [proof.syntax :as s]
            [loom.common.manifest :as manifest]))

(deftest accepts-minimal-valid-manifest
  (s/given
    {:name "loom"
     :version "0.1.0"
     :load-roots ["src"]})

  (s/when [valid-manifest]
    (manifest/validation-errors valid-manifest))

  (s/then [valid-manifest-errors]
    (is (= [] valid-manifest-errors))))

(deftest reports-required-manifest-fields
  (s/given
    {:description "No identity."})

  (s/when [missing-required-fields]
    (manifest/validation-errors missing-required-fields))

  (s/then [required-field-errors]
    (is (= ["missing required field :name"
            "missing required field :version"
            "missing required field :load-roots"]
           required-field-errors))))

(deftest reports-invalid-manifest-field-types
  (s/given
    {:name ["loom"]
     :version {:major 0}
     :load-roots "src"})

  (s/when [invalid-field-types]
    (manifest/validation-errors invalid-field-types))

  (s/then [invalid-type-errors]
    (is (= [":name must be a string, symbol, or keyword"
            ":version must be a string, symbol, or keyword"
            ":load-roots must be a vector"]
           invalid-type-errors))))

(deftest reports-invalid-load-root-values
  (s/given
    {:name "loom"
     :version "0.1.0"
     :load-roots ["src" {:bad true}]})

  (s/when [invalid-load-roots]
    (manifest/validation-errors invalid-load-roots))

  (s/then [invalid-load-root-errors]
    (is (= [":load-roots must contain only strings"]
           invalid-load-root-errors))))

(deftest accepts-namespace-roots-without-repeated-load-roots
  (s/given
    {:name "loom"
     :version "0.1.0"
     :namespace-roots {"loom" ["src" "src/support"]}})

  (s/when [namespace-root-manifest]
    {:errors (manifest/validation-errors namespace-root-manifest)
     :load-roots (manifest/load-roots namespace-root-manifest)})

  (s/then [result]
    (is (= {:errors []
            :load-roots ["src"]}
           result))))

(deftest combines-explicit-and-inferred-production-load-roots
  (s/given
    {:name "loom"
     :version "0.1.0"
     :load-roots ["src/../lib" "./assets"]
     :namespace-roots {"loom" "lib/loom"
                       "generated" "generated"
                       "fixtures" "testing"}
     :dev {:namespace-roots {"loom" "test"}}})

  (s/when [package-manifest]
    (manifest/load-roots package-manifest))

  (s/then [roots]
    (is (= ["lib" "assets" "generated" "testing"] roots))))

(deftest reports-invalid-namespace-root-values
  (s/given
    {:name "loom"
     :version "0.1.0"
     :namespace-roots ["src"]})

  (s/when [invalid-namespace-roots]
    (manifest/validation-errors invalid-namespace-roots))

  (s/then [invalid-namespace-root-errors]
    (is (= [":namespace-roots must be a map"]
           invalid-namespace-root-errors))))

(deftest reports-non-string-namespace-root-paths
  (s/given
    {:name "loom"
     :version "0.1.0"
     :namespace-roots {"loom" :src}})

  (s/when [invalid-namespace-roots]
    (manifest/validation-errors invalid-namespace-roots))

  (s/then [invalid-namespace-root-errors]
    (is (= [":namespace-roots paths must be strings"]
           invalid-namespace-root-errors))))
