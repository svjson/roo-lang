(ns loom.common.files-test
  (:require proof.core
            [lisple.io :as io]
            [loom.common.files :as files]
            [loom.test-support :as support]))

(deftest copies-existing-file-paths
  (given
    (let [root (support/fresh-repo! "loom-proof-files")
          source (io/join-path root "source/config.edn")
          target (io/join-path root "target/config.edn")]
      (io/spit! source "{:ok true}")
      {:source source
       :target target}))

  (when [{:keys [source target]}]
    (files/copy-path-if-present! source target))

  (then [copied-path {:keys [target]}]
    (is (io/exists? target))
    (is (= "{:ok true}" (io/slurp! target)))))
