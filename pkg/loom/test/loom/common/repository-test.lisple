(ns loom.common.repository-test
  (:require proof.core
            [loom.common.repository :as repository]))

(deftest package-id-uses-at-version
  (given
    {:package-name "loom"
     :version "0.1.0"})

  (when [{:keys [package-name version]}]
    (repository/package-id package-name version))

  (then [id]
    (is (= "loom@0.1.0" id))))

(deftest package-paths-use-local-repository-layout
  (given
    "/tmp/lisple-pkg")

  (when [repo-root]
    {:target-dir (repository/package-target-dir repo-root "loom" "0.1.0")
     :manifest-path (repository/package-manifest-path repo-root "loom" "0.1.0")})

  (then [{:keys [target-dir manifest-path]}]
    (is (= "/tmp/lisple-pkg/loom/0.1.0" target-dir))
    (is (= "/tmp/lisple-pkg/loom/0.1.0/package.edn" manifest-path))))
