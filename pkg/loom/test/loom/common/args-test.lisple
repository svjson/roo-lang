(ns loom.common.args-test
  (:require proof.core
            [loom.common.args :as args]))

(deftest finds-arguments-by-index
  (given
    (def index-argv ["install" "pkg/loom"]))

  (when
    (def index-command (args/arg-at index-argv 0))
    (def missing-index-arg (args/arg-at index-argv 3)))

  (then
    (is (= "install" index-command))
    (is (nil? missing-index-arg))))

(deftest finds-options-and-flags-from-offset
  (given
    (def options-argv ["install" "pkg/loom" "--repo" "build/repo" "--force"]))

  (when
    (def option-repo (args/option-from options-argv 2 "--repo" "default-repo"))
    (def force-option? (args/flag-from? options-argv 2 "--force"))
    (def dry-run-option? (args/flag-from? options-argv 2 "--dry-run")))

  (then
    (is (= "build/repo" option-repo))
    (is force-option?)
    (is (= false dry-run-option?))))
