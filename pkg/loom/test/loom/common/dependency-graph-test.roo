(ns loom.common.dependency-graph-test
  (:require proof.core
            proof.fixture
            [proof.syntax :as s]
            [roo.io :as io]
            [loom.command.install :as install]
            [loom.common.dependency-graph :as graph]
            [loom.test-support :as support]))



;; Fixtures

(deffixture simple-repo {:storage :cache}
  (let [repo-root (support/fresh-repo! "loom-proof-dependency-graph")
        graph-leaf-dir
        (support/fresh-package! "loom-proof-graph-leaf"
                                "{:name leaf :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
        graph-middle-dir
        (support/fresh-package! "loom-proof-graph-middle"
                                "{:name middle :version \"1.0.0\" :dependencies {leaf \"1.0.0\"} :load-roots [\"src\"]}")
        graph-app-dir
        (support/fresh-package! "loom-proof-graph-app"
                                "{:name app :version \"0.1.0\" :dependencies {middle \"1.0.0\"} :load-roots [\"src\"]}")]
    (io/spit! (io/join-path graph-leaf-dir "src/leaf.roo") "(ns leaf)\n")
    (io/spit! (io/join-path graph-middle-dir "src/middle.roo") "(ns middle)\n")
    (install/install! graph-leaf-dir repo-root true)
    (install/install! graph-middle-dir repo-root true)
    {:repo-root repo-root
     :graph-app-dir graph-app-dir}))

(deffixture relative-path-repo {:storage :cache}
  (let [repo-root (support/fresh-repo! "loom-proof-dependency-graph-file")
        file-leaf-dir
        (support/fresh-package! "loom-proof-graph-file/leaf"
                                "{:name leaf :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
        file-middle-dir
        (support/fresh-package! "loom-proof-graph-file/middle"
                                "{:name middle :version \"1.0.0\" :dependencies {leaf {:path \"../leaf\"}} :load-roots [\"src\"]}")
        file-app-dir
        (support/fresh-package! "loom-proof-graph-file/app"
                                "{:name app :version \"0.1.0\" :dependencies {middle \"file:../middle\"} :load-roots [\"src\"]}")]
    {:repo-root repo-root
     :file-app-dir file-app-dir}))

(deffixture deep-relative-path-repo {:storage :cache}
  (let [repo-root (support/fresh-repo! "loom-proof-dependency-graph-deep-file")
        root (support/build-path "loom-proof-graph-deep-file")
        deep-app-dir (io/join-path root "apps/app")]
    (when (io/exists? root)
      (io/remove-tree! root))
    (support/fresh-package-at! (io/join-path root "util")
                               "{:name util :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
    (support/fresh-package-at! (io/join-path root "apps/util")
                               "{:name wrong-util :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
    (support/fresh-package-at! deep-app-dir
                               "{:name app :version \"0.1.0\" :dependencies {util \"file:../../util\"} :load-roots [\"src\"]}")
    {:repo-root repo-root
     :deep-app-dir deep-app-dir}))



;; Support functions

(defun simplify-dependency-graph [graph]
  (cond-> {:id (:id graph)}

          (:missing? graph)
          (assoc :missing? (:missing? graph))

          (:dependencies graph)
          (assoc :dependencies (map (:dependencies graph) simplify-dependency-graph))))



;;; loom.common.dependency-graph/root-node!

(deftest root-node!/resolves-transitive-local-dependencies
  [simple-repo]
  (s/given simple-repo)

  (s/when [{:keys [repo-root graph-app-dir]}]
    (graph/root-node! graph-app-dir repo-root))

  (s/then [resolved-graph]
    (is (= {:id "app@0.1.0"
            :dependencies [{:id "middle@1.0.0"
                            :dependencies [{:id "leaf@1.0.0"
                                            :dependencies []}]}]}
           (simplify-dependency-graph resolved-graph)))
    (is (graph/complete? resolved-graph))))

(deftest root-node!/resolves-file-path-dependencies-relative-to-declaring-package
  [relative-path-repo]
  (s/given relative-path-repo)

  (s/when [{:keys [repo-root file-app-dir]}]
    (graph/root-node! file-app-dir repo-root))

  (s/then [resolved-graph]
    (is (= {:id "app@0.1.0"
            :dependencies [{:id "middle@1.0.0"
                            :dependencies [{:id "leaf@1.0.0"
                                            :dependencies []}]}]}
           (simplify-dependency-graph resolved-graph)))
    (is (graph/complete? resolved-graph))))

(deftest root-node!/resolves-deep-file-path-dependencies-relative-to-declaring-package
  [deep-relative-path-repo]
  (s/given deep-relative-path-repo)

  (s/when [{:keys [repo-root deep-app-dir]}]
    (graph/root-node! deep-app-dir repo-root))

  (s/then [resolved-graph]
    (is (= {:id "app@0.1.0"
            :dependencies [{:id "util@1.0.0"
                            :dependencies []}]}
           (simplify-dependency-graph resolved-graph)))
    (is (graph/complete? resolved-graph))))

(deftest root-node!/reports-missing-local-dependencies
  (s/given
    {:repo-root (support/fresh-repo! "loom-proof-dependency-graph-missing")
     :missing-app-dir (support/fresh-package! "loom-proof-graph-missing-app"
                                              "{:name app :version \"0.1.0\" :dependencies {missing \"9.9.9\"} :load-roots [\"src\"]}")})

  (s/when [{:keys [repo-root missing-app-dir]}]
    (graph/root-node! missing-app-dir repo-root))

  (s/then [resolved-graph]
    (is (= {:id "app@0.1.0"
            :dependencies [{:id "missing@9.9.9"
                            :missing? true
                            :dependencies []}]}
           (simplify-dependency-graph resolved-graph)))))



;;; loom.common.dependency-graph/absolute-path?

(deftest absolute-path?/detects-platform-absolute-paths
  (is (graph/absolute-path? "/tmp/pkg"))
  (is (graph/absolute-path? "\\tmp\\pkg"))
  (is (graph/absolute-path? "C:/tmp/pkg"))
  (is (graph/absolute-path? "C:\\tmp\\pkg"))
  (is (= false (graph/absolute-path? "tmp/pkg")))
  (is (= false (graph/absolute-path? "file:tmp/pkg"))))



;;; loom.common.dependency-graph/dependency-path-root

(deftest dependency-path-root/does-not-join-windows-drive-path-dependencies-under-package-root
  (is (= "C:/tmp/pkg"
         (graph/dependency-path-root "/repo/app" {:path "C:/tmp/pkg"})))
  (is (= "C:\\tmp\\pkg"
         (graph/dependency-path-root "/repo/app" {:path "C:\\tmp\\pkg"}))))

