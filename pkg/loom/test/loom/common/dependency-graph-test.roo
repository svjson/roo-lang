(ns loom.common.dependency-graph-test
  (:require proof.core
            [roo.io :as io]
            [loom.command.install :as install]
            [loom.common.dependency-graph :as graph]
            [loom.test-support :as support]))

(deftest resolves-transitive-local-dependencies
  (given
    (let [repo-root (support/fresh-repo! "loom-proof-dependency-graph")
          graph-leaf-dir
          (support/fresh-package! "loom-proof-graph-leaf"
                                  "{:name leaf :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
          graph-middle-dir
          (support/fresh-package! "loom-proof-graph-middle"
                                  "{:name middle :version \"1.0.0\" :dependencies {leaf \"1.0.0\"} :load-roots [\"src\"]}")
          graph-app-dir
          (support/fresh-package! "loom-proof-graph-app"
                                  "{:name app :version \"0.1.0\" :dependencies {middle \"1.0.0\"} :load-roots [\"src\"]}")]
      (install/install! graph-leaf-dir repo-root true)
      (install/install! graph-middle-dir repo-root true)
      {:repo-root repo-root
       :graph-app-dir graph-app-dir}))

  (when [{:keys [repo-root graph-app-dir]}]
    (let [resolved-graph (graph/root-node! graph-app-dir repo-root)
          middle-node (nth (:dependencies resolved-graph) 0)
          leaf-node (nth (:dependencies middle-node) 0)]
      {:resolved-graph resolved-graph
       :middle-node middle-node
       :leaf-node leaf-node}))

  (then [{:keys [resolved-graph middle-node leaf-node]}]
    (is (= "app@0.1.0" (:id resolved-graph)))
    (is (= "middle@1.0.0" (:id middle-node)))
    (is (= "leaf@1.0.0" (:id leaf-node)))
    (is (graph/complete? resolved-graph))))

(deftest reports-missing-local-dependencies
  (given
    {:repo-root (support/fresh-repo! "loom-proof-dependency-graph-missing")
     :missing-app-dir (support/fresh-package! "loom-proof-graph-missing-app"
                                              "{:name app :version \"0.1.0\" :dependencies {missing \"9.9.9\"} :load-roots [\"src\"]}")})

  (when [{:keys [repo-root missing-app-dir]}]
    (let [missing-graph (graph/root-node! missing-app-dir repo-root)
          missing-node (nth (:dependencies missing-graph) 0)]
      {:missing-graph missing-graph
       :missing-node missing-node}))

  (then [{:keys [missing-graph missing-node]}]
    (is (= "missing@9.9.9" (:id missing-node)))
    (is (:missing? missing-node))
    (is (= ["missing@9.9.9"] (graph/collect-missing-package-ids missing-graph)))
    (is (= false (graph/complete? missing-graph)))))

(deftest detects-platform-absolute-paths
  (is (graph/absolute-path? "/tmp/pkg"))
  (is (graph/absolute-path? "\\tmp\\pkg"))
  (is (graph/absolute-path? "C:/tmp/pkg"))
  (is (graph/absolute-path? "C:\\tmp\\pkg"))
  (is (= false (graph/absolute-path? "tmp/pkg")))
  (is (= false (graph/absolute-path? "file:tmp/pkg"))))

(deftest does-not-join-windows-drive-path-dependencies-under-package-root
  (is (= "C:/tmp/pkg"
         (graph/dependency-path-root "/repo/app" {:path "C:/tmp/pkg"})))
  (is (= "C:\\tmp\\pkg"
         (graph/dependency-path-root "/repo/app" {:path "C:\\tmp\\pkg"}))))

(deftest resolves-file-path-dependencies-relative-to-declaring-package
  (given
    (let [repo-root (support/fresh-repo! "loom-proof-dependency-graph-file")
          file-leaf-dir
          (support/fresh-package! "loom-proof-graph-file/leaf"
                                  "{:name leaf :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
          file-middle-dir
          (support/fresh-package! "loom-proof-graph-file/middle"
                                  "{:name middle :version \"1.0.0\" :dependencies {leaf {:path \"../leaf\"}} :load-roots [\"src\"]}")
          file-app-dir
          (support/fresh-package! "loom-proof-graph-file/app"
                                  "{:name app :version \"0.1.0\" :dependencies {middle \"file:../middle\"} :load-roots [\"src\"]}")]
      {:repo-root repo-root
       :file-app-dir file-app-dir}))

  (when [{:keys [repo-root file-app-dir]}]
    (let [file-graph (graph/root-node! file-app-dir repo-root)
          file-middle-node (nth (:dependencies file-graph) 0)
          file-leaf-node (nth (:dependencies file-middle-node) 0)]
      {:file-graph file-graph
       :file-middle-node file-middle-node
       :file-leaf-node file-leaf-node}))

  (then [{:keys [file-graph file-middle-node file-leaf-node]}]
    (is (= "app@0.1.0" (:id file-graph)))
    (is (= "middle@1.0.0" (:id file-middle-node)))
    (is (= "leaf@1.0.0" (:id file-leaf-node)))
    (is (= false (:missing? file-middle-node)))
    (is (= false (:missing? file-leaf-node)))
    (is (graph/complete? file-graph))))

(deftest resolves-deep-file-path-dependencies-relative-to-declaring-package
  (given
    (let [repo-root (support/fresh-repo! "loom-proof-dependency-graph-deep-file")
          root (support/build-path "loom-proof-graph-deep-file")
          deep-app-dir (io/join-path root "apps/app")]
      (if (io/exists? root)
        (io/remove-tree! root)
        nil)
      (support/fresh-package-at! (io/join-path root "util")
                                 "{:name util :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
      (support/fresh-package-at! (io/join-path root "apps/util")
                                 "{:name wrong-util :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
      (support/fresh-package-at! deep-app-dir
                                 "{:name app :version \"0.1.0\" :dependencies {util \"file:../../util\"} :load-roots [\"src\"]}")
      {:repo-root repo-root
       :deep-app-dir deep-app-dir}))

  (when [{:keys [repo-root deep-app-dir]}]
    (let [deep-file-graph (graph/root-node! deep-app-dir repo-root)
          util-node (nth (:dependencies deep-file-graph) 0)]
      {:deep-file-graph deep-file-graph
       :util-node util-node}))

  (then [{:keys [deep-file-graph util-node]}]
    (is (= "app@0.1.0" (:id deep-file-graph)))
    (is (= "util@1.0.0" (:id util-node)))
    (is (= false (:missing? util-node)))
    (is (graph/complete? deep-file-graph))))
