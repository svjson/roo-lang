(ns loom.core-test
  (:require proof.core
            [loom.core :as core]
            [loom.test-support :as support]))

(deftest dispatches_list_command
  (let [repo-root (support/fresh-repo! "loom-proof-core-list")]
    (given
      (def list-argv ["list" "--repo" repo-root]))

    (when
      (def list-result (core/main list-argv)))

    (then
      (is (= [] list-result)))))
