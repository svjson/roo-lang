(ns loom.command.bootstrap-test
  (:require proof.core
            proof.fixture
            [proof.syntax :as s]
            [roo.io :as io]
            [loom.command.bootstrap :as bootstrap]
            loom.fixture.bootstrap
            [loom.test-support :as support]))



;; Fixtures

(deffixture source-dependency-closure {:storage :cache}
  (let [source-root (support/build-path "loom-proof-bootstrap-sources")]
    (when (io/exists? source-root)
      (io/remove-tree! source-root))
    (support/fresh-package-at!
      (io/join-path source-root "leaf")
      "{:name leaf :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
    (support/fresh-package-at!
      (io/join-path source-root "middle")
      "{:name middle :version \"2.0.0\" :dependencies {leaf \"1.0.0\"} :load-roots [\"src\"]}")
    (io/spit! (io/join-path source-root "leaf/src/leaf.roo") "(ns leaf)\n")
    (io/spit! (io/join-path source-root "middle/src/middle.roo") "(ns middle)\n")
    {:source-root source-root
     :package-dir
     (support/fresh-package-at!
       (io/join-path source-root "app")
       "{:name app :version \"3.0.0\" :dependencies {middle \"2.0.0\"} :load-roots [\"src\"]}")}))

(deffixture cyclic-package-dependencies {:storage :cache}
  (let [source-root (support/build-path "loom-proof-bootstrap-cycle-sources")]
    (when (io/exists? source-root)
      (io/remove-tree! source-root))
    (support/fresh-package-at!
      (io/join-path source-root "middle")
      "{:name middle :version \"1.0.0\" :dependencies {app \"1.0.0\"} :load-roots [\"src\"]}")
    {:source-root source-root
     :package-dir
     (support/fresh-package-at!
       (io/join-path source-root "app")
       "{:name app :version \"1.0.0\" :dependencies {middle \"1.0.0\"} :load-roots [\"src\"]}")}))



;;; loom.command.bootstrap/bootstrap!

(deftest bootstrap!/installs-source-dependency-closure-in-versioned-layout
  [source-dependency-closure]
  (s/given
    (support/fresh-repo! "loom-proof-bootstrap-repo"))

  (s/when [repo-root]
    (bootstrap/bootstrap! (:package-dir source-dependency-closure)
                          (:source-root source-dependency-closure)
                          repo-root))

  (s/then [installed repo-root]
    (is (= ["leaf@1.0.0" "middle@2.0.0"] installed))
    (is (io/exists? (support/installed-path repo-root "leaf" "1.0.0" "package.edn")))
    (is (io/exists? (support/installed-path repo-root "middle" "2.0.0" "package.edn")))
    (is (= false
           (io/exists? (support/installed-path repo-root "app" "3.0.0" "package.edn"))))))

(deftest bootstrap!/rejects-missing-dependency
  [package-with-missing-dependency]
  (s/given
    (support/fresh-repo! "loom-proof-bootstrap-missing-repo"))

  (s/when [repo-root]
    (bootstrap/bootstrap! (:package-dir package-with-missing-dependency)
                          (:source-root package-with-missing-dependency)
                          repo-root))

  (s/then [result repo-root]
    (is (nil? result))
    (is (= false (io/exists? (io/join-path repo-root "missing"))))))

(deftest bootstrap!/rejects-cyclic-dependency
  [cyclic-package-dependencies]
  (s/given
    (support/fresh-repo! "loom-proof-bootstrap-cycle-repo"))

  (s/when [repo-root]
    (bootstrap/bootstrap! (:package-dir cyclic-package-dependencies)
                          (:source-root cyclic-package-dependencies)
                          repo-root))

  (s/then [result repo-root]
    (is (nil? result))
    (is (= false (io/exists? (io/join-path repo-root "middle"))))))
