(ns loom.command.install-test
  (:require proof.core
            proof.fixture
            [proof.syntax :as s]
            [roo.io :as io]
            [loom.command.install :as install]
            [loom.command.link :as link]
            [loom.common.repository :as repository]
            [loom.test-support :as support]))



;; Fixtures

(deffixture installed-native-package {:storage :cache}
  (let [repo-root (support/fresh-repo! "loom-proof-install-preflight-repo")
        package-dir (support/fresh-package!
                      "loom-proof-install-preflight-installed-package"
                      "{:name protected\n :version \"1.0.0\"\n :load-roots [\"src\"]\n :native-libraries [{:name \"protected-native\" :path \"native\"}]}")]
    (io/spit! (io/join-path package-dir "src/protected.roo")
              "(ns protected)\n")
    (io/spit! (io/join-path package-dir "native/libprotected.so") "native")
    (let [target-dir (install/install! package-dir repo-root false)
          marker (io/join-path target-dir "keep-me")]
      (io/spit! marker "installed")
      {:repo-root repo-root
       :target-dir target-dir
       :marker marker})))

(deffixture unbuilt-native-package {:storage :cache}
  (let [package-dir
        (support/fresh-package!
          "loom-proof-install-preflight-unbuilt-package"
          "{:name protected\n :version \"1.0.0\"\n :load-roots [\"src\"]\n :native-libraries [{:name \"protected-native\" :path \"native\"}]}")]
    (io/spit! (io/join-path package-dir "src/protected.roo")
              "(ns protected)\n")
    package-dir))

(deffixture linked-package-for-install {:storage :cache}
  (let [repo-root (support/fresh-repo! "loom-proof-link-install-replace")
        package-dir
        (support/fresh-package! "loom-proof-link-install-replace-package"
                                "{:name linked :version \"0.1.0\" :dependencies [] :load-roots [\"src\"]}")
        target-dir (repository/package-target-dir repo-root "linked" "0.1.0")]
    (io/spit! (io/join-path package-dir "src/linked.roo") "(ns linked)\n")
    (link/link! package-dir repo-root)
    {:repo-root repo-root
     :package-dir package-dir
     :target-dir target-dir}))

(deffixture relocatable-package-install {:storage :cache}
  (let [repo-root (support/fresh-repo! "loom-proof-relocatable-install")
        package-dir
        (support/fresh-package!
          "loom-proof-relocatable-package"
          "{:name relocatable :version \"1.0.0\" :dependencies [] :load-roots [\"src\"]}")
        source-path (io/join-path package-dir "src/relocatable.roo")]
    (io/spit! source-path
              "(ns relocatable)\n(defun value \"Return a value.\" [] 1)\n")
    (let [target-dir (install/install! package-dir repo-root false)]
      (io/remove-tree! package-dir)
      {:package-dir package-dir
       :target-dir target-dir
       :symbols-path (io/join-path target-dir "symbols.edn")})))



;;; loom.command.install/install!

(deftest install!/preserves-existing-package-when-native-replacement-is-unbuilt
  [installed-native-package unbuilt-native-package]
  (s/when []
    (install/install! unbuilt-native-package
                      (:repo-root installed-native-package)
                      false))

  (s/then [result]
    (is (nil? result))
    (is (io/exists? (:target-dir installed-native-package)))
    (is (= "installed" (io/slurp! (:marker installed-native-package))))))

(deftest install!/installs-package-manifest-source-roots-and-symbol-index
  (s/given
    {:repo-root (support/fresh-repo! "loom-proof-install")
     :package-dir (support/loom-package-dir)})

  (s/when [{:keys [repo-root package-dir]}]
    (install/install! package-dir repo-root true))

  (s/then [installed-package-dir {:keys [repo-root]}]
    (is (= (repository/package-target-dir repo-root "loom" "0.1.0")
           installed-package-dir))
    (is (io/exists? (support/installed-path repo-root "loom" "0.1.0" "package.edn")))
    (is (io/exists? (support/installed-path repo-root "loom" "0.1.0"
                                            "src/loom/core.roo")))
    (is (io/exists? (support/installed-path repo-root "loom" "0.1.0"
                                            "src/loom/command/install.roo")))
    (is (io/exists? (io/join-path installed-package-dir "symbols.edn")))))

(deftest install!/produces-relocatable-symbol-index
  [relocatable-package-install]
  (s/when []
    (io/slurp-edn! (:symbols-path relocatable-package-install)))

  (s/then [symbol-index]
    (is (= false
           (io/exists? (:package-dir relocatable-package-install))))
    (is (= [{:path "src/relocatable.roo"}]
           (:sources symbol-index)))
    (is (io/file?
          (io/join-path (:target-dir relocatable-package-install)
                        "src/relocatable.roo")))
    (is (= "src/relocatable.roo"
           (:path
             (:source
               (find-first (:symbols symbol-index)
                           (fn [symbol]
                             (= "relocatable/value"
                                (:qualified-name symbol))))))))))

(deftest install!/installs-declared-native-libraries
  (s/given
    {:repo-root (support/fresh-repo! "loom-proof-install-native")
     :package-dir (support/proof-package-dir)})

  (s/when [{:keys [repo-root package-dir]}]
    (install/install! package-dir repo-root true))

  (s/then [installed-package-dir {:keys [repo-root]}]
    (is (= (repository/package-target-dir repo-root "proof" "0.1.0")
           installed-package-dir))
    (is (io/directory? (support/installed-path repo-root "proof" "0.1.0" "native")))
    (is (not-empty?
          (io/list-directory!
            (support/installed-path repo-root "proof" "0.1.0" "native"))))))

(deftest install!/replaces-linked-package-with-copied-package
  [linked-package-for-install]
  (s/given linked-package-for-install)

  (s/when [{:keys [repo-root package-dir]}]
    (install/install! package-dir repo-root false))

  (s/then [installed-package-dir {:keys [package-dir target-dir]}]
    (is (= target-dir installed-package-dir))
    (is (= false (io/symlink? target-dir)))
    (is (io/exists? (io/join-path target-dir "package.edn")))
    (is (io/exists? (io/join-path package-dir "package.edn")))))

(deftest install!/removes-previous-package-contents-when-reinstalling
  (s/given
    (let [repo-root (support/fresh-repo! "loom-proof-reinstall")
          stale-file
          (support/installed-path repo-root "loom" "0.1.0" "stale-file")]
      (install/install! (support/loom-package-dir) repo-root true)
      (io/spit! stale-file "stale")
      {:repo-root repo-root
       :stale-file stale-file}))

  (s/when [{:keys [repo-root]}]
    (install/install! (support/loom-package-dir) repo-root false))

  (s/then [installed-package-dir {:keys [repo-root stale-file]}]
    (is (= (repository/package-target-dir repo-root "loom" "0.1.0")
           installed-package-dir))
    (is (= false (io/exists? stale-file)))))

(deftest install!/rejects-package-without-manifest
  (s/given
    (let [repo-root (support/fresh-repo! "loom-proof-install-missing-manifest")
          package-dir (support/build-path "loom-proof-package-missing-manifest")]
      (when (io/exists? package-dir)
        (io/remove-tree! package-dir))
      {:repo-root repo-root
       :package-dir package-dir}))

  (s/when [{:keys [repo-root package-dir]}]
    (install/install! package-dir repo-root true))

  (s/then [result {:keys [repo-root]}]
    (is (nil? result))
    (is (= false (io/exists? repo-root)))))

(deftest install!/rejects-manifest-without-required-fields
  (s/given
    {:repo-root (support/fresh-repo! "loom-proof-install-invalid-manifest")
     :package-dir (support/fresh-package! "loom-proof-package-invalid-manifest"
                                          "{:description \"Bad package.\"}")})

  (s/when [{:keys [repo-root package-dir]}]
    (install/install! package-dir repo-root true))

  (s/then [result {:keys [repo-root]}]
    (is (nil? result))
    (is (= false (io/exists? repo-root)))))

(deftest install!/rejects-manifest-with-invalid-load-roots
  (s/given
    {:repo-root (support/fresh-repo! "loom-proof-install-invalid-load-roots")
     :package-dir (support/fresh-package! "loom-proof-package-invalid-load-roots"
                                          "{:name invalid :version \"0.1.0\" :load-roots \"src\"}")})

  (s/when [{:keys [repo-root package-dir]}]
    (install/install! package-dir repo-root true))

  (s/then [result {:keys [repo-root]}]
    (is (nil? result))
    (is (= false (io/exists? repo-root)))))
