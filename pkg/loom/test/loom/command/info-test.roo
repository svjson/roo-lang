(ns loom.command.info-test
  (:require proof.core
            [proof.syntax :as s]
            [loom.command.info :as info]
            [loom.command.install :as install]
            [loom.test-support :as support]))

(deftest returns-manifest-for-installed-package
  (s/given
    (let [repo-root (support/fresh-repo! "loom-proof-info")]
      (install/install! (support/loom-package-dir) repo-root true)
      repo-root))

  (s/when [repo-root]
    (info/info! repo-root "loom" "0.1.0"))

  (s/then [installed-manifest]
    (is (= "loom" (str (:name installed-manifest))))
    (is (= "0.1.0" (:version installed-manifest)))
    (is (= "Roo package manager." (:description installed-manifest)))))

(deftest returns-nil-for-missing-package
  (s/given
    {:repo-root (support/fresh-repo! "loom-proof-info-missing")
     :package-name "missing"})

  (s/when [{:keys [repo-root package-name]}]
    (info/info! repo-root package-name "0.1.0"))

  (s/then [missing-manifest]
    (is (nil? missing-manifest))))
