(ns loom.command.uninstall-test
  (:require proof.core
            [lisple.io :as io]
            [loom.core :as core]
            [loom.command.install :as install]
            [loom.command.uninstall :as uninstall]
            [loom.common.repository :as repository]
            [loom.test-support :as support]))

(deftest uninstall-removes-installed-package-version
  (given
    (let [repo-root (support/fresh-repo! "loom-proof-uninstall")]
      (install/install! (support/loom-package-dir) repo-root true)
      {:repo-root repo-root
       :target-dir (repository/package-target-dir repo-root "loom" "0.1.0")}))

  (when [{:keys [repo-root]}]
    (uninstall/uninstall! repo-root "loom" "0.1.0"))

  (then [uninstalled-dir {:keys [target-dir]}]
    (is (= target-dir uninstalled-dir))
    (is (= false (io/exists? target-dir)))))

(deftest uninstall-command-accepts-package-at-version
  (given
    (let [repo-root (support/fresh-repo! "loom-proof-uninstall-package-id")]
      (install/install! (support/loom-package-dir) repo-root true)
      {:repo-root repo-root
       :target-dir (repository/package-target-dir repo-root "loom" "0.1.0")}))

  (when [{:keys [repo-root]}]
    (core/uninstall-command ["uninstall" "loom@0.1.0" "--repo" repo-root]))

  (then [uninstall-package-id-result {:keys [target-dir]}]
    (is (= target-dir uninstall-package-id-result))
    (is (= false (io/exists? target-dir)))))

(deftest uninstall-returns-nil-for-missing-package
  (given
    {:repo-root (support/fresh-repo! "loom-proof-uninstall-missing")
     :package-id (repository/package-id "missing" "0.1.0")})

  (when [{:keys [repo-root]}]
    (uninstall/uninstall! repo-root "missing" "0.1.0"))

  (then [missing-removed-dir {:keys [package-id]}]
    (is (= "missing@0.1.0" package-id))
    (is (nil? missing-removed-dir))))
