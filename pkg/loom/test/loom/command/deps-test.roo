(ns loom.command.deps-test
  (:require proof.core
            [proof.syntax :as s]
            [loom.command.deps :as deps]))

(deftest renders-dependency-graph-as-tree
  (s/given
    {:id "app@0.1.0"
     :dependencies [{:id "alpha@1.0.0"
                     :dependencies [{:id "common@1.0.0"
                                     :dependencies []}]}
                    {:id "beta@1.0.0"
                     :dependencies []}]})

  (s/when [tree-root]
    (deps/tree-lines tree-root false))

  (s/then [rendered-tree]
    (is (= ["app@0.1.0"
            "├── alpha@1.0.0"
            "│   └── common@1.0.0"
            "└── beta@1.0.0"]
           rendered-tree))))

(deftest omits-repeated-marker-by-default
  (s/given
    {:id "app@0.1.0"
     :dependencies [{:id "left@1.0.0"
                     :dependencies [{:id "shared@1.0.0"
                                     :dependencies []}]}
                    {:id "right@1.0.0"
                     :dependencies [{:id "shared@1.0.0"
                                     :dependencies []}]}]})

  (s/when [default-repeated-root]
    (deps/tree-lines default-repeated-root false))

  (s/then [default-repeated-tree]
    (is (= ["app@0.1.0"
            "├── left@1.0.0"
            "│   └── shared@1.0.0"
            "└── right@1.0.0"
            "    └── shared@1.0.0"]
           default-repeated-tree))))

(deftest shows-repeated-marker-when-requested
  (s/given
    {:id "app@0.1.0"
     :dependencies [{:id "left@1.0.0"
                     :dependencies [{:id "shared@1.0.0"
                                     :dependencies []}]}
                    {:id "right@1.0.0"
                     :dependencies [{:id "shared@1.0.0"
                                     :dependencies []}]}]})

  (s/when [marked-repeated-root]
    (deps/tree-lines marked-repeated-root true))

  (s/then [marked-repeated-tree]
    (is (= ["app@0.1.0"
            "├── left@1.0.0"
            "│   └── shared@1.0.0"
            "└── right@1.0.0"
            "    └── shared@1.0.0 (*)"]
           marked-repeated-tree))))

(deftest renders-flat-dependency-list
  (s/given
    {:id "app@0.1.0"
     :dependencies [{:id "beta@1.0.0"
                     :dependencies []}
                    {:id "alpha@1.0.0"
                     :dependencies [{:id "common@1.0.0"
                                     :dependencies []}]}]})

  (s/when [flat-root]
    (deps/flat-lines flat-root))

  (s/then [flat-lines]
    (is (= ["alpha@1.0.0" "beta@1.0.0" "common@1.0.0"]
           flat-lines))))
