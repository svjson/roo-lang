(ns lookup.core
  (:require [lookup.docs :as docs]
            [lookup.index :as index]
            [lookup.package :as package]
            [lookup.source :as source]
            [lookup.symbols :as symbols]
            [lookup.thing-at :as thing-at]))

(def version package/version)

(def default-index-path "roo-symbols.edn")

(def source-file? source/source-file?)
(def source-files-in source/source-files-in)
(def manifest-path package/manifest-path)
(def read-manifest! package/read-manifest!)
(def package-info package/package-info)
(def package-load-roots package/package-load-roots)
(def source-files index/package-source-files)
(def normalized-path source/normalized-path)
(def normalized-source-location source/normalized-source-location)
(def source-form-entry source/source-form-entry)
(def source-entry source/source-entry)
(def source-form-index index/source-form-index)
(def empty-doc docs/empty-doc)
(def empty-return docs/empty-return)
(def list-form? symbols/list-form?)
(def symbol-name symbols/symbol-name)
(def form-head-name symbols/form-head-name)
(def form-named? symbols/form-named?)
(def ns-entry? symbols/ns-entry?)
(def ns-entry-name symbols/ns-entry-name)
(def source-namespace-entry symbols/source-namespace-entry)
(def source-namespace-name symbols/source-namespace-name)
(def starts-with? symbols/starts-with?)
(def rest-param-name? symbols/rest-param-name?)
(def clean-param-name symbols/clean-param-name)
(def param-info-step symbols/param-info-step)
(def params-info symbols/params-info)
(def signature-display symbols/signature-display)
(def signature-arity symbols/signature-arity)
(def function-signature symbols/function-signature)
(def qualified-name symbols/qualified-name)
(def base-symbol-entry symbols/base-symbol-entry)
(def def-symbol-entry symbols/def-symbol-entry)
(def defun-symbol-entry symbols/defun-symbol-entry)
(def symbol-entry symbols/symbol-entry)
(def source-symbols symbols/source-symbols)
(def symbol-index index/symbol-index)
(def read-stdin! thing-at/read-stdin!)
(def thing-at thing-at/thing-at)
