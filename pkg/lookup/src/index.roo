(ns lookup.index
  (:require [lookup.native-docs :as native-docs]
            [lookup.source :as source]
            [lookup.symbols :as symbols]))

(defun source-form-index
  "Build a source-form index for a package.

  Args:
  - `package-dir`: Package root containing `package.edn`.

  Returns:
  A `:roo/source-forms` index map with package metadata and parsed top-level
  forms."
  [package-dir]
  (let [manifest (source/read-manifest! package-dir)
        files (source/package-source-files package-dir manifest)]
    {:format :roo/source-forms
     :version 1
     :package (source/package-info manifest)
     :sources (map files source/source-entry)}))

(defun symbol-index-with-native-source-roots
  "Build a symbol index for a package.

  The symbol index includes namespace entries, top-level `def` and `defun`
  symbols, function signatures, source locations, and Roo docstrings when
  present.

  Args:
  - `package-dir`: Package root containing `package.edn`.

  Returns:
  A `:roo/symbol-index` map for editor lookup and documentation generation."
  [package-dir native-source-roots]
  (let [source-index (source-form-index package-dir)
        package-name (:name (:package source-index))
        sources (:sources source-index)]
    {:format :roo/symbol-index
     :version 1
     :package (:package source-index)
     :sources (map sources (fn [source] {:path (:path source)}))
     :namespaces (keep sources symbols/source-namespace-entry)
     :symbols (concat
                (flatten
                  (map sources
                       (fn [source]
                         (symbols/source-symbols package-name source))))
                (native-docs/package-native-symbol-entries! package-dir package-name)
                (native-docs/native-source-root-symbol-entries!
                  package-name
                  native-source-roots))}))

(defun symbol-index
  "Build a symbol index for a package.

  The symbol index includes namespace entries, top-level `def` and `defun`
  symbols, function signatures, source locations, Roo docstrings, and package
  native documentation when present.

  Args:
  - `package-dir`: Package root containing `package.edn`.

  Returns:
  A `:roo/symbol-index` map for editor lookup and documentation generation."
  [package-dir]
  (symbol-index-with-native-source-roots package-dir []))


(defun native-source-root-index
  "Build a native-only symbol index from C/C++ source roots."
  [native-source-roots]
  (let [roots (map native-source-roots source/normalized-path)
        native-files (sort
                       (flatten
                         (map native-source-roots
                              native-docs/native-source-root-files))
                       <)
        native-symbols (native-docs/native-source-root-symbol-entries!
                         nil
                         native-source-roots)]
    {:format :roo/symbol-index
     :version 1
     :origin {:kind :native-source-roots
              :roots roots}
     :sources (map native-files (fn [path] {:path path}))
     :namespaces []
     :symbols native-symbols}))

(defun index-with-options
  "Build an index using parsed CLI options."
  [options]
  (let [package-dir (:package-dir options)
        extractors (:extractors options)
        native-source-roots (:native-source-roots options)
        forms? (contains? extractors :forms)
        symbols? (contains? extractors :symbols)]
    (cond

      (nil? package-dir)
      (native-source-root-index native-source-roots)

      (and forms? symbols?)
      (let [forms-index (source-form-index package-dir)
            symbols-index (symbol-index-with-native-source-roots
                            package-dir
                            native-source-roots)]
        {:format :roo/index
         :version 1
         :package (:package symbols-index)
         :forms forms-index
         :symbols symbols-index})

      forms?
      (source-form-index package-dir)

      symbols?
      (symbol-index-with-native-source-roots package-dir native-source-roots)

      true
      (symbol-index-with-native-source-roots package-dir native-source-roots))))

(defun index-with-extractors
  "Build an index using the requested extractors.

  Args:
  - `package-dir`: Package root containing `package.edn`.
  - `extractors`: Vector containing `:forms`, `:symbols`, or both.

  Returns:
  A source-form index, a symbol index, or a combined `:roo/index` map."
  [package-dir extractors]
  (let [forms? (contains? extractors :forms)
        symbols? (contains? extractors :symbols)]
    (cond

      (and forms? symbols?)
      (let [forms-index (source-form-index package-dir)
            symbols-index (symbol-index package-dir)]
        {:format :roo/index
         :version 1
         :package (:package symbols-index)
         :forms forms-index
         :symbols symbols-index})

      forms?
      (source-form-index package-dir)

      symbols?
      (symbol-index package-dir)

      true
      (symbol-index package-dir))))
