(ns lookup.index
  (:require [lookup.source :as source]
            [lookup.symbols :as symbols]))

(defun source-form-index [package-dir]
  (let [manifest (source/read-manifest! package-dir)
        files (source/package-source-files package-dir manifest)]
    {:format :roo/source-forms
     :version 1
     :package (source/package-info manifest)
     :sources (map files source/source-entry)}))

(defun symbol-index [package-dir]
  (let [source-index (source-form-index package-dir)
        package-name (:name (:package source-index))
        sources (:sources source-index)]
    {:format :roo/symbol-index
     :version 1
     :package (:package source-index)
     :sources (map sources (fn [source] {:path (:path source)}))
     :namespaces (keep sources symbols/source-namespace-entry)
     :symbols (flatten
                (map sources
                     (fn [source]
                       (symbols/source-symbols package-name source))))}))

(defun index-with-extractors [package-dir extractors]
  (let [forms? (contains? extractors :forms)
        symbols? (contains? extractors :symbols)]
    (cond

      (and forms? symbols?)
      (let [forms-index (source-form-index package-dir)
            symbols-index (symbol-index package-dir)]
        {:format :roo/index
         :version 1
         :package (:package symbols-index)
         :forms forms-index
         :symbols symbols-index})

      forms?
      (source-form-index package-dir)

      symbols?
      (symbol-index package-dir)

      true
      (symbol-index package-dir))))
