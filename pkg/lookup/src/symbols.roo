(ns lookup.symbols
  (:require [lookup.docstrings :as docstrings]
            [roo.string :as string]))

(defun form-head-name [form]
  (when (= "list" (type-of form))
    (str (head form))))

(defun source-namespace-entry
  "Extract a namespace entry from a source-form index entry.

  Args:
  - `source`: Source-form index entry with parsed top-level forms.

  Returns:
  A namespace map when the source contains an `ns` form; otherwise `nil`."
  [source]
  (let [entry (find-first (:forms source)
                          (fn [entry]
                            (= "ns" (form-head-name (:form entry)))))]
    (when (not (nil? entry))
      {:name (str (nth (:form entry) 1))
       :doc (docstrings/empty)
       :source (:source entry)})))

(defun source-namespace-name [source]
  (or (:name (source-namespace-entry source)) "user"))

(defun rest-param-name? [name]
  (and (string/starts-with? name "&")
       (not= name "&")))

(defun clean-param-name [name]
  (if (rest-param-name? name)
    (substr name 1 (count name))
    name))

(defun param-info-step [state raw-param]
  (let [display-name (str raw-param)
        rest? (rest-param-name? display-name)]
    (case display-name
      "&" {:optional? true
           :params (:params state)}
      :default {:optional? (:optional? state)
                :params (concat (:params state)
                                [{:name (clean-param-name display-name)
                                  :display display-name
                                  :type nil
                                  :doc nil
                                  :optional? (or (:optional? state) rest?)
                                  :rest? rest?}])})))

(defun params-info [raw-params]
  (:params (reduce raw-params {:optional? false :params []} param-info-step)))

(defun signature-display [name raw-params]
  (let [param-names (map raw-params str)
        params-display (apply join (concat [" "] param-names))]
    (if (empty? param-names)
      (str "(" name ")")
      (str "(" name " " params-display ")"))))

(defun signature-arity [params]
  (let [variadic? (not (nil? (find-first params (fn [param] (:rest? param)))))
        required-params (filter params
                                (fn [param]
                                  (and (not (:optional? param))
                                       (not (:rest? param)))))]
    {:min (count required-params)
     :max (unless variadic? (count params))
     :variadic variadic?}))

(defun function-signature
  "Build lookup signature data for a Roo function.

  Args:
  - `name`: Function name.
  - `raw-params`: Roo parameter vector from a `defun` form.

  Returns:
  A signature map with display text, parameters, return placeholder, and arity."
  [name raw-params]
  (let [params (params-info raw-params)]
    {:display (signature-display name raw-params)
     :params (map params
                  (fn [param]
                    {:name (:name param)
                     :type (:type param)
                     :doc (:doc param)
                     :optional? (:optional? param)
                     :rest? (:rest? param)}))
     :returns {:type nil
               :doc nil}
     :arity (signature-arity params)}))

(defun function-signature-with-doc [name raw-params doc]
  (let [signature (function-signature name raw-params)
        param-docs (:params doc)
        return-doc (:returns doc)]
    (assoc signature
           :params
           (map (:params signature)
                (fn [param]
                  (if-let [param-doc (get param-docs (:name param))]
                    (assoc param
                           :type (:type param-doc)
                           :doc (:doc param-doc))
                    param)))
           :returns
           (if (nil? return-doc)
             (:returns signature)
             return-doc))))

(defun base-symbol-entry [package namespace name kind source]
  (let [qualified-name (str namespace "/" name)]
    {:id qualified-name
     :name name
     :qualified-name qualified-name
     :namespace namespace
     :package package
     :kind kind
     :origin :source
     :visibility :public
     :status :stable
     :source source
     :doc-source nil
     :doc (docstrings/empty)}))

(defun def-symbol-entry [package namespace entry]
  (let [form (:form entry)
        name (str (nth form 1))
        docstring (when (string? (nth form 2)) (nth form 2))
        doc (if (nil? docstring)
              (docstrings/empty)
              (docstrings/from-string docstring))]
    (merge (base-symbol-entry package namespace name :var (:source entry))
           {:doc doc
            :doc-source (when (not (nil? docstring))
                          {:kind :roo-docstring
                           :source (:source entry)})
            :signatures []})))

(defun defun-symbol-entry [package namespace entry]
  (let [form (:form entry)
        name (str (nth form 1))
        docstring (when (string? (nth form 2)) (nth form 2))
        params (if (nil? docstring) (nth form 2) (nth form 3))
        doc (if (nil? docstring)
              (docstrings/empty)
              (docstrings/from-string docstring))]
    (merge (base-symbol-entry package namespace name :function (:source entry))
           {:doc doc
            :doc-source (when (not (nil? docstring))
                          {:kind :roo-docstring
                           :source (:source entry)})
            :signatures [(function-signature-with-doc name params doc)]})))

(defun symbol-entry [package namespace entry]
  (let [form (:form entry)
        head-name (form-head-name form)]
    (cond

      (= head-name "def")
      (def-symbol-entry package namespace entry)

      (= head-name "defun")
      (defun-symbol-entry package namespace entry)

      true
      nil)))

(defun source-symbols
  "Extract top-level symbols from a source-form index entry.

  Args:
  - `package`: Package name used for symbol index entries.
  - `source`: Source-form index entry with parsed top-level forms.

  Returns:
  A vector of lookup symbol entries for supported top-level forms."
  [package source]
  (let [namespace (source-namespace-name source)]
    (keep (:forms source)
          (fn [entry]
            (symbol-entry package namespace entry)))))
