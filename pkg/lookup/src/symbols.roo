(ns lookup.symbols)

(defun empty-doc []
  {:summary nil
   :body nil
   :format :plain
   :params {}
   :returns nil
   :examples []
   :see []})

(defun empty-return []
  {:type nil
   :doc nil})

(defun list-form? [form]
  (= "list" (type-of form)))

(defun symbol-name [symbol]
  (str symbol))

(defun form-head-name [form]
  (if (list-form? form)
    (symbol-name (head form))
    nil))

(defun form-named? [form name]
  (= name (form-head-name form)))

(defun ns-entry? [entry]
  (form-named? (:form entry) "ns"))

(defun ns-entry-name [entry]
  (symbol-name (nth (:form entry) 1)))

(defun source-namespace-entry [source]
  (let [entry (find-first (:forms source) ns-entry?)]
    (if (nil? entry)
      nil
      {:name (ns-entry-name entry)
       :doc (empty-doc)
       :source (:source entry)})))

(defun source-namespace-name [source]
  (let [entry (source-namespace-entry source)]
    (if (nil? entry)
      "user"
      (:name entry))))

(defun starts-with? [text prefix]
  (if (< (count text) (count prefix))
    false
    (= prefix (substr text 0 (count prefix)))))

(defun rest-param-name? [name]
  (and (starts-with? name "&")
       (not (= name "&"))))

(defun clean-param-name [name]
  (if (rest-param-name? name)
    (substr name 1 (count name))
    name))

(defun param-info-step [state raw-param]
  (let [display-name (symbol-name raw-param)
        rest? (rest-param-name? display-name)]
    (if (= display-name "&")
      {:optional? true
       :params (:params state)}
      {:optional? (:optional? state)
       :params (concat (:params state)
                       [{:name (clean-param-name display-name)
                         :display display-name
                         :type nil
                         :doc nil
                         :optional? (or (:optional? state) rest?)
                         :rest? rest?}])})))

(defun params-info [raw-params]
  (:params (reduce raw-params {:optional? false :params []} param-info-step)))

(defun signature-display [name raw-params]
  (let [param-names (map raw-params symbol-name)
        params-display (apply join (concat [" "] param-names))]
    (if (= 0 (count param-names))
      (str "(" name ")")
      (str "(" name " " params-display ")"))))

(defun signature-arity [params]
  (let [variadic? (not (nil? (find-first params (fn [param] (:rest? param)))))
        required-params (filter params
                                (fn [param]
                                  (and (not (:optional? param))
                                       (not (:rest? param)))))]
    {:min (count required-params)
     :max (if variadic? nil (count params))
     :variadic variadic?}))

(defun function-signature [name raw-params]
  (let [params (params-info raw-params)]
    {:display (signature-display name raw-params)
     :params (map params
                  (fn [param]
                    {:name (:name param)
                     :type (:type param)
                     :doc (:doc param)
                     :optional? (:optional? param)
                     :rest? (:rest? param)}))
     :returns (empty-return)
     :arity (signature-arity params)}))

(defun qualified-name [namespace name]
  (str namespace "/" name))

(defun base-symbol-entry [package namespace name kind source]
  {:id (qualified-name namespace name)
   :name name
   :qualified-name (qualified-name namespace name)
   :namespace namespace
   :package package
   :kind kind
   :origin :source
   :visibility :public
   :status :stable
   :source source
   :doc-source nil
   :doc (empty-doc)})

(defun def-symbol-entry [package namespace entry]
  (let [form (:form entry)
        name (symbol-name (nth form 1))]
    (merge (base-symbol-entry package namespace name :var (:source entry))
           {:signatures []})))

(defun defun-symbol-entry [package namespace entry]
  (let [form (:form entry)
        name (symbol-name (nth form 1))
        params (nth form 2)]
    (merge (base-symbol-entry package namespace name :function (:source entry))
           {:signatures [(function-signature name params)]})))

(defun symbol-entry [package namespace entry]
  (let [form (:form entry)
        head-name (form-head-name form)]
    (cond

      (= head-name "def")
      (def-symbol-entry package namespace entry)

      (= head-name "defun")
      (defun-symbol-entry package namespace entry)

      true
      nil)))

(defun source-symbols [package source]
  (let [namespace (source-namespace-name source)]
    (filter
      (map (:forms source)
           (fn [entry]
             (symbol-entry package namespace entry)))
      (fn [entry]
        (not (nil? entry))))))
