(ns lookup.audit)



;; Option Constants

(def DEFAULT-OPTIONS
  "Default validation requirements for a Lookup audit."
  {:require-summary? false
   :require-param-docs? false
   :require-signatures? false
   :allow-zero-arity []
   :fail-on nil})



;; Utility functions

(defun symbol-id [symbol]
  (or (:qualified-name symbol)
      (:id symbol)
      (:name symbol)))



;; Diagnostic construction

(defun diagnostic [kind symbol message details]
  (merge {:severity :warning
          :kind kind
          :symbol (symbol-id symbol)
          :message message}
         details))

(defun summary-diagnostics [symbol options]
  (cond-> []
    (and (:require-summary? options)
         (blank? (:summary symbol)))
    (append (diagnostic :missing-doc-summary symbol
                   "Missing documentation summary." {}))))

(defun signature-diagnostics [symbol {:keys [params] :as signature} options]
  (cond-> []

    (and (:require-signatures? options)
         (empty? params)
         (not (contains? (:allow-zero-arity options) (symbol-id symbol))))
    (append (diagnostic :zero-arity-signature symbol
                        "Documented signature has no parameters."
                        {:signature (:display signature)}))

    (:require-param-docs? options)
    (concat (keep params
                  (fn [param] (when (empty? (:content param))
                                (diagnostic :missing-param-doc symbol
                                            "Missing parameter documentation."
                                            {:signature (:display signature)
                                             :param (:name param)})))))))

(defun signatures-diagnostics [{:keys [signatures] :as symbol} options]
  (cond
    (not (contains? [:function :special-form] (:kind symbol)))
    []

    (and (:require-signatures? options)
         (empty? signatures))
    [(diagnostic :missing-signatures symbol
                 "Function or special form has no documented signatures."
                 {})]

    :default
    (flat-map signatures
              (fn [signature]
                (signature-diagnostics symbol signature options)))))



;; Severity & pass/fail

(defun severity-rank [severity]
  (case severity
    :error 2
    :warning 1
    :default 0))

(defun diagnostic-fails? [diagnostic fail-on]
  (and (keyword? fail-on)
       (>= (severity-rank (:severity diagnostic))
           (severity-rank fail-on))))

(defun audit-failed? [diagnostics options]
  (any? diagnostics
        (fn [diagnostic]
          (diagnostic-fails? diagnostic (:fail-on options)))))



;; Public API

(defun symbol-index
  "Audit a lookup symbol index and return diagnostic data.

   Args:
   - `index`: A lookup symbol index map.
   - `options`: Audit options. Supported keys are `:require-summary?`,
     `:require-param-docs?`, `:require-signatures?`, `:allow-zero-arity`,
     and `:fail-on`.

   Returns:
   A `:roo/lookup-audit` map with diagnostics."
  [index options]
  (let [effective-options (merge DEFAULT-OPTIONS options)
        diagnostics (flat-map (:symbols index)
                              (fn [symbol]
                                (concat
                                 (summary-diagnostics symbol effective-options)
                                 (signatures-diagnostics symbol
                                                         effective-options))))]
    {:format :roo/lookup-audit
     :version 1
     :diagnostics diagnostics
     :failed? (audit-failed? diagnostics effective-options)}))
