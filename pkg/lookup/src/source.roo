(ns lookup.source
  (:require [roo.io :as io]
            [roo.string :as string]
            [lookup.reader :as reader]))

(defun manifest-path [package-dir]
  (io/join-path package-dir "package.edn"))

(defun read-manifest!
  "Read a package manifest from a package directory.

  Args:
  - `package-dir`: Package root containing `package.edn`.

  Returns:
  The parsed package manifest map."
  [package-dir]
  (io/slurp-edn! (manifest-path package-dir)))

(defun package-info
  "Build package metadata for lookup indexes.

  Args:
  - `manifest`: Parsed package manifest map.

  Returns:
  A map with package `:name`, `:version`, and `:description`."
  [manifest]
  {:name (str (:name manifest))
   :version (:version manifest)
   :description (:description manifest)})

(defun package-load-roots [manifest]
  (if (nil? (:load-roots manifest))
    ["src"]
    (:load-roots manifest)))

(defun source-file?
  "Test whether a path names a Roo source file.

  Args:
  - `path`: File path to inspect.

  Returns:
  `true` when the path extension is `.roo`; otherwise `false`."
  [path]
  (= ".roo" (io/extension path)))

(defun source-entry?
  [entry metadata]
  (and (= (:type entry) :file)
       (source-file? (:relative-path metadata))))

(defun source-files-in [root]
  (if (io/directory? root)
    (for [result (io/walk! root {:keep? source-entry?})]
      (:path (:entry result)))
    []))

(defun normalized-path [path]
  (string/replace (str path) "\\" "/"))

(defun source-form-entry [{:keys [source] :as entry}]
  (if source
    (assoc-in entry [:source :path] (normalized-path (:path source)))
    (assoc entry :source {:path (normalized-path (:path entry))})))

(defun source-entry
  "Read one source file into a source-form index entry.

  Args:
  - `path`: Roo source file path.

  Returns:
  A map containing normalized `:path` and parsed top-level `:forms`."
  [path]
  {:path (normalized-path path)
   :forms (map (reader/read-file-forms! path) source-form-entry)})

(defun package-source-files
  "Find all Roo source files declared by a package manifest.

  Args:
  - `package-dir`: Package root containing the source roots.
  - `manifest`: Parsed package manifest map.

  Returns:
  A sorted vector of source file paths."
  [package-dir manifest]
  (sort
    (flat-map (package-load-roots manifest)
              (fn [root]
                (source-files-in (io/join-path package-dir (str root)))))
    <))
