(ns lookup.source
  (:require [roo.io :as io]
            [roo.string :as string]
            [lookup.reader :as reader]))

(defun manifest-path [package-dir]
  (io/join-path package-dir "package.edn"))

(defun read-manifest! [package-dir]
  (io/slurp-edn! (manifest-path package-dir)))

(defun package-info [manifest]
  {:name (str (:name manifest))
   :version (:version manifest)
   :description (:description manifest)})

(defun package-load-roots [manifest]
  (if (nil? (:load-roots manifest))
    ["src"]
    (:load-roots manifest)))

(defun source-file? [path]
  (= ".roo" (io/extension path)))

(defun source-files-in [root]
  (if (io/directory? root)
    (let [entries (io/list-directory! root)
          files (map (filter entries
                             (fn [entry]
                               (and (= (:type entry) :file)
                                    (source-file? (:path entry)))))
                     :path)
          directories (filter entries (fn [entry] (= (:type entry) :directory)))]
      (concat files
              (flatten
                (map directories
                     (fn [entry]
                       (source-files-in (:path entry)))))))
    []))

(defun normalized-path [path]
  (string/replace (str path) "\\" "/"))

(defun normalized-source-location [source]
  (assoc source :path (normalized-path (:path source))))

(defun source-form-entry [entry]
  (assoc entry :source (normalized-source-location (:source entry))))

(defun source-entry [path]
  {:path (normalized-path path)
   :forms (map (reader/read-file-forms! path) source-form-entry)})

(defun package-source-files [package-dir manifest]
  (sort
    (flatten
      (map (package-load-roots manifest)
           (fn [root]
             (source-files-in (io/join-path package-dir (str root))))))
    <))
