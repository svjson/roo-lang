(ns lookup.command.audit
  (:require [roo.io :as io]
            [lookup.audit :as audit]
            [lookup.index :as index]
            [lookup.system :as system]))

(defun audit-index!
  "Load or build the symbol index selected by audit options.

  Args:
  - `options`: Audit options containing `:input`, source roots, and exclusions.

  Returns:
  A Roo symbol index artifact. Raises an error when the input does not exist."
  [{:keys [input] :as options}]
  (cond
    (io/file? input)
    (io/slurp-edn! input)

    (and (io/directory? input)
         (io/exists? (io/join-path input "package.edn")))
    (index/index-with-options {:extractors [:symbols]
                               :out nil
                               :package-dir input
                               :roots (:roots options)
                               :excludes (:excludes options)
                               :errors []})

    (io/directory? input)
    (index/root-index {:roots (concat [input] (:roots options))
                       :excludes (:excludes options)
                       :extractors [:native]})

    true
    (system/fail! (str "lookup audit input does not exist: " input))))

(defun diagnostic-extra
  "Format optional signature and parameter context for an audit diagnostic.

  Args:
  - `diagnostic`: One audit diagnostic map.

  Returns:
  A bracketed context suffix, or an empty string when no context is present."
  [diagnostic]
  (cond
    (and (:signature diagnostic)
         (:param diagnostic))
    (str " [" (:signature diagnostic) ", param: " (:param diagnostic) "]")

    (:signature diagnostic)
    (str " [" (:signature diagnostic) "]")

    (:param diagnostic)
    (str " [param: " (:param diagnostic) "]")

    true
    ""))

(defun diagnostic-line
  "Render one audit diagnostic as a text line.

  Args:
  - `diagnostic`: One audit diagnostic map.

  Returns:
  A human-readable diagnostic string."
  [diagnostic]
  (str (name (:severity diagnostic))
       " "
       (name (:kind diagnostic))
       " "
       (:symbol diagnostic)
       ": "
       (:message diagnostic)
       (diagnostic-extra diagnostic)))

(defun text-lines
  "Render an audit result as text output.

  Args:
  - `result`: Roo lookup-audit artifact.

  Returns:
  A vector of human-readable audit output lines."
  [result]
  (let [diagnostics (:diagnostics result)
        diagnostic-count (count diagnostics)]
    (case diagnostic-count
      0 ["lookup audit: no diagnostics"]
      :default (concat [(str "lookup audit: "
                             diagnostic-count
                             " "
                             (case diagnostic-count
                               1 "diagnostic"
                               :default "diagnostics"))]
                       (map diagnostics diagnostic-line)
                       [(if (:failed? result)
                          "lookup audit: failed"
                          "lookup audit: passed")]))))

(defun execute!
  "Audit the selected index or source input and emit the requested format.

  Args:
  - `context`: CLI invocation context; audit execution does not inspect it.
  - `options`: Validated audit command options.

  Returns:
  The Roo lookup-audit artifact. Raises a process failure when its configured
  threshold is reached."
  [_context options]
  (let [result (audit/symbol-index (audit-index! options) options)
        output (case (:format options)
                 :text (text-lines result)
                 :default result)]
    (case (:format options)
      :text (map output prn!)
      :default (prn! output))
    (when (:failed? result)
      (system/fail! "lookup audit failed"))
    result))

(def command
  "cli-trooper declaration for the `lookup audit` command."
  {:description "Audit documentation in a Roo index or source tree."
   :mixin :source-paths
   :execute! execute!
   :flags {["o" "output-format"] {:type :enum
                                   :values ["edn" "text"]
                                   :destination :format
                                   :default :edn}
           "require-summary" {:type :flag
                              :destination :require-summary?
                              :default false}
           "require-param-docs" {:type :flag
                                 :destination :require-param-docs?
                                 :default false}
           "require-signatures" {:type :flag
                                 :destination :require-signatures?
                                 :default false}
           "allow-zero-arity" {:type :symbol
                               :repeatable? true
                               :default []}
           "fail-on" {:type :enum
                      :values ["warning" "error"]
                      :default nil}}
   :positional [{:type :path
                 :name "index-file|source-root|package-dir"
                 :destination :input}]})
