(ns lookup.command.index
  (:require [roo.io :as io]
            [lookup.index :as index]
            [lookup.index.incremental :as incremental]))

(defun validation-errors
  "Validate semantic constraints between lookup index options.

  Args:
  - `options`: Fully parsed index command options.

  Returns:
  A vector containing the first semantic diagnostic, or an empty vector when
  the options describe a supported indexing operation."
  [options]
  (let [has-package? (some? (:package-dir options))
        has-roots? (not-empty? (:roots options))
        state? (some? (:state options))]
    (cond
      (and (or (:package-version options)
               (:package-description options))
           (nil? (:package-name options)))
      [{:kind :package-name-required
        :message "Package name required for package metadata"}]

      (and (not has-package?) (not has-roots?))
      [{:kind :index-input-required
        :message "Missing package directory or root"}]

      (and (contains? (:extractors options) :forms)
           (not has-package?))
      [{:kind :package-dir-required
        :extractor :forms
        :message "Package directory required for forms extractor"}]

      (and (contains? (:extractors options) :native)
           (not has-roots?))
      [{:kind :root-required
        :extractor :native
        :message "Root required for native extractor"}]

      (and (not-empty? (:updates options)) (not state?))
      [{:kind :state-required
        :argument "--update"
        :message "--update requires --state"}]

      (and (some? (:emit-delta options)) (not state?))
      [{:kind :state-required
        :argument "--emit-delta"
        :message "--emit-delta requires --state"}]

      (and state?
           (or (not has-package?)
               has-roots?
               (not= [:symbols] (:extractors options))))
      [{:kind :invalid-incremental-options
        :message "Incremental state currently requires one package directory and the symbols extractor"}]

      true
      [])))

(defun execute!
  "Build an index artifact and print or write the requested representation.

  Args:
  - `context`: CLI invocation context; index execution does not inspect it.
  - `options`: Validated index command options.

  Returns:
  The generated index snapshot or delta."
  [_context options]
  (if (:state options)
    (let [result (incremental/index-with-state options)
          snapshot (:snapshot result)
          value (if (:emit-delta options) (:delta result) snapshot)]
      (when-let [out (:out options)]
        (io/spit! out (str snapshot "\n")))
      (when (or (nil? (:out options)) (:emit-delta options))
        (prn! value))
      value)
    (let [value (index/index-with-options options)]
      (if-let [out (:out options)]
        (io/spit! out (str value "\n"))
        (prn! value))
      value)))

(def command
  "cli-trooper declaration for the `lookup index` command."
  {:description "Build a Roo index artifact."
   :mixin :source-paths
   :execute! execute!
   :validate validation-errors
   :flags {"x" {:type :enum
                 :name "extractor"
                 :values ["forms" "symbols" "native"]
                 :repeatable? true
                 :destination :extractors
                 :default (fn [options]
                            (if (:package-dir options)
                              [:symbols]
                              [:native]))}
           ["o" "out"] {:type :file
                         :default nil}
           "package-name" {:type :string
                           :name "name"
                           :default nil}
           "package-version" {:type :string
                              :name "version"
                              :default nil}
           "package-description" {:type :text
                                  :default nil}
           "state" {:type :dir
                    :default nil}
           "update" {:type :file
                     :repeatable? true
                     :destination :updates
                     :default []}
           "emit-delta" {:type :enum
                         :values ["edn"]
                         :default nil}}
   :positional [{:type :dir
                 :name "package-dir"
                 :optional? true
                 :default nil}]})
