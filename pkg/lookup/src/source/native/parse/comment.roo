(ns lookup.source.native.parse.comment
  (:require [lookup.doc :as doc]
            [roo.string :as string]))



;; Comment Text

(defun strip-suffix [text suffix]
  (cond-> text
          (string/ends-with? text suffix)
          (substr 0 (- (count text) (count suffix)))))

(defun strip-first-prefix [text prefixes]
  (if-let [prefix (find-first prefixes
                              (fn [candidate]
                                (string/starts-with? text candidate)))]
    (trim (substr text (count prefix)))
    text))

(defun strip-line [line]
  (-> (trim line)
      (strip-first-prefix ["/**" "/*!" "/*"])
      (strip-suffix "*/")
      (strip-first-prefix ["*"])))

(defun lines [text]
  (map (split text "\n") strip-line))



;; Roo Annotations

(defun directive-value [line directive]
  (let [trimmed (trim line)
        prefix (str directive " ")]
    (when (string/starts-with? trimmed prefix)
      (trim (substr trimmed (count prefix) (count trimmed))))))

(defun annotation
  "Parse an explicit Roo symbol annotation from a native block comment.

  Args:
  - `text`: Complete native block-comment text.

  Returns:
  The annotated symbol identity and kind, or `nil` when the annotation is
  incomplete or invalid."
  [text]
  (let [comment-lines (lines text)
        qualified-name (find-first
                         (keep comment-lines
                               (fn [line]
                                 (directive-value line "@roo.symbol")))
                         not-empty?)
        kind-name (find-first
                    (keep comment-lines
                          (fn [line]
                            (directive-value line "@roo.kind")))
                    not-empty?)
        native-kind (when kind-name (keyword kind-name))
        separator (when qualified-name
                    (find-index qualified-name
                                (fn [character]
                                  (= "/" (str character)))))]
    (when (and separator
               (< 0 separator)
               (< separator (- (count qualified-name) 1))
               (contains? [:function :special-form :macro :var :constant]
                          native-kind))
      {:qualified-name qualified-name
       :native-kind native-kind})))

(defun namespace-annotation
  "Parse an explicit Roo namespace annotation from a native block comment.

  Args:
  - `text`: Complete native block-comment text.

  Returns:
  The annotated namespace name, or `nil` when none is declared."
  [text]
  (when-let [name (find-first
                    (keep (lines text)
                          (fn [line]
                            (directive-value line "@roo.namespace")))
                    not-empty?)]
    {:name name}))



;; Source Recognition

(defun append-annotation-text [current value]
  (cond
    (nil? current) value
    (blank? value) current
    (blank? current) value
    true (str current "\n" value)))

(defun arg-row [line]
  (let [trimmed (trim line)]
    (when (string/starts-with? trimmed "|")
      (let [content (strip-suffix (substr trimmed 1 (count trimmed)) "|")
            separator (find-index content
                                  (fn [character]
                                    (= "|" (str character))))]
        (when separator
          (let [arg (trim (substr content 0 separator))
                content (trim (substr content (+ separator 1) (count content)))]
            (cond
              (contains? ["Arg #" "Arg" "Param" "Parameter" "Name"] arg)
              {:kind :header}

              (string/starts-with? arg "---")
              {:kind :separator}

              (blank? arg)
              (unless (blank? content)
                {:kind :continuation
                 :content content})

              true
              {:kind :param
               :name arg
               :content content})))))))

(defun param-directive [line]
  (when-let [content (directive-value line "@param")]
    (if-let [separator (find-index content
                                  (fn [character]
                                    (contains? [" " "\t"] (str character))))]
      {:name (doc/strip-backticks (substr content 0 separator))
       :content (trim (substr content (+ separator 1) (count content)))}
      {:name (doc/strip-backticks content)
       :content ""})))

(defun return-text [line]
  (or (directive-value line "@returns")
      (directive-value line "@return")
      (when (contains? ["@return" "@returns"] (trim line)) "")))

(defun header? [line]
  (let [trimmed (trim line)]
    (and (not (blank? trimmed))
         (string/ends-with? trimmed ":"))))

(defun code-language [line offset]
  (let [language (trim (substr (trim line) offset))]
    (unless (or (blank? language) (= "roo" language))
      (keyword language))))



;; Ordered Content

(defun append-target-block [state block]
  (case (:target state)
    :param (update-in state
                      [:signature-docs (:signature-index state)
                       :params (:target-name state) :content]
                      [append block])
    :return (update-in state
                       [:signature-docs (:signature-index state) :returns :content]
                       [append block])
    :default (update state :content [append block])))

(defun finish-text [{:keys [text-lines] :as state}]
  (if (empty? text-lines)
    state
    (let [block {:kind :text
                 :content (apply join (concat ["\n"] text-lines))}]
      (cond-> (assoc (append-target-block state block)
                     :text-lines []
                     :brief? false)
              (or (:brief? state)
                  (and (= :root (:target state))
                       (nil? (:summary state))))
              (assoc :summary (:content block))))))

(defun append-header [state line]
  (append-target-block (finish-text state)
                       {:kind :header
                        :content (trim line)}))

(defun start-code [state language end-marker]
  (assoc (finish-text state)
         :code {:language language
                :end-marker end-marker
                :lines []}))

(defun finish-code [state]
  (let [code (:code state)
        source (apply join (concat ["\n"] (:lines code)))
        block (if (:language code)
                {:kind :code
                 :language (:language code)
                 :content source}
                {:kind :code
                 :content source})]
    (assoc (append-target-block state block) :code nil)))

(defun finish-block [state]
  (-> state
      finish-text
      (assoc :target (case (:target state) :return :return :default :root)
             :target-name nil
             :boundary? true
             :param-sequence? false
             :table? false)))

(defun start-args [state]
  (let [current-index (:signature-index state)
        current (when current-index
                  (nth (:signature-docs state) current-index))
        new? (or (nil? current-index)
                 (contains? current :params))
        index (if new?
                (count (:signature-docs state))
                current-index)
        started (if new?
                  (update state :signature-docs
                          [append {:params {}
                                   :param-order []}])
                  (assoc-in state
                            [:signature-docs index :params] {}
                            [:signature-docs index :param-order] []))]
    (assoc started
           :signature-index index
           :content (append (:content state) {:kind :sig-args :index index}))))

(defun start-param [state name content]
  (let [state (finish-text state)
        index (:signature-index state)
        order (get-in state [:signature-docs index :param-order])]
    (assoc-in state
              [:signature-docs index :param-order]
              (cond-> order
                      (not (contains? order name))
                      (append name))
              [:target] :param
              [:target-name] name
              [:text-lines] (cond-> []
                                    (not (blank? content))
                                    (append content))
              [:boundary?] false)))

(defun start-return [state content]
  (let [state (finish-text state)
        current-index (:signature-index state)
        current (when current-index
                  (nth (:signature-docs state) current-index))
        new? (or (nil? current-index)
                 (contains? current :returns))
        index (if new?
                (count (:signature-docs state))
                current-index)
        started (if new?
                  (update state :signature-docs
                          [append {:returns {:content []}}])
                  (assoc-in state
                            [:signature-docs index :returns] {:content []}))]
    (assoc started
           :signature-index index
           :content (append (:content state) {:kind :sig-ret :index index})
           :return-index index
           :return-count (+ (:return-count state) 1)
           :target :return
           :target-name nil
           :text-lines (cond-> []
                               (not (blank? content))
                               (append content))
           :boundary? false
           :param-sequence? false)))



;; Parsing

(defun step [{:keys [code boundary? target] :as state} line]
  (let [trimmed (trim line)
        row (arg-row line)
        param (param-directive line)
        return (return-text line)
        brief (directive-value line "@brief")
        see (directive-value line "@see")
        since (directive-value line "@since")
        deprecated (directive-value line "@deprecated")]
    (cond
      code
      (if (or (and (= :directive (:end-marker code)) (= "@endcode" trimmed))
              (and (= :fence (:end-marker code))
                   (string/starts-with? trimmed "```")))
        (assoc (finish-code state) :boundary? false)
        (assoc-in state [:code :lines] (append (:lines code) trimmed)))

      (blank? trimmed)
      (finish-block state)

      (string/starts-with? trimmed "@code")
      (start-code state (code-language line 5) :directive)

      (string/starts-with? trimmed "```")
      (start-code state (code-language line 3) :fence)

      brief
      (assoc (finish-text state)
             :target :root
             :text-lines [brief]
             :brief? true
             :boundary? false
             :param-sequence? false)

      row
      (case (:kind row)
        :header (assoc (start-args (finish-text state))
                       :target :args
                       :target-name nil
                       :boundary? true
                       :param-sequence? false
                       :table? true)
        :separator state
        :continuation (cond-> state
                             (and (:table? state) (= :param target))
                             (assoc :text-lines
                                    (append (:text-lines state) (:content row))
                                    :boundary? false))
        :param (let [state (if (:table? state)
                             state
                             (start-args (finish-text state)))]
                 (assoc (start-param state (:name row) (:content row))
                        :table? true
                        :param-sequence? false)))

      param
      (let [state (if (:param-sequence? state)
                    state
                    (start-args (finish-text state)))]
        (assoc (start-param state (:name param) (:content param))
               :param-sequence? true
               :table? false))

      return
      (start-return state return)

      see
      (assoc (finish-text state)
             :target :see
             :see (append (:see state) (doc/strip-backticks see))
             :boundary? false
             :param-sequence? false)

      since
      (assoc (finish-text state)
             :target :since
             :since (append-annotation-text (:since state) since)
             :boundary? false
             :param-sequence? false)

      (or deprecated (= "@deprecated" trimmed))
      (assoc (finish-text state)
             :target :deprecated
             :deprecated (append-annotation-text (:deprecated state)
                                                 (or deprecated ""))
             :boundary? false
             :param-sequence? false)

      (string/starts-with? trimmed "@")
      (assoc (finish-text state)
             :target :root
             :target-name nil
             :boundary? true
             :param-sequence? false)

      (and boundary? (header? line))
      (assoc (append-header (cond-> state
                                   (= :return target)
                                   (assoc :target :root))
                            line)
             :boundary? false)

      true
      (assoc state
             :text-lines (append (:text-lines state) trimmed)
             :boundary? false))))

(defun reuse-single-return [state]
  (case (:return-count state)
    1 (let [returns (get-in state
                            [:signature-docs (:return-index state) :returns])]
        (assoc state
               :signature-docs
               (for [signature (:signature-docs state)]
                 (assoc signature :returns returns))))
    :default state))

(defun parse
  "Parse a Roo native C++ documentation comment.

  Args:
  - `text`: Complete native block-comment text.

  Returns:
  Ordered documentation fields and internal per-signature documentation used by
  native symbol normalization."
  [text]
  (let [state (-> (reduce (lines text)
                          {:summary nil
                           :content []
                           :signature-docs []
                           :signature-index nil
                           :return-index nil
                           :return-count 0
                           :see []
                           :since nil
                           :deprecated nil
                           :target :root
                           :target-name nil
                           :text-lines []
                           :code nil
                           :brief? false
                           :boundary? true
                           :param-sequence? false
                           :table? false}
                          step)
                  finish-text)
        state (cond-> state (:code state) finish-code)
        state (reuse-single-return state)]
    (cond-> (select-keys state [:summary :content :signature-docs
                                :see :since :deprecated])
            (nil? (:summary state)) (dissoc :summary)
            (empty? (:content state)) (dissoc :content)
            (empty? (:signature-docs state)) (dissoc :signature-docs)
            (empty? (:see state)) (dissoc :see)
            (nil? (:since state)) (dissoc :since)
            (nil? (:deprecated state)) (dissoc :deprecated))))



;; Legacy Identities

(defun identity
  "Parse `ClassName - roo.namespace/exported-symbol` from a native comment."
  [text]
  (let [comment-lines (filter (lines text) (fn [line] (not (blank? line))))
        line (head comment-lines)
        separator (when line
                    (find-index line
                                (fn [character]
                                  (= "-" (str character)))))]
    (unless (or (nil? separator)
                (string/starts-with? line "@"))
      {:native-class (trim (substr line 0 separator))
       :qualified-name (trim (substr line (+ separator 1) (count line)))})))

(defun line-identity [line]
  (let [trimmed (trim line)
        text (cond
               (string/starts-with? trimmed "///")
               (trim (substr trimmed 3 (count trimmed)))

               (string/starts-with? trimmed "//")
               (trim (substr trimmed 2 (count trimmed)))

               true
               nil)]
    (when text
      (identity text))))
