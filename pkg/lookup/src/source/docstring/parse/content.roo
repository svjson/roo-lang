(ns lookup.source.docstring.parse.content
  (:require [lookup.doc :as doc]
            [roo.string :as string]))



;; Docstring Parsing

(defun section [line]
  (case (trim line)
    "Args:" :args
    "Returns:" :returns
    "Examples:" :examples
    "See Also:" :see
    "Since:" :since
    "Deprecated:" :deprecated
    :default nil))

(defun arg-line [state line]
  (let [trimmed (trim line)
        colon (index-of trimmed ':')]
    (if (and (string/starts-with? trimmed "- ")
             (some? colon))
      (let [name (doc/strip-backticks (substr trimmed 2 (- colon 2)))
            doc (trim (substr trimmed (+ colon 1)))]
        (assoc-in state [:params name] {:type nil :doc doc}))
      state)))

(defun see-line [{:keys [see] :as state} line]
  (let [trimmed (trim line)]
    (if (blank? trimmed)
      state
      (assoc state
             :see
             (append see
                     (doc/strip-backticks
                       (cond-> trimmed
                               (string/starts-with? trimmed "- ")
                               (substr 2))))))))

(defun single-line-section [state key line]
  (if (blank? line)
    state
    (assoc state
           key
           (if (nil? (get state key))
             (trim line)
             (str (get state key) " " (trim line))))))

(defun example-line [{:keys [fence examples] :as state} line]
  (let [trimmed (trim line)]
    (cond

      (and (nil? fence)
           (string/starts-with? trimmed "```"))
      (assoc state
             :fence
             {:format (let [language (trim (substr trimmed 3))]
                        (if (blank? language)
                          :text
                          (keyword language)))
              :lines []})

      (and fence
           (string/starts-with? trimmed "```"))
      (assoc state
             :examples
             (append examples
                     {:format (:format fence)
                      :source (apply join
                                     (concat ["\n"] (:lines fence)))})
             :fence nil)

      fence
      (assoc-in state [:fence :lines] (append (:lines fence) (trim line)))

      true
      state)))

(defun step [state line]
  (if-let [section (section line)]
    (assoc state :section section)
    (case (:section state)
      :args
      (arg-line state line)

      :returns
      (if (blank? line)
        state
        (update state :returns [append line]))

      :examples
      (example-line state line)

      :see
      (see-line state line)

      :since
      (single-line-section state :since line)

      :deprecated
      (single-line-section state :deprecated line)

      :default
      (update state :prose [append line]))))

(defun parse
  "Parse a Roo docstring into lookup documentation data.

  Args:
  - `text`: Docstring text from a `def` or `defun` form.

  Returns:
  A documentation map with summary, body, params, returns,
  examples, see-also, since, and deprecated fields."
  [text]
  (let [state (reduce (split text "\n")
                      {:section nil
                       :prose []
                       :params {}
                       :returns []
                       :examples []
                       :see []
                       :since nil
                       :deprecated nil
                       :fence nil}
                      step)
        prose (doc/paragraphs (:prose state))]
    {:summary (head prose)
     :body (doc/paragraph-text (tail prose))
     :format :markdown
     :params (:params state)
     :returns (unless (empty? (:returns state))
                {:type nil
                 :doc (doc/paragraph-text
                        (doc/paragraphs (:returns state)))})
     :examples (:examples state)
     :see (:see state)
     :since (:since state)
     :deprecated (:deprecated state)}))
