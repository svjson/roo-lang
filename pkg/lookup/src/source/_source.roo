(ns lookup.source
  (:require [roo.io :as io]
            [lookup.reader :as reader]
            [lookup.source.docstring.symbols :as docstrings]
            [lookup.source.native.parse.entries :as native]
            [lookup.source.native.symbols :as native-symbols]
            [lookup.source.path :as path]))

(defun read-manifest!
  "Read a package manifest from a package directory.

  Args:
  - `package-dir`: Package root containing `package.edn`.

  Returns:
  The parsed package manifest map."
  [package-dir]
  (io/slurp-edn! (io/join-path package-dir "package.edn")))

(defun package-info
  "Build package metadata for lookup indexes.

  Args:
  - `manifest`: Parsed package manifest map.

  Returns:
  A map with package `:name`, `:version`, and `:description`."
  [manifest]
  {:name (str (:name manifest))
   :version (:version manifest)
   :description (:description manifest)})

(defun package-load-roots
  "Return the effective production source roots declared by a manifest.

  Args:
  - `manifest`: Parsed package manifest map.

  Returns:
  An ordered vector containing explicit load roots and uncovered namespace-root paths."
  [manifest]
  (let [roots (map (if (and (nil? (:load-roots manifest))
                            (empty? (:namespace-roots manifest)))
                     ["src"]
                     (:load-roots manifest))
                   io/normalize-path)
        namespace-roots (flat-map (vals (:namespace-roots manifest))
                                  (fn [value]
                                    (map (case (type-of value)
                                           "vector" value
                                           :default [value])
                                         io/normalize-path)))]
    (reduce namespace-roots
            roots
            (fn [roots path]
              (if (any? roots
                        (fn [root]
                          (path/within? path root)))
                roots
                (append roots path))))))

(defun source-file?
  "Test whether a path names a Roo source file.

  Args:
  - `path`: File path to inspect.

  Returns:
  `true` when the path extension is `.roo`; otherwise `false`."
  [path]
  (= ".roo" (io/extension path)))

(defun source-entry?
  [entry metadata]
  (and (= (:type entry) :file)
       (source-file? (:relative-path metadata))))

(defun source-files-in [root]
  (when (io/directory? root)
    (for [result (io/walk! root {:keep? source-entry?})]
      (:path (:entry result)))))

(defun source-entry-for-index
  "Read one source file into an index under a separately supplied source path.

  Args:
  - `path`: Filesystem path used to read the Roo source file.
  - `index-path`: Path recorded in the generated index.

  Returns:
  A map containing normalized `:path` and parsed top-level `:forms`."
  [path index-path]
  (let [index-path (io/normalize-path index-path)]
    {:path index-path
     :forms (for [entry (reader/read-file-forms! path)]
              (cond-> (assoc-in entry [:source :path] index-path)
                      (:path entry) (assoc :path index-path)))}))

(defun source-entry
  "Read one source file into a source-form index entry.

  Args:
  - `path`: Roo source file path.

  Returns:
  A map containing normalized `:path` and parsed top-level `:forms`."
  [path]
  (source-entry-for-index path path))

(defun package-source-files
  "Find all Roo source files declared by a package manifest.

  Args:
  - `package-dir`: Package root containing the source roots.
  - `manifest`: Parsed package manifest map.

  Returns:
  A sorted vector of source file paths."
  [package-dir manifest]
  (sort (flat-map (package-load-roots manifest)
                  (fn [root]
                    (source-files-in (io/join-path package-dir (str root)))))
        <))



;; Index Sources

(defun package-forms
  "Read the Roo forms belonging to a package.

  Args:
  - `package-dir`: Package root containing `package.edn`.

  Returns:
  Package metadata and parsed Roo source entries."
  [package-dir]
  (let [manifest (read-manifest! package-dir)]
    {:package (package-info manifest)
     :sources (for [source-path (package-source-files package-dir manifest)]
                (source-entry-for-index source-path (path/package-relative package-dir source-path)))}))

(defun extract-pkg-symbols
  "Extract the symbols and namespaces belonging to a package and extra roots.

  Args:
  - `package-dir`: Package root containing `package.edn`.
  - `roots`: Additional native source roots.
  - `excludes`: Paths excluded from additional roots.

  Returns:
  Package metadata, source paths, namespaces, and symbols."
  [package-dir roots excludes]
  (let [forms (package-forms package-dir)
        package-name (:name (:package forms))
        sources (:sources forms)
        package-native (native/package-entries! package-dir)
        root-native (native/root-entries! roots excludes)]
    {:package (:package forms)
     :sources (for [source sources] {:path (:path source)})
     :namespaces (concat (keep sources docstrings/source-namespace-entry)
                         (native-symbols/namespaces package-name package-native)
                         (native-symbols/namespaces package-name root-native))
     :symbols (concat (flat-map sources
                                (fn [source]
                                  (docstrings/source-symbols package-name source)))
                      (native-symbols/entries package-name package-native)
                      (native-symbols/entries package-name root-native))}))

(defun root-symbols
  "Extract symbols and namespaces from generic native source roots.

  Args:
  - `options`: Map containing `:roots`, `:excludes`, `:extractors`, and
    optional `:package` metadata.

  Returns:
  Normalized roots and excludes, source paths, namespaces, and symbols."
  [options]
  (let [roots (:roots options)
        excludes (:excludes options)
        package (:package options)
        native-files (sort (flat-map roots
                                     (fn [root]
                                       (native/root-files root excludes)))
                           <)
        native-entries (if (contains? (:extractors options) :native)
                         (native/root-entries! roots excludes)
                         [])]
    {:roots (map roots io/normalize-path)
     :excludes (map excludes io/normalize-path)
     :sources (for [source-path native-files] {:path source-path})
     :namespaces (native-symbols/namespaces (:name package) native-entries)
     :symbols (native-symbols/entries (:name package) native-entries)}))



;; Incremental Contributions

(defun roo-contribution
  "Index one Roo source as a replaceable package contribution.

  Args:
  - `package-dir`: Package root containing the source.
  - `package-name`: Package name attached to extracted symbols.
  - `source-path`: Absolute Roo source path.

  Returns:
  A contribution containing the source's namespaces and symbols."
  [package-dir package-name source-path]
  (let [index-path (path/package-relative package-dir source-path)
        source (source-entry-for-index source-path index-path)
        namespace (docstrings/source-namespace-entry source)]
    {:path source-path
     :index-path index-path
     :namespaces (if namespace [namespace] [])
     :symbols (docstrings/source-symbols package-name source)}))

(defun native-contributions
  "Index native package sources and group results by owning source path.

  Args:
  - `package-dir`: Package root containing the native source declarations.
  - `package-name`: Package name attached to extracted entries.

  Returns:
  Source contributions in stable package-relative path order."
  [package-dir package-name]
  (let [paths (native/package-files package-dir)
        entries (native/package-entries! package-dir)
        symbols (native-symbols/entries package-name entries)
        namespaces (native-symbols/namespaces package-name entries)
        initial (reduce paths
                        {}
                        (fn [result source-path]
                          (let [index-path (path/package-relative package-dir source-path)]
                            (assoc result
                                   index-path
                                   {:path source-path
                                    :index-path index-path
                                    :namespaces []
                                    :symbols []}))))
        grouped (reduce symbols
                        initial
                        (fn [result symbol]
                          (let [index-path (:path (:source symbol))
                                contribution (get result index-path)]
                            (assoc-in result
                                      [index-path :symbols]
                                      (append (:symbols contribution) symbol)))))
        grouped (reduce namespaces
                        grouped
                        (fn [result namespace]
                          (let [index-path (:path (:source namespace))
                                contribution (get result index-path)]
                            (assoc-in result
                                      [index-path :namespaces]
                                      (append (:namespaces contribution)
                                              namespace)))))]
    (for [index-path (sort (keys grouped) <)]
      (get grouped index-path))))

(defun package-contributions
  "Build independently replaceable Roo and native package contributions.

  Args:
  - `package-dir`: Package root containing the indexed sources.
  - `package`: Package metadata attached to extracted entries.

  Returns:
  Roo and native contributions in source order."
  [package-dir package]
  (let [manifest (read-manifest! package-dir)
        package-name (:name package)]
    (concat (for [source-path (package-source-files package-dir manifest)]
              (roo-contribution package-dir package-name source-path))
            (native-contributions package-dir package-name))))

(defun package-inputs
  "Discover the current Roo and native package input paths.

  Args:
  - `package-dir`: Package root containing the indexed sources.

  Returns:
  A map containing `:roo` and `:native` source paths."
  [package-dir]
  (let [manifest (read-manifest! package-dir)]
    {:roo (package-source-files package-dir manifest)
     :native (native/package-files package-dir)}))
