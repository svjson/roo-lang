(ns lookup.native-docs
  (:require [lookup.docstrings :as docstrings]
            [lookup.source :as source]
            [roo.io :as io]
            [roo.string :as string]))

(defun strip-suffix [text suffix]
  (if (string/ends-with? text suffix)
    (substr text 0 (- (count text) (count suffix)))
    text))

(defun strip-cpp-comment-line [line]
  (let [trimmed (trim line)
        without-open (cond
                       (string/starts-with? trimmed "/**")
                       (substr trimmed 3 (count trimmed))

                       (string/starts-with? trimmed "/*!")
                       (substr trimmed 3 (count trimmed))

                       (string/starts-with? trimmed "/*")
                       (substr trimmed 2 (count trimmed))

                       true
                       trimmed)
        without-close (strip-suffix (trim without-open) "*/")
        clean (trim without-close)]
    (trim
      (if (string/starts-with? clean "*")
        (substr clean 1 (count clean))
        clean))))

(defun cpp-comment-lines [text]
  (map (docstrings/split-lines text) strip-cpp-comment-line))

(defun join-lines [separator lines]
  (if (= 0 (count lines))
    nil
    (apply join (concat [separator] lines))))

(defun cpp-doc-directive? [line]
  (string/starts-with? (trim line) "@"))

(defun cpp-doc-usage-line? [line]
  (= "Usage:" (trim line)))

(defun cpp-doc-table-line? [line]
  (string/starts-with? (trim line) "|"))

(defun cpp-doc-body-line? [line]
  (not (or (cpp-doc-directive? line)
           (cpp-doc-usage-line? line)
           (cpp-doc-table-line? line))))

(defun cpp-doc-brief-text [line]
  (let [trimmed (trim line)]
    (if (string/starts-with? trimmed "@brief")
      (trim (substr trimmed 6 (count trimmed)))
      nil)))

(defun cpp-doc-code-format [state]
  (or (:code-format state) :roo))

(defun cpp-doc-start-code [state line]
  (let [trimmed (trim line)
        format-name (trim (substr trimmed 5 (count trimmed)))]
    (assoc state
           :section :code
           :code-format (if (blank? format-name) :roo (keyword format-name))
           :code-lines [])))

(defun cpp-doc-finish-code [state]
  (assoc state
         :section nil
         :examples (concat (:examples state)
                           [{:format (cpp-doc-code-format state)
                             :source (join-lines "\n" (:code-lines state))}])
         :code-format nil
         :code-lines []))

(defun cpp-doc-arg-row [line]
  (let [trimmed (trim line)]
    (if (not (cpp-doc-table-line? trimmed))
      nil
      (let [content (strip-suffix (substr trimmed 1 (count trimmed)) "|")
            separator (find-index content (fn [ch] (= "|" (str ch))))]
        (if (nil? separator)
          nil
          (let [arg (trim (substr content 0 separator))
                doc (trim (substr content (+ separator 1) (count content)))]
            (if (or (blank? arg)
                    (= "Arg #" arg)
                    (string/starts-with? arg "---"))
              nil
              {:key arg
               :doc {:type nil :doc doc}})))))))

(defun cpp-doc-return-text [line]
  (let [trimmed (trim line)]
    (cond
      (string/starts-with? trimmed "@returns")
      (trim (substr trimmed 8 (count trimmed)))

      (string/starts-with? trimmed "@return")
      (trim (substr trimmed 7 (count trimmed)))

      true
      nil)))

(defun cpp-doc-step [state line]
  (let [trimmed (trim line)]
    (cond

      (= :code (:section state))
      (if (= "@endcode" trimmed)
        (cpp-doc-finish-code state)
        (assoc state
               :code-lines
               (concat (:code-lines state) [trimmed])))

      (string/starts-with? trimmed "@code")
      (cpp-doc-start-code state trimmed)

      (not (nil? (cpp-doc-brief-text trimmed)))
      (assoc state
             :summary
             (concat (:summary state) [(cpp-doc-brief-text trimmed)])
             :brief? true)

      (and (:brief? state)
           (not (blank? trimmed))
           (cpp-doc-body-line? trimmed))
      (assoc state
             :summary
             (concat (:summary state) [trimmed]))

      (:brief? state)
      (cpp-doc-step (assoc state :brief? false) line)

      (not (nil? (cpp-doc-return-text trimmed)))
      (assoc state
             :returns
             (concat (:returns state) [(cpp-doc-return-text trimmed)]))

      (not (nil? (cpp-doc-arg-row trimmed)))
      (let [row (cpp-doc-arg-row trimmed)]
        (assoc state
               :params
               (assoc (:params state) (:key row) (:doc row))))

      (cpp-doc-body-line? trimmed)
      (assoc state
             :body
             (concat (:body state) [line]))

      true
      state)))

(defun from-cpp-comment
  "Parse an existing Roo native C++ header comment into documentation data."
  [text]
  (let [state (reduce (cpp-comment-lines text)
                      {:summary []
                       :body []
                       :params {}
                       :returns []
                       :examples []
                       :section nil
                       :code-format nil
                       :code-lines []
                       :brief? false}
                      cpp-doc-step)]
    {:summary (join-lines " " (:summary state))
     :body (docstrings/paragraph-text (docstrings/paragraphs (:body state)))
     :format :markdown
     :params (:params state)
     :returns (if (= 0 (count (:returns state)))
                nil
                {:type nil
                 :doc (docstrings/paragraph-text
                        (docstrings/paragraphs (:returns state)))})
     :examples (:examples state)
     :see []
     :since nil
     :deprecated nil}))

(defun native-identity-from-cpp-comment
  "Parse a native implementation identity comment.

  The accepted idiom is:
  `ClassName - roo.namespace/exported-symbol`."
  [text]
  (let [lines (filter (cpp-comment-lines text) (fn [line] (not (blank? line))))
        line (head lines)
        separator (if (nil? line)
                    nil
                    (find-index line (fn [ch] (= "-" (str ch)))))]
    (if (nil? separator)
      nil
      {:native-class (trim (substr line 0 separator))
       :qualified-name (trim (substr line (+ separator 1) (count line)))})))

(defun native-source-file? [path]
  (contains? [".c" ".cc" ".cpp" ".cxx" ".h" ".hh" ".hpp" ".hxx"]
             (io/extension path)))

(defun native-source-files-in [root]
  (if (io/directory? root)
    (let [entries (io/list-directory! root)
          files (map (filter entries
                             (fn [entry]
                               (and (= (:type entry) :file)
                                    (native-source-file? (:path entry)))))
                     :path)
          directories (filter entries (fn [entry] (= (:type entry) :directory)))]
      (concat files
              (flatten
                (map directories
                     (fn [entry]
                       (native-source-files-in (:path entry)))))))
    []))

(defun native-library-source-root [package-dir native-library]
  (io/join-path package-dir (:path native-library)))

(defun native-library-source-files [package-dir native-library]
  (native-source-files-in (native-library-source-root package-dir native-library)))

(defun package-native-source-files
  "Find C++ source and header files under package native library roots."
  [package-dir]
  (let [manifest (source/read-manifest! package-dir)
        native-libraries (or (:native-libraries manifest) [])]
    (sort
      (map (flatten
             (map native-libraries
                  (fn [native-library]
                    (native-library-source-files package-dir native-library))))
           source/normalized-path)
      <)))

(defun indexed-lines [text]
  (:entries
    (reduce (docstrings/split-lines text)
            {:line 1 :entries []}
            (fn [state line]
              {:line (+ (:line state) 1)
               :entries (concat (:entries state)
                                [{:line (:line state)
                                  :text line}])}))))

(defun block-comment-start? [line]
  (string/starts-with? (trim line) "/*"))

(defun block-comment-end? [line]
  (string/ends-with? (trim line) "*/"))

(defun native-declaration-kind [line]
  (let [trimmed (trim line)]
    (cond
      (string/starts-with? trimmed "FUNC(")
      :function

      (string/starts-with? trimmed "SPECIAL_FORM_DECL(")
      :special-form

      true
      nil)))

(defun native-declaration? [line]
  (not (nil? (native-declaration-kind line))))

(defun native-declaration-class [line]
  (let [trimmed (trim line)
        open (find-index trimmed (fn [ch] (= "(" (str ch))))]
    (if (nil? open)
      nil
      (let [tail (substr trimmed (+ open 1) (count trimmed))
            separator (find-index tail
                                  (fn [ch]
                                    (or (= "," (str ch))
                                        (= ")" (str ch)))))]
        (trim
          (if (nil? separator)
            tail
            (substr tail 0 separator)))))))

(defun source-location [path line]
  {:path (source/normalized-path path)
   :line line
   :column 1})

(defun comment-text [comment]
  (join-lines "\n" (:lines comment)))

(defun native-identity-entry [path comment]
  (if-let [identity (native-identity-from-cpp-comment (comment-text comment))]
    (merge {:kind :native-identity-comment
            :source (source-location path (:start-line comment))}
           identity)
    nil))

(defun native-doc-entry [path comment declaration]
  (let [line (:text declaration)]
    {:kind :native-doc-comment
     :native-class (native-declaration-class line)
     :native-kind (native-declaration-kind line)
     :doc (from-cpp-comment (comment-text comment))
     :source (source-location path (:start-line comment))
     :declaration-source (source-location path (:line declaration))}))

(defun finish-comment [state comment]
  (if-let [identity-entry (native-identity-entry (:path state) comment)]
    (assoc state
           :comment nil
           :pending-comment comment
           :entries (concat (:entries state) [identity-entry]))
    (assoc state
           :comment nil
           :pending-comment comment)))

(defun start-comment [state line-entry]
  (let [comment {:start-line (:line line-entry)
                 :lines [(:text line-entry)]}]
    (if (block-comment-end? (:text line-entry))
      (finish-comment state comment)
      (assoc state :comment comment))))

(defun append-comment-line [state line-entry]
  (let [comment (assoc (:comment state)
                       :lines
                       (concat (:lines (:comment state)) [(:text line-entry)]))]
    (if (block-comment-end? (:text line-entry))
      (finish-comment state comment)
      (assoc state :comment comment))))

(defun native-comment-step [state line-entry]
  (let [line (:text line-entry)
        pending-comment (:pending-comment state)]
    (cond

      (not (nil? (:comment state)))
      (append-comment-line state line-entry)

      (block-comment-start? line)
      (start-comment state line-entry)

      (and (not (nil? pending-comment))
           (blank? line))
      state

      (and (not (nil? pending-comment))
           (native-declaration? line))
      (assoc state
             :pending-comment nil
             :entries (concat (:entries state)
                              [(native-doc-entry (:path state)
                                                 pending-comment
                                                 line-entry)]))

      true
      (assoc state :pending-comment nil))))

(defun source-native-comment-entries
  "Extract native documentation and identity comments from C++ source text."
  [path text]
  (:entries
    (reduce (indexed-lines text)
            {:path path
             :entries []
             :comment nil
             :pending-comment nil}
            native-comment-step)))

(defun source-native-comment-entries!
  "Read a C++ source file and extract native documentation comment entries."
  [path]
  (source-native-comment-entries path (io/slurp! path)))

(defun package-native-comment-entries!
  "Extract native documentation comment entries from a package's C++ sources."
  [package-dir]
  (flatten
    (map (package-native-source-files package-dir)
         source-native-comment-entries!)))

(defun native-doc-entry-for-class [entries native-class]
  (find-first entries
              (fn [entry]
                (and (= :native-doc-comment (:kind entry))
                     (= native-class (:native-class entry))))))

(defun qualified-symbol-separator [qualified-name]
  (find-index qualified-name (fn [ch] (= "/" (str ch)))))

(defun qualified-symbol-namespace [qualified-name]
  (if-let [separator (qualified-symbol-separator qualified-name)]
    (substr qualified-name 0 separator)
    nil))

(defun qualified-symbol-name [qualified-name]
  (if-let [separator (qualified-symbol-separator qualified-name)]
    (substr qualified-name (+ separator 1) (count qualified-name))
    qualified-name))

(defun native-symbol-kind [native-doc-entry]
  (case (:native-kind native-doc-entry)
    :special-form :special-form
    :default :function))

(defun native-param-variadic? [key]
  (string/ends-with? key "..."))

(defun native-param-name [key]
  (if (native-param-variadic? key)
    "args"
    (str "arg" key)))

(defun native-signature-params [doc]
  (let [param-docs (:params doc)]
    (map (sort (keys param-docs) <)
         (fn [key]
           (let [rest? (native-param-variadic? key)
                 param-doc (get param-docs key)]
             {:name (native-param-name key)
              :type (:type param-doc)
              :doc (:doc param-doc)
              :optional? rest?
              :rest? rest?})))))

(defun native-signature-display [name params]
  (let [param-names (map params :name)
        params-display (join-lines " " param-names)]
    (if (nil? params-display)
      (str "(" name ")")
      (str "(" name " " params-display ")"))))

(defun native-signature-arity [params]
  (let [variadic? (not (nil? (find-first params (fn [param] (:rest? param)))))
        required-params (filter params
                                (fn [param]
                                  (and (not (:optional? param))
                                       (not (:rest? param)))))]
    {:min (count required-params)
     :max (if variadic? nil (count params))
     :variadic variadic?}))

(defun native-signature [name doc]
  (let [params (native-signature-params doc)]
    {:display (native-signature-display name params)
     :params params
     :returns (or (:returns doc)
                  {:type nil
                   :doc nil})
     :arity (native-signature-arity params)}))

(defun native-symbol-entry [package entries identity-entry]
  (let [qualified-name (:qualified-name identity-entry)
        namespace (qualified-symbol-namespace qualified-name)
        name (qualified-symbol-name qualified-name)
        doc-entry (native-doc-entry-for-class entries (:native-class identity-entry))
        doc (if (nil? doc-entry)
              (docstrings/empty)
              (:doc doc-entry))]
    (if (nil? namespace)
      nil
      {:id qualified-name
       :name name
       :qualified-name qualified-name
       :namespace namespace
       :package package
       :kind (native-symbol-kind doc-entry)
       :origin :native
       :visibility :public
       :status :stable
       :source (:source identity-entry)
       :declaration-source (:declaration-source doc-entry)
       :doc-source (if (nil? doc-entry)
                     nil
                     {:kind :native-cpp-comment
                      :source (:source doc-entry)})
       :doc doc
       :signatures [(native-signature name doc)]})))

(defun native-symbol-entries [package entries]
  (keep entries
        (fn [entry]
          (if (= :native-identity-comment (:kind entry))
            (native-symbol-entry package entries entry)
            nil))))

(defun package-native-symbol-entries!
  "Build native symbol entries for a package from extracted C++ comments."
  [package-dir package]
  (native-symbol-entries package (package-native-comment-entries! package-dir)))
