(ns lookup.cli
  (:require [lookup.analysis :as analysis]
            [lookup.command.audit :as audit-command]
            [lookup.command.index :as index-command]
            [lookup.reader :as reader]
            [lookup.system :as system]))

(def usage-lines
  "Command usage lines printed by `lookup --help` and parse errors."
  ["Usage: lookup [--help|--version]"
   index-command/usage-line
   audit-command/usage-line
   "       lookup thing-at <package-dir> <file> <line> <column>"])

(def version
  "Lookup command version."
  "0.1.0")

(defun help-lines
  "Build the full help text for the lookup command.

  Returns:
  A vector of lines for `lookup --help`."
  []
  (concat ["lookup: build Roo symbol index artifacts"]
          usage-lines
          [""
           "Extractors: forms, symbols, native"
           "Default: symbols for packages, native for roots"
           "Roots are scanned by applicable extractors; excludes skip paths and subtrees"]))

(defun version-text
  "Build the lookup version output.

  Returns:
  Version text printed by `lookup --version`."
  []
  (str "lookup " version))

(defun command
  "Resolve CLI arguments to a lookup command.

  Args:
  - `args`: Command line argument vector.

  Returns:
  One of `:help`, `:version`, `:index`, `:audit`, `:thing-at`, or `:usage`."
  [args]
  (let [first-arg (head args)]
    (cond

      (or (nil? first-arg)
          (contains? ["--help" "-h"] first-arg))
      :help

      (= first-arg "--version")
      :version

      (= first-arg "index")
      :index

      (= first-arg "audit")
      :audit

      (= first-arg "thing-at")
      :thing-at

      true
      :usage)))

(defun print-lines! [lines]
  (map lines prn))

(defun print-usage! []
  (print-lines! usage-lines))

(defun print-help! []
  (print-lines! (help-lines)))

(defun print-version! []
  (prn (version-text)))

(defun print-errors-and-usage! [errors]
  (map errors prn)
  (print-usage!))

(defun print-command-result! [result]
  (let [errors (or (:errors result) [])]
    (if (not-empty? errors)
      (print-errors-and-usage! errors)
      (case (:format result)
        :text (print-lines! (:output result))
        :default (when (not (nil? (:value result)))
                   (prn (:value result)))))))

(defun print-index! [args]
  (print-command-result! (index-command/run! (tail args))))

(defun print-audit! [args]
  (let [result (audit-command/run! (tail args))]
    (print-command-result! result)
    (if (:failed? result)
      (system/fail! "lookup audit failed")
      result)))

(defun print-thing-at! [args]
  (let [package-dir (nth args 1)
        file (nth args 2)
        line (nth args 3)
        column (nth args 4)]
    (if (or (nil? package-dir)
            (nil? file)
            (nil? line)
            (nil? column))
      (print-usage!)
      (prn (analysis/thing-at! package-dir
                               file
                               line
                               column
                               (reader/read-stdin!))))))

(defun main
  "Run the lookup command line entry point.

  Args:
  - `args`: Command line argument vector.

  Returns:
  The result of printing or writing the selected lookup command output."
  [args]
  (case (command args)
    :help (print-help!)
    :version (print-version!)
    :index (print-index! args)
    :audit (print-audit! args)
    :thing-at (print-thing-at! args)
    :default (print-usage!)))
