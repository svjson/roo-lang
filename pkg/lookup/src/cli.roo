(ns lookup.cli
  (:require [cli-trooper :as cli]
            [lookup.command.audit :as audit]
            [lookup.command.index :as index]
            [lookup.command.thing-at :as thing-at]))

(def application
  "cli-trooper declaration for the Lookup command-line application."
  {:application "lookup"
   :version "0.1.0"
   :description "build Roo symbol index artifacts"
   :features {:help {:after [""
                              "Extractors: forms, symbols, native"
                              "Default: symbols for packages, native for roots"
                              "Roots are scanned by applicable extractors; excludes skip paths and subtrees"]}}
   :mixins {:source-paths
            {:flags {"root" {:type :dir
                              :name "dir"
                              :repeatable? true
                              :destination :roots
                              :default []}
                     "exclude" {:type :path
                                :repeatable? true
                                :destination :excludes
                                :default []}}}}
   :commands {"index" index/command
              "audit" audit/command
              "thing-at" thing-at/command}})

(defun main
  "Run the Lookup command-line application.

  Args:
  - `args`: Command-line argument vector.

  Returns:
  A process-compatible exit code."
  [args]
  (cli/run! application {:args args}))
