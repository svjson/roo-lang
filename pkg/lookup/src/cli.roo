(ns lookup.cli
  (:require [lookup.core :as lookup]))

(def usage-lines
  ["Usage: lookup [--help|--version]"
   "       lookup index [--out <file>] <package-dir>"
   "       lookup thing-at <package-dir> <file> <line> <column>"])

(defun help-lines []
  (concat ["lookup: build Roo symbol index artifacts"]
          usage-lines))

(defun version-text []
  (str "lookup " lookup/version))

(defun command [args]
  (let [first-arg (nth args 0)]
    (cond

      (or (nil? first-arg)
          (contains? ["--help" "-h"] first-arg))
      :help

      (= first-arg "--version")
      :version

      (= first-arg "index")
      :index

      (= first-arg "thing-at")
      :thing-at

      true
      :usage)))

(defun print-lines! [lines]
  (map lines prn))

(defun print-usage! []
  (print-lines! usage-lines))

(defun print-help! []
  (print-lines! (help-lines)))

(defun print-version! []
  (prn (version-text)))

(defun print-index! [args]
  (let [package-dir (nth args 1)]
    (if (nil? package-dir)
      (print-usage!)
      (prn (lookup/symbol-index package-dir)))))

(defun print-thing-at! [args]
  (let [package-dir (nth args 1)
        file (nth args 2)
        line (nth args 3)
        column (nth args 4)]
    (if (or (nil? package-dir)
            (nil? file)
            (nil? line)
            (nil? column))
      (print-usage!)
      (prn (lookup/thing-at package-dir
                            file
                            line
                            column
                            (lookup/read-stdin!))))))

(defun main [args]
  (let [command-name (command args)]
    (cond

      (= command-name :help)
      (print-help!)

      (= command-name :version)
      (print-version!)

      (= command-name :index)
      (print-index! args)

      (= command-name :thing-at)
      (print-thing-at! args)

      true
      (print-usage!))))
