(ns lookup.index.incremental
  (:require [roo.io :as io]
            [lookup.source :as source]
            [lookup.source.docstring.symbols :as docstring-symbols]
            [lookup.source.native.parse.entries :as native-entries]
            [lookup.source.native.symbols :as native-symbols]))

(def INDEX-METADATA
  "Format identities and schema version for persisted incremental index data."
  {:state-format :roo/incremental-index-state
   :delta-format :roo/index-delta
   :schema-version 1})

(defun canonical-path
  "Return PATH as a normalized absolute path."
  [path]
  (source/normalized-path (io/absolute-path! path)))

(defun state-options
  "Select and normalize the index options that identify compatible state."
  [options]
  {:package-dir (canonical-path (:package-dir options))
   :extractors (:extractors options)})

(defun manifest-path
  "Return the manifest path beneath STATE-DIR."
  [state-dir]
  (io/join-path state-dir "manifest.edn"))

(defun package-manifest-path
  "Return the package manifest path beneath PACKAGE-DIR."
  [package-dir]
  (io/join-path package-dir "package.edn"))

(defun modified-ms
  "Return PATH's filesystem modification time in milliseconds."
  [path]
  (:modified-ms (io/stat! path)))

(defun write-edn-atomically!
  "Serialize VALUE as EDN and atomically publish it at PATH."
  [path value]
  (io/spit-edn! path value {:atomic? true}))

(defun unique-paths
  "Return PATHS in encounter order with duplicate paths removed."
  [paths]
  (reduce paths
          []
          (fn [result path]
            (if (contains? result path)
              result
              (append result path)))))

(defun empty-contribution
  "Create an empty source contribution owned by PATH."
  [path]
  {:path path
   :namespaces []
   :symbols []})

(defun roo-contribution
  "Index one Roo source at PATH as a replaceable package contribution."
  [package-name path]
  (let [source-entry (source/source-entry path)
        namespace-entry (docstring-symbols/source-namespace-entry source-entry)]
    {:path path
     :namespaces (if namespace-entry [namespace-entry] [])
     :symbols (docstring-symbols/source-symbols package-name source-entry)}))

(defun native-contributions
  "Index native package sources and group symbols by their owning source path."
  [package-dir package-name]
  (let [paths (native-entries/package-files package-dir)
        entries (native-entries/package-entries! package-dir)
        symbols (native-symbols/entries package-name entries)
        initial (reduce paths
                        {}
                        (fn [result path]
                          (assoc result path (empty-contribution path))))
        grouped (reduce symbols
                        initial
                        (fn [result symbol]
                          (let [path (:path (:source symbol))
                                contribution (get result
                                                  path
                                                  (empty-contribution path))]
                            (assoc result
                                   path
                                   (update contribution
                                           :symbols
                                           [append
                                            symbol])))))]
    (for [path (sort (keys grouped) <)]
      (get grouped path))))

(defun package-contributions
  "Build independently replaceable Roo and native contributions for PACKAGE."
  [package-dir package]
  (let [manifest (source/read-manifest! package-dir)
        package-name (:name package)
        roo-files (source/package-source-files package-dir manifest)]
    (concat
      (for [path roo-files]
        (roo-contribution package-name path))
      (native-contributions package-dir package-name))))

(defun snapshot
  "Assemble a complete symbol-index snapshot from source CONTRIBUTIONS."
  [package contributions]
  {:format :roo/symbol-index
   :version 1
   :package package
   :sources (for [contribution contributions]
              {:path (:path contribution)})
   :namespaces (flat-map contributions
                         (fn [contribution]
                           (:namespaces contribution)))
   :symbols (flat-map contributions
                      (fn [contribution]
                        (:symbols contribution)))})

(defun source-kind
  "Classify PATH as a Roo or native index source."
  [path]
  (case (io/extension path)
    ".roo" :roo
    :default :native))

(defun shard-relative-path
  "Return the state-relative shard path for source ID at REVISION."
  [id revision]
  (source/normalized-path
    (io/join-path "sources"
                  (str "source-" id "-r" revision ".edn"))))

(defun persist-contributions!
  "Persist CONTRIBUTIONS as revisioned shards and return their manifest entries."
  [state-dir revision contributions]
  (reduce contributions
          {:sources {}
           :next-source-id 1}
          (fn [result contribution]
            (let [id (:next-source-id result)
                  path (:path contribution)
                  shard (shard-relative-path id revision)]
              (write-edn-atomically! (io/join-path state-dir shard)
                                     contribution)
              {:sources (assoc (:sources result)
                               path
                               {:id id
                                :kind (source-kind path)
                                :mtime-ms (modified-ms path)
                                :shard shard})
               :next-source-id (+ id 1)}))))

(defun reset-delta
  "Build a delta that replaces consumer state with FULL-SNAPSHOT."
  [metadata base-revision revision full-snapshot]
  {:format (:delta-format metadata)
   :schema-version (:schema-version metadata)
   :base-revision base-revision
   :revision revision
   :reset full-snapshot
   :replace {}
   :remove []})

(defun full-build!
  "Rebuild, persist, and publish complete incremental index state."
  [metadata options state-dir base-revision]
  (let [package-dir (canonical-path (:package-dir options))
        package-manifest (source/read-manifest! package-dir)
        package (source/package-info package-manifest)
        revision (if (nil? base-revision) 1 (+ base-revision 1))
        contributions (package-contributions package-dir package)
        persisted (persist-contributions! state-dir revision contributions)
        full-snapshot (snapshot package contributions)
        manifest {:format (:state-format metadata)
                  :schema-version (:schema-version metadata)
                  :revision revision
                  :options (state-options options)
                  :package package
                  :package-manifest
                  {:path (package-manifest-path package-dir)
                   :mtime-ms (modified-ms
                               (package-manifest-path package-dir))}
                  :sources (:sources persisted)
                  :next-source-id (:next-source-id persisted)}]
    (write-edn-atomically! (manifest-path state-dir) manifest)
    {:manifest manifest
     :snapshot full-snapshot
     :delta (reset-delta metadata
                         base-revision
                         revision
                         full-snapshot)}))

(defun read-contributions
  "Read the source contributions referenced by MANIFEST in stable path order."
  [state-dir manifest]
  (for [path (sort (keys (:sources manifest)) <)]
    (io/slurp-edn!
      (io/join-path state-dir (:shard (get (:sources manifest) path))))))

(defun manifest-snapshot
  "Assemble a complete snapshot from the shards referenced by MANIFEST."
  [state-dir manifest]
  (snapshot (:package manifest) (read-contributions state-dir manifest)))

(defun compatible-state?
  "Test whether MANIFEST can be reused for OPTIONS and METADATA."
  [metadata manifest options]
  (and (= (:state-format metadata) (:format manifest))
       (= (:schema-version metadata) (:schema-version manifest))
       (= (state-options options) (:options manifest))))

(defun package-manifest-current?
  "Test whether the package manifest metadata recorded in MANIFEST is current."
  [{:keys [package-manifest]}]
  (and (io/file? (:path package-manifest))
       (= (:mtime-ms package-manifest)
          (modified-ms (:path package-manifest)))))

(defun new-source-entry
  "Build a manifest entry for a newly persisted Roo source shard."
  [id path shard]
  {:id id
   :kind :roo
   :mtime-ms (modified-ms path)
   :shard shard})

(defun update-roo-sources!
  "Replace or remove Roo source contributions and publish one revision delta."
  [metadata state-dir manifest paths]
  (let [base-revision (:revision manifest)
        next-revision (+ base-revision 1)
        result
        (reduce paths
                {:manifest manifest
                 :replace {}
                 :remove []
                 :changed? false}
                (fn [result path]
                  (let [current-manifest (:manifest result)
                        current-sources (:sources current-manifest)
                        existing (get current-sources path)]
                    (cond
                      (io/file? path)
                      (let [id (if existing
                                 (:id existing)
                                 (:next-source-id current-manifest))
                            shard (shard-relative-path id next-revision)
                            contribution (roo-contribution
                                           (:name (:package current-manifest))
                                           path)
                            next-id (if existing
                                      (:next-source-id current-manifest)
                                      (+ id 1))]
                        (write-edn-atomically! (io/join-path state-dir shard)
                                               contribution)
                        {:manifest
                         (assoc current-manifest
                                :sources
                                (assoc current-sources
                                       path
                                       (new-source-entry id path shard))
                                :next-source-id next-id)
                         :replace (assoc (:replace result) path contribution)
                         :remove (:remove result)
                         :changed? true})

                      existing
                      {:manifest (assoc current-manifest
                                        :sources
                                        (dissoc current-sources path))
                       :replace (:replace result)
                       :remove (append (:remove result) path)
                       :changed? true}

                      true
                      result))))
        changed? (:changed? result)
        revision (if changed? next-revision base-revision)
        published-manifest (cond-> (:manifest result)
                                   changed?
                                   (assoc :revision revision))
        delta {:format (:delta-format metadata)
               :schema-version (:schema-version metadata)
               :base-revision base-revision
               :revision revision
               :replace (:replace result)
               :remove (:remove result)}]
    (when changed?
      (write-edn-atomically! (manifest-path state-dir) published-manifest))
    {:manifest published-manifest
     :snapshot nil
     :delta delta}))

(defun current-inputs
  "Discover the current Roo and native package inputs for OPTIONS."
  [options]
  (let [package-dir (canonical-path (:package-dir options))
        manifest (source/read-manifest! package-dir)]
    {:roo (source/package-source-files package-dir manifest)
     :native (native-entries/package-files package-dir)}))

(defun changed-path?
  "Test whether PATH is new or has a different mtime than MANIFEST records."
  [manifest path]
  (let [entry (get (:sources manifest) path)]
    (or (nil? entry)
        (not= (:mtime-ms entry) (modified-ms path)))))

(defun native-path?
  "Test whether PATH is recorded or classified as a native source."
  [manifest path]
  (let [entry (get (:sources manifest) path)]
    (= :native (if entry (:kind entry) (source-kind path)))))

(defun reconcile!
  "Reconcile persisted state against all current package inputs by mtime."
  [metadata options state-dir manifest]
  (let [inputs (current-inputs options)
        current (unique-paths (concat (:roo inputs) (:native inputs)))
        existing (keys (:sources manifest))
        changed (filter current (fn [path] (changed-path? manifest path)))
        removed (filter existing (fn [path] (not (contains? current path))))
        affected (unique-paths (concat changed removed))]
    (if (any? affected (fn [path] (native-path? manifest path)))
      (full-build! metadata options state-dir (:revision manifest))
      (update-roo-sources! metadata state-dir manifest affected))))

(defun normalize-updates
  "Canonicalize PATHS and remove duplicates while preserving encounter order."
  [paths]
  (unique-paths (map paths canonical-path)))

(defun update-native?
  "Test whether any explicitly updated path is a native source."
  [manifest paths]
  (any? paths (fn [path] (native-path? manifest path))))

(defun index-with-state-config
  "Update dynamic index state using explicit format METADATA and CLI OPTIONS."
  [metadata options]
  (let [state-dir (canonical-path (:state options))
        state-file (manifest-path state-dir)
        existing (when (io/file? state-file) (io/slurp-edn! state-file))
        updates (normalize-updates (or (:updates options) []))
        result
        (cond
          (nil? existing)
          (full-build! metadata options state-dir nil)

          (not (compatible-state? metadata existing options))
          (full-build! metadata options state-dir (:revision existing))

          (not (package-manifest-current? existing))
          (full-build! metadata options state-dir (:revision existing))

          (not-empty? updates)
          (if (update-native? existing updates)
            (full-build! metadata options state-dir (:revision existing))
            (update-roo-sources! metadata state-dir existing updates))

          true
          (reconcile! metadata options state-dir existing))
        need-snapshot? (or (nil? (:emit-delta options))
                           (some? (:out options)))
        full-snapshot (or (:snapshot result)
                          (when need-snapshot?
                            (manifest-snapshot state-dir (:manifest result))))]
    (assoc result :snapshot full-snapshot)))

(defun index-with-state
  "Update or initialize a dynamic lookup index state store.

  Args:
  - `options`: Parsed index command options.

  Returns:
  Published manifest, optional snapshot, and revision delta."
  [options]
  (index-with-state-config INDEX-METADATA options))
