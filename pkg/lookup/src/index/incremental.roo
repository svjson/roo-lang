(ns lookup.index.incremental
  (:require [roo.io :as io]
            [lookup.source :as source]
            [lookup.source.path :as path]))



;;; Constants

(def INDEX-METADATA
  "Format identities and schema version for persisted incremental index data."
  {:state-format :roo/incremental-index-state
   :delta-format :roo/index-delta
   :schema-version 2})

(defun state-options
  "Select and normalize the index options that identify compatible state."
  [options]
  {:package-dir (path/canonical (:package-dir options))
   :extractors (:extractors options)})

(defun manifest-path
  "Return the manifest path beneath STATE-DIR."
  [state-dir]
  (io/join-path state-dir "manifest.edn"))

(defun modified-ms
  "Return PATH's filesystem modification time in milliseconds."
  [path]
  (:modified-ms (io/stat! path)))

(defun unique-paths
  "Return PATHS in encounter order with duplicate paths removed."
  [paths]
  (reduce paths
          []
          (fn [result path]
            (if (contains? result path)
              result
              (append result path)))))

(defun published-contribution
  "Remove incremental path bookkeeping from a source contribution.

  Args:
  - `contribution`: Persisted contribution containing `:path` and
    `:index-path` identities.

  Returns:
  A contribution whose `:path` is package-relative and which contains no
  `:index-path` field."
  [contribution]
  (-> contribution
      (assoc :path (:index-path contribution))
      (dissoc :index-path)))

(defun snapshot
  "Assemble a complete symbol-index snapshot from source CONTRIBUTIONS."
  [package contributions]
  (let [published (for [contribution contributions]
                    (published-contribution contribution))]
    {:format :roo/symbol-index
     :version 1
     :package package
     :sources (for [contribution published]
                {:path (:path contribution)})
     :namespaces (flat-map published
                           (fn [contribution]
                             (:namespaces contribution)))
     :symbols (flat-map published
                        (fn [contribution]
                          (:symbols contribution)))}))

(defun source-kind
  "Classify PATH as a Roo or native index source."
  [path]
  (case (io/extension path)
    ".roo" :roo
    :default :native))

(defun shard-relative-path
  "Return the state-relative shard path for source ID at REVISION."
  [id revision]
  (io/join-path "sources" (str "source-" id "-r" revision ".edn")))

(defun persist-contributions!
  "Persist CONTRIBUTIONS as revisioned shards and return their manifest entries."
  [state-dir revision contributions]
  (reduce contributions
          {:sources {}
           :next-source-id 1}
          (fn [result contribution]
            (let [id (:next-source-id result)
                  path (:path contribution)
                  shard (shard-relative-path id revision)]
              (io/spit-edn! (io/join-path state-dir shard)
                            contribution
                            {:atomic? true})
              {:sources (assoc (:sources result)
                               path
                               {:id id
                                :kind (source-kind path)
                                :mtime-ms (modified-ms path)
                                :shard shard})
               :next-source-id (+ id 1)}))))

(defun full-build!
  "Rebuild, persist, and publish complete incremental index state."
  [metadata options state-dir base-revision]
  (let [package-dir (path/canonical (:package-dir options))
        package-manifest-path (io/join-path package-dir "package.edn")
        package-manifest (source/read-manifest! package-dir)
        package (source/package-info package-manifest)
        revision (if (nil? base-revision) 1 (+ base-revision 1))
        contributions (source/package-contributions package-dir package)
        persisted (persist-contributions! state-dir revision contributions)
        full-snapshot (snapshot package contributions)
        manifest {:format (:state-format metadata)
                  :schema-version (:schema-version metadata)
                  :revision revision
                  :options (state-options options)
                  :package package
                  :package-manifest
                  {:path package-manifest-path
                   :mtime-ms (modified-ms package-manifest-path)}
                  :sources (:sources persisted)
                  :next-source-id (:next-source-id persisted)}]
    (io/spit-edn! (manifest-path state-dir) manifest {:atomic? true})
    {:manifest manifest
     :snapshot full-snapshot
     :delta {:format (:delta-format metadata)
             :schema-version (:schema-version metadata)
             :base-revision base-revision
             :revision revision
             :reset full-snapshot
             :replace {}
             :remove []}}))

(defun manifest-snapshot
  "Assemble a complete snapshot from the shards referenced by MANIFEST."
  [state-dir manifest]
  (snapshot (:package manifest)
            (for [path (sort (keys (:sources manifest)) <)]
              (io/slurp-edn! (io/join-path state-dir
                                           (:shard (get (:sources manifest) path)))))))

(defun compatible-state?
  "Test whether MANIFEST can be reused for OPTIONS and METADATA."
  [metadata manifest options]
  (and (= (:state-format metadata) (:format manifest))
       (= (:schema-version metadata) (:schema-version manifest))
       (= (state-options options) (:options manifest))))

(defun package-manifest-current?
  "Test whether the package manifest metadata recorded in MANIFEST is current."
  [{:keys [package-manifest]}]
  (and (io/file? (:path package-manifest))
       (= (:mtime-ms package-manifest)
          (modified-ms (:path package-manifest)))))

(defun update-roo-sources!
  "Replace or remove Roo source contributions and publish one revision delta."
  [metadata state-dir manifest paths]
  (let [base-revision (:revision manifest)
        next-revision (+ base-revision 1)
        result
        (reduce paths
                {:manifest manifest
                 :replace {}
                 :remove []
                 :changed? false}
                (fn [result path]
                  (let [current-manifest (:manifest result)
                        current-sources (:sources current-manifest)
                        existing (get current-sources path)]
                    (cond
                      (io/file? path)
                      (let [id (if existing
                                 (:id existing)
                                 (:next-source-id current-manifest))
                            shard (shard-relative-path id next-revision)
                            contribution (source/roo-contribution (:package-dir (:options current-manifest)) (:name (:package current-manifest)) path)
                            next-id (if existing
                                      (:next-source-id current-manifest)
                                      (+ id 1))]
                        (io/spit-edn! (io/join-path state-dir shard)
                                      contribution
                                      {:atomic? true})
                        {:manifest
                         (assoc current-manifest
                                :sources
                                (assoc current-sources
                                       path
                                       {:id id
                                        :kind :roo
                                        :mtime-ms (modified-ms path)
                                        :shard shard})
                                :next-source-id next-id)
                         :replace (assoc (:replace result)
                                         (:index-path contribution)
                                         (published-contribution contribution))
                         :remove (:remove result)
                         :changed? true})

                      existing
                      (let [index-path (path/package-relative (:package-dir (:options current-manifest)) path)]
                        {:manifest (assoc current-manifest
                                          :sources
                                          (dissoc current-sources path))
                         :replace (:replace result)
                         :remove (append (:remove result) index-path)
                         :changed? true})

                      true
                      result))))
        changed? (:changed? result)
        revision (if changed? next-revision base-revision)
        published-manifest (cond-> (:manifest result)
                                   changed?
                                   (assoc :revision revision))
        delta {:format (:delta-format metadata)
               :schema-version (:schema-version metadata)
               :base-revision base-revision
               :revision revision
               :replace (:replace result)
               :remove (:remove result)}]
    (when changed?
      (io/spit-edn! (manifest-path state-dir)
                    published-manifest
                    {:atomic? true}))
    {:manifest published-manifest
     :snapshot nil
     :delta delta}))

(defun native-path?
  "Test whether PATH is recorded or classified as a native source."
  [manifest path]
  (let [entry (get (:sources manifest) path)]
    (= :native (if entry (:kind entry) (source-kind path)))))

(defun reconcile!
  "Reconcile persisted state against all current package inputs by mtime."
  [metadata options state-dir manifest]
  (let [inputs (source/package-inputs (path/canonical (:package-dir options)))
        current (unique-paths (concat (:roo inputs) (:native inputs)))
        existing (keys (:sources manifest))
        changed (filter current
                        (fn [path]
                          (let [entry (get (:sources manifest) path)]
                            (or (nil? entry)
                                (not= (:mtime-ms entry) (modified-ms path))))))
        removed (filter existing (fn [path] (not (contains? current path))))
        affected (unique-paths (concat changed removed))]
    (if (any? affected (fn [path] (native-path? manifest path)))
      (full-build! metadata options state-dir (:revision manifest))
      (update-roo-sources! metadata state-dir manifest affected))))

(defun index-with-state
  "Update or initialize a dynamic lookup index state store.

  Args:
  - `options`: Parsed index command options.

  Returns:
  Published manifest, optional snapshot, and revision delta."
  [options]
  (let [metadata INDEX-METADATA
        state-dir (path/canonical (:state options))
        state-file (manifest-path state-dir)
        existing (when (io/file? state-file) (io/slurp-edn! state-file))
        updates (unique-paths (map (:updates options) path/canonical))
        result
        (cond
          (nil? existing)
          (full-build! metadata options state-dir nil)

          (not (compatible-state? metadata existing options))
          (full-build! metadata options state-dir (:revision existing))

          (not (package-manifest-current? existing))
          (full-build! metadata options state-dir (:revision existing))

          (not-empty? updates)
          (if (any? updates (fn [path] (native-path? existing path)))
            (full-build! metadata options state-dir (:revision existing))
            (update-roo-sources! metadata state-dir existing updates))

          true
          (reconcile! metadata options state-dir existing))
        need-snapshot? (or (nil? (:emit-delta options))
                           (some? (:out options)))
        full-snapshot (or (:snapshot result)
                          (when need-snapshot?
                            (manifest-snapshot state-dir (:manifest result))))]
    (assoc result :snapshot full-snapshot)))
