(ns lookup.cli-test
  (:require proof.core
            [lookup.cli :as cli]))

(deftest reports-usage-lines
  (is (= ["Usage: lookup [--help|--version]"
          "       lookup index [-x extractor]... [--root <dir>]... [--exclude <path>]... [-o <file>] [<package-dir>]"
          "       lookup thing-at <package-dir> <file> <line> <column>"]
         cli/usage-lines)))

(deftest reports-help-lines
  (is (= ["lookup: build Roo symbol index artifacts"
          "Usage: lookup [--help|--version]"
          "       lookup index [-x extractor]... [--root <dir>]... [--exclude <path>]... [-o <file>] [<package-dir>]"
          "       lookup thing-at <package-dir> <file> <line> <column>"
          ""
          "Extractors: forms, symbols, native"
          "Default: symbols for packages, native for roots"
          "Roots are scanned by applicable extractors; excludes skip paths and subtrees"]
         (cli/help-lines))))

(deftest reports-version-text
  (is (= "lookup 0.1.0" (cli/version-text))))

(deftest resolves-help-commands
  (is (= :help (cli/command [])))
  (is (= :help (cli/command ["--help"])))
  (is (= :help (cli/command ["-h"]))))

(deftest resolves-version-command
  (is (= :version (cli/command ["--version"]))))

(deftest resolves-index-command
  (is (= :index (cli/command ["index" "pkg/lookup"]))))

(deftest parses-default-index-options
  (is (= {:extractors [:symbols]
          :out nil
          :package-dir "pkg/lookup"
          :roots []
          :excludes []
          :errors []}
         (cli/parse-index-args ["pkg/lookup"]))))

(deftest parses-repeated-index-extractors
  (is (= {:extractors [:forms :symbols]
          :out nil
          :package-dir "pkg/lookup"
          :roots []
          :excludes []
          :errors []}
         (cli/parse-index-args ["-x" "forms" "-x" "symbols" "pkg/lookup"]))))

(deftest parses-index-roots-and-excludes
  (is (= {:extractors [:symbols]
          :out nil
          :package-dir "pkg/lookup"
          :roots ["lib/libroo/include" "lib/libroo/src"]
          :excludes ["lib/libroo/test"]
          :errors []}
         (cli/parse-index-args ["--root" "lib/libroo/include"
                                "--root" "lib/libroo/src"
                                "--exclude" "lib/libroo/test"
                                "pkg/lookup"]))))

(deftest parses-native-only-index-options
  (is (= {:extractors [:native]
          :out nil
          :package-dir nil
          :roots ["lib/libroo/include"]
          :excludes []
          :errors []}
         (cli/parse-index-args ["--root" "lib/libroo/include"]))))

(deftest parses-explicit-native-index-options
  (is (= {:extractors [:native]
          :out nil
          :package-dir nil
          :roots ["lib/libroo/include"]
          :excludes ["lib/libroo/test"]
          :errors []}
         (cli/parse-index-args ["-x" "native"
                                "--root" "lib/libroo/include"
                                "--exclude" "lib/libroo/test"]))))

(deftest parses-index-output-file
  (is (= {:extractors [:symbols]
          :out "build/lookup.edn"
          :package-dir "pkg/lookup"
          :roots []
          :excludes []
          :errors []}
         (cli/parse-index-args ["-o" "build/lookup.edn" "pkg/lookup"]))))

(deftest reports-index-option-errors
  (let [missing-extractor (cli/parse-index-args ["-x"])
        missing-root (cli/parse-index-args ["--root"])
        missing-exclude (cli/parse-index-args ["--exclude"])
        unknown-option (cli/parse-index-args ["--wat" "pkg/lookup"])
        missing-input (cli/parse-index-args [])
        native-forms (cli/parse-index-args ["-x" "forms"
                                            "--root"
                                            "lib/libroo/include"])
        native-without-root (cli/parse-index-args ["-x" "native" "pkg/lookup"])
        extra-arg (cli/parse-index-args ["pkg/lookup" "extra"])]
    (is (contains? (:errors missing-extractor) "Missing extractor after -x"))
    (is (contains? (:errors missing-root) "Missing directory after --root"))
    (is (contains? (:errors missing-exclude) "Missing path after --exclude"))
    (is (contains? (:errors unknown-option) "Unknown index option: --wat"))
    (is (contains? (:errors missing-input) "Missing package directory or root"))
    (is (contains? (:errors native-forms)
                   "Package directory required for forms extractor"))
    (is (contains? (:errors native-without-root)
                   "Root required for native extractor"))
    (is (contains? (:errors extra-arg) "Unexpected index argument: extra"))))

(deftest resolves-thing-at-command
  (is (= :thing-at (cli/command ["thing-at" "pkg/lookup" "src/sample.roo" "1" "1"]))))

(deftest resolves-unknown-commands-to-usage
  (is (= :usage (cli/command ["wat"]))))
