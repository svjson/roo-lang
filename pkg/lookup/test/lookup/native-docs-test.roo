(ns lookup.native-docs-test
  (:require proof.core
            [lookup.native-docs :as native-docs]))

(deftest parses-cpp-native-header-comment
  (let [doc (native-docs/from-cpp-comment
              "/*!
               * @brief Read the complete contents of a text file as a string.
               *
               * Usage:
               * @code
               * (roo.io/slurp! \"notes.txt\") => \"file contents\"
               * @endcode
               *
               * | Arg # | Description                                                        |
               * | ----- | ------------------------------------------------------------------ |
               * | 0     | The path of the file to read.                                      |
               */")]
    (is (= "Read the complete contents of a text file as a string."
           (:summary doc)))
    (is (= nil (:body doc)))
    (is (= :markdown (:format doc)))
    (is (= {:type nil :doc "The path of the file to read."}
           (get (:params doc) "0")))
    (is (= [{:format :roo
             :source "(roo.io/slurp! \"notes.txt\") => \"file contents\""}]
           (:examples doc)))))

(deftest parses-cpp-native-header-comment-body-and-continuation
  (let [doc (native-docs/from-cpp-comment
              "/**
               * @brief Shifts an integer value right by one bit, or by the given
               * number of bits.
               *
               * `>>` is the signed/arithmetic right shift operator. Negative values
               * keep their sign through the shift.
               *
               * Usage:
               * @code
               * (>> 8)
               * => 4
               * @endcode
               *
               * | Arg # | Description                                                        |
               * | ----- | ------------------------------------------------------------------ |
               * | 0     | Integer value to shift.                                            |
               * | 1     | Optional integer number of bits to shift by. Defaults to 1.        |
               */")]
    (is (= "Shifts an integer value right by one bit, or by the given number of bits."
           (:summary doc)))
    (is (= "`>>` is the signed/arithmetic right shift operator. Negative values\nkeep their sign through the shift."
           (:body doc)))
    (is (= {:type nil :doc "Integer value to shift."}
           (get (:params doc) "0")))
    (is (= {:type nil
            :doc "Optional integer number of bits to shift by. Defaults to 1."}
           (get (:params doc) "1")))
    (is (= [{:format :roo
             :source "(>> 8)\n=> 4"}]
           (:examples doc)))))

(deftest parses-cpp-native-header-comment-with-spaced-table-separator
  (let [doc (native-docs/from-cpp-comment
              "/**
               * @brief Read a path.
               *
               * | Arg   | Description                                                        |
               * | ----- | ------------------------------------------------------------------ |
               * | path  | Path to read from.                                                 |
               * |       | a fixture.                                                        |
               */")]
    (is (= {:type nil :doc "Path to read from. a fixture."}
           (get (:params doc) "path")))))

(deftest builds-native-signature-with-named-cpp-arguments
  (let [doc (native-docs/from-cpp-comment
              "/**
               * @brief Collect values from a path.
               *
               * | Arg       | Description                                                        |
               * | --------- | ------------------------------------------------------------------ |
               * | path      | Path to read.                                                      |
               * | values... | Additional values.                                                 |
               */")
        signature (native-docs/native-signature "collect" doc)]
    (is (= "(collect path values...)" (:display signature)))
    (is (= [{:name "path"
             :display "path"
             :type nil
             :doc "Path to read."
             :optional? false
             :rest? false
             :group? false}
            {:name "values"
             :display "values..."
             :type nil
             :doc "Additional values."
             :optional? true
             :rest? true
             :group? false}]
           (:params signature)))
    (is (= {:min 1 :max nil :variadic true}
           (:arity signature)))))


(deftest builds-native-signature-with-repeating-argument-groups
  (let [doc (native-docs/from-cpp-comment
              "/**
               * @brief Branch by pairs.
               *
               * | Arg                   | Description                                   |
               * | --------------------- | --------------------------------------------- |
               * | value                 | Value to match.                               |
               * | (condition result)... | Repeated condition/result pairs.              |
               */")
        signature (native-docs/native-signature "cond" doc)]
    (is (= "(cond value (condition result)...)" (:display signature)))
    (is (= [{:name "value"
             :display "value"
             :type nil
             :doc "Value to match."
             :optional? false
             :rest? false
             :group? false}
            {:name "condition result"
             :display "(condition result)..."
             :type nil
             :doc "Repeated condition/result pairs."
             :optional? true
             :rest? true
             :group? true
             :group {:params ["condition" "result"]}}]
           (:params signature)))
    (is (= {:min 1 :max nil :variadic true}
           (:arity signature)))))

(deftest builds-multiple-native-signatures-from-multiple-arg-tables
  (let [doc (native-docs/from-cpp-comment
              "/**
               * @brief Read a value.
               *
               * | Arg  | Description                                   |
               * | ---- | --------------------------------------------- |
               * | path | Path to read.                                 |
               *
               * | Arg      | Description                                |
               * | -------- | ------------------------------------------ |
               * | path     | Path to read.                              |
               * | fallback | Value returned when the path is missing.   |
               */")
        signatures (native-docs/native-signatures "read" doc)]
    (is (= 2 (count signatures)))
    (is (= ["(read path)" "(read path fallback)"]
           (map signatures :display)))
    (is (= "Value returned when the path is missing."
           (:doc (nth (:params (nth signatures 1)) 1))))))

(deftest parses-cpp-native-identity-comment
  (is (= {:native-class "SlurpBangFunction"
          :qualified-name "roo.io/slurp!"}
         (native-docs/native-identity-from-cpp-comment
           "/** SlurpBangFunction - roo.io/slurp! */")))
  (is (= {:native-class "PlusFunction"
          :qualified-name "roo/+"}
         (native-docs/native-identity-from-cpp-comment
           "/** PlusFunction - roo/+ */")))
  (is (= {:native-class "MultiplyFunction"
          :qualified-name "roo/*"}
         (native-docs/native-identity-from-cpp-comment
           "/** MultiplyFunction - roo/* */")))
  (is (= nil
         (native-docs/native-identity-from-cpp-comment
           "/* just a note */"))))

(deftest extracts-line-native-identity-comment
  (let [entries (native-docs/source-native-comment-entries
                  "operator.cpp"
                  "// MultiplyFunction - roo/*\nFUNC_IMPL(MultiplyFunction, nil)")]
    (is (= [{:kind :native-identity-comment
             :source {:path "operator.cpp" :line 1 :column 1}
             :native-class "MultiplyFunction"
             :qualified-name "roo/*"}]
           entries))))

(deftest locates-package-native-source-files
  (is (= ["assets/native-package/native/include/sample.h"
          "assets/native-package/native/src/sample.cpp"]
         (native-docs/package-native-source-files "assets/native-package"))))

(deftest extracts-native-doc-comment-entries-from-source
  (let [entries (native-docs/source-native-comment-entries!
                  "assets/native-package/native/include/sample.h")
        entry (find-first entries
                          (fn [entry]
                            (= :native-doc-comment (:kind entry))))
        doc (:doc entry)]
    (is (= 1 (count entries)))
    (is (= "SampleReadFunction" (:native-class entry)))
    (is (= :function (:native-kind entry)))
    (is (= "Read fixture data from a path." (:summary doc)))
    (is (= "The fixture keeps this as a separate paragraph." (:body doc)))
    (is (= {:type nil :doc "Path to read."}
           (get (:params doc) "path")))
    (is (= [{:format :roo
             :source "(sample.native/read! \"fixture.txt\")\n=> \"contents\""}]
           (:examples doc)))
    (is (= {:path "assets/native-package/native/include/sample.h"
            :line 6
            :column 1}
           (:source entry)))
    (is (= {:path "assets/native-package/native/include/sample.h"
            :line 21
            :column 1}
           (:declaration-source entry)))))

(deftest extracts-native-identity-comment-entries-from-source
  (let [entries (native-docs/source-native-comment-entries!
                  "assets/native-package/native/src/sample.cpp")
        entry (find-first entries
                          (fn [entry]
                            (= :native-identity-comment (:kind entry))))]
    (is (= 1 (count entries)))
    (is (= "SampleReadFunction" (:native-class entry)))
    (is (= "sample.native/read!" (:qualified-name entry)))
    (is (= {:path "assets/native-package/native/src/sample.cpp"
            :line 5
            :column 1}
           (:source entry)))))

(deftest extracts-native-comment-entries-from-generic-source-root
  (let [entries (native-docs/native-source-root-comment-entries!
                  ["assets/native-package/native"]
                  [])
        kinds (map entries :kind)]
    (is (= 2 (count entries)))
    (is (= [:native-doc-comment :native-identity-comment] kinds))))

(deftest excludes-native-source-root-subtrees
  (is (= ["assets/native-root-only/include/extra.h"
          "assets/native-root-only/src/extra.cpp"]
         (native-docs/native-source-root-files
           "assets"
           ["assets/native-package"]))))

(deftest extracts-package-native-comment-entries
  (let [entries (native-docs/package-native-comment-entries! "assets/native-package")
        kinds (map entries :kind)]
    (is (= 2 (count entries)))
    (is (= [:native-doc-comment :native-identity-comment] kinds))))

(deftest builds-native-symbol-entries-from-generic-source-root
  (let [symbols (native-docs/native-source-root-symbol-entries!
                  "native-fixture"
                  ["assets/native-package/native"]
                  [])
        symbol (head symbols)]
    (is (= 1 (count symbols)))
    (is (= "sample.native/read!" (:qualified-name symbol)))
    (is (= "Read fixture data from a path."
           (:summary (:doc symbol))))))

(deftest builds-native-symbol-entries
  (let [entries (native-docs/package-native-comment-entries! "assets/native-package")
        symbols (native-docs/native-symbol-entries "native-fixture" entries)
        symbol (head symbols)
        signature (head (:signatures symbol))]
    (is (= 1 (count symbols)))
    (is (= "sample.native/read!" (:qualified-name symbol)))
    (is (= "read!" (:name symbol)))
    (is (= "sample.native" (:namespace symbol)))
    (is (= "native-fixture" (:package symbol)))
    (is (= :function (:kind symbol)))
    (is (= :native (:origin symbol)))
    (is (= "Read fixture data from a path." (:summary (:doc symbol))))
    (is (= {:kind :native-cpp-comment
            :source {:path "assets/native-package/native/include/sample.h"
                     :line 6
                     :column 1}}
           (:doc-source symbol)))
    (is (= {:path "assets/native-package/native/src/sample.cpp"
            :line 5
            :column 1}
           (:source symbol)))
    (is (= "(read! path)" (:display signature)))
    (is (= [{:name "path"
             :display "path"
             :type nil
             :doc "Path to read."
             :optional? false
             :rest? false
             :group? false}]
           (:params signature)))))
