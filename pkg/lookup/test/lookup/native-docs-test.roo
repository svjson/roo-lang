(ns lookup.native-docs-test
  (:require proof.core
            [lookup.native-docs :as native-docs]))

(deftest parses-cpp-native-header-comment
  (let [doc (native-docs/from-cpp-comment
              "/*!
               * @brief Read the complete contents of a text file as a string.
               *
               * Usage:
               * @code
               * (roo.io/slurp! \"notes.txt\") => \"file contents\"
               * @endcode
               *
               * | Arg # | Description                   |
               * |-------|-------------------------------|
               * | 0     | The path of the file to read. |
               */")]
    (is (= "Read the complete contents of a text file as a string."
           (:summary doc)))
    (is (= nil (:body doc)))
    (is (= :markdown (:format doc)))
    (is (= {:type nil :doc "The path of the file to read."}
           (get (:params doc) "0")))
    (is (= [{:format :roo
             :source "(roo.io/slurp! \"notes.txt\") => \"file contents\""}]
           (:examples doc)))))

(deftest parses-cpp-native-header-comment-body-and-continuation
  (let [doc (native-docs/from-cpp-comment
              "/**
               * @brief Shifts an integer value right by one bit, or by the given
               * number of bits.
               *
               * `>>` is the signed/arithmetic right shift operator. Negative values
               * keep their sign through the shift.
               *
               * Usage:
               * @code
               * (>> 8)
               * => 4
               * @endcode
               *
               * | Arg # | Description                                                 |
               * |-------|-------------------------------------------------------------|
               * | 0     | Integer value to shift.                                     |
               * | 1     | Optional integer number of bits to shift by. Defaults to 1. |
               */")]
    (is (= "Shifts an integer value right by one bit, or by the given number of bits."
           (:summary doc)))
    (is (= "`>>` is the signed/arithmetic right shift operator. Negative values\nkeep their sign through the shift."
           (:body doc)))
    (is (= {:type nil :doc "Integer value to shift."}
           (get (:params doc) "0")))
    (is (= {:type nil
            :doc "Optional integer number of bits to shift by. Defaults to 1."}
           (get (:params doc) "1")))
    (is (= [{:format :roo
             :source "(>> 8)\n=> 4"}]
           (:examples doc)))))

(deftest parses-cpp-native-identity-comment
  (is (= {:native-class "SlurpBangFunction"
          :qualified-name "roo.io/slurp!"}
         (native-docs/native-identity-from-cpp-comment
           "/** SlurpBangFunction - roo.io/slurp! */")))
  (is (= nil
         (native-docs/native-identity-from-cpp-comment
           "/* just a note */"))))

(deftest locates-package-native-source-files
  (is (= ["assets/native-package/native/include/sample.h"
          "assets/native-package/native/src/sample.cpp"]
         (native-docs/package-native-source-files "assets/native-package"))))

(deftest extracts-native-doc-comment-entries-from-source
  (let [entries (native-docs/source-native-comment-entries!
                  "assets/native-package/native/include/sample.h")
        entry (find-first entries
                          (fn [entry]
                            (= :native-doc-comment (:kind entry))))
        doc (:doc entry)]
    (is (= 1 (count entries)))
    (is (= "SampleReadFunction" (:native-class entry)))
    (is (= :function (:native-kind entry)))
    (is (= "Read fixture data from a path." (:summary doc)))
    (is (= "The fixture keeps this as a separate paragraph." (:body doc)))
    (is (= {:type nil :doc "Path to read."}
           (get (:params doc) "0")))
    (is (= [{:format :roo
             :source "(sample.native/read! \"fixture.txt\")\n=> \"contents\""}]
           (:examples doc)))
    (is (= {:path "assets/native-package/native/include/sample.h"
            :line 6
            :column 1}
           (:source entry)))
    (is (= {:path "assets/native-package/native/include/sample.h"
            :line 21
            :column 1}
           (:declaration-source entry)))))

(deftest extracts-native-identity-comment-entries-from-source
  (let [entries (native-docs/source-native-comment-entries!
                  "assets/native-package/native/src/sample.cpp")
        entry (find-first entries
                          (fn [entry]
                            (= :native-identity-comment (:kind entry))))]
    (is (= 1 (count entries)))
    (is (= "SampleReadFunction" (:native-class entry)))
    (is (= "sample.native/read!" (:qualified-name entry)))
    (is (= {:path "assets/native-package/native/src/sample.cpp"
            :line 5
            :column 1}
           (:source entry)))))

(deftest extracts-package-native-comment-entries
  (let [entries (native-docs/package-native-comment-entries! "assets/native-package")
        kinds (map entries :kind)]
    (is (= 2 (count entries)))
    (is (= [:native-doc-comment :native-identity-comment] kinds))))
