(ns lookup.command.index-test
  (:require proof.core
            [lookup.command.index :as index-command]))



;; lookup.command.index/parse-args

(deftest parse-args/defaults-to-symbols-for-a-package
  (is (= {:extractors [:symbols]
          :out nil
          :package-dir "pkg/lookup"
          :roots []
          :excludes []
          :state nil
          :updates []
          :emit-delta nil
          :package-name nil
          :package-version nil
          :package-description nil
          :errors []}
         (index-command/parse-args ["pkg/lookup"]))))

(deftest parse-args/accumulates-repeated-extractors
  (is (= {:extractors [:forms :symbols]
          :out nil
          :package-dir "pkg/lookup"
          :roots []
          :excludes []
          :state nil
          :updates []
          :emit-delta nil
          :package-name nil
          :package-version nil
          :package-description nil
          :errors []}
         (index-command/parse-args ["-x" "forms" "-x" "symbols" "pkg/lookup"]))))

(deftest parse-args/accumulates-roots-and-excludes
  (is (= {:extractors [:symbols]
          :out nil
          :package-dir "pkg/lookup"
          :roots ["lib/libroo/include" "lib/libroo/src"]
          :excludes ["lib/libroo/test"]
          :state nil
          :updates []
          :emit-delta nil
          :package-name nil
          :package-version nil
          :package-description nil
          :errors []}
         (index-command/parse-args ["--root" "lib/libroo/include"
                                    "--root" "lib/libroo/src"
                                    "--exclude" "lib/libroo/test"
                                    "pkg/lookup"]))))

(deftest parse-args/defaults-to-native-for-a-root-only-index
  (is (= {:extractors [:native]
          :out nil
          :package-dir nil
          :roots ["lib/libroo/include"]
          :excludes []
          :state nil
          :updates []
          :emit-delta nil
          :package-name nil
          :package-version nil
          :package-description nil
          :errors []}
         (index-command/parse-args ["--root" "lib/libroo/include"]))))

(deftest parse-args/accepts-native-index-package-metadata
  (is (= {:extractors [:native]
          :out nil
          :package-dir nil
          :roots ["lib/libroo/include"]
          :excludes []
          :state nil
          :updates []
          :emit-delta nil
          :package-name "roo"
          :package-version "0.1.0"
          :package-description "Roo standard library."
          :errors []}
         (index-command/parse-args ["--root" "lib/libroo/include"
                                    "--package-name" "roo"
                                    "--package-version" "0.1.0"
                                    "--package-description"
                                    "Roo standard library."]))))

(deftest parse-args/accepts-an-explicit-native-extractor
  (is (= {:extractors [:native]
          :out nil
          :package-dir nil
          :roots ["lib/libroo/include"]
          :excludes ["lib/libroo/test"]
          :state nil
          :updates []
          :emit-delta nil
          :package-name nil
          :package-version nil
          :package-description nil
          :errors []}
         (index-command/parse-args ["-x" "native"
                                    "--root" "lib/libroo/include"
                                    "--exclude" "lib/libroo/test"]))))

(deftest parse-args/accepts-an-output-file
  (is (= {:extractors [:symbols]
          :out "build/lookup.edn"
          :package-dir "pkg/lookup"
          :roots []
          :excludes []
          :state nil
          :updates []
          :emit-delta nil
          :package-name nil
          :package-version nil
          :package-description nil
          :errors []}
         (index-command/parse-args ["-o" "build/lookup.edn" "pkg/lookup"]))))

(deftest parse-args/accepts-state-updates-and-edn-delta-output
  (is (= {:extractors [:symbols]
          :out nil
          :package-dir "pkg/lookup"
          :roots []
          :excludes []
          :state ".lookup/index"
          :updates ["src/foo.roo" "src/bar.roo"]
          :emit-delta :edn
          :package-name nil
          :package-version nil
          :package-description nil
          :errors []}
         (index-command/parse-args ["pkg/lookup"
                                    "--state" ".lookup/index"
                                    "--update" "src/foo.roo"
                                    "--update" "src/bar.roo"
                                    "--emit-delta" "edn"]))))

(deftest parse-args/rejects-a-missing-extractor-after-x
  (is (= ["Missing extractor after -x"]
         (:errors (index-command/parse-args ["pkg/lookup" "-x"])))))

(deftest parse-args/rejects-a-missing-directory-after-root
  (is (= ["Missing directory after --root"]
         (:errors (index-command/parse-args ["pkg/lookup" "--root"])))))

(deftest parse-args/rejects-a-missing-path-after-exclude
  (is (= ["Missing path after --exclude"]
         (:errors (index-command/parse-args ["pkg/lookup" "--exclude"])))))

(deftest parse-args/rejects-a-missing-directory-after-state
  (is (= ["Missing directory after --state"]
         (:errors (index-command/parse-args ["pkg/lookup" "--state"])))))

(deftest parse-args/requires-state-for-an-explicit-update
  (is (= ["--update requires --state"]
         (:errors
           (index-command/parse-args
             ["pkg/lookup" "--update" "src/foo.roo"])))))

(deftest parse-args/requires-state-for-delta-output
  (is (= ["--emit-delta requires --state"]
         (:errors
           (index-command/parse-args
             ["pkg/lookup" "--emit-delta" "edn"])))))

(deftest parse-args/rejects-an-unknown-delta-format
  (is (= ["Unknown delta format: json"]
         (:errors
           (index-command/parse-args
             ["pkg/lookup"
              "--state" ".lookup/index"
              "--emit-delta" "json"])))))

(deftest parse-args/rejects-an-unknown-option
  (is (= ["Unknown index option: --wat"]
         (:errors (index-command/parse-args ["--wat" "pkg/lookup"])))))

(deftest parse-args/requires-a-package-directory-or-root
  (is (= ["Missing package directory or root"]
         (:errors (index-command/parse-args [])))))

(deftest parse-args/requires-a-package-directory-for-the-forms-extractor
  (is (= ["Package directory required for forms extractor"]
         (:errors
           (index-command/parse-args
             ["-x" "forms" "--root" "lib/libroo/include"])))))

(deftest parse-args/requires-a-root-for-the-native-extractor
  (is (= ["Root required for native extractor"]
         (:errors
           (index-command/parse-args ["-x" "native" "pkg/lookup"])))))

(deftest parse-args/rejects-an-extra-positional-argument
  (is (= ["Unexpected index argument: extra"]
         (:errors (index-command/parse-args ["pkg/lookup" "extra"])))))
