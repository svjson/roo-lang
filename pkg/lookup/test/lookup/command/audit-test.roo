(ns lookup.command.audit-test
  (:require proof.core
            [lookup.command.audit :as audit-command]))


;;; lookup.command.audit/text-lines

(deftest text-lines/formats-audit-text-output
  (is (= ["lookup audit: 2 diagnostics"
          "warning missing-doc-summary sample/missing: Missing documentation summary."
          "warning missing-param-doc sample/missing: Missing parameter documentation. [(missing value), param: value]"
          "lookup audit: failed"]
         (audit-command/text-lines {:diagnostics [{:severity :warning
                                                   :kind :missing-doc-summary
                                                   :symbol "sample/missing"
                                                   :message "Missing documentation summary."}
                                                  {:severity :warning
                                                   :kind :missing-param-doc
                                                   :symbol "sample/missing"
                                                   :message "Missing parameter documentation."
                                                   :signature "(missing value)"
                                                   :param "value"}]
                                    :failed? true}))))

(deftest text-lines/formats-empty-audit-text-output
  (is (= ["lookup audit: no diagnostics"]
         (audit-command/text-lines {:diagnostics [] :failed? false}))))
