(ns lookup.source-test
  (:require proof.core
            [lookup.source :as source]))

(deftest source/identifies-roo-source-files
  (is (source/source-file? "src/index/_index.roo"))
  (is (= false (source/source-file? "package.edn"))))

(deftest source-entry/reads-broken-source-file-into-error-entry
  (is (= {:path "assets/broken-syntax.roo"
          :forms [{:error "Could not read Roo forms from assets/broken-syntax.roo: Unexpected end of input"
                   :path "assets/broken-syntax.roo"
                   :source {:path "assets/broken-syntax.roo"}}]}
         (source/source-entry "assets/broken-syntax.roo"))))

(deftest package-load-roots/combines-explicit-and-inferred-production-roots
  (is (= ["lib" "assets" "generated" "testing"]
         (source/package-load-roots
           {:load-roots ["src/../lib" "./assets"]
            :namespace-roots {"app" "lib/app"
                              "generated" "generated"
                              "fixtures" "testing"}
            :dev {:namespace-roots {"app" "test"}}}))))

(deftest package-load-roots/defaults-to-src-without-source-root-fields
  (is (= ["src"] (source/package-load-roots {}))))
