(ns lookup.source.docstring.symbols-test
  (:require proof.core
            [proof.syntax :as p]
            [lookup.reader :as reader]
            [lookup.source.docstring.symbols :as docstring-symbols]))



;; lookup.source.docstring.symbols/source-namespace-entry

(deftest source-namespace-entry/extracts-namespace-docstrings
  (let [source-location {:path "src/sample/docs.roo"
                         :line 1
                         :column 1}]
    (is (= {:name "sample.docs"
            :source source-location
            :summary "Sample namespace."
            :content [{:kind :text :content "Sample namespace."}]
            :doc-source {:kind :roo-docstring
                         :source source-location}}
           (docstring-symbols/source-namespace-entry
             {:forms [{:form '(ns sample.docs "Sample namespace.")
                       :source source-location}]})))))



;; lookup.source.docstring.symbols/source-symbols

(deftest source-symbols/extracts-docstrings-from-def-and-defun
  (p/given
    {:path "assets/docstrings-sample.roo"
     :forms (reader/read-file-forms! "assets/docstrings-sample.roo")})

  (p/when [source]
    (docstring-symbols/source-symbols "sample" source))

  (p/then [entries]
    (is (= [{:id "sample.docs/answer"
             :name "answer"
             :qualified-name "sample.docs/answer"
             :namespace "sample.docs"
             :package "sample"
             :kind :var
             :origin :source
             :visibility :public
             :status :stable
             :source {:path "assets/docstrings-sample.roo"
                      :line 3
                      :column 1
                      :start {:line 3 :column 1}
                      :end {:line 8 :column 5}}
             :summary "The answer used by examples."
             :content [{:kind :text
                        :content "The answer used by examples."}]
             :since "0.1.0"
             :doc-source {:kind :roo-docstring
                          :source {:path "assets/docstrings-sample.roo"
                                   :line 3
                                   :column 1
                                   :start {:line 3 :column 1}
                                   :end {:line 8 :column 5}}}
             :signatures []}
            {:id "sample.docs/greet"
             :name "greet"
             :qualified-name "sample.docs/greet"
             :namespace "sample.docs"
             :package "sample"
             :kind :function
             :origin :source
             :visibility :public
             :status :stable
             :source {:path "assets/docstrings-sample.roo"
                      :line 10
                      :column 1
                      :start {:line 10 :column 1}
                      :end {:line 32 :column 25}}
             :summary "Build a greeting for `name`."
             :content [{:kind :text
                        :content "Build a greeting for `name`."}
                       {:kind :text
                        :content "Uses a friendly default format."}
                       {:kind :sig-args :index 0}
                       {:kind :sig-ret :index 0}
                       {:kind :header :content "Examples:"}
                       {:kind :code :content "(greet \"Ada\" \"Dr.\")"}]
             :see ["str"]
             :doc-source {:kind :roo-docstring
                          :source {:path "assets/docstrings-sample.roo"
                                   :line 10
                                   :column 1
                                   :start {:line 10 :column 1}
                                   :end {:line 32 :column 25}}}
             :signatures [{:display "(greet name & title)"
                           :params [{:name "name"
                                     :display "name"
                                     :optional? false
                                     :rest? false
                                     :content [{:kind :text
                                                :content "Person to greet."}]}
                                    {:name "title"
                                     :display "title"
                                     :optional? true
                                     :rest? false
                                     :content [{:kind :text
                                                :content "Optional title."}]}]
                           :returns {:content [{:kind :text
                                               :content "A greeting string."}]}
                           :arity {:min 1 :max 2 :variadic false}}]}]
           entries))))
