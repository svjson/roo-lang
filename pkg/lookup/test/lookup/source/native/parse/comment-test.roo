(ns lookup.source.native.parse.comment-test
  (:require proof.core
            [lookup.source.native.parse.comment :as comment]))



;; lookup.source.native.parse.comment/parse

(deftest parse/returns-ordered-documentation
  (is (= {:summary "Read the complete contents of a text file as a string."
          :content [{:kind :text
                     :content "Read the complete contents of a text file as a string."}
                    {:kind :header :content "Usage:"}
                    {:kind :code
                     :content "(roo.io/slurp! \"notes.txt\") => \"file contents\""}
                    {:kind :sig-args :index 0}]
          :signature-docs
          [{:params {"0" {:content [{:kind :text
                                     :content "The path of the file to read."}]}}
            :param-order ["0"]}]}
         (comment/parse
           "/*!
            * @brief Read the complete contents of a text file as a string.
            *
            * Usage:
            * @code
            * (roo.io/slurp! \"notes.txt\") => \"file contents\"
            * @endcode
            *
            * | Arg # | Description                           |
            * | ----- | ------------------------------------- |
            * | 0     | The path of the file to read.         |
            */"))))

(deftest parse/retains-multiline-brief-parameters-and-table-rows
  (is (= {:summary
          "Shift an integer value right by one bit, or by the given\nnumber of bits."
          :content [{:kind :text
                     :content
                     "Shift an integer value right by one bit, or by the given\nnumber of bits."}
                    {:kind :sig-args :index 0}]
          :signature-docs
          [{:params
            {"0" {:content [{:kind :text
                             :content "Integer value to shift."}]}
             "1" {:content [{:kind :text
                             :content
                             "Optional number of bits to shift by.\nDefaults to 1."}]}}
            :param-order ["0" "1"]}]}
         (comment/parse
           "/**
            * @brief Shift an integer value right by one bit, or by the given
            * number of bits.
            *
            * | Arg # | Description                               |
            * | ----- | ----------------------------------------- |
            * | 0     | Integer value to shift.                   |
            * | 1     | Optional number of bits to shift by.      |
            * |       | Defaults to 1.                            |
            */"))))

(deftest parse/keeps-return-before-grouped-args-in-one-signature
  (is (= {:summary "Choose the result for the first truthy condition."
          :content [{:kind :text
                     :content "Choose the result for the first truthy condition."}
                    {:kind :sig-ret :index 0}
                    {:kind :sig-args :index 0}]
          :signature-docs
          [{:returns {:content [{:kind :text
                                 :content "The selected result."}]}
            :params
            {"(condition result)..."
             {:content [{:kind :text
                         :content "Repeated condition/result pairs."}]}}
            :param-order ["(condition result)..."]}]}
         (comment/parse
           "/*!
            * @brief Choose the result for the first truthy condition.
            *
            * @return The selected result.
            *
            * | Arg                    | Description                      |
            * |------------------------|----------------------------------|
            * | (condition result)...  | Repeated condition/result pairs. |
            */"))))

(deftest parse/reuses-one-return-across-signatures-without-adding-an-occurrence
  (is (= {:summary "Open a resource."
          :content [{:kind :text :content "Open a resource."}
                    {:kind :sig-args :index 0}
                    {:kind :text :content "An explicit mode is also accepted."}
                    {:kind :sig-args :index 1}
                    {:kind :sig-ret :index 1}]
          :signature-docs
          [{:params {"path" {:content [{:kind :text
                                        :content "Resource path."}]}}
            :param-order ["path"]
            :returns {:content [{:kind :text
                                 :content "The opened resource.\nOr an error."}]}}
           {:params {"path" {:content [{:kind :text
                                        :content "Resource path."}]}
                     "mode" {:content [{:kind :text
                                        :content "Opening mode."}]}}
            :param-order ["path" "mode"]
            :returns {:content [{:kind :text
                                 :content "The opened resource.\nOr an error."}]}}]}
         (comment/parse
           "/**
            * @brief Open a resource.
            *
            * | Arg  | Description   |
            * | ---- | ------------- |
            * | path | Resource path.|
            *
            * An explicit mode is also accepted.
            *
            * | Arg  | Description   |
            * | ---- | ------------- |
            * | path | Resource path.|
            * | mode | Opening mode. |
            *
            * @returns The opened resource.
            * Or an error.
            */"))))

(deftest parse/accepts-param-sequences
  (is (= {:content [{:kind :sig-args :index 0}
                    {:kind :sig-ret :index 0}]
          :signature-docs
          [{:params {"path" {:content [{:kind :text
                                        :content "Path to read.\nMay be relative."}]}
                     "fallback" {:content [{:kind :text
                                            :content "Value used when absent."}]}}
            :param-order ["path" "fallback"]
            :returns {:content [{:kind :text
                                 :content "The value."}]}}]}
         (comment/parse
           "/*!
            * @param path Path to read.
            * May be relative.
            * @param fallback Value used when absent.
            * @return The value.
            */"))))

(deftest parse/keeps-repeated-returns-on-distinct-signatures
  (is (= {:content [{:kind :sig-ret :index 0}
                    {:kind :sig-args :index 0}
                    {:kind :sig-ret :index 1}
                    {:kind :sig-args :index 1}]
          :signature-docs
          [{:returns {:content [{:kind :text :content "First result."}]}
            :params {"first" {:content [{:kind :text
                                          :content "First input."}]}}
            :param-order ["first"]}
           {:returns {:content [{:kind :text :content "Second result."}]}
            :params {"second" {:content [{:kind :text
                                           :content "Second input."}]}}
            :param-order ["second"]}]}
         (comment/parse
           "/*!
            * @return First result.
            *
            * | Arg   | Description  |
            * |-------|--------------|
            * | first | First input. |
            *
            * @return Second result.
            *
            * | Arg    | Description   |
            * |--------|---------------|
            * | second | Second input. |
            */"))))

(deftest parse/preserves-multiple-return-blocks
  (is (= {:content [{:kind :sig-ret :index 0}
                    {:kind :header :content "Usage:"}]
          :signature-docs
          [{:returns {:content [{:kind :text :content "Result text."}
                                {:kind :text :content "More result detail."}
                                {:kind :code :content "{:ok true}"}]}}]}
         (comment/parse
           "/*!
            * @return Result text.
            *
            * More result detail.
            *
            * @code
            * {:ok true}
            * @endcode
            *
            * Usage:
            */"))))

(deftest parse/retains-native-documentation-metadata
  (is (= {:summary "Read a legacy value."
          :content [{:kind :text :content "Read a legacy value."}]
          :see ["sample.native/read" "sample.native/migrate"]
          :since "0.2.0"
          :deprecated "Use `sample.native/read` instead."}
         (comment/parse
           "/*!
            * @brief Read a legacy value.
            * @see `sample.native/read`
            * @see sample.native/migrate
            * @since 0.2.0
            * @deprecated Use `sample.native/read` instead.
            */"))))

(deftest parse/retains-marker-only-deprecation
  (is (= ""
         (:deprecated
           (comment/parse
             "/*!
              * @brief Read a legacy value.
              * @deprecated
              */")))))



;; Roo Annotations

(deftest annotation/returns-the-declared-native-symbol
  (is (= {:qualified-name "proof.syntax/given"
          :native-kind :special-form}
         (comment/annotation
           "/*!
            * @roo.symbol proof.syntax/given
            * @roo.kind special-form
            * @brief Seed scenario state.
            */"))))

(deftest annotation/rejects-incomplete-or-invalid-directives
  (is (nil? (comment/annotation
              "/*!
               * @roo.symbol proof.syntax/given
               * @brief Missing kind.
               */")))
  (is (nil? (comment/annotation
              "/*!
               * @roo.symbol proof.syntax/given
               * @roo.kind procedure
               */")))
  (is (nil? (comment/annotation
              "/*!
               * @roo.symbol given
               * @roo.kind special-form
               */"))))

(deftest namespace-annotation/returns-the-declared-namespace
  (is (= {:name "roo.ast"}
         (comment/namespace-annotation
           "/*!
            * @roo.namespace roo.ast
            * @brief Read Roo abstract syntax trees.
            */"))))



;; lookup.source.native.parse.comment/identity

(deftest identity/parses-native-implementation-identities
  (is (= {:native-class "SlurpBangFunction"
          :qualified-name "roo.io/slurp!"}
         (comment/identity
           "/** SlurpBangFunction - roo.io/slurp! */")))
  (is (= {:native-class "PlusFunction"
          :qualified-name "roo/+"}
         (comment/identity "/** PlusFunction - roo/+ */")))
  (is (= {:native-class "MultiplyFunction"
          :qualified-name "roo/*"}
         (comment/identity "/** MultiplyFunction - roo/* */")))
  (is (nil? (comment/identity "/* just a note */"))))
