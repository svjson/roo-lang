(ns lookup.source.native.parse.entries-test
  (:require proof.core
            [lookup.source.native.parse.entries :as native-entries]))



;; lookup.source.native.parse.entries/entries

(deftest entries/extracts-annotations-without-interpreting-cpp-registrations
  (is (= [{:kind :native-annotated-symbol
           :doc {:summary "Seed scenario state."
                 :body nil
                 :format :markdown
                 :params {"body..." {:type nil
                                     :doc "State-producing forms."}}
                 :param-order ["body..."]
                 :signature-docs
                 [{:params {"body..." {:type nil
                                       :doc "State-producing forms."}}
                   :param-order ["body..."]}]
                 :returns nil
                 :examples []
                 :see []
                 :since nil
                 :deprecated nil}
           :source {:path "native.cpp" :line 1 :column 1}
           :qualified-name "proof.syntax/given"
           :native-kind :special-form}
          {:kind :native-annotated-symbol
           :doc {:summary "Advance scenario state."
                 :body nil
                 :format :markdown
                 :params {}
                 :param-order []
                 :signature-docs []
                 :returns nil
                 :examples []
                 :see []
                 :since nil
                 :deprecated nil}
           :source {:path "native.cpp" :line 12 :column 1}
           :qualified-name "proof.syntax/when"
           :native-kind :special-form}]
         (native-entries/entries
           "native.cpp"
           "/*!
            * @roo.symbol proof.syntax/given
            * @roo.kind special-form
            * @brief Seed scenario state.
            *
            * | Arg     | Description            |
            * | ------- | ---------------------- |
            * | body... | State-producing forms. |
            */
           ns->store(\"given\", PhaseForm::make(\"given\"));

           /*!
            * @roo.symbol proof.syntax/when
            * @roo.kind special-form
            * @brief Advance scenario state.
            */
           ns->store(\"when\", PhaseForm::make(\"when\"));"))))

(deftest entries/extracts-line-native-identities
  (is (= [{:kind :native-identity-comment
           :source {:path "operator.cpp" :line 1 :column 1}
           :native-class "MultiplyFunction"
           :qualified-name "roo/*"}]
         (native-entries/entries
           "operator.cpp"
           "// MultiplyFunction - roo/*\nFUNC_IMPL(MultiplyFunction, nil)"))))



;; lookup.source.native.parse.entries/entries!

(deftest entries!/returns-the-complete-documentation-entry
  (is (= [{:kind :native-doc-comment
           :native-class "SampleReadFunction"
           :native-kind :function
           :doc {:summary "Read fixture data from a path."
                 :body "The fixture keeps this as a separate paragraph."
                 :format :markdown
                 :params {"path" {:type nil :doc "Path to read."}}
                 :param-order ["path"]
                 :signature-docs
                 [{:params {"path" {:type nil :doc "Path to read."}}
                   :param-order ["path"]}]
                 :returns nil
                 :examples
                 [{:format :roo
                   :source
                   "(sample.native/read! \"fixture.txt\")\n=> \"contents\""}]
                 :see []
                 :since nil
                 :deprecated nil}
           :source {:path "assets/native-package/native/include/sample.h"
                    :line 6
                    :column 1}
           :declaration-source
           {:path "assets/native-package/native/include/sample.h"
            :line 21
            :column 1}}]
         (native-entries/entries!
           "assets/native-package/native/include/sample.h"))))

(deftest entries!/returns-every-entry-from-an-implementation-file
  (is (= [{:kind :native-identity-comment
           :source {:path "assets/native-package/native/src/sample.cpp"
                    :line 5
                    :column 1}
           :native-class "SampleReadFunction"
           :qualified-name "sample.native/read!"}
          {:kind :native-annotated-symbol
           :doc {:summary "Write fixture data to a path."
                 :body nil
                 :format :markdown
                 :params {"path" {:type nil :doc "Path to write."}}
                 :param-order ["path"]
                 :signature-docs
                 [{:params {"path" {:type nil :doc "Path to write."}}
                   :param-order ["path"]}]
                 :returns nil
                 :examples []
                 :see []
                 :since nil
                 :deprecated nil}
           :source {:path "assets/native-package/native/src/sample.cpp"
                    :line 8
                    :column 1}
           :qualified-name "sample.native/write!"
           :native-kind :function}]
         (native-entries/entries!
           "assets/native-package/native/src/sample.cpp"))))



;; lookup.source.native.parse.entries/package-files

(deftest package-files/returns-declared-native-source-files
  (is (= ["assets/native-package/native/include/sample.h"
          "assets/native-package/native/src/sample.cpp"]
         (native-entries/package-files "assets/native-package"))))

(deftest package-files/prefers-a-declared-source-over-the-artifact-path
  ;; `:path` here ("native") holds no source at all - a package whose
  ;; native source lives apart from where the compiled artifact gets
  ;; staged (pixils' own layout, discovered directly: its `:path "native"`
  ;; only ever holds the built `.so`) declares `:source` to say where the
  ;; real source is instead.
  (is (= ["assets/native-package-split-source/include/sample.h"
          "assets/native-package-split-source/src/sample.cpp"]
         (native-entries/package-files "assets/native-package-split-source"))))



;; lookup.source.native.parse.entries/root-files

(deftest root-files/excludes-native-source-subtrees
  (is (= ["assets/native-root-only/include/extra.h"
          "assets/native-root-only/src/extra.cpp"]
         (native-entries/root-files "assets"
                                    ["assets/native-package"
                                     "assets/native-package-split-source"]))))
