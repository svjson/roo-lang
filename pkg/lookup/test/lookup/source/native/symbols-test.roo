(ns lookup.source.native.symbols-test
  (:require proof.core
            [proof.syntax :as p]
            [lookup.source.native.parse.comment :as native-comment]
            [lookup.source.native.symbols :as native-symbols]))



;; lookup.source.native.symbols/signature

(deftest signature/builds-the-complete-native-signature-model
  (is (= {:display "(collect path values...)"
          :params [{:name "path"
                    :display "path"
                    :optional? false
                    :rest? false
                    :group? false
                    :content [{:kind :text :content "Path to read."}]}
                   {:name "values"
                    :display "values..."
                    :optional? true
                    :rest? true
                    :group? false
                    :content [{:kind :text :content "Additional values."}]}]
          :returns {:content [{:kind :text :content "Collected values."}]}
          :arity {:min 1 :max nil :variadic true}}
         (native-symbols/signature
           "collect"
           {:params {"path" {:content [{:kind :text :content "Path to read."}]}
                     "values..." {:content [{:kind :text
                                             :content "Additional values."}]}}
            :param-order ["path" "values..."]
            :returns {:content [{:kind :text :content "Collected values."}]}}))))

(deftest signature/describes-repeating-parameter-groups
  (is (= {:display "(cond value (condition result)...)"
          :params [{:name "value"
                    :display "value"
                    :optional? false
                    :rest? false
                    :group? false}
                   {:name "condition result"
                    :display "(condition result)..."
                    :optional? true
                    :rest? true
                    :group? true
                    :group {:params ["condition" "result"]}}]
          :arity {:min 1 :max nil :variadic true}}
         (native-symbols/signature
           "cond"
           {:params {"value" {}
                     "(condition result)..." {}}
            :param-order ["value" "(condition result)..."]}))))



;; lookup.source.native.symbols/signatures

(deftest signatures/normalizes-return-before-repeating-group
  (is (= [{:display "(cond (condition result)...)"
           :params [{:name "condition result"
                     :display "(condition result)..."
                     :optional? true
                     :rest? true
                     :group? true
                     :content [{:kind :text
                                :content "Repeated condition/result pairs."}]
                     :group {:params ["condition" "result"]}}]
           :returns {:content [{:kind :text
                                :content "The selected result."}]}
           :arity {:min 0 :max nil :variadic true}}]
         (native-symbols/signatures
           "cond"
           (native-comment/parse
             "/*!
              * @brief Choose the result for the first truthy condition.
              *
              * @return The selected result.
              *
              * | Arg                    | Description                      |
              * |------------------------|----------------------------------|
              * | (condition result)...  | Repeated condition/result pairs. |
              */")))))

(deftest signatures/preserves-per-signature-documentation
  (is (= [{:display "(read path)"
           :params [{:name "path"
                     :display "path"
                     :optional? false
                     :rest? false
                     :group? false
                     :content [{:kind :text :content "Path to read."}]}]
           :returns {:content [{:kind :text :content "Read value."}]}
           :arity {:min 1 :max 1 :variadic false}}
          {:display "(read path fallback)"
           :params [{:name "path"
                     :display "path"
                     :optional? false
                     :rest? false
                     :group? false
                     :content [{:kind :text :content "Path to read."}]}
                    {:name "fallback"
                     :display "fallback"
                     :optional? false
                     :rest? false
                     :group? false
                     :content [{:kind :text
                                :content "Value used when absent."}]}]
           :returns {:content [{:kind :text :content "Read value."}]}
           :arity {:min 2 :max 2 :variadic false}}]
         (native-symbols/signatures
           "read"
           {:signature-docs
            [{:params {"path" {:content [{:kind :text
                                          :content "Path to read."}]}}
              :param-order ["path"]
              :returns {:content [{:kind :text :content "Read value."}]}}
             {:params {"path" {:content [{:kind :text
                                          :content "Path to read."}]}
                       "fallback" {:content [{:kind :text
                                              :content "Value used when absent."}]}}
              :param-order ["path" "fallback"]
              :returns {:content [{:kind :text :content "Read value."}]}}]}))))



;; Public Entries

(deftest entries/builds-direct-documentation-fields
  (p/given
    (native-comment/parse
      "/*!
       * @brief Read a legacy value.
       * @param path Path to read.
       * @return The migrated value.
       * @see sample.native/read
       */"))

  (p/when [documentation]
    (head
      (native-symbols/entries
        "sample"
        [{:kind :native-annotated-symbol
          :native-kind :function
          :qualified-name "sample.native/legacy-read"
          :source {:path "native.cpp" :line 1 :column 1}
          :doc documentation}])))

  (p/then [symbol]
    (is (= {:id "sample.native/legacy-read"
            :name "legacy-read"
            :qualified-name "sample.native/legacy-read"
            :namespace "sample.native"
            :kind :function
            :origin :native
            :visibility :public
            :status :stable
            :source {:path "native.cpp" :line 1 :column 1}
            :summary "Read a legacy value."
            :content [{:kind :text :content "Read a legacy value."}
                      {:kind :sig-args :index 0}
                      {:kind :sig-ret :index 0}]
            :see ["sample.native/read"]
            :signatures
            [{:display "(legacy-read path)"
              :params [{:name "path"
                        :display "path"
                        :optional? false
                        :rest? false
                        :group? false
                        :content [{:kind :text :content "Path to read."}]}]
              :returns {:content [{:kind :text :content "The migrated value."}]}
              :arity {:min 1 :max 1 :variadic false}}]
            :package "sample"
            :doc-source {:kind :native-cpp-comment
                         :source {:path "native.cpp" :line 1 :column 1}}}
           symbol))))

(deftest namespaces/builds-native-namespace-documentation
  (is (= [{:name "roo.ast"
           :source {:path "ast.cpp" :line 3 :column 1}
           :summary "Read Roo syntax trees."
           :content [{:kind :text :content "Read Roo syntax trees."}]
           :doc-source {:kind :native-cpp-comment
                        :source {:path "ast.cpp" :line 3 :column 1}}
           :package "roo"}]
         (native-symbols/namespaces
           "roo"
           [{:kind :native-annotated-namespace
             :name "roo.ast"
             :source {:path "ast.cpp" :line 3 :column 1}
             :doc {:summary "Read Roo syntax trees."
                   :content [{:kind :text
                              :content "Read Roo syntax trees."}]}}]))))
