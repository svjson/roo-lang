(ns lookup.docstrings-test
  (:require proof.core
            [lookup.docstrings :as docstrings]))


(deftest empty-docstring-doc-has-index-shape
  (is (= {:summary nil
          :body nil
          :format :plain
          :params {}
          :returns nil
          :examples []
          :see []
          :since nil
          :deprecated nil}
         (docstrings/empty))))

(deftest parses-structured-docstring-text
  (is (= (docstrings/from-string
          "Build a greeting for `name`.

              Uses a friendly default format.

              Args:
              - `name`: Person to greet.

              Returns:
              A greeting string.

              Examples:
              ```roo
              (greet \"Ada\")
              ```

              See Also:
              - `str`

              Since:
              0.1.0

              Deprecated:
              Use `welcome` instead.")

         {:summary "Build a greeting for `name`."
          :body "Uses a friendly default format."
          :format :markdown
          :params {"name" {:type nil
                           :doc "Person to greet."}}
          :returns {:type nil
                    :doc "A greeting string."}
          :examples [{:format :roo
                      :source "(greet \"Ada\")"}]
          :see ["str"]
          :since "0.1.0"
          :deprecated "Use `welcome` instead."})))
