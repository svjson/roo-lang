(ns lookup.audit-test
  (:require proof.core
            [lookup.audit :as audit]))


;; Test Data

(def documented-function
  {:id "sample/greet"
   :name "greet"
   :qualified-name "sample/greet"
   :kind :function
   :summary "Build a greeting."
   :signatures [{:display "(greet name)"
                 :params [{:name "name"
                           :content [{:kind :text
                                      :content "Person to greet."}]}]}]})



;;; lookup.audit/symbol-index

(deftest symbol-index/returns-empty-diagnostics-by-default
  (is (= {:format :roo/lookup-audit
          :version 1
          :diagnostics []
          :failed? false}
         (audit/symbol-index {:symbols [documented-function]} {}))))

(deftest symbol-index/reports-missing-summary-when-required
  (is (= {:format :roo/lookup-audit
          :version 1
          :diagnostics [{:severity :warning
                         :kind :missing-doc-summary
                         :symbol "sample/greet"
                         :message "Missing documentation summary."}]
          :failed? false}
         (audit/symbol-index {:symbols [(assoc documented-function
                                               :summary nil)]}
                             {:require-summary? true}))))

(deftest symbol-index/reports-missing-signatures-when-required
  (is (= {:format :roo/lookup-audit
          :version 1
          :diagnostics [{:severity :warning
                         :kind :missing-signatures
                         :symbol "sample/greet"
                         :message
                         "Function or special form has no documented signatures."}]
          :failed? false}
         (audit/symbol-index {:symbols [(assoc documented-function :signatures [])]}
                             {:require-signatures? true}))))

(deftest symbol-index/reports-zero-arity-signatures-when-not-allowed
  (is (= {:format :roo/lookup-audit
          :version 1
          :diagnostics [{:severity :warning
                         :kind :zero-arity-signature
                         :symbol "sample/greet"
                         :message "Documented signature has no parameters."
                         :signature "(greet)"}]
          :failed? false}
         (audit/symbol-index {:symbols [(assoc documented-function
                                               :signatures [{:display "(greet)"
                                                             :params []}])]}
                             {:require-signatures? true}))))

(deftest symbol-index/allows-declared-zero-arity-signatures
  (is (= {:format :roo/lookup-audit
          :version 1
          :diagnostics []
          :failed? false}
         (audit/symbol-index {:symbols [(assoc documented-function
                                               :id "sample/now"
                                               :qualified-name "sample/now"
                                               :signatures [{:display "(now)"
                                                             :params []}])]}
                             {:require-signatures? true
                              :allow-zero-arity ["sample/now"]}))))

(deftest symbol-index/reports-missing-parameter-docs-when-required
  (is (= {:format :roo/lookup-audit
          :version 1
          :diagnostics [{:severity :warning
                         :kind :missing-param-doc
                         :symbol "sample/greet"
                         :message "Missing parameter documentation."
                         :signature "(greet name)"
                         :param "name"}]
          :failed? false}
         (audit/symbol-index {:symbols [(assoc documented-function
                                               :signatures [{:display "(greet name)"
                                                             :params [{:name "name"}]}])]}
                             {:require-param-docs? true}))))

(deftest symbol-index/marks-audit-failed-at-threshold
  (is (= {:format :roo/lookup-audit
          :version 1
          :diagnostics [{:severity :warning
                         :kind :missing-doc-summary
                         :symbol "sample/greet"
                         :message "Missing documentation summary."}]
          :failed? true}
         (audit/symbol-index {:symbols [(assoc documented-function
                                               :summary nil)]}
                             {:require-summary? true
                              :fail-on :warning}))))
