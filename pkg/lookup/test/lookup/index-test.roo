(ns lookup.index-test
  (:require proof.core
            [lookup.analysis :as analysis]
            [lookup.index :as index]
            [lookup.reader :as reader]
            [lookup.source :as source]
            [lookup.symbols :as symbols]))

(deftest identifies-roo-source-files
  (is (source/source-file? "src/index.roo"))
  (is (= false (source/source-file? "package.edn"))))

(deftest builds-source-form-index
  (let [source-index (index/source-form-index "..")
        sources (:sources source-index)
        paths (map sources (fn [source] (:path source)))
        index-source (find-first sources
                                 (fn [source]
                                   (= "../src/index.roo" (:path source))))
        first-form (nth (:forms index-source) 0)]
    (is (= :roo/source-forms (:format source-index)))
    (is (= 1 (:version source-index)))
    (is (= "lookup" (:name (:package source-index))))
    (is (= "0.1.0" (:version (:package source-index))))
    (is (= 6 (count sources)))
    (is (= ["../src/cli.roo"
            "../src/docstrings.roo"
            "../src/index.roo"
            "../src/native-docs.roo"
            "../src/source.roo"
            "../src/symbols.roo"]
           paths))
    (is (= "../src/index.roo" (:path index-source)))
    (is (= "ns" (str (head (:form first-form)))))
    (is (= "lookup.index" (str (nth (:form first-form) 1))))))

(deftest builds-symbol-index-v1
  (let [symbol-index (index/symbol-index "..")
        sources (:sources symbol-index)
        namespaces (:namespaces symbol-index)
        symbols (:symbols symbol-index)
        version-symbol (find-first symbols
                                   (fn [symbol]
                                     (= "lookup.cli/version"
                                        (:qualified-name symbol))))
        symbol-index-symbol (find-first symbols
                                        (fn [symbol]
                                          (= "lookup.index/symbol-index"
                                             (:qualified-name symbol))))
        command-symbol (find-first symbols
                                   (fn [symbol]
                                     (= "lookup.cli/command"
                                        (:qualified-name symbol))))
        symbol-index-signature (nth (:signatures symbol-index-symbol) 0)]
    (is (= :roo/symbol-index (:format symbol-index)))
    (is (= 1 (:version symbol-index)))
    (is (= "lookup" (:name (:package symbol-index))))
    (is (contains? sources {:path "../src/cli.roo"}))
    (is (contains? sources {:path "../src/index.roo"}))
    (is (not (nil? (find-first namespaces
                               (fn [namespace]
                                 (= "lookup.cli" (:name namespace)))))))
    (is (not (nil? (find-first namespaces
                               (fn [namespace]
                                 (= "lookup.docstrings" (:name namespace)))))))
    (is (not (nil? (find-first namespaces
                               (fn [namespace]
                                 (= "lookup.index" (:name namespace)))))))
    (is (not (nil? (find-first namespaces
                               (fn [namespace]
                                 (= "lookup.source" (:name namespace)))))))
    (is (= :var (:kind version-symbol)))
    (is (= :source (:origin version-symbol)))
    (is (= :public (:visibility version-symbol)))
    (is (= [] (:signatures version-symbol)))
    (is (= "Lookup command version." (:summary (:doc version-symbol))))
    (is (= :function (:kind symbol-index-symbol)))
    (is (= "Build a symbol index for a package."
           (:summary (:doc symbol-index-symbol))))
    (is (= "(symbol-index package-dir)" (:display symbol-index-signature)))
    (is (= [{:name "args"
             :type nil
             :doc "Command line argument vector."
             :optional? false
             :rest? false}]
           (:params (nth (:signatures command-symbol) 0))))
    (is (= [{:name "package-dir"
             :type nil
             :doc "Package root containing `package.edn`."
             :optional? false
             :rest? false}]
           (:params symbol-index-signature)))
    (is (= {:min 1 :max 1 :variadic false}
           (:arity symbol-index-signature)))
    (is (= :markdown (:format (:doc symbol-index-symbol))))
    (is (= "../src/index.roo"
           (:path (:source symbol-index-symbol))))))

(deftest reads-top-level-forms-with-source-locations
  (let [forms (reader/read-file-forms! "assets/read-forms-sample.roo")
        ns-entry (nth forms 0)
        def-entry (nth forms 1)
        defun-entry (nth forms 2)
        ns-form (:form ns-entry)
        def-form (:form def-entry)
        defun-form (:form defun-entry)
        ns-source (:source ns-entry)
        def-source (:source def-entry)
        defun-source (:source defun-entry)]
    (is (= 3 (count forms)))
    (is (= "ns" (str (head ns-form))))
    (is (= "sample.forms" (str (nth ns-form 1))))
    (is (= "def" (str (head def-form))))
    (is (= "answer" (str (nth def-form 1))))
    (is (= "defun" (str (head defun-form))))
    (is (= "greet" (str (nth defun-form 1))))
    (is (= "assets/read-forms-sample.roo" (:path ns-source)))
    (is (= 1 (:line ns-source)))
    (is (= 1 (:column ns-source)))
    (is (= 3 (:line def-source)))
    (is (= 5 (:line defun-source)))))

(deftest extracts-docstrings-from-def-and-defun
  (let [source {:path "assets/docstrings-sample.roo"
                :forms (reader/read-file-forms! "assets/docstrings-sample.roo")}
        entries (symbols/source-symbols "sample" source)
        answer (find-first entries
                           (fn [symbol]
                             (= "sample.docs/answer" (:qualified-name symbol))))
        greet (find-first entries
                          (fn [symbol]
                            (= "sample.docs/greet" (:qualified-name symbol))))
        greet-doc (:doc greet)
        greet-signature (nth (:signatures greet) 0)]
    (is (= "The answer used by examples." (:summary (:doc answer))))
    (is (= "0.1.0" (:since (:doc answer))))
    (is (= :roo-docstring (:kind (:doc-source answer))))
    (is (= "Build a greeting for `name`." (:summary greet-doc)))
    (is (= "Uses a friendly default format." (:body greet-doc)))
    (is (= "Person to greet." (:doc (get (:params greet-doc) "name"))))
    (is (= "Optional title." (:doc (get (:params greet-doc) "title"))))
    (is (= {:type nil :doc "A greeting string."} (:returns greet-doc)))
    (is (= [{:format :roo :source "(greet \"Ada\" \"Dr.\")"}]
           (:examples greet-doc)))
    (is (= ["str"] (:see greet-doc)))
    (is (= "(greet name & title)" (:display greet-signature)))
    (is (= [{:name "name"
             :type nil
             :doc "Person to greet."
             :optional? false
             :rest? false}
            {:name "title"
             :type nil
             :doc "Optional title."
             :optional? true
             :rest? false}]
           (:params greet-signature)))
    (is (= {:type nil :doc "A greeting string."}
           (:returns greet-signature)))))

(deftest resolves-thing-at-local-let-binding
  (let [source "(ns sample.core)\n(let [command-value 1]\n  command-value)\n"
        result (analysis/thing-at! "." "src/sample.roo" "3" "3" source)
        thing (:thing result)
        resolution (:resolution thing)
        source-location (:source resolution)]
    (is (= :ok (:status result)))
    (is (= "command-value" (:text thing)))
    (is (= :symbol (:kind thing)))
    (is (= :local-reference (:role thing)))
    (is (= :local (:kind resolution)))
    (is (= "command-value" (:name resolution)))
    (is (= "local binding" (:signature resolution)))
    (is (= "src/sample.roo" (:path source-location)))
    (is (= 2 (:line source-location)))
    (is (= 7 (:column source-location)))))

(deftest resolves-thing-at-function-parameter
  (let [source "(ns sample.core)\n(defun submit [command-value]\n  command-value)\n"
        result (analysis/thing-at! "." "src/sample.roo" "3" "3" source)
        thing (:thing result)
        resolution (:resolution thing)
        source-location (:source resolution)]
    (is (= :ok (:status result)))
    (is (= "command-value" (:text thing)))
    (is (= :local-reference (:role thing)))
    (is (= "command-value" (:name resolution)))
    (is (= "parameter" (:signature resolution)))
    (is (= 2 (:line source-location)))
    (is (= 16 (:column source-location)))))

(deftest builds-symbol-index-with-generic-native-source-root
  (let [symbol-index (index/symbol-index-with-native-source-roots
                      "assets/native-package"
                      ["assets/native-root-only"])
        symbols (:symbols symbol-index)
        native-symbol (find-first symbols
                                  (fn [symbol]
                                    (= "extra.native/read!"
                                       (:qualified-name symbol))))]
    (is (= :roo/symbol-index (:format symbol-index)))
    (is (= "extra.native/read!" (:id native-symbol)))
    (is (= "Read data from an external native source root."
           (:summary (:doc native-symbol))))))

(deftest builds-native-symbols-in-symbol-index
  (let [symbol-index (index/symbol-index "assets/native-package")
        symbols (:symbols symbol-index)
        native-symbol (find-first symbols
                                  (fn [symbol]
                                    (= "sample.native/read!"
                                       (:qualified-name symbol))))
        signature (head (:signatures native-symbol))]
    (is (= :roo/symbol-index (:format symbol-index)))
    (is (= "native-fixture" (:name (:package symbol-index))))
    (is (= "sample.native/read!" (:id native-symbol)))
    (is (= :native (:origin native-symbol)))
    (is (= "Read fixture data from a path."
           (:summary (:doc native-symbol))))
    (is (= "(read! arg0)" (:display signature)))
    (is (= "Path to read." (:doc (head (:params signature)))))))
