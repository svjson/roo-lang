(ns lookup.index-test
  (:require proof.core
            [lookup.index :as index]))

(deftest source-form-index/builds-source-form-index
  (let [source-index (index/source-form-index "..")
        sources (:sources source-index)
        paths (for [source sources] (:path source))
        index-source (find-first sources
                                 (fn [source]
                                   (= "../src/index.roo" (:path source))))
        first-form (head (:forms index-source))]
    (is (= :roo/source-forms (:format source-index)))
    (is (= 1 (:version source-index)))
    (is (= "lookup" (:name (:package source-index))))
    (is (= "0.1.0" (:version (:package source-index))))
    (is (= 10 (count sources)))
    (is (= ["../src/audit.roo"
            "../src/cli.roo"
            "../src/command/audit.roo"
            "../src/command/index.roo"
            "../src/command/thing-at.roo"
            "../src/docstrings.roo"
            "../src/index.roo"
            "../src/native-docs.roo"
            "../src/source.roo"
            "../src/symbols.roo"]
           paths))
    (is (= "../src/index.roo" (:path index-source)))
    (is (= "ns" (str (head (:form first-form)))))
    (is (= "lookup.index" (str (nth (:form first-form) 1))))))

(deftest builds-symbol-index-v1
  (let [symbol-index (index/symbol-index "..")
        sources (:sources symbol-index)
        namespaces (:namespaces symbol-index)
        symbols (:symbols symbol-index)
        version-symbol (find-first symbols
                                   (fn [symbol]
                                     (= "lookup.cli/version"
                                        (:qualified-name symbol))))
        symbol-index-symbol (find-first symbols
                                        (fn [symbol]
                                          (= "lookup.index/symbol-index"
                                             (:qualified-name symbol))))
        command-symbol (find-first symbols
                                   (fn [symbol]
                                     (= "lookup.cli/command"
                                        (:qualified-name symbol))))
        symbol-index-signature (nth (:signatures symbol-index-symbol) 0)]
    (is (= :roo/symbol-index (:format symbol-index)))
    (is (= 1 (:version symbol-index)))
    (is (= "lookup" (:name (:package symbol-index))))
    (is (contains? sources {:path "../src/cli.roo"}))
    (is (contains? sources {:path "../src/index.roo"}))
    (is (any? namespaces (fn [namespace]
                           (= "lookup.cli" (:name namespace)))))
    (is (any? namespaces
              (fn [namespace]
                (= "lookup.docstrings" (:name namespace)))))
    (is (any? namespaces
              (fn [namespace]
                (= "lookup.index" (:name namespace)))))
    (is (any? namespaces
              (fn [namespace]
                (= "lookup.source" (:name namespace)))))
    (is (= :var (:kind version-symbol)))
    (is (= :source (:origin version-symbol)))
    (is (= :public (:visibility version-symbol)))
    (is (= [] (:signatures version-symbol)))
    (is (= "Lookup command version." (:summary (:doc version-symbol))))
    (is (= :function (:kind symbol-index-symbol)))
    (is (= "Build a symbol index for a package."
           (:summary (:doc symbol-index-symbol))))
    (is (= "(symbol-index package-dir)" (:display symbol-index-signature)))
    (is (= [{:name "args"
             :optional? false
             :rest? false
             :type nil
             :doc "Command line argument vector."}]
           (:params (head (:signatures command-symbol)))))
    (is (= [{:name "package-dir"
             :optional? false
             :rest? false
             :type nil
             :doc "Package root containing `package.edn`."}]
           (:params symbol-index-signature)))
    (is (= {:min 1 :max 1 :variadic false}
           (:arity symbol-index-signature)))
    (is (= :markdown (:format (:doc symbol-index-symbol))))
    (is (= "../src/index.roo"
           (:path (:source symbol-index-symbol))))))



(deftest builds-native-only-symbol-index-from-generic-root
  (let [symbol-index (index/root-index
                      {:roots ["assets/native-root-only"]
                       :excludes []
                       :extractors [:native]})
        symbols (:symbols symbol-index)
        native-symbol (head symbols)]
    (is (= :roo/symbol-index (:format symbol-index)))
    (is (= {:kind :roots
            :roots ["assets/native-root-only"]
            :excludes []
            :extractors [:native]}
           (:origin symbol-index)))
    (is (= nil (:package symbol-index)))
    (is (= [{:path "assets/native-root-only/include/extra.h"}
            {:path "assets/native-root-only/src/extra.cpp"}]
           (:sources symbol-index)))
    (is (= "extra.native/read!" (:id native-symbol)))
    (is (= nil (:package native-symbol)))
    (is (= "Read data from an external native source root."
           (:summary (:doc native-symbol))))))

(deftest builds-native-only-symbol-index-with-package-metadata
  (let [symbol-index (index/root-index
                       {:roots ["assets/native-root-only"]
                        :excludes []
                        :extractors [:native]
                        :package {:name "roo"
                                  :version "0.1.0"
                                  :description "Roo standard library."}})
        native-symbol (head (:symbols symbol-index))]
    (is (= {:name "roo"
            :version "0.1.0"
            :description "Roo standard library."}
           (:package symbol-index)))
    (is (= "roo" (:package native-symbol)))))

(deftest builds-native-only-symbol-index-with-excludes
  (let [symbol-index (index/root-index
                      {:roots ["assets"]
                       :excludes ["assets/native-package"]
                       :extractors [:native]})
        symbols (:symbols symbol-index)
        native-symbol (head symbols)]
    (is (= {:kind :roots
            :roots ["assets"]
            :excludes ["assets/native-package"]
            :extractors [:native]}
           (:origin symbol-index)))
    (is (= 1 (count symbols)))
    (is (= "extra.native/read!" (:id native-symbol)))))

(deftest builds-symbol-index-with-generic-root
  (let [symbol-index (index/symbol-index-with-roots
                      "assets/native-package"
                      ["assets/native-root-only"]
                      [])
        symbols (:symbols symbol-index)
        native-symbol (find-first symbols
                                  (fn [symbol]
                                    (= "extra.native/read!"
                                       (:qualified-name symbol))))]
    (is (= :roo/symbol-index (:format symbol-index)))
    (is (= "extra.native/read!" (:id native-symbol)))
    (is (= "Read data from an external native source root."
           (:summary (:doc native-symbol))))))

(deftest builds-native-symbols-in-symbol-index
  (let [symbol-index (index/symbol-index "assets/native-package")
        symbols (:symbols symbol-index)
        native-symbol (find-first symbols
                                  (fn [symbol]
                                    (= "sample.native/read!"
                                       (:qualified-name symbol))))
        signature (head (:signatures native-symbol))]
    (is (= :roo/symbol-index (:format symbol-index)))
    (is (= "native-fixture" (:name (:package symbol-index))))
    (is (= "sample.native/read!" (:id native-symbol)))
    (is (= :native (:origin native-symbol)))
    (is (= "Read fixture data from a path."
           (:summary (:doc native-symbol))))
    (is (= "(read! path)" (:display signature)))
    (is (= "Path to read." (:doc (head (:params signature)))))))
