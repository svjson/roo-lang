(ns lookup.index-test
  (:require proof.core
            [proof.syntax :as p]
            [lookup.index :as index]))



;; lookup.index/source-form-index

(deftest source-form-index/builds-source-form-index
  (p/when []
    (index/source-form-index "."))

  (p/then [source-index]
    (let [sources (:sources source-index)
          index-source (find-first sources
                                   (fn [source]
                                     (= "src/index/_index.roo" (:path source))))
          first-form (head (:forms index-source))]
      (is (= {:format :roo/source-forms
              :version 1
              :package {:name "lookup"
                        :version "0.1.0"
                        :description "Roo symbol index generator."}}
             (merge (select-keys source-index [:format
                                               :version
                                               :package]))))
      (is (= ["src/audit.roo"
              "src/cli.roo"
              "src/command/audit.roo"
              "src/command/index.roo"
              "src/command/thing-at.roo"
              "src/doc.roo"
              "src/index/_index.roo"
              "src/index/incremental.roo"
              "src/source/_source.roo"
              "src/source/docstring/parse/content.roo"
              "src/source/docstring/symbols.roo"
              "src/source/native/parse/comment.roo"
              "src/source/native/parse/entries.roo"
              "src/source/native/symbols.roo"
              "src/source/path.roo"]
             (map sources :path)))

      (is (= "src/index/_index.roo" (:path index-source)))
      (is (= "ns" (str (head (:form first-form)))))
      (is (= "lookup.index" (str (nth (:form first-form) 1)))))))



;; lookup.index/symbol-index

(deftest symbol-index/builds-symbol-index-v1
  (p/when []
    (index/symbol-index "."))

  (p/then [symbol-index]
    (let [sources (:sources symbol-index)
          namespaces (:namespaces symbol-index)
          symbols (:symbols symbol-index)
          symbol-index-symbol (find-first symbols
                                          (fn [symbol]
                                            (= "lookup.index/symbol-index"
                                               (:qualified-name symbol))))
          main-symbol (find-first symbols
                                  (fn [symbol]
                                    (= "lookup.cli/main"
                                       (:qualified-name symbol))))
          symbol-index-signature (head (:signatures symbol-index-symbol))]
      (is (= :roo/symbol-index (:format symbol-index)))
      (is (= 1 (:version symbol-index)))
      (is (= "lookup" (:name (:package symbol-index))))
      (is (contains? sources {:path "src/cli.roo"}))
      (is (contains? sources {:path "src/index/_index.roo"}))
      (is (any? namespaces (fn [namespace]
                             (= "lookup.cli" (:name namespace)))))
      (is (any? namespaces
                (fn [namespace]
                  (= "lookup.source.docstring.parse.content"
                     (:name namespace)))))
      (is (any? namespaces
                (fn [namespace]
                  (= "lookup.index" (:name namespace)))))
      (is (any? namespaces
                (fn [namespace]
                  (= "lookup.source" (:name namespace)))))
      (is (= :function (:kind symbol-index-symbol)))
      (is (= "Build a symbol index for a package."
             (:summary symbol-index-symbol)))
      (is (= "(symbol-index package-dir)" (:display symbol-index-signature)))
      (is (= [{:name "args"
               :display "args"
               :optional? false
               :rest? false
               :content [{:kind :text
                          :content "Command-line argument vector."}]}]
             (:params (head (:signatures main-symbol)))))
      (is (= [{:name "package-dir"
               :display "package-dir"
               :optional? false
               :rest? false
               :content [{:kind :text
                          :content "Package root containing `package.edn`."}]}]
             (:params symbol-index-signature)))
      (is (= {:min 1 :max 1 :variadic false}
             (:arity symbol-index-signature)))
      (is (nil? (:format (head (:content symbol-index-symbol)))))
      (is (= "src/index/_index.roo"
             (:path (:source symbol-index-symbol)))))))



(deftest symbol-index/builds-native-symbols
  (p/when []
    (index/symbol-index "test/assets/native-package"))

  (p/then [symbol-index]
    (let [symbols (:symbols symbol-index)
          native-symbol (find-first symbols
                                    (fn [symbol]
                                      (= "sample.native/read!"
                                         (:qualified-name symbol))))
          annotated-symbol (find-first symbols
                                       (fn [symbol]
                                         (= "sample.native/write!"
                                            (:qualified-name symbol))))]
      (is (= :roo/symbol-index (:format symbol-index)))
      (is (= "native-fixture" (:name (:package symbol-index))))
      (is (= [{:id "sample.native/read!"
               :summary "Read fixture data from a path."
               :content [{:kind :text
                          :content "Read fixture data from a path."}
                         {:kind :text
                          :content "The fixture keeps this as a separate paragraph."}
                         {:kind :header :content "Usage:"}
                         {:kind :code
                          :content
                          "(sample.native/read! \"fixture.txt\")\n=> \"contents\""}
                         {:kind :sig-args :index 0}]}
              {:id "sample.native/write!"
               :summary "Write fixture data to a path."
               :content [{:kind :text
                          :content "Write fixture data to a path."}
                         {:kind :sig-args :index 0}]}]
             (for [symbol [native-symbol annotated-symbol]]
               (select-keys symbol [:id :summary :content])))))))



;; lookup.index/root-index

(deftest root-index/builds-native-only-symbol-index-from-generic-root
  (p/when []
    (index/root-index
      {:roots ["test/assets/native-root-only"]
       :excludes []
       :extractors [:native]}))

  (p/then [symbol-index]
    (let [native-symbol (head (:symbols symbol-index))
          native-namespace (head (:namespaces symbol-index))]
      (is (= :roo/symbol-index (:format symbol-index)))
      (is (= {:kind :roots
              :roots ["test/assets/native-root-only"]
              :excludes []
              :extractors [:native]}
             (:origin symbol-index)))
      (is (nil? (:package symbol-index)))
      (is (= [{:path "test/assets/native-root-only/include/extra.h"}
              {:path "test/assets/native-root-only/src/extra.cpp"}]
             (:sources symbol-index)))
      (is (= "extra.native/read!" (:id native-symbol)))
      (is (nil? (:package native-symbol)))
      (is (= "Read data from an external native source root."
             (:summary native-symbol)))
      (is (= {:name "extra.native"
              :summary "Read data from an external native source root."
              :content [{:kind :text
                         :content "Read data from an external native source root."}]}
             (select-keys native-namespace [:name :summary :content]))))))

(deftest root-index/includes-package-metadata
  (p/when []
    (index/root-index
      {:roots ["test/assets/native-root-only"]
       :excludes []
       :extractors [:native]
       :package {:name "roo"
                 :version "0.1.0"
                 :description "Roo standard library."}}))

  (p/then [symbol-index]
    (is (= {:name "roo"
            :version "0.1.0"
            :description "Roo standard library."}
           (:package symbol-index)))
    (is (= "roo" (:package (head (:symbols symbol-index)))))))

(deftest root-index/honors-native-source-excludes
  (p/when []
    (index/root-index
      {:roots ["test/assets"]
       :excludes ["test/assets/native-package"
                  "test/assets/native-package-split-source"]
       :extractors [:native]}))

  (p/then [symbol-index]
    (is (= {:kind :roots
            :roots ["test/assets"]
            :excludes ["test/assets/native-package"
                       "test/assets/native-package-split-source"]
            :extractors [:native]}
           (:origin symbol-index)))
    (is (= ["extra.native/read!"]
           (map (:symbols symbol-index) :id)))))



;; lookup.index/symbol-index-with-roots

(deftest symbol-index-with-roots/includes-symbols-from-generic-roots
  (p/when []
    (index/symbol-index-with-roots
      "test/assets/native-package"
      ["test/assets/native-root-only"]
      []))

  (p/then [symbol-index]
    (let [native-symbol (find-first (:symbols symbol-index)
                                    (fn [symbol]
                                      (= "extra.native/read!"
                                         (:qualified-name symbol))))]
      (is (= :roo/symbol-index (:format symbol-index)))
      (is (= "extra.native/read!" (:id native-symbol)))
      (is (= "Read data from an external native source root."
             (:summary native-symbol))))))
