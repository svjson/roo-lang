(ns proofread.higher-order-non-candidates)

(def already-flat-map
  (flat-map items expand-item))

(def plain-map
  (map items expand-item))

(def plain-head
  (head items))

(def plain-filter
  (filter items active?))

(def already-keep
  (keep items
        (fn [item]
          (when (active? item)
            (:id item)))))

(def plain-flatten
  (flatten nested-items))

(def multi-sequence-map
  (flatten
    (map left-items right-items combine-items)))
