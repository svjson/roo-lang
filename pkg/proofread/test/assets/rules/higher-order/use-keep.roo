(ns proofread.higher-order-use-keep)

(def kept-when
  (map items
       (fn [item]
         (when (active? item)
           (:id item)))))

(def kept-unless
  (map items
       (fn [item]
         (unless (archived? item)
           (:id item)))))

(def mapped-filter
  (map (filter params (fn [param] (blank-text? (:doc param))))
       (fn [param]
         (missing-param-doc-diagnostic symbol signature param))))

(def filtered-map
  (filter (map contexts
               (fn [context]
                 (project-context context options)))
          (fn [context]
            (some? context))))

(def filtered-map-not-nil
  (filter (map contexts
               (fn [context]
                 (project-context context options)))
          (fn [context]
            (not (nil? context)))))

(def filtered-map-some
  (filter (map contexts
               (fn [context]
                 (project-context context options)))
          some?))
