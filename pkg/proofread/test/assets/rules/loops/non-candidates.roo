(ns proofread.loops-non-candidates)

(def already-for-indexed
  (for-indexed [index child children]
    (append! lines (:id child))))

(def plain-map
  (map values render-value))

(def direct-set-outside-loop
  (let [current value]
    (set! [current] (advance current))
    current))

(def loop-mutates-unbound-state
  (let [current value]
    (for [entry entries]
      (set! [external] entry)
      (handle current entry))))

(def plain-while
  (while (active?)
    (tick!)))
