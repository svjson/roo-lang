(ns proofread.loops-non-candidates)

(def already-for-indexed
  (for-indexed [index child children]
    (append! lines (:id child))))

(def counted-while-without-indexed-read
  (let [index 0]
    (while (< index (count children))
      (append! lines index)
      (set! [index] (+ index 1)))))

(def counted-while-with-different-read-target
  (let [index 0]
    (while (< index (count children))
      (let [child (nth other-children index)]
        (append! lines (:id child))
        (set! [index] (+ index 1))))))

(def counted-while-with-non-unit-step
  (let [index 0]
    (while (< index (count children))
      (let [child (nth children index)]
        (append! lines (:id child))
        (set! [index] (+ index 2))))))

(def plain-while
  (while (active?)
    (tick!)))
