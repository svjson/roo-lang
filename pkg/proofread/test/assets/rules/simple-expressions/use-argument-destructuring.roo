(ns proofread.simple-expressions-use-argument-destructuring)

(def handler
  (fn [state event ctx]
    (let [payload (:payload event)]
      (case (:type payload)
        :confirm
        (actions/edit-selected-mask-set
         state
         (:id payload)
         (:name payload))

        :default state))))

(def option-renderer
  (fn [option]
    (let [label (:label option)]
      (str label))))

(defun append-flat-ids! [ids seen node]
  (let [id (:id node)]
    (unless (contains? seen id)
      (append! seen id)
      (append! ids id)
      (for [child (:dependencies node)]
        (append-flat-ids! ids seen child)))))
