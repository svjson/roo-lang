(ns proofread.simple-expressions-redundant-let)

(def single-binding
  (let [id (:id node)]
    (save! id)))

(def multi-binding-first
  (let [age (:age input)
        old? (> age 80)]
    (when old?
      :old)))

(def multi-binding-second
  (let [value (build-value input)
        id (:id value)]
    (save! id)))

(def self-rebound-cond-thread
  (let [options (parse-options args)
        options (cond-> options
                        (nil? (:out options))
                        (update :errors [append "Missing output directory"]))]
    (cond-> options
            (empty? (:indexes options))
            (update :errors [append "Missing lookup index file"]))))
