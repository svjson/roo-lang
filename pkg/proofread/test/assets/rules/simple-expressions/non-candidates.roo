(ns proofread.simple-expressions-non-candidates)

(def second-item
  (nth items 1))

(def one-item
  (= 1 (count items)))

(def enough-items
  (> (count items) 1))

(def blank-text
  (not (blank? text)))

(def different-values
  (not= left right))

(def missing-value
  (nil? value))

(def required-map-check
  (and (map? node)
       (= (count node) 2)))

(def different-target
  (and (map? node)
       (= (:type other) :symbol)))
