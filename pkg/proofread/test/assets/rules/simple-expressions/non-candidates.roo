(ns proofread.simple-expressions-non-candidates)

(def second-item
  (nth items 1))

(def one-item
  (= 1 (count items)))

(def enough-items
  (> (count items) 1))

(def value-preserving-branch
  (let [field-errors (validate-field value)]
    (if (empty? field-errors)
      errors
      (assoc errors field-id field-errors))))

(def value-producing-expression
  (let [field-errors (validate-field value)]
    (assoc errors field-id (not (empty? field-errors)))))

(def blank-text
  (not (blank? text)))

(def different-values
  (not= left right))

(def missing-value
  (nil? value))

(def keep-index
  (find-index name (fn [ch] (= "_" (str ch)))))

(def keep-location
  (index-of name '-'))

(def required-fallback
  (assoc options :symbols (or (:symbols index) [])))

(def non-empty-default
  (keep (or (:symbols index) [:default]) symbol-entry))

(def dynamic-get
  (get values key))

(def explicit-default
  (get values key default-value))

(def non-get-default
  (or selected-value default-value))

(def required-map-check
  (and (map? node)
       (= (count node) 2)))

(def different-target
  (and (map? node)
       (= (:type other) :symbol)))

(def explicit-false-option
  (when (some? (:enabled? options))
    (:enabled? options)))

(def explicit-symbol-presence
  (when (some? enabled?)
    enabled?))

(def non-string-guard
  (and (some? namespace)
       (contains? namespaces namespace)))
