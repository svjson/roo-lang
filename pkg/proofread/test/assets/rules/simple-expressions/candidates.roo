(ns proofread.simple-expressions-candidates)

(def first-item
  (nth items 0))

(def empty-a
  (= 0 (count items)))

(def empty-b
  (= (count items) 0))

(def not-empty-a
  (if (< 0 (count items))
    :items
    :none))

(def not-empty-b
  (when (> (count items) 0)
    items))

(def not-empty-c
  (and ready?
       (not (empty? items))))

(def different-values
  (not (= left right)))

(def nil-a
  (= nil value))

(def nil-b
  (= value nil))

(def present-value
  (not (nil? value)))

(def contains-underscore?
  (not (nil? (find-index name (fn [ch] (= "_" (str ch)))))))

(def found-name
  (not (nil? (find-first names (fn [name] (= name target))))))

(def contains-separator?
  (not (nil? (index-of name '-'))))
