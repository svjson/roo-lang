(ns proofread.simple-expressions-candidates)

(def first-item
  (nth items 0))

(def empty-a
  (= 0 (count items)))

(def empty-b
  (= (count items) 0))

(def not-empty-a
  (if (< 0 (count items))
    :items
    :none))

(def not-empty-b
  (when (> (count items) 0)
    items))

(def not-empty-c
  (and ready?
       (not (empty? items))))

(def different-values
  (not (= left right)))

(def nil-a
  (= nil value))

(def nil-b
  (= value nil))

(def present-value
  (not (nil? value)))

(def contains-underscore?
  (not (nil? (find-index name (fn [ch] (= "_" (str ch)))))))

(def found-name
  (not (nil? (find-first names (fn [name] (= name target))))))

(def contains-separator?
  (not (nil? (index-of name '-'))))

(def indexed-symbols
  (keep (or (:symbols index) []) symbol-entry))

(def visible-items
  (map (or items []) item-view))

(def named-symbol
  (find-first (or symbols []) named?))

(def symbol-name
  (get symbol :name))

(def selected-value
  (or (get values key)
      default-value))

(def selected-name
  (or (get values :name)
      "Missing"))

(def failing-audit?
  (some? (find-first diagnostics failing?)))

(def print-result-value
  (when (some? (:value result))
    (prn (:value result))))

(def selected-reporter
  (cond
    (some? reporter) reporter
    true :default))

(def sub-namespace?
  (and (some? namespace)
       (string/starts-with? namespace (str parent "."))))

(def feature-enabled?
  (any? features
        (fn [candidate]
          (= feature candidate))))

(def feature-enabled-reversed?
  (any? features
        (fn [candidate]
          (= candidate feature))))
