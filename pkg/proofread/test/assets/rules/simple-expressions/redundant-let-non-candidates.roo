(ns proofread.simple-expressions-redundant-let-non-candidates)

(def complex-single-binding
  (let [value (build-value input)]
    (save! value)))

(def repeated-single-binding
  (let [id (:id node)]
    (save! id)
    (index! id)))

(def repeated-multi-binding
  (let [id (:id node)
        label (:label node)]
    (save! id label)
    (index! id label)))

(def destructured-binding
  (let [{:keys [id]} node]
    (save! id)))

(def self-rebound-with-intermediate-condition
  (let [options (parse-options args)
        options (cond-> options
                        missing?
                        (update :errors [append "Missing output directory"]))]
    (cond-> options
            (empty? (:errors options))
            (update :errors [append "Missing lookup index file"]))))
