(ns proofread.direct-conditions-use-when-let)

(def value
  (let [item (find-item)]
    (when item
      (save! item))))

(def printed-value
  (when (:value result)
    (prn (:value result))))

(def dependency-lines
  (let [root (graph/root-node! package-dir repo-root)]
    (unless (nil? root)
      (if flat?
        (print-lines! (flat-lines root))
        (print-lines! (tree-lines root show-repeated?))))))

(def selected-option-value
  (if-let [option (selected-option options selected-index)]
    (or (:value option) (:id option))
    nil))
