(ns proofread.direct-conditions-non-candidates)

(def real-else
  (if ready?
    (save!)
    (skip!)))

(def different-if-condition
  (let [item (find-item)]
    (if ready?
      item
      :missing)))

(def different-nil-condition
  (let [item (find-item)]
    (if (nil? ready?)
      item
      :missing)))

(def different-when-condition
  (let [item (find-item)]
    (when ready?
      (save! item))))

(def multiple-bindings
  (let [item (find-item)
        ready? (ready? item)]
    (if item
      item
      :missing)))

(def dynamic-call-head
  ((:run step)
   {:work work
    :data (:data work)
    :step step}))

(def nil-comparison
  (if (= value nil)
    :missing
    :present))

(def expression-comparison
  (if (= (actual) (expected))
    :same
    :different))

(def repeated-call-condition
  (when (next-value!)
    (save! (next-value!))))

(def unrepeated-keyword-condition
  (when (:value result)
    (save! result)))
