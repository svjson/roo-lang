(ns proofread.direct-conditions-non-candidates)

(def real-else
  (if ready?
    (save!)
    (skip!)))

(def transformed-else-branch
  (if enabled?
    config
    (assoc config :enabled true)))

(def unrelated-else-value
  (if enabled?
    (assoc config :enabled true)
    other-config))

(def meaningful-conditional-merge
  (merge base
         (if enabled? {:enabled true} {:enabled false})))

(def value-as-if-condition
  (if enabled?
    (if config
      :enabled
      :disabled)
    config))

(def different-if-condition
  (let [item (find-item)]
    (if ready?
      item
      :missing)))

(def different-nil-condition
  (let [item (find-item)]
    (if (nil? ready?)
      item
      :missing)))

(def different-when-condition
  (let [item (find-item)]
    (when ready?
      (save! item))))

(def different-unless-nil-condition
  (let [item (find-item)]
    (unless (nil? ready?)
      (save! item))))

(def multiple-bindings
  (let [item (find-item)
        ready? (ready? item)]
    (if item
      item
      :missing)))

(def dynamic-call-head
  ((:run step)
   {:work work
    :data (:data work)
    :step step}))

(def nil-comparison
  (if (= value nil)
    :missing
    :present))

(def expression-comparison
  (if (= (actual) (expected))
    :same
    :different))

(def distinct-nested-branches
  (if ready?
    (if valid?
      :ok
      :invalid)
    :missing))

(def repeated-call-condition
  (when (next-value!)
    (save! (next-value!))))

(def unrepeated-keyword-condition
  (when (:value result)
    (save! result)))

(def meaningful-if-let-binding
  (if-let [value (:value option)]
    value
    (:id option)))

(def meaningful-when-let-binding
  (when-let [value (selected-value option)]
    (render value)))

(def destructured-if-let-binding
  (if-let [{:keys [value]} option]
    value
    (:id option)))
