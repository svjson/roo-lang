(ns proofread.direct-conditions-use-if-let)

(def empty-else
  (let [item (find-item)]
    (if item
      (:name item)
      nil)))

(def explicit-else
  (let [item (find-item)]
    (if item
      (:name item)
      :missing)))

(def nil-test
  (let [value (:value option)]
    (if (nil? value)
      (:id option)
      value)))
