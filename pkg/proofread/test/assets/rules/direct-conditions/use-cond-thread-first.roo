(ns proofread.direct-conditions-use-cond-thread-first)

(def conditional-assoc
  (if enabled?
    (assoc config :enabled true)
    config))

(def conditional-thread
  (if debug?
    (-> options
        (assoc :debug true)
        (assoc :level :verbose))
    options))

(def conditional-merge
  (merge {:mode 'ui/button
          :style (or style {})}
         (if class {:class class} {})
         (if ui-state {:ui-state ui-state} {})
         (if init {:init init} {})))
