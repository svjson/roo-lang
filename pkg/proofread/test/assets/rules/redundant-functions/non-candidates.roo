(ns proofread.redundant-functions-non-candidates)

(defun known?
  [value]
  (registered? value))

(defun value
  [book]
  (:value book))

(defun path-present?
  [value path]
  (path-present-at? value path 0))

(defun selected?
  [reporter]
  (case reporter
    :simple true
    :default false))

(defun contains-normalized?
  [name]
  (contains? (normalize name) '_'))

(defun recursive?
  [value]
  (recursive? value))

(defun total
  [left right]
  (+ left right))

(defun defaulted-value
  [value]
  (or value :default))

(defun default-separator []
  '-')

(defun check
  [value]
  (normalize value))

(defun check-file
  [path]
  (parse-file path))
