(ns proofread.redundant-functions-candidates)

(defun contains-underscore?
  "Test whether a name contains an underscore."
  [name]
  (contains? name '_'))

(defun keyword-named?
  [key]
  (= key :name))

(defun object-kind
  [object]
  (:kind object))

(def rules [])

(defun rule-ids
  []
  (registry/rule-ids rules))

(defun known-rule?
  [id]
  (registry/known-rule? rules id))
