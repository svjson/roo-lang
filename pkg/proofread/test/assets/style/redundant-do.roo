(ns proofread.style-sample)

(def value
  (do 42))

(defun function-body []
  (do
    (prn "first")
    (prn "second")))

(defun function-docstring-body
  "Sample function with a docstring."
  []
  (do
    (prn "first")
    (prn "second")))

(def wrapped-lambda
  (fn []
    (do
      (prn "first")
      (prn "second"))))

(def let-body
  (let [value 42]
    (do
      (prn value)
      value)))

(def when-body
  (when true
    (do
      (prn "first")
      (prn "second"))))

(def unless-body
  (unless false
    (do
      (prn "first")
      (prn "second"))))

(def when-let-body
  (when-let [value 42]
    (do
      (prn value)
      value)))

(def dotimes-body
  (dotimes [index 2]
    (do
      (prn index)
      index)))

(def for-body
  (for [value [1 2]]
    (do
      (prn value)
      value)))

(def doseq-body
  (doseq [value [1 2]]
    (do
      (prn value)
      value)))

(def for-indexed-body
  (for-indexed [index value [1 2]]
    (do
      (prn index value)
      value)))

(def while-body
  (while false
    (do
      (prn "first")
      (prn "second"))))

(def seeded-body
  (with-random-seed 1
    (do
      (prn "first")
      (prn "second"))))

(def nested-do
  (do
    (do
      (prn "first")
      (prn "second"))))

(def necessary-if-do
  (if true
    (do
      (prn "first")
      (prn "second"))
    nil))
