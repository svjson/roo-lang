(ns proofread.command.suggest-test
  (:require [cli-trooper :as cli-trooper]
            proof.core
            [proofread.cli :as proofread-cli]
            [proofread.command.suggest :as suggest-command]
            [proofread.source :as source]))



;; Fixture Source File Paths

(def candidates-path
  "Simple-expression candidate fixture path."
  "assets/rules/simple-expressions/candidates.roo")

(def direct-conditions-when-path
  "Direct-condition use-when candidate fixture path."
  "assets/rules/direct-conditions/use-when.roo")

(def direct-conditions-unless-path
  "Direct-condition use-unless candidate fixture path."
  "assets/rules/direct-conditions/use-unless-when.roo")



;; Fixture Functions

(defun suggestion-summary
  [diagnostic]
  [(:rule diagnostic)
   (map (:suggestions diagnostic) :title)
   (flat-map (:suggestions diagnostic)
             (fn [suggestion]
               (map (:edits suggestion) :replacement)))])

(defun suggestions-at
  [line column]
  (map (suggest-command/suggestions-at (source/diagnostics candidates-path)
                                       line
                                       column)
       suggestion-summary))

(defun suggestions-at-path
  [path line column]
  (map (suggest-command/suggestions-at (source/diagnostics path)
                                       line
                                       column)
       suggestion-summary))



;; cli-trooper option parsing

(deftest cli-options/parses-suggest-options
  (is (= {:line 12
          :column 4
          :file "src/app.roo"}
         (:options
          (cli-trooper/parse proofread-cli/application
                             {:args ["suggest"
                                     "src/app.roo"
                                     "--line" "12"
                                     "--column" "4"]}))))
  (is (= [:missing-positional]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["suggest"
                                          "--line" "12"
                                          "--column" "4"]}))
              :kind))))

(deftest cli-options/reports-invalid-suggest-options
  (is (= [:missing-required-option :missing-required-option]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["suggest" "src/app.roo"]}))
              :kind)))
  (is (= [:invalid-positive-integer :missing-required-option]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["suggest" "src/app.roo"
                                          "--line" "zero"]}))
              :kind)))
  (is (= [:unknown-option
          :missing-required-option
          :missing-required-option]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["suggest" "src/app.roo" "--wat"]}))
              :kind))))



;; proofread.command.suggest.suggestions-at

(deftest suggestions-at/finds-suggestions-at-source-position
  (is (= [[:use-head
           ["Rewrite as head"]
           ["(head items)"]]]
         (suggestions-at 4 5))))

(deftest suggest-no-nil-for-not-empty-with-guard
  (is (= [[:use-not-empty?
           ["Rewrite as not-empty?"]
           ["(not-empty? items)"]]]
        (suggestions-at 23 8))))

(deftest reports-suggestions-for-direct-condition-rules
  (is (= :use-when
         (head (head (suggestions-at-path direct-conditions-when-path 4 5))))))

(deftest reports-suggestions-for-direct-unless-rules
  (is (= :use-unless
         (head (head (suggestions-at-path direct-conditions-unless-path 4 5))))))


(deftest ignores-positions-without-suggestions
  (is (= [] (suggestions-at 1 1)))
  (is (= [] (suggestions-at 8 5))))

(deftest preserves-multiple-suggestions-and-orders-inner-ranges-first
  (let [diagnostics [{:rule :outer
                      :source {:start {:line 1 :column 1}
                               :end {:line 6 :column 1}}
                      :suggestions [{:title "Outer rewrite"
                                     :kind :rewrite
                                     :edits []}
                                    {:title "Outer alternative"
                                     :kind :rewrite
                                     :edits []}]}
                     {:rule :inner
                      :source {:start {:line 3 :column 3}
                               :end {:line 3 :column 12}}
                      :suggestions [{:title "Inner rewrite"
                                     :kind :rewrite
                                     :edits []}]}
                     {:rule :same-start-inner
                      :source {:start {:line 1 :column 1}
                               :end {:line 4 :column 1}}
                      :suggestions [{:title "Same-start rewrite"
                                     :kind :rewrite
                                     :edits []}]}]
        matches (suggest-command/suggestions-at diagnostics 3 5)]
    (is (= [:inner :same-start-inner :outer] (map matches :rule)))
    (is (= ["Outer rewrite" "Outer alternative"]
           (map (:suggestions (nth matches 2)) :title)))))



;; proofread.command.suggest/checked-diagnostics

(deftest returns-parse-error-diagnostics-when-unreadable
  (is (= [{:rule :parse
           :severity :error
           :file "assets/invalid/broken.roo"
           :source {:path "assets/invalid/broken.roo"}
           :message "Unexpected end of input"}]
         (suggest-command/checked-diagnostics "assets/invalid/broken.roo"))))
