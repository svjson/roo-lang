(ns proofread.command.check-test
  (:require [cli-trooper :as cli-trooper]
            proof.core
            [proofread.cli :as proofread-cli]
            [proofread.native :as native]
            [proofread.command.check :as check-command]
            [voodoo.session :as session]))



;; cli-trooper option parsing

(deftest cli-options/parses-reporter-option
  (is (= {:reporter :simple
          :groups []
          :show-ranges? false
          :stdin-filename nil
          :files ["src"]}
         (:options (cli-trooper/parse proofread-cli/application
                                      {:args ["--reporter"
                                              "simple"
                                              "src"]}))))
  (is (= {:reporter :simple
          :groups []
          :show-ranges? false
          :stdin-filename nil
          :files ["src"]}
         (:options (cli-trooper/parse proofread-cli/application
                                      {:args ["src"
                                              "--reporter"
                                              "simple"]})))))

(deftest cli-options/parses-group-options
  (is (= [:rule :namespace]
         (:groups (:options (cli-trooper/parse proofread-cli/application
                                               {:args ["--group-by"
                                                       "rule,namespace"
                                                       "src"]})))))
  (is (= [:namespace :rule]
         (:groups
          (:options
           (cli-trooper/parse proofread-cli/application
                              {:args ["--group-by" "namespace"
                                      "--group-by" "rule"
                                      "src"]}))))))

(deftest cli-options/parses-show-ranges-option
  (is (= {:show-ranges? true}
         (select-keys (:options (cli-trooper/parse proofread-cli/application
                                                   {:args ["--show-ranges"
                                                           "src"]}))
                      [:show-ranges?]))))

(deftest cli-options/parses-stdin-filename-option
  (is (= "/workspace/src/app.roo"
         (-> proofread-cli/application
             (cli-trooper/parse {:args ["--reporter"
                                        "simple"
                                        "--stdin-filename"
                                        "/workspace/src/app.roo"]})
             :options
             :stdin-filename))))

(deftest cli-options/reports-invalid-check-arguments
  (is (= [:missing-input]
         (map (:errors (cli-trooper/parse proofread-cli/application {:args []}))
              :kind)))
  (is (= [:missing-option-value]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["src" "--reporter"]}))
              :kind)))
  (is (= [:invalid-enum-value]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["--reporter" "tree" "src"]}))
              :kind)))
  (is (= [:missing-option-value]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["src" "--group-by"]}))
              :kind)))
  (is (= [:invalid-enum-value]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["--group-by" "rule,unknown" "src"]}))
              :kind))))

(deftest cli-options/rejects-invalid-stdin-filename-combinations
  (is (= [:missing-option-value]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["--stdin-filename"]}))
              :kind)))
  (is (= [:conflicting-inputs]
         (map (:errors
               (cli-trooper/parse proofread-cli/application
                                  {:args ["--stdin-filename" "src/app.roo"
                                          "src/other.roo"]}))
              :kind))))

(deftest cli-options/parses-explicit-check-command
  (= {:command "check"
      :options {:files ["src"]}
      :errors []}
     (cli-trooper/parse proofread-cli/application
                                  {:args ["check" "src"]})))



;; proofread.command.check/await-execution!

(deftest await-execution!/guards-failed-worker-collection
  (roo.worker/create! :proofread-test/failure)
  (let [execution (roo.worker/execute-let! :proofread-test/failure []
                    (raise :proofread.test/planned-failure "planned failure"))
        outcome (check-command/await-execution! (session/make {:tty? false})
                                                execution
                                                "Scanning test input")]
    (is (= :failed (:status outcome)))
    (is (= :proofread.test/planned-failure (get-in outcome [:error :type])))
    (is (= "planned failure" (get-in outcome [:error :detail])))))



;; proofread.command.check/check-source-result!

(deftest check-source-result!/checks-valid-malformed-and-empty-in-memory-source
  (let [path "/missing/project/src/app.roo"]

    (is (= {:checked 1 :errors 0 :error-details []}
           (native/check-source-result! path "(ns sample.app)")))

    (is (= {:checked 0
            :errors 1
            :error-details [{:path path
                             :message "Unexpected end of input"}]}
           (native/check-source-result! path "(ns sample.app")))

    (is (= {:checked 1 :errors 0 :error-details []}
           (native/check-source-result! path "")))))
