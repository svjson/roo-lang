(ns proofread.config-test
  (:require proof.core
            [proofread.config :as config]
            [proofread.rules :as rules]
            [proofread.rules.registry :as registry]
            [proofread.source :as source]))



;;; proofread.config/merge-config

(deftest merges-config-maps-recursively
  (is (= {:rules {:redundant-do :off
                  :use-head {:severity :error}}}
         (config/merge-config {:rules {:redundant-do {:severity :error}
                                       :use-head :off}}
                              {:rules {:redundant-do :off
                                       :use-head {:severity :error}}}))))



;;; proofread.config/apply-diagnostics


(deftest applies-rule-config-to-diagnostics
  (is (= [{:rule :use-head
           :severity :error}]
         (config/apply-diagnostics {:rules {:redundant-do :off
                                            :use-head {:severity :error}}}
                                   [{:rule :redundant-do
                                     :severity :warning}
                                    {:rule :use-head
                                     :severity :warning}]))))



;;; proofread.config/unknown-rules


(deftest reports-unknown-configured-rules
  (is (= [:missing-rule]
         (config/unknown-rules {:rules {:use-head :off
                                        :missing-rule :off}}
                               (registry/rule-ids rules/rules)))))
