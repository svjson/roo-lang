(ns proofread.reporter.common-test
  (:require proof.core
            [proofread.reporter.common :as common]
            [soot.core :as soot-core]))

(def esc soot-core/esc)

(deftest styles-location-segments
  (is (= (str "world-map/src/"
              esc "[1msymbols.roo" esc "[22m"
              esc "[2;90m:" esc "[39;22m"
              esc "[36m117" esc "[39m"
              esc "[2;90m:" esc "[39;22m"
              esc "[36m28" esc "[39m"
              ":")
         (common/diagnostic-location {:path "world-map/src/symbols.roo"
                                      :line 117
                                      :column 28}))))

(deftest formats-file-level-locations
  (is (= (str "world-map/src/"
              esc "[1msymbols.roo" esc "[22m"
              ":")
         (common/diagnostic-location {:path "world-map/src/symbols.roo"}))))

(deftest formats-location-ranges-when-enabled
  (is (= (str "world-map/src/"
              esc "[1msymbols.roo" esc "[22m"
              esc "[2;90m:" esc "[39;22m"
              esc "[36m117" esc "[39m"
              esc "[2;90m:" esc "[39;22m"
              esc "[36m28" esc "[39m"
              esc "[2;90m-" esc "[39;22m"
              esc "[36m119" esc "[39m"
              esc "[2;90m:" esc "[39;22m"
              esc "[36m9" esc "[39m"
              ":")
         (common/diagnostic-location-with-options
          {:path "world-map/src/symbols.roo"
           :line 117
           :column 28
           :end {:line 119
                 :column 9}}
          {:show-ranges? true}))))

(deftest styles-error-diagnostics
  (is (= (str esc "[1msymbols.roo" esc "[22m"
              ": "
              esc "[1;31merror" esc "[39;22m"
              " "
              esc "[35mparse" esc "[39m"
              ": Unexpected end of input")
         (common/diagnostic-line {:source {:path "symbols.roo"}
                                  :severity :error
                                  :rule :parse
                                  :message "Unexpected end of input"}))))

(deftest styles-rule-name-as-magenta
  (is (= (str esc "[1msymbols.roo" esc "[22m"
              esc "[2;90m:" esc "[39;22m"
              esc "[36m117" esc "[39m"
              esc "[2;90m:" esc "[39;22m"
              esc "[36m28" esc "[39m"
              ":"
              " "
              esc "[1;33mwarning" esc "[39;22m"
              " "
              esc "[35mredundant-do" esc "[39m"
              ": Redundant do form")
         (common/diagnostic-line {:source {:path "symbols.roo"
                                           :line 117
                                           :column 28}
                                  :severity :warning
                                  :rule :redundant-do
                                  :message "Redundant do form"}))))
