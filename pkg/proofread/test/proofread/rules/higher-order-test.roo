(ns proofread.rules.higher-order-test
  (:require proof.core
            [proofread.rules.higher-order :as higher-order]
            [proofread.rules.support :as support]))



;;; Fixtures

(defun produce-summary
  [path]
  (support/produce-rule-start-summary path higher-order/check))



;;; proofread.rules.higher-order/check

(deftest use-flat-map/reports-candidates
  (is (= [{:rule :use-flat-map
           :start {:line 4
                   :column 3}}
          {:rule :use-flat-map
           :start {:line 8
                   :column 3}}]
         (produce-summary "assets/rules/higher-order/use-flat-map.roo"))))


(deftest use-find-first/reports-candidates
  (is (= [{:rule :use-find-first
           :start {:line 4
                   :column 3}}
          {:rule :use-find-first
           :start {:line 7
                   :column 3}}]
         (produce-summary "assets/rules/higher-order/use-find-first.roo"))))


(deftest use-keep/reports-candidates
  (is (= [{:rule :use-keep
           :start {:line 4
                   :column 3}}
          {:rule :use-keep
           :start {:line 10
                   :column 3}}
          {:rule :use-keep
           :start {:line 16
                   :column 3}}
          {:rule :use-keep
           :start {:line 21
                   :column 3}}
          {:rule :use-keep
           :start {:line 28
                   :column 3}}
          {:rule :use-keep
           :start {:line 35
                   :column 3}}]
         (produce-summary "assets/rules/higher-order/use-keep.roo"))))


(deftest higher-order/ignores-non-candidates
  (is (= []
         (produce-summary "assets/rules/higher-order/non-candidates.roo"))))
