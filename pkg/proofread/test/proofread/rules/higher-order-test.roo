(ns proofread.rules.higher-order-test
  (:require proof.core
            [proofread.rules.higher-order :as higher-order]
            [roo.ast :as ast]))

(defun diagnostics [path]
  (flat-map (ast/slurp! path) higher-order/check))

(defun diagnostic-lines [path]
  (map (diagnostics path)
       (fn [diagnostic]
         (:line (:source diagnostic)))))

(defun diagnostic-rules [path]
  (map (diagnostics path)
       (fn [diagnostic]
         (:rule diagnostic))))

(deftest reports-flat-map-candidates
  (is (= [4 8]
         (diagnostic-lines "assets/rules/higher-order/use-flat-map.roo"))))

(deftest reports-find-first-candidates
  (is (= [:use-find-first :use-find-first]
         (diagnostic-rules "assets/rules/higher-order/use-find-first.roo")))
  (is (= [4 7]
         (diagnostic-lines "assets/rules/higher-order/use-find-first.roo"))))

(deftest reports-keep-candidates
  (is (= [:use-keep :use-keep :use-keep :use-keep :use-keep :use-keep]
         (diagnostic-rules "assets/rules/higher-order/use-keep.roo")))
  (is (= [4 10 16 21 28 35]
         (diagnostic-lines "assets/rules/higher-order/use-keep.roo"))))

(deftest ignores-higher-order-non-candidates
  (is (= []
         (diagnostics "assets/rules/higher-order/non-candidates.roo"))))
