(ns proofread.rules.registry-test
  (:require proof.core
            [proofread.rules :as rules]
            [proofread.rules.registry :as registry]))



;;; proofread.rules.registry/descriptors

(deftest descriptors/loads-ordered-rule-modules
  (let [descriptors
        (registry/descriptors
          :sample
          {:first 'proofread.rules.higher-order.use-flat-map
           :second 'proofread.rules.higher-order.use-find-first})
        first-rule (head descriptors)]
    (is (= [:first :second] (registry/rule-ids descriptors)))
    (is (= (get (module 'proofread.rules.higher-order.use-flat-map) 'check)
           (get (:module first-rule) 'check)))
    (is (= :node (:scope first-rule)))
    (is (nil? (:default-options first-rule)))))

(deftest descriptors/reads-optional-module-metadata
  (let [filename-rule (find-first rules/rules
                                  (fn [rule]
                                    (= :kebab-case-filename (:id rule))))
        destructuring-rule (find-first rules/rules
                                       (fn [rule]
                                         (= :use-argument-destructuring (:id rule))))]
    (is (= :file (:scope filename-rule)))
    (is (= {:allow-renamed-keyword-lookups true}
           (:default-options destructuring-rule)))))



;;; proofread.rules.registry/node-diagnostic

(deftest node-diagnostic/passes-rule-options-to-check
  (is (= {:parent :parent
          :node :node
          :options {:mode :strict}}
         (registry/node-diagnostic
           [{:module {'check (fn [parent node options]
                               {:parent parent :node node :options options})}
             :options {:mode :strict}}]
           :parent
           :node))))



;;; proofread.rules.registry/known-rule?

(deftest known-rule?/exposes-registered-rule-ids
  (is (registry/known-rule? rules/rules :use-head))
  (is (registry/known-rule? rules/rules :use-for-indexed))
  (is (registry/known-rule? rules/rules :redundant-do))
  (is (not (registry/known-rule? rules/rules :missing-rule))))
