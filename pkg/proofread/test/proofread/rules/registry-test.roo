(ns proofread.rules.registry-test
  (:require proof.core
            [proofread.rules :as rules]
            [proofread.rules.registry :as registry]))



;;; proofread.rules.registry/descriptors

(deftest descriptors/registers-one-check-function
  (let [check (fn [_parent _node _options] nil)
        rule (head (registry/descriptors :sample [[:sample check]]))]
    (is (= check (:check rule)))
    (is (not (contains? rule :check-with-options)))))



;;; proofread.rules.registry/node-diagnostic

(deftest node-diagnostic/passes-rule-options-to-check
  (is (= {:parent :parent
          :node :node
          :options {:mode :strict}}
         (registry/node-diagnostic
           [{:check (fn [parent node options]
                      {:parent parent
                       :node node
                       :options options})
             :options {:mode :strict}}]
           :parent
           :node))))



;;; proofread.rules.registry/known-rule?

(deftest known-rule?/exposes-registered-rule-ids
  (is (registry/known-rule? rules/rules :use-head))
  (is (registry/known-rule? rules/rules :use-for-indexed))
  (is (registry/known-rule? rules/rules :redundant-do))
  (is (not (registry/known-rule? rules/rules :missing-rule))))
