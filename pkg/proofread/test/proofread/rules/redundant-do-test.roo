(ns proofread.rules.redundant-do-test
  (:require proof.core
            [proofread.rules.redundant-do :as redundant-do]
            [proofread.rules.support :as support]))



;;; Fixtures

(defun produce-summary
  [path]
  (support/produce-rule-start-summary path redundant-do/check redundant-do/rules))



;;; proofread.rules.redundant-do/check

(deftest redundant-do/reports-single-expression-do-forms
  (is (= [{:rule :redundant-do
           :start {:line 4
                   :column 3}}]
         (produce-summary "assets/rules/redundant-do/single-expression.roo"))))

(deftest redundant-do/reports-do-forms-that-wrap-implicit-bodies
  (is (= [{:rule :redundant-do
           :start {:line 4
                   :column 3}}
          {:rule :redundant-do
           :start {:line 10
                   :column 5}}
          {:rule :redundant-do
           :start {:line 16
                   :column 5}}
          {:rule :redundant-do
           :start {:line 22
                   :column 5}}
          {:rule :redundant-do
           :start {:line 28
                   :column 5}}
          {:rule :redundant-do
           :start {:line 34
                   :column 5}}]
         (produce-summary "assets/rules/redundant-do/body-wrappers.roo"))))

(deftest redundant-do/reports-do-forms-that-wrap-loop-bodies
  (is (= [{:rule :redundant-do
           :start {:line 5
                   :column 5}}
          {:rule :redundant-do
           :start {:line 11
                   :column 5}}
          {:rule :redundant-do
           :start {:line 17
                   :column 5}}
          {:rule :redundant-do
           :start {:line 23
                   :column 5}}
          {:rule :redundant-do
           :start {:line 29
                   :column 5}}
          {:rule :redundant-do
           :start {:line 35
                   :column 5}}]
         (produce-summary "assets/rules/redundant-do/loop-body-wrappers.roo"))))

(deftest redundant-do/reports-nested-do-body-wrappers
  (is (= [{:rule :redundant-do
           :start {:line 4
                   :column 3}}
          {:rule :redundant-do
           :start {:line 5
                   :column 5}}]
         (produce-summary "assets/rules/redundant-do/nested-do.roo"))))

(deftest redundant-do/ignores-required-branch-do-forms
  (is (= []
         (produce-summary "assets/rules/redundant-do/required-branch-do.roo"))))

(deftest redundant-do/ignores-required-value-do-forms
  (is (= []
         (produce-summary "assets/rules/redundant-do/required-value-do.roo"))))

(deftest redundant-do/ignores-dynamic-call-heads
  (is (= []
         (produce-summary "assets/rules/redundant-do/dynamic-call-head.roo"))))
