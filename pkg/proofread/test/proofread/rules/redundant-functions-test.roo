(ns proofread.rules.redundant-functions-test
  (:require proof.core
            [proofread.rules.support :as support]
            [proofread.rules.redundant-functions :as redundant-functions]))



;;; Fixtures

(defun produce-summary
  [path]
  (support/produce-rule-start-summary path redundant-functions/check))



;;; proofread.rules.redundant-functions/check

(deftest redundant-function/reports-candidates
  (is (= [{:rule :redundant-function
           :start {:line 3
                   :column 1}}
          {:rule :redundant-function
           :start {:line 8
                   :column 1}}
          {:rule :redundant-function
           :start {:line 12
                   :column 1}}
          {:rule :redundant-function
           :start {:line 18
                   :column 1}}
          {:rule :redundant-function
           :start {:line 22
                   :column 1}}]
         (produce-summary "assets/rules/redundant-functions/candidates.roo"))))

(deftest redundant-function/ignores-non-candidates
  (is (= []
         (produce-summary "assets/rules/redundant-functions/non-candidates.roo"))))
