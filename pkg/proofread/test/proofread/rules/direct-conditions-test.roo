(ns proofread.rules.direct-conditions-test
  (:require proof.core
            [proofread.rules.direct-conditions :as direct-conditions]
            [proofread.rules.support :as support]))



;;; Fixtures

(defun produce-summary
  [path]
  (support/produce-rule-start-summary path direct-conditions/check))



;;; proofread.rules.direct-conditions/check

(deftest use-when/reports-for-empty-else-branches []
  (is (= [{:rule :use-when
           :start {:line 4
                   :column 3}}
          {:rule :use-when
           :start {:line 9
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/use-when.roo"))))


(deftest use-unless/reports-for-empty-then-branches
  (is (= [{:rule :use-unless
           :start {:line 4
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/use-unless.roo")))
  (is (= [{:rule :use-unless
           :start {:line 4
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/use-unless-when.roo"))))


(deftest use-if-let/reports-let-wrapped-if-forms
  (is (= [{:rule :use-if-let
           :start {:line 4
                   :column 3}}
          {:rule :use-if-let
           :start {:line 10
                   :column 3}}
          {:rule :use-if-let
           :start {:line 16
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/use-if-let.roo"))))


(deftest use-when-let/reports-let-wrapped-when-forms
  (is (= [{:rule :use-when-let
           :start {:line 4
                   :column 3}}
          {:rule :use-when-let
           :start {:line 9
                   :column 3}}
          {:rule :use-when-let
           :start {:line 13
                   :column 3}}
          {:rule :use-when-let
           :start {:line 20
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/use-when-let.roo"))))


(deftest redundant-self-binding/reports-redundant-bindings
  (is (= [{:rule :redundant-self-binding
           :start {:line 4
                   :column 3}}
          {:rule :redundant-self-binding
           :start {:line 9
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/redundant-self-binding.roo"))))


(deftest use-case/reports-literal-equality-dispatch
  (is (= [{:rule :use-case
           :start {:line 4
                   :column 3}}
          {:rule :use-case
           :start {:line 9
                   :column 3}}
          {:rule :use-case
           :start {:line 14
                   :column 3}}
          {:rule :use-case
           :start {:line 19
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/use-case.roo"))))


(deftest use-case/reports-literal-equality-dispatch-pyramids
  (is (= [{:rule :use-case
           :start {:line 4
                   :column 3}}
          {:rule :use-case
           :start {:line 13
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/use-case-pyramid.roo"))))


(deftest use-cond/reports-if-pyramids
  (is (= [{:rule :use-cond
           :start {:line 4
                   :column 3}}
          {:rule :use-cond
           :start {:line 11
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/use-cond.roo"))))


(deftest use-cond-thread-first/reports-if-expressions-in-thread-first-context
  (is (= [{:rule :use-cond-thread-first
           :start {:line 4
                   :column 3}}
          {:rule :use-cond-thread-first
           :start {:line 9
                   :column 3}}
          {:rule :use-cond-thread-first
           :start {:line 16
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/use-cond-thread-first.roo"))))


(deftest flatten-if-pyramid/reports-if-pyramids
  (is (= [{:rule :flatten-if-pyramid
           :start {:line 4
                   :column 3}}
          {:rule :flatten-if-pyramid
           :start {:line 11
                   :column 3}}
          {:rule :flatten-if-pyramid
           :start {:line 18
                   :column 3}}
          {:rule :flatten-if-pyramid
           :start {:line 25
                   :column 3}}]
         (produce-summary "assets/rules/direct-conditions/flatten-if-pyramid.roo"))))


(deftest direct-conditions/ignores-non-candidates
  (is (= []
         (produce-summary "assets/rules/direct-conditions/non-candidates.roo"))))
