(ns proofread.rules.loops-test
  (:require proof.core
            [proofread.rules.loops :as loops]
            [proofread.rules.support :as support]))



;;; Fixtures

(defun produce-summary
  [path]
  (support/produce-rule-start-summary path loops/check loops/rules))



;;; proofread.rules.loops/check

(deftest use-for-indexed/reports-indexed-while-loops
  (is (= [{:rule :use-for-indexed
           :start {:line 4
                   :column 3}}
          {:rule :use-for-indexed
           :start {:line 15
                   :column 3}}]
         (produce-summary "assets/rules/loops/use-for-indexed.roo"))))

(deftest use-reduce/reports-while-candidates
  (is (= [{:rule :use-reduce
           :start {:line 4
                   :column 3}}
          {:rule :use-reduce
           :start {:line 15
                   :column 3}}
          {:rule :use-reduce
           :start {:line 21
                   :column 3}}]
         (produce-summary "assets/rules/loops/use-reduce.roo"))))

(deftest loops/ignores-non-candidates
  (is (= []
         (produce-summary "assets/rules/loops/non-candidates.roo"))))
