(ns proofread.rules.support)



;;; Re-usable test support functions/fixtures

(defun produce-rule-start-summary
  "Summarize triggered rules and their start locations for one source file.

  Args:
  - `path`: Roo source file path.
  - `check-fn`: Category check function.
  - `active-rules`: Rule descriptors to pass to `check-fn`.

  Returns:
  Maps containing each diagnostic's rule and start location."
  [path check-fn active-rules]
  (for [d (flat-map (roo.ast/slurp! path) (fn [root] (check-fn active-rules root)))]
    {:rule (:rule d)
     :start (-> d :source :start)}))

(defun produce-suggestion-summary
  "Summarize suggestions from one rule for a source file.

  Args:
  - `path`: Roo source file path.
  - `check-fn`: Category check function.
  - `active-rules`: Rule descriptors to pass to `check-fn`.
  - `rule`: Rule keyword whose suggestions should be retained.

  Returns:
  Maps containing the selected rule and its suggestion titles and edits."
  [path check-fn active-rules rule]
  (keep (flat-map (roo.ast/slurp! path) (fn [root] (check-fn active-rules root)))
        (fn [d]
          (when (= (:rule d) rule)
            {:rule (:rule d)
             :suggestions (for [s (:suggestions d)]
                            {:title (:title s)
                             :edits (for [e (:edits s)]
                                      {:replacement (:replacement e)})})}))))
