(ns proofread.rules.names-test
  (:require proof.core
            [proofread.rules.names :as names]
            [proofread.rules.support :as support]))



;;; Fixtures

(defun produce-summary
  [path]
  (support/produce-rule-start-summary path names/check))



;;; proofread.rules.names/check

(deftest kebab-case-name/reports-underscore-identifiers
  (is (= [{:rule :kebab-case-name
           :start {:line 3
                   :column 6}}
          {:rule :kebab-case-name
           :start {:line 6
                   :column 8}}
          {:rule :kebab-case-name
           :start {:line 11
                   :column 3}}]
         (produce-summary "assets/rules/names/candidates.roo"))))


(deftest kebab-case-name/ignores-kebab-case-identifiers
  (is (= []
         (produce-summary "assets/rules/names/non-candidates.roo"))))


(deftest kebab-case-filename/reports-underscore-filenames
  (is (= [{:rule :kebab-case-filename
           :severity :warning
           :source {:path "assets/rules/names/bad_filename.roo"}
           :message "Use kebab-case filenames"}]
         (support/produce-file-diagnostics names/check-file
                                           names/rules
                                           "assets/rules/names/bad_filename.roo"))))


(deftest kebab-case-filename/ignores-kebab-case-filenames
  (is (= []
         (support/produce-file-diagnostics names/check-file
                                           names/rules
                                           "assets/rules/names/good-filename.roo"))))


(deftest kebab-case-filename/ignores-namespace-directory-entry-filenames
  (is (= []
         (support/produce-file-diagnostics
           names/check-file
           names/rules
           "assets/rules/names/default-layout/src/my-app/infra/_infra.roo")))
  (is (= []
         (support/produce-file-diagnostics
           names/check-file
           names/rules
           "assets/rules/names/namespace-root-layout/src/_my-app.roo"))))


(deftest kebab-case-filename/reports-mismatched-directory-entry-filenames
  (is (= [{:rule :kebab-case-filename
           :severity :warning
           :source {:path "assets/rules/names/default-layout/src/my-app/infra/_cowabunga.roo"}
           :message "Use kebab-case filenames"}]
         (support/produce-file-diagnostics
           names/check-file
           names/rules
           "assets/rules/names/default-layout/src/my-app/infra/_cowabunga.roo"))))
