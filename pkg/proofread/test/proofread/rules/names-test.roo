(ns proofread.rules.names-test
  (:require proof.core
            [proofread.rules.names :as names]
            [roo.ast :as ast]))

(defun diagnostics
  [path]
  (flatten
    (map (ast/slurp! path) names/check)))

(defun diagnostic-lines
  [path]
  (map (diagnostics path)
       (fn [diagnostic]
         (:line (:source diagnostic)))))

(defun file-diagnostics
  [path]
  (names/check-file names/rules path))

(deftest reports-underscore-identifiers
  (is (= [3 6 11]
         (diagnostic-lines "assets/rules/names/candidates.roo"))))

(deftest ignores-kebab-case-identifiers
  (is (= []
         (diagnostics "assets/rules/names/non-candidates.roo"))))

(deftest reports-underscore-filenames
  (is (= [:kebab-case-filename]
         (map (file-diagnostics "assets/rules/names/bad_filename.roo") :rule))))

(deftest ignores-kebab-case-filenames
  (is (= []
         (file-diagnostics "assets/rules/names/good-filename.roo"))))
