(ns proofread.rules.simple-expressions-test
  (:require proof.core
            [proofread.rules.simple-expressions :as simple-expressions]
            [roo.ast :as ast]))

(defun diagnostics
  [path]
  (flat-map (ast/slurp! path) simple-expressions/check))

(defun diagnostic-summary
  [path]
  (map (diagnostics path)
       (fn [diagnostic]
         [(:rule diagnostic) (:line (:source diagnostic))])))

(deftest reports-simple-expression-rewrites
  (is (= [[:use-head 4]
          [:use-empty? 7]
          [:use-empty? 10]
          [:use-not-empty? 13]
          [:use-not-empty? 18]
          [:use-not-empty? 23]
          [:use-not= 26]
          [:use-nil? 29]
          [:use-nil? 32]
          [:use-some? 35]
          [:use-some? 38]
          [:use-any? 38]
          [:use-some? 41]
          [:use-some? 44]
          [:use-contains? 44]
          [:redundant-empty-fallback 47]
          [:redundant-empty-fallback 50]
          [:redundant-empty-fallback 53]]
         (diagnostic-summary "assets/rules/simple-expressions/candidates.roo"))))

(deftest ignores-simple-expression-non-candidates
  (is (= []
         (diagnostics "assets/rules/simple-expressions/non-candidates.roo"))))

(deftest reports-redundant-map-checks
  (is (= [[:redundant-map-check 4]
          [:redundant-map-check 9]
          [:redundant-map-check 13]]
         (diagnostic-summary "assets/rules/simple-expressions/redundant-map-check.roo"))))

(deftest reports-select-keys-candidates
  (is (= [[:use-select-keys 4]
          [:use-select-keys 9]]
         (diagnostic-summary "assets/rules/simple-expressions/use-select-keys.roo"))))

(deftest ignores-select-keys-non-candidates
  (is (= []
         (diagnostics "assets/rules/simple-expressions/select-keys-non-candidates.roo"))))
