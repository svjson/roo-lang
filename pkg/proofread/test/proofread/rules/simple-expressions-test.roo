(ns proofread.rules.simple-expressions-test
  (:require proof.core
            [proofread.rules.simple-expressions :as simple-expressions]
            [roo.ast :as ast]))

(defun diagnostics
  [path]
  (flat-map (ast/slurp! path) simple-expressions/check))

(defun diagnostic-summary
  [path]
  (map (diagnostics path)
       (fn [diagnostic]
         [(:rule diagnostic) (:line (:source diagnostic))])))

(defun diagnostic-for-rule
  [path rule]
  (find-first (diagnostics path)
              (fn [diagnostic]
                (= rule (:rule diagnostic)))))

(defun suggestion-summary
  [path rule]
  (map (:suggestions (diagnostic-for-rule path rule))
       (fn [suggestion]
         [(:title suggestion)
          (:kind suggestion)
          (map (:edits suggestion) :replacement)])))

(deftest reports-simple-expression-rewrites
  (is (= [[:use-head 4]
          [:use-empty? 7]
          [:use-empty? 10]
          [:use-not-empty? 13]
          [:use-not-empty? 18]
          [:use-not-empty? 23]
          [:use-not= 26]
          [:use-nil? 29]
          [:use-nil? 32]
          [:use-some? 35]
          [:use-some? 38]
          [:use-any? 38]
          [:use-some? 41]
          [:use-any? 41]
          [:use-some? 44]
          [:use-contains? 44]
          [:redundant-empty-fallback 47]
          [:redundant-empty-fallback 50]
          [:redundant-empty-fallback 53]
          [:redundant-empty-fallback 56]
          [:use-keyword-lookup 59]
          [:use-get-with-default 62]
          [:use-get-with-default 66]
          [:use-get-in-with-default 70]
          [:use-any? 75]
          [:redundant-some? 78]
          [:redundant-some? 83]
          [:use-string? 87]
          [:use-contains? 91]
          [:use-contains? 96]
          [:use-clamp 101]
          [:use-clamp 104]
          [:use-clamp 107]
          [:use-clamp 110]
          [:use-type-predicate 113]
          [:use-type-predicate 116]
          [:use-update 119]
          [:use-update 124]]
         (diagnostic-summary "assets/rules/simple-expressions/candidates.roo"))))

(deftest ignores-simple-expression-non-candidates
  (is (= []
         (diagnostics "assets/rules/simple-expressions/non-candidates.roo"))))

(deftest reports-structured-suggestions
  (is (= [["Rewrite as head" :rewrite ["(head items)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-head)))
  (is (= [["Rewrite as empty?" :rewrite ["(empty? items)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-empty?)))
  (is (= [["Rewrite as not-empty?" :rewrite ["(not-empty? items)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-not-empty?)))
  (is (= [["Rewrite as not=" :rewrite ["(not= left right)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-not=)))
  (is (= [["Rewrite as nil?" :rewrite ["(nil? value)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-nil?)))
  (is (= [["Rewrite as some?" :rewrite ["(some? value)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-some?)))
  (is (= [["Rewrite as any?" :rewrite ["(any? name (fn [ch] (= \"_\" (str ch))))"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-any?)))
  (is (= [["Rewrite as get with default" :rewrite ["(get values key default-value)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-get-with-default)))
  (is (= [["Rewrite as get-in with default"
           :rewrite
           ["(get-in game-state (concat obligations-path [:groups group-id]) [])"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-get-in-with-default)))
  (is (= [["Rewrite as keyword lookup" :rewrite ["(:name symbol)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-keyword-lookup)))
  (is (= [["Rewrite as type predicate" :rewrite ["(map? patch)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-type-predicate)))
  (is (= [["Rewrite as starts-with?" :rewrite ["(string/starts-with? text \":\")"]]]
         (suggestion-summary "assets/rules/simple-expressions/use-string-starts-with.roo"
                             :use-string-starts-with?)))
)

(deftest reports-use-append-candidates
  (is (= [[:use-append 4]]
         (diagnostic-summary "assets/rules/simple-expressions/use-append.roo"))))

(deftest ignores-use-append-non-candidates
  (is (= []
         (diagnostics "assets/rules/simple-expressions/use-append-non-candidates.roo"))))

(deftest reports-contains-and-append-candidates
  (let [path "assets/rules/simple-expressions/use-contains-and-append.roo"]
    (is (= 2 (count (diagnostics path))))
    (is (some? (diagnostic-for-rule path :use-contains?)))
    (is (some? (diagnostic-for-rule path :use-append)))))

(deftest reports-redundant-map-checks
  (is (= [[:redundant-map-check 4]
          [:redundant-map-check 9]
          [:redundant-map-check 13]
          [:redundant-map-check 18]
          [:redundant-map-check 23]]
         (diagnostic-summary "assets/rules/simple-expressions/redundant-map-check.roo"))))

