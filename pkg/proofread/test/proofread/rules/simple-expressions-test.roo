(ns proofread.rules.simple-expressions-test
  (:require proof.core
            [proofread.rules.support :as support]
            [proofread.rules.simple-expressions :as simple-expressions]))



;;; Fixtures

(defun produce-summary
  [path]
  (support/produce-rule-start-summary path
                                      simple-expressions/check
                                      simple-expressions/rules))



;;; proofread.rules.simple-expressions/check

