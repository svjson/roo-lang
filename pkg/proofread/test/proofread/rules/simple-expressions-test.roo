(deftest use-string-starts-with?/reports-structured-suggestions
  (is (= [{:rule :use-string-starts-with?
           :suggestions [{:title "Rewrite as starts-with?"
                          :edits [{:replacement "(string/starts-with? text \":\")"}]}]}
          {:rule :use-string-starts-with?
           :suggestions [{:title "Rewrite as starts-with?"
                          :edits [{:replacement "(if (string/starts-with? text \":\") (substr text 1) text)"}]}]}]
         (support/produce-suggestion-summary "assets/rules/simple-expressions/use-string-starts-with.roo"
                                             simple-expressions/check
                                             simple-expressions/rules
                                             :use-string-starts-with?))))
