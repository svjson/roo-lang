(deftest use-some?/reports-structured-suggestions
  (is (= [{:rule :use-some?
           :suggestions [{:title "Rewrite as some?"
                          :edits [{:replacement "(some? value)"}]}]}
          {:rule :use-some?
           :suggestions [{:title "Rewrite as some?"
                          :edits [{:replacement "(some? (find-index name (fn [ch] (= \"_\" (str ch)))))"}]}]}
          {:rule :use-some?
           :suggestions [{:title "Rewrite as some?"
                          :edits [{:replacement "(some? (find-first names (fn [name] (= name target))))"}]}]}
          {:rule :use-some?
           :suggestions [{:title "Rewrite as some?"
                          :edits [{:replacement "(some? (index-of name '-'))"}]}]}]
         (support/produce-suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                                             simple-expressions/check
                                             simple-expressions/rules
                                             :use-some?))))

(deftest use-any?/reports-structured-suggestions
  (is (= [{:rule :use-any?
           :suggestions [{:title "Rewrite as any?"
                          :edits [{:replacement "(any? name (fn [ch] (= \"_\" (str ch))))"}]}]}
          {:rule :use-any?
           :suggestions [{:title "Rewrite as any?"
                          :edits [{:replacement "(any? names (fn [name] (= name target)))"}]}]}
          {:rule :use-any?
