(ns proofread.rules.simple-expressions-test
  (:require proof.core
            [proofread.rules.simple-expressions :as simple-expressions]
            [roo.ast :as ast]))

(defun diagnostics
  [path]
  (flat-map (ast/slurp! path) simple-expressions/check))

(defun diagnostic-summary
  [path]
  (map (diagnostics path)
       (fn [diagnostic]
         [(:rule diagnostic) (:line (:source diagnostic))])))

(defun diagnostic-for-rule
  [path rule]
  (find-first (diagnostics path)
              (fn [diagnostic]
                (= rule (:rule diagnostic)))))

(defun suggestion-summary
  [path rule]
  (map (:suggestions (diagnostic-for-rule path rule))
       (fn [suggestion]
         [(:title suggestion)
          (:kind suggestion)
          (map (:edits suggestion) :replacement)])))

(deftest reports-simple-expression-rewrites
  (is (= [[:use-head 4]
          [:use-empty? 7]
          [:use-empty? 10]
          [:use-not-empty? 13]
          [:use-not-empty? 18]
          [:use-not-empty? 23]
          [:use-not= 26]
          [:use-nil? 29]
          [:use-nil? 32]
          [:use-some? 35]
          [:use-some? 38]
          [:use-any? 38]
          [:use-some? 41]
          [:use-any? 41]
          [:use-some? 44]
          [:use-contains? 44]
          [:redundant-empty-fallback 47]
          [:redundant-empty-fallback 50]
          [:redundant-empty-fallback 53]
          [:redundant-empty-fallback 56]
          [:use-keyword-lookup 59]
          [:use-get-with-default 62]
          [:use-get-with-default 66]
          [:use-get-in-with-default 70]
          [:use-any? 75]
          [:redundant-some? 78]
          [:redundant-some? 83]
          [:use-string? 87]
          [:use-contains? 91]
          [:use-contains? 96]
          [:use-clamp 101]
          [:use-clamp 104]
          [:use-clamp 107]
          [:use-clamp 110]
          [:use-type-predicate 113]
          [:use-type-predicate 116]]
         (diagnostic-summary "assets/rules/simple-expressions/candidates.roo"))))

(deftest ignores-simple-expression-non-candidates
  (is (= []
         (diagnostics "assets/rules/simple-expressions/non-candidates.roo"))))

(deftest reports-structured-suggestions
  (is (= [["Rewrite as head" :rewrite ["(head items)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-head)))
  (is (= [["Rewrite as keyword lookup" :rewrite ["(:name symbol)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-keyword-lookup)))
  (is (= [["Rewrite as type predicate" :rewrite ["(map? patch)"]]]
         (suggestion-summary "assets/rules/simple-expressions/candidates.roo"
                             :use-type-predicate))))

(deftest reports-redundant-map-checks
  (is (= [[:redundant-map-check 4]
          [:redundant-map-check 9]
          [:redundant-map-check 13]
          [:redundant-map-check 18]
          [:redundant-map-check 23]]
         (diagnostic-summary "assets/rules/simple-expressions/redundant-map-check.roo"))))

(deftest reports-select-keys-candidates
  (is (= [[:use-select-keys 4]
          [:use-select-keys 9]]
         (diagnostic-summary "assets/rules/simple-expressions/use-select-keys.roo"))))

(deftest ignores-select-keys-non-candidates
  (is (= []
         (diagnostics "assets/rules/simple-expressions/select-keys-non-candidates.roo"))))

(deftest reports-for-candidates
  (is (= [[:use-for 4]
          [:use-for 9]]
         (diagnostic-summary "assets/rules/simple-expressions/use-for.roo"))))

(deftest reports-argument-destructuring-candidates
  (is (= [[:use-argument-destructuring 5]
          [:use-argument-destructuring 17]
          [:use-argument-destructuring 21]]
         (diagnostic-summary "assets/rules/simple-expressions/use-argument-destructuring.roo"))))

(deftest ignores-argument-destructuring-non-candidates
  (is (= []
         (diagnostics "assets/rules/simple-expressions/argument-destructuring-non-candidates.roo"))))

(deftest reports-redundant-let-candidates
  (is (= [[:redundant-let 4]
          [:redundant-let-binding 8]
          [:redundant-let-binding 15]]
         (diagnostic-summary "assets/rules/simple-expressions/redundant-let.roo"))))

(deftest ignores-redundant-let-non-candidates
  (is (= []
         (diagnostics "assets/rules/simple-expressions/redundant-let-non-candidates.roo"))))
