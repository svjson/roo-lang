(deftest redundant-empty-default/reports-all-nil-tolerant-consumers
  (let [diagnostics
        (produce-summary
          "assets/rules/simple-expressions/redundant-empty-default-consumers.roo")]
    (is (= 109 (count diagnostics)))
    (is (= (repeat 109 :redundant-empty-default)
           (map diagnostics :rule)))))

