;; Suggestions

(deftest flatten-struct-operations/reports-structured-suggestions
  (is (= [{:rule :flatten-struct-operations
           :suggestions [{:title "Rewrite as one assoc call"
                          :edits [{:replacement
                                   "(assoc (static-game) :scheduler {:time 100} :food-pressure 2 :amulet-appeared? true :area-generation 1)"}]}]}
          {:rule :flatten-struct-operations
           :suggestions [{:title "Rewrite as one assoc call"
                          :edits [{:replacement
                                   "(assoc options :width 80 :height 24 :color? true :format :compact)"}]}]}
          {:rule :flatten-struct-operations
           :suggestions [{:title "Rewrite as one assoc-in call"
                          :edits [{:replacement
                                   "(assoc-in profile [:name] \"Ada\" [:preferences :theme] :dark)"}]}]}
          {:rule :flatten-struct-operations
           :suggestions [{:title "Rewrite as one dissoc call"
                          :edits [{:replacement
                                   "(dissoc state :temporary :cache :debug)"}]}]}
          {:rule :flatten-struct-operations
           :suggestions [{:title "Rewrite as one dissoc-in call"
                          :edits [{:replacement
                                   "(dissoc-in profile [:session :token] [:preferences :legacy] [:debug])"}]}]}
          {:rule :flatten-struct-operations
           :suggestions [{:title "Rewrite as one update call"
                          :edits [{:replacement
                                   "(update state :count inc :items [append item])"}]}]}
          {:rule :flatten-struct-operations
           :suggestions [{:title "Rewrite as one update-in call"
                          :edits [{:replacement
                                   "(update-in profile [:stats :count] inc [:items] [append item])"}]}]}]
         (support/produce-suggestion-summary
           "assets/rules/simple-expressions/flatten-struct-operations.roo"
           simple-expressions/check
           simple-expressions/rules
           :flatten-struct-operations))))


(deftest use-slice/reports-structured-suggestions
  (is (= [{:rule :use-slice
           :suggestions [{:title "Rewrite as slice"
                          :edits [{:replacement "(slice args 2)"}]}]}
