{:name proofread
 :version "0.1.0"
 :description "Roo syntax and style checker."
 :dependencies {cli-trooper "0.1.0"
                soot "0.1.0"
                voodoo "0.1.0"}
 :load-roots ["src"]
 :namespace-roots {proofread "src"}
 :dev {:dependencies {proof "0.1.0"}
       :load-roots ["test"]}
 :config {proof {:test-roots ["test/proofread"]}}
 :native-libraries [{:name "proofread-native"
                     :version "0.1.0"
                     :path "native"
                     :namespaces [proofread.native]}]
 :main proofread.cli/main}
