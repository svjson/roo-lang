(ns proofread.cli
  (:require [proofread.command.check :as check-command]
            [proofread.native :as native]))

(def version
  "Proofread command version."
  "0.1.0")

(defun usage!
  "Print the short proofread usage line.

  Returns:
  `nil`."
  []
  (prn check-command/usage-line))

(defun print-help!
  "Print proofread help text.

  Returns:
  `nil`."
  []
  (prn "proofread: check that Roo and EDN files parse")
  (usage!))

(defun print-version!
  "Print the proofread version line.

  Returns:
  `nil`."
  []
  (prn (str "proofread " version)))

(defun main
  "Run the proofread command line entry point.

  Args:
  - `args`: Command line arguments.

  Returns:
  `nil` for help/version commands or the successful check summary."
  [args]
  (let [first-arg (head args)]
    (cond
      (nil? first-arg)
      (do
        (usage!)
        (native/fail! "No files or patterns provided."))

      (contains? ["--help" "-h"] first-arg)
      (print-help!)

      (= first-arg "--version")
      (print-version!)

      true
      (check-command/run! args))))
