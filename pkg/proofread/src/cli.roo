(ns proofread.cli
  (:require [cli-trooper :as cli-trooper]
            [proofread.command.check :as check-command]
            [proofread.command.suggest :as suggest-command]))

(def version
  "Proofread command version."
  "0.1.0")

(def application
  "Proofread's supplied cli-trooper application declaration."
  (assoc check-command/command
         :application "proofread"
         :version version
         :description "check Roo source and EDN files"
         :features {:help {:default? false}}
         :commands {"check" check-command/command
                    "suggest" suggest-command/command}))

(defun main
  "Run the proofread command line entry point.

  Args:
  - `args`: Command line arguments.

  Returns:
  Process exit code `0` after help, version, or successful execution, `1` when
  checks fail, or `2` for invalid command-line input."
  [args]
  (cli-trooper/run! application {:args args}))
