(ns proofread.command.check
  (:require [proofread.native :as native]
            [proofread.source.walk :as walk]
            [proofread.reporter :as reporter]
            [proofread.source :as source]))

(defun validation-errors
  "Return semantic diagnostics for parsed check options.

  Args:
  - `options`: Parsed check options containing `:files` and
    `:stdin-filename`.

  Returns:
  A diagnostic vector when standard input conflicts with positional inputs or
  neither input form was supplied; otherwise an empty vector."
  [options]
  (cond
    (and (some? (:stdin-filename options))
         (not-empty? (:files options)))
    [{:kind :conflicting-inputs
      :message "Cannot combine --stdin-filename with files or patterns."}]

    (and (empty? (:files options))
         (nil? (:stdin-filename options)))
    [{:kind :missing-input
      :message "No files or patterns provided."}]

    true
    []))

(defun parse-error-diagnostic
  "Build a diagnostic for a parse or read error.

  Args:
  - `error`: Error detail map returned by `proofread.native/check-files-result!`.

  Returns:
  A diagnostic map with `:error` severity."
  [error]
  {:rule :parse
   :severity :error
   :file (:path error)
   :source {:path (:path error)}
   :message (:message error)})

(defun check-diagnostics
  "Return diagnostics for an input from a native check result.

  Args:
  - `file`: Source file identity.
  - `check-result`: Native check result map.
  - `options`: Optional source input options passed to `proofread.source/diagnostics`.

  Returns:
  A vector of rule diagnostics, including parse diagnostics when checking fails."
  [file check-result & options]
  (case (:errors check-result)
    0 (source/diagnostics file options)
    :default (map (:error-details check-result) parse-error-diagnostic)))

(defun diagnostic-count
  "Count diagnostics with a given severity.

  Args:
  - `diagnostics`: Diagnostic maps.
  - `severity`: Severity keyword to count.

  Returns:
  The number of matching diagnostics."
  [diagnostics severity]
  (count (filter diagnostics
                 (fn [diagnostic]
                   (= severity (:severity diagnostic))))))

(defun execute!
  "Run proofread checks with parsed command options.

  Args:
  - `_context`: The cli-trooper invocation context.
  - `options`: Parsed check options.

  Returns:
  A summary map when no errors were found."
  [_context options]
  (let [stdin-filename (:stdin-filename options)
        source-text (when stdin-filename (native/read-stdin!))
        source-options (when stdin-filename {:source source-text})
        collection (unless stdin-filename (walk/collect (:files options)))
        files-to-check (if stdin-filename
                         [stdin-filename]
                         (:files collection))
        collection-errors (:errors collection)]
    (when (not-empty? collection-errors)
      (map collection-errors prn)
      (native/fail! "proofread: checks failed"))
    (let [run-result (reduce files-to-check
                             {:summary {:files 0
                                        :warnings 0
                                        :errors 0}
                              :reporter (reporter/make options files-to-check)}
                             (fn [{:keys [summary reporter]} file]
                               (let [check-result (if stdin-filename
                                                    (native/check-source-result! file source-text)
                                                    (native/check-files-result! [file]))
                                     file-errors (:errors check-result)
                                     diagnostics (check-diagnostics file
                                                                    check-result
                                                                    source-options)
                                     file-result {:file file
                                                  :checked (:checked check-result)
                                                  :errors file-errors
                                                  :diagnostics diagnostics}]
                                 {:summary {:files (+ (:files summary)
                                                     (:checked check-result)
                                                     file-errors)
                                            :warnings (+ (:warnings summary)
                                                         (diagnostic-count diagnostics
                                                                           :warning))
                                            :errors (+ (:errors summary)
                                                      (case file-errors
                                                        0 (diagnostic-count diagnostics
                                                                            :error)
                                                        :default file-errors))}
                                  :reporter (reporter/report-file! reporter
                                                                  file-result)})))
          summary (:summary run-result)]
      (reporter/report-summary! (:reporter run-result) summary)
      (case (:errors summary)
        0 summary
        :default (native/fail! "proofread: checks failed")))))

(def command
  "cli-trooper declaration for Proofread's `check` command."
  {:description "Check Roo source and EDN files."
   :execute! execute!
   :flags {"reporter" {:type :enum
                        :values ["simple"]
                        :default :simple}
           "group-by" {:type :enum
                        :values ["rule" "namespace" "file" "package"]
                        :delimiter ","
                        :repeatable? true
                        :destination :groups}
           "show-ranges" {:type :flag
                           :destination :show-ranges?}
           "stdin-filename" {:type :path}}
   :positional [{:type :path
                 :name "file-or-pattern"
                 :destination :files
                 :repeatable? true
                 :optional? true}]
   :validate validation-errors})
