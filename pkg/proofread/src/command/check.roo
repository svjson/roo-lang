(ns proofread.command.check
  (:require [proofread.native :as native]
            [proofread.reporter :as reporter]
            [proofread.source :as source]
            [roo.string :as string]))

(def usage-line
  "Usage line for the proofread check command."
  "Usage: proofread [--help|--version] [--reporter simple] [--group-by rule,namespace,file,package] <file|pattern>...")

(defun split-groups
  "Split a comma-separated group option.

  Args:
  - `text`: Group option text.

  Returns:
  A vector of trimmed group names."
  [text]
  (if-let [separator (find-index text
                                 (fn [ch]
                                   (= "," (str ch))))]
    (concat [(trim (substr text 0 separator))]
            (split-groups (substr text (+ separator 1) (count text))))
    [(trim text)]))

(defun group-criterion
  "Return a group criterion keyword for CLI text.

  Args:
  - `text`: CLI criterion name.

  Returns:
  A group criterion keyword, or `nil` when unknown."
  [text]
  (case text
    "rule" :rule
    "namespace" :namespace
    "file" :file
    "package" :package
    :default nil))

(defun parse-group-step
  "Parse one group criterion into an accumulated result.

  Args:
  - `result`: Accumulated parse result.
  - `text`: CLI criterion name.

  Returns:
  Updated parse result containing `:groups` and `:errors`."
  [result text]
  (if (blank? text)
    result
    (if-let [criterion (group-criterion text)]
      (update result :groups [append! criterion])
      (update result
              :errors
              [append! (str "Unknown group criterion: " text)]))))

(defun parse-groups
  "Parse a CLI group option.

  Args:
  - `text`: Group option text, possibly comma-separated.

  Returns:
  A map containing parsed `:groups` and `:errors`."
  [text]
  (reduce (split-groups text)
          {:groups []
           :errors []}
          parse-group-step))

(defun parse-args-step
  "Parse proofread check arguments.

  Args:
  - `args`: Remaining command line arguments.
  - `options`: Accumulated options map.

  Returns:
  An options map containing `:files`, `:reporter`, `:groups`, and `:errors`."
  [args options]
  (let [arg (head args)]
    (cond

      (nil? arg)
      options

      (= arg "--reporter")
      (let [reporter-name (nth args 1)]
        (cond
          (nil? reporter-name)
          (update options
                  :errors
                  [concat ["Missing reporter after --reporter"]])

          (reporter/known? (keyword reporter-name))
          (parse-args-step (tail (tail args))
                           (assoc options :reporter (keyword reporter-name)))

          true
          (parse-args-step (tail (tail args))
                           (update options
                                   :errors
                                   [concat [(str "Unknown reporter: "
                                                 reporter-name)]]))))

      (= arg "--group-by")
      (if-let [group-text (nth args 1)]
        (let [result (parse-groups group-text)]
          (parse-args-step (tail (tail args))
                           (assoc options
                                  :groups (concat (:groups options)
                                                  (:groups result))
                                  :errors (concat (:errors options)
                                                  (:errors result)))))
        (update options
                :errors
                [concat ["Missing group criteria after --group-by"]]))

      (string/starts-with? arg "--")
      (parse-args-step (tail args)
                       (update options
                               :errors
                               [concat [(str "Unknown option: " arg)]]))

      true
      (parse-args-step (tail args)
                       (update options :files [concat [arg]])))))

(defun parse-args
  "Parse arguments for the proofread check command.

  Args:
  - `args`: Command line file paths, shell-style patterns, and check options.

  Returns:
  An options map containing `:files`, `:reporter`, `:groups`, and `:errors`."
  [args]
  (let [options (parse-args-step args
                                 {:files []
                                  :reporter :simple
                                  :groups []
                                  :errors []})]
    (cond-> options
            (empty? (:files options))
            (update :errors [concat ["No files or patterns provided."]]))))

(defun parse-error-diagnostic
  "Build a diagnostic for a parse or read error.

  Args:
  - `error`: Error detail map returned by `proofread.native/check-files-result!`.

  Returns:
  A diagnostic map with `:error` severity."
  [error]
  {:rule :parse
   :severity :error
   :file (:path error)
   :source {:path (:path error)}
   :message (:message error)})

(defun diagnostic-count
  "Count diagnostics with a given severity.

  Args:
  - `diagnostics`: Diagnostic maps.
  - `severity`: Severity keyword to count.

  Returns:
  The number of matching diagnostics."
  [diagnostics severity]
  (count (filter diagnostics
                 (fn [diagnostic]
                   (= severity (:severity diagnostic))))))

(defun run!
  "Run proofread checks for CLI file and pattern arguments.

  Args:
  - `args`: Command line file paths, shell-style patterns, and check options.

  Returns:
  A summary map when no errors were found."
  [args]
  (let [options (parse-args args)]
    (if (not-empty? (:errors options))
      (do
        (map (:errors options) prn)
        (prn usage-line)
        (native/fail! "proofread: invalid arguments"))
      (let [files-to-check (native/files! (:files options))
            run-result (reduce files-to-check
                               {:summary {:files 0
                                          :warnings 0
                                          :errors 0}
                                :reporter (reporter/make options files-to-check)}
                               (fn [{:keys [summary reporter]} file]
                                 (let [check-result (native/check-files-result! [file])
                                       file-errors (:errors check-result)
                                       diagnostics (case file-errors
                                                     0 (source/diagnostics file)
                                                     :default (map (:error-details check-result)
                                                                   parse-error-diagnostic))
                                       file-result {:file file
                                                    :checked (:checked check-result)
                                                    :errors file-errors
                                                    :diagnostics diagnostics}]
                                   {:summary {:files (+ (:files summary)
                                                        (:checked check-result)
                                                        file-errors)
                                              :warnings (+ (:warnings summary)
                                                           (diagnostic-count diagnostics
                                                                             :warning))
                                              :errors (+ (:errors summary)
                                                         (case file-errors
                                                           0 (diagnostic-count diagnostics
                                                                               :error)
                                                           :default file-errors))}
                                    :reporter (reporter/report-file! reporter
                                                                    file-result)})))
            summary (:summary run-result)]
        (reporter/report-summary! (:reporter run-result) summary)
        (case (:errors summary)
          0 summary
          :default (native/fail! "proofread: checks failed"))))))
