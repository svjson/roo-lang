(ns proofread.command.check
  (:require [proofread.native :as native]
            [proofread.style :as style]))

(def usage-line
  "Usage line for the proofread check command."
  "Usage: proofread [--help|--version] <file|pattern>...")

(defun summary-text
  "Format a proofread run summary.

  Args:
  - `summary`: A map containing `:files`, `:warnings`, and `:errors` counts.

  Returns:
  A single summary line."
  [{:keys [files warnings errors]}]
  (str "proofread: " files " file"
       (case files
         1 ""
         :default "s")
       ", " warnings " warning"
       (case warnings
         1 ""
         :default "s")
       ", " errors " error"
       (case errors
         1 ""
         :default "s")))

(defun print-summary!
  "Print a proofread run summary.

  Args:
  - `summary`: A map containing `:files`, `:warnings`, and `:errors` counts.

  Returns:
  `summary`."
  [summary]
  (let [text (summary-text summary)
        separator (apply join (concat [""]
                                      (repeat (count text) "-")))]
    (prn separator)
    (prn text)
    (prn separator)
    summary))

(defun run!
  "Run proofread checks for CLI file and pattern arguments.

  Args:
  - `args`: Command line file paths and shell-style patterns.

  Returns:
  A summary map when no errors were found."
  [args]
  (let [summary (reduce (native/files! args)
                        {:files 0
                         :warnings 0
                         :errors 0}
                        (fn [{:keys [files warnings errors]} file]
                          (let [check-result (native/check-files-result! [file])
                                file-errors (:errors check-result)
                                diagnostics (case file-errors
                                              0 (style/check-file file)
                                              :default [])]
                            (style/print-diagnostics! diagnostics)
                            {:files (+ files (:checked check-result) file-errors)
                             :warnings (+ warnings (count diagnostics))
                             :errors (+ errors file-errors)})))]
    (print-summary! summary)
    (case (:errors summary)
      0 summary
      :default (native/fail! "proofread: checks failed"))))
