(ns proofread.command.suggest
  (:require [proofread.native :as native]
            [proofread.source :as source]))

(defun parse-positive-int
  "Convert CLI text to a positive integer.

  Args:
  - `text`: Raw option value.

  Returns:
  A cli-trooper conversion result containing the integer under `:value`, or an
  invalid-positive-integer diagnostic under `:error`."
  [text]
  (if (and (not (blank? text))
           (any? text digit?))
    (let [value (int text)]
      (if (< 0 value)
        {:value value}
        {:error {:kind :invalid-positive-integer
                 :value text
                 :expected "positive integer"}}))
    {:error {:kind :invalid-positive-integer
             :value text
             :expected "positive integer"}}))

(defun before-or-at?
  [left right]
  (or (< (:line left) (:line right))
      (and (= (:line left) (:line right))
           (not (< (:column right) (:column left))))))

(defun source-range
  [source]
  (when-let [start (:start source)
             end (:end source)]
    {:start start
     :end end}))

(defun position-in-source?
  [source line column]
  (when-let [range (source-range source)]
    (let [position {:line line :column column}]
      (and (before-or-at? (:start range) position)
           (before-or-at? position (:end range))))))

(defun range-size
  [source]
  (let [range (source-range source)]
    (+ (* 100000 (- (:line (:end range))
                    (:line (:start range))))
       (- (:column (:end range))
          (:column (:start range))))))

(defun parse-error-diagnostic
  "Build a diagnostic for a parse or read error.

  Args:
  - `error`: Error detail map returned by `proofread.native/check-files-result!`.

  Returns:
  A diagnostic map with `:error` severity."
  [error]
  {:rule :parse
   :severity :error
   :file (:path error)
   :source {:path (:path error)}
   :message (:message error)})

(defun suggestable-at?
  [diagnostic line column]
  (and (head (:suggestions diagnostic))
       (position-in-source? (:source diagnostic) line column)))

(defun suggestions-at
  "Return suggestable diagnostics containing a source position.

  Args:
  - `diagnostics`: Proofread diagnostics.
  - `line`: One-based line number.
  - `column`: One-based column number.

  Returns:
  Matching diagnostics, ordered from innermost to outermost source range."
  [diagnostics line column]
  (sort (filter diagnostics
                (fn [diagnostic]
                  (suggestable-at? diagnostic line column)))
        (fn [left right]
          (< (range-size (:source left))
             (range-size (:source right))))))

(defun checked-diagnostics
  [file]
  (let [check-result (native/check-files-result! [file])]
    (case (:errors check-result)
      0 (source/diagnostics file)
      :default (map (:error-details check-result) parse-error-diagnostic))))

(defun execute!
  "Print suggestions at a file position from parsed command options.

  Args:
  - `_context`: The cli-trooper invocation context.
  - `options`: Parsed options containing `:file`, `:line`, and `:column`.

  Returns:
  Matching diagnostics with structured suggestions."
  [_context options]
  (let [diagnostics (suggestions-at (checked-diagnostics (:file options))
                                    (:line options)
                                    (:column options))]
    (prn! diagnostics)
    diagnostics))

(def command
  "cli-trooper declaration for Proofread's `suggest` command."
  {:description "Show structured suggestions at a source position."
   :execute! execute!
   :flags {"line" {:type :positive-integer
                   :parse parse-positive-int
                   :required? true}
           "column" {:type :positive-integer
                     :parse parse-positive-int
                     :required? true}}
   :positional [{:type :file
                 :name "file"}]})
