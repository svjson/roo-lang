(ns proofread.rules.simple-expressions
  (:require [proofread.forms :as forms]))

(defun zero-node?
  "Test whether an AST node is the number `0`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for the numeric literal `0`, otherwise `false`."
  [node]
  (and (= (:type node) :number)
       (= (:form node) 0)))

(defun nil-node?
  "Test whether an AST node is the symbol `nil`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for the `nil` symbol, otherwise `false`."
  [node]
  (= "nil" (forms/symbol-name node)))

(defun count-form?
  "Test whether an AST node is a `(count value)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for two-child `count` calls, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "count" (forms/head-name node))
       (= 2 (count children))))

(defun empty-count-comparison?
  "Test whether an AST node compares a count to zero.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(= 0 (count value))` and `(= (count value) 0)`, otherwise
  `false`."
  [{:keys [children] :as node}]
  (and (= "=" (forms/head-name node))
       (= 3 (count children))
       (or (and (zero-node? (nth children 1))
                (count-form? (nth children 2)))
           (and (count-form? (nth children 1))
                (zero-node? (nth children 2))))))

(defun not-empty-count-comparison?
  "Test whether an AST node compares a count as greater than zero.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(< 0 (count value))` and `(> (count value) 0)`, otherwise
  `false`."
  [{:keys [children] :as node}]
  (and (= 3 (count children))
       (or (and (= "<" (forms/head-name node))
                (zero-node? (nth children 1))
                (count-form? (nth children 2)))
           (and (= ">" (forms/head-name node))
                (count-form? (nth children 1))
                (zero-node? (nth children 2))))))

(defun not-empty-negation?
  "Test whether an AST node negates an `empty?` call.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(not (empty? value))`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "not" (forms/head-name node))
       (= 2 (count children))
       (= "empty?" (forms/head-name (nth children 1)))))

(defun not-equals-negation?
  "Test whether an AST node negates an equality call.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(not (= left right))`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "not" (forms/head-name node))
       (= 2 (count children))
       (= "=" (forms/head-name (nth children 1)))))

(defun nil-comparison?
  "Test whether an AST node compares a value to `nil`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(= nil value)` and `(= value nil)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "=" (forms/head-name node))
       (= 3 (count children))
       (or (nil-node? (nth children 1))
           (nil-node? (nth children 2)))))

(defun map-check?
  "Test whether an AST node is a `(map? value)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The checked symbol name for `(map? name)`, otherwise `nil`."
  [{:keys [children] :as node}]
  (when (and (= "map?" (forms/head-name node))
             (= 2 (count children)))
    (forms/symbol-name (nth children 1))))

(defun keyword-lookup?
  "Test whether an AST node is a keyword lookup form.

  Args:
  - `node`: A `roo.ast` node map.
  - `target-name`: Symbol name expected as the lookup target.

  Returns:
  `true` for `(:key target-name)`, otherwise `false`."
  [node target-name]
  (and (= (:type node) :list)
       (= 2 (count (:children node)))
       (forms/keyword-name (head (:children node)))
       (= target-name (forms/symbol-name (nth (:children node) 1)))))

(defun lookup-comparison?
  "Test whether an AST node compares a keyword lookup against another value.

  Args:
  - `node`: A `roo.ast` node map.
  - `target-name`: Symbol name expected as the lookup target.

  Returns:
  `true` for equality comparisons involving `(:key target-name)`, otherwise
  `false`."
  [{:keys [children] :as node} target-name]
  (and (= "=" (forms/head-name node))
       (= 3 (count children))
       (or (keyword-lookup? (nth children 1) target-name)
           (keyword-lookup? (nth children 2) target-name))))

(defun redundant-map-check?
  "Test whether an `and` form contains a redundant `map?` guard.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(and (map? value) (= (:key value) other) ...)`, otherwise
  `false`."
  [{:keys [children] :as node}]
  (when (and (= "and" (forms/head-name node))
             (< 1 (count children)))
    (when-let [target-name (map-check? (nth children 1))]
      (not (nil?
             (find-first (tail (tail children))
                         (fn [child]
                           (lookup-comparison? child target-name))))))))

(defun diagnostic
  "Build a simple-expression diagnostic for an AST node.

  Args:
  - `node`: A `roo.ast` node map.
  - `rule`: Diagnostic rule keyword.
  - `message`: Diagnostic message.

  Returns:
  A diagnostic map."
  [node rule message]
  {:rule rule
   :severity :warning
   :source (:source node)
   :message message})

(defun simple-expression-diagnostic
  "Return the simple-expression diagnostic for an AST node.

  Args:
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when the node does not match a rule."
  [{:keys [children] :as node}]
  (cond
    (and (= "nth" (forms/head-name node))
         (= 3 (count children))
         (zero-node? (nth children 2)))
    (diagnostic node :use-head "Use head")

    (empty-count-comparison? node)
    (diagnostic node :use-empty? "Use empty?")

    (or (not-empty-count-comparison? node)
        (not-empty-negation? node))
    (diagnostic node :use-not-empty? "Use not-empty?")

    (not-equals-negation? node)
    (diagnostic node :use-not= "Use not=")

    (nil-comparison? node)
    (diagnostic node :use-nil? "Use nil?")

    (redundant-map-check? node)
    (diagnostic node :redundant-map-check "Remove redundant map? check")

    true
    nil))

(defun check-node
  "Find simple-expression diagnostics beneath one AST node.

  Args:
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [node]
  (if (map? node)
    (concat
      (if-let [node-diagnostic (simple-expression-diagnostic node)]
        [node-diagnostic]
        [])
      (flat-map (:children node) check-node))
    []))

(defun check
  "Find simple-expression diagnostics beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (check-node root))
