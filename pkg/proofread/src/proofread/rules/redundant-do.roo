(ns proofread.rules.redundant-do
  (:require [proofread.forms :as forms]))

(defun redundant-do?
  "Test whether an AST node is a redundant single-expression `do` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(do expr)` nodes, otherwise `false`."
  [node]
  (and (= "do" (forms/head-name node))
       (= 2 (count (:children node)))))

(defun check
  "Find redundant `do` forms beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (keep (forms/nodes root)
        (fn [node]
          (when (redundant-do? node)
            {:rule :redundant-do
             :severity :warning
             :source (:source node)
             :message "Redundant do form with a single expression"}))))
