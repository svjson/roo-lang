(ns proofread.rules.direct-conditions
  (:require [proofread.forms :as forms]))

(defun symbol-name
  "Return the symbol name for an AST node.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The symbol name string, or `nil` when `node` is not a symbol."
  [node]
  (when (and (map? node)
             (= (:type node) :symbol))
    (str (:form node))))

(defun nil-node?
  "Test whether an AST node is the symbol `nil`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for the `nil` symbol, otherwise `false`."
  [node]
  (= "nil" (symbol-name node)))

(defun diagnostic
  "Build a direct-condition diagnostic for an AST node.

  Args:
  - `node`: A `roo.ast` node map.
  - `rule`: Diagnostic rule keyword.
  - `message`: Diagnostic message.

  Returns:
  A diagnostic map."
  [node rule message]
  {:rule rule
   :severity :warning
   :source (:source node)
   :message message})

(defun single-binding-symbol
  "Return the binding symbol for a single-binding `let` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The bound symbol name when `node` is `(let [name expr] body)`, otherwise
  `nil`."
  [{:keys [children] :as node}]
  (when (= "let" (forms/head-name node))
    (when-let [bindings (:children (nth children 1))]
      (when (= 2 (count bindings))
        (symbol-name (head bindings))))))

(defun sole-let-body-form
  "Return the sole body form for a single-body `let`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The sole body child when `node` is a `let` with exactly one body form,
  otherwise `nil`."
  [{:keys [children] :as node}]
  (when (= "let" (forms/head-name node))
    (when (= 3 (count children))
      (nth children 2))))

(defun let-if-candidate?
  "Test whether a `let` form should be `if-let`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(let [name expr] (if name ...))`, otherwise `false`."
  [node]
  (when-let [binding-name (single-binding-symbol node)
             body (sole-let-body-form node)]
    (and (= "if" (forms/head-name body))
         (= binding-name (symbol-name (nth (:children body) 1))))))

(defun let-when-candidate?
  "Test whether a `let` form should be `when-let`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(let [name expr] (when name ...))`, otherwise `false`."
  [node]
  (when-let [binding-name (single-binding-symbol node)
             body (sole-let-body-form node)]
    (and (= "when" (forms/head-name body))
         (= binding-name (symbol-name (nth (:children body) 1))))))

(defun let-condition-child?
  "Test whether `node` is the condition form inside a direct-condition `let`.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil`.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` when the parent will produce an `if-let` or `when-let` diagnostic."
  [parent node]
  (and (= node (sole-let-body-form parent))
       (or (let-if-candidate? parent)
           (let-when-candidate? parent))))

(defun direct-condition-diagnostic
  "Return the direct-condition diagnostic for an AST node.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when the node does not match a rule."
  [parent {:keys [children] :as node}]
  (cond
    (let-if-candidate? node)
    (diagnostic node :use-if-let "Use if-let")

    (let-when-candidate? node)
    (diagnostic node :use-when-let "Use when-let")

    (and (= "if" (forms/head-name node))
         (not (let-condition-child? parent node))
         (or (= 3 (count children))
             (nil-node? (nth children 3))))
    (diagnostic node :use-when "Use when")

    (and (= "if" (forms/head-name node))
         (not (let-condition-child? parent node))
         (= 4 (count children))
         (nil-node? (nth children 2)))
    (diagnostic node :use-unless "Use unless")

    true
    nil))

(defun check-node
  "Find direct-condition diagnostics beneath one AST node.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [parent node]
  (if (map? node)
    (concat
      (when-let [node-diagnostic (direct-condition-diagnostic parent node)]
        [node-diagnostic])
      (flatten
        (map (:children node)
             (fn [child]
               (check-node node child)))))
    []))

(defun check
  "Find direct-condition diagnostics beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (check-node nil root))
