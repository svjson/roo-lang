(ns proofread.forms)

(defun head-name
  "Return the list head name for an AST node.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The string form of the first child when `node` is a non-empty list; otherwise
  `nil`."
  [node]
  (when (and (map? node)
             (= (:type node) :list))
    (let [first-child (head (:children node))]
      (when (= (:type first-child) :symbol)
        (str (:form first-child))))))
