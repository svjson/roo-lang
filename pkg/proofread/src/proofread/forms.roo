(ns proofread.forms)

(defun head-name
  "Return the list head name for an AST node.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The string form of the first child when `node` is a non-empty list; otherwise
  `nil`."
  [{:keys [type children]}]
  (when (= type :list)
    (when-let [form (:form (head children))]
      (str form))))

(defun nodes
  "Return `node` and every nested child node.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  A flat vector of AST node maps in parent-before-children order."
  [node]
  (concat [node]
          (flatten
            (map (:children node) nodes))))
