(ns proofread.core
  (:require [proofread.native :as native]
            [roo.string :as string]))

(def version "0.1.0")

(defun usage []
  (prn "Usage: proofread [--help|--version] <file|pattern>..."))

(defun print-help []
  (prn "proofread: check that Roo and EDN files parse")
  (usage))

(defun print-version []
  (prn (str "proofread " version)))

(defun report-ok [checked-count]
  (prn (str "proofread: " checked-count " file"
            (if (= checked-count 1) "" "s")
            " ok"))
  checked-count)

(defun help-option? [arg]
  (contains? ["--help" "-h"] arg))

(defun main [args]
  (let [first-arg (nth args 0)]
    (cond
      (nil? first-arg)
      (do
        (usage)
        (native/fail! "No files or patterns provided."))

      (help-option? first-arg)
      (print-help)

      (= first-arg "--version")
      (print-version)

      (string/starts-with? first-arg "--")
      (do
        (usage)
        (native/fail! (str "Unknown option: " first-arg)))

      true
      (report-ok (native/check! args)))))
