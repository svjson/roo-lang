(ns proofread.core
  (:require [proofread.native :as native]
            [proofread.style :as style]
            [roo.string :as string]))

(def version
  "Proofread command version."
  "0.1.0")

(defun usage
  "Print the short proofread usage line.

  Returns:
  `nil`."
  []
  (prn "Usage: proofread [--help|--version] <file|pattern>..."))

(defun print-help
  "Print proofread help text.

  Returns:
  `nil`."
  []
  (prn "proofread: check that Roo and EDN files parse")
  (usage))

(defun print-version
  "Print the proofread version line.

  Returns:
  `nil`."
  []
  (prn (str "proofread " version)))

(defun summary-text
  "Format a proofread run summary.

  Args:
  - `summary`: A map containing `:files`, `:warnings`, and `:errors` counts.

  Returns:
  A single summary line."
  [{:keys [files warnings errors]}]
  (str "proofread: " files " file"
       (case files
         1 ""
         :default "s")
       ", " warnings " warning"
       (case warnings
         1 ""
         :default "s")
       ", " errors " error"
       (case errors
         1 ""
         :default "s")))

(defun print-summary!
  "Print a proofread run summary.

  Args:
  - `summary`: A map containing `:files`, `:warnings`, and `:errors` counts.

  Returns:
  `summary`."
  [summary]
  (let [text (summary-text summary)
        separator (apply join (concat [""]
                                      (repeat (count text) "-")))]
    (prn separator)
    (prn text)
    (prn separator)
    summary))

(defun check!
  "Run proofread checks for CLI file and pattern arguments.

  Args:
  - `args`: Command line file paths and shell-style patterns.

  Returns:
  A summary map when no errors were found."
  [args]
  (let [summary (reduce (native/files! args)
                        {:files 0
                         :warnings 0
                         :errors 0}
                        (fn [{:keys [files warnings errors]} file]
                          (let [check-result (native/check-files-result! [file])
                                file-errors (:errors check-result)
                                diagnostics (case file-errors
                                              0 (style/check-file file)
                                              :default [])]
                            (style/print-diagnostics! diagnostics)
                            {:files (+ files (:checked check-result) file-errors)
                             :warnings (+ warnings (count diagnostics))
                             :errors (+ errors file-errors)})))]
    (print-summary! summary)
    (case (:errors summary)
      0 summary
      :default (native/fail! "proofread: checks failed"))))

(defun main
  "Run the proofread command line entry point.

  Args:
  - `args`: Command line arguments.

  Returns:
  `nil` for help/version commands or the successful parse-check count."
  [args]
  (let [first-arg (head args)]
    (cond
      (nil? first-arg)
      (do
        (usage)
        (native/fail! "No files or patterns provided."))

      (contains? ["--help" "-h"] first-arg)
      (print-help)

      (= first-arg "--version")
      (print-version)

      (string/starts-with? first-arg "--")
      (do
        (usage)
        (native/fail! (str "Unknown option: " first-arg)))

      true
      (check! args))))
