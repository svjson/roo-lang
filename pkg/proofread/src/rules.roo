(ns proofread.rules
  (:require [proofread.config :as config]
            [proofread.rules.direct-conditions :as direct-conditions]
            [proofread.rules.higher-order :as higher-order]
            [proofread.rules.names :as names]
            [proofread.rules.registry :as registry]
            [proofread.rules.redundant-do :as redundant-do]
            [proofread.rules.redundant-functions :as redundant-functions]
            [proofread.rules.simple-expressions :as simple-expressions]))

(def rules
  "Registered proofread rule descriptors."
  (concat direct-conditions/rules
          higher-order/rules
          simple-expressions/rules
          names/rules
          redundant-functions/rules
          redundant-do/rules))

(defun enabled-rules
  "Return rule descriptors enabled by config.

  Args:
  - `active-config`: Effective proofread config.
  - `rule-descriptors`: Rule descriptor maps.

  Returns:
  Rule descriptors not disabled by config."
  [active-config rule-descriptors]
  (filter rule-descriptors
          (fn [rule]
            (config/rule-enabled? active-config (:id rule)))))

(defun check-with-config
  "Run enabled proofread rules for parsed source roots.

  Args:
  - `roots`: Top-level `roo.ast` nodes.
  - `active-config`: Effective proofread config.

  Returns:
  A vector of diagnostic maps from all enabled rules."
  [roots active-config]
  (let [direct-condition-rules (enabled-rules active-config direct-conditions/rules)
        higher-order-rules (enabled-rules active-config higher-order/rules)
        simple-expression-rules (enabled-rules active-config simple-expressions/rules)
        name-rules (enabled-rules active-config names/rules)
        redundant-function-rules (enabled-rules active-config redundant-functions/rules)
        redundant-do-rules (enabled-rules active-config redundant-do/rules)]
    (flat-map roots
              (fn [root]
                (concat
                  (direct-conditions/check-with-rules direct-condition-rules root)
                  (higher-order/check-with-rules higher-order-rules root)
                  (simple-expressions/check-with-rules simple-expression-rules root)
                  (names/check-with-rules name-rules root)
                  (redundant-functions/check-with-rules redundant-function-rules root)
                  (redundant-do/check-with-rules redundant-do-rules root))))))

(defun check
  "Run all proofread rules for parsed source roots.

  Args:
  - `roots`: Top-level `roo.ast` nodes.

  Returns:
  A vector of diagnostic maps from all rules."
  [roots]
  (check-with-config roots {}))
