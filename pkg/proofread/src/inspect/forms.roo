(ns proofread.inspect.forms)

(defun symbol-name
  "Return the symbol name for an AST node.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The symbol name string, or `nil` when `node` is not a symbol."
  [node]
  (when (= (:type node) :symbol)
    (str (:form node))))

(defun keyword-name
  "Return the keyword name for an AST node.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The keyword name string, or `nil` when `node` is not a keyword."
  [node]
  (when (= (:type node) :keyword)
    (name (:form node))))

(defun head-name
  "Return the list head name for an AST node.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The string form of the symbol head when `node` is a named list; otherwise
  `nil`."
  [node]
  (when (= (:type node) :list)
    (symbol-name (head (:children node)))))

(defun call?
  "Test whether an AST node is a list call with a specific head and arity.

  Args:
  - `node`: A `roo.ast` node map.
  - `head`: Expected call head name.
  - `arity`: Expected child count including the head symbol.

  Returns:
  `true` when `node` is a list headed by `head` with `arity` children,
  otherwise `false`."
  [{:keys [children] :as node} head arity]
  (and (= head (head-name node))
       (= arity (count children))))

(defun map-form?
  "Test whether an AST node is a single-sequence `map` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(map values f)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "map" (head-name node))
       (= 3 (count children))))

(defun count-call?
  "Test whether an AST node is a two-argument `(count ...)` call.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` when `node` is `(count value)`, otherwise `false`."
  [node]
  (call? node "count" 2))

(defun count-argument
  "Return the argument expression of a `(count value)` call.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The single argument node for `(count value)`, or `nil` when not a count call."
  [{:keys [children] :as node}]
  (when (count-call? node)
    (nth children 1)))

(defun single-binding-symbol
  "Return the binding symbol for a single-binding `let` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The bound symbol name for `(let [name value] ...)`, otherwise `nil`."
  [{:keys [children] :as node}]
  (when (= "let" (head-name node))
    (when-let [bindings (:children (nth children 1))]
      (when (= 2 (count bindings))
        (symbol-name (head bindings))))))

(defun sole-let-body-form
  "Return the sole body form for a single-body `let`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The sole body form for `(let [...] body)`, otherwise `nil`."
  [{:keys [children] :as node}]
  (when (= "let" (head-name node))
    (when (= 3 (count children))
      (nth children 2))))

(defun same-form?
  "Test whether two AST nodes represent the same source form.

  Args:
  - `left`: A `roo.ast` node map.
  - `right`: A `roo.ast` node map.

  Returns:
  `true` when both nodes have the same parsed form value, otherwise `false`."
  [left right]
  (= (:form left) (:form right)))

(defun form-string
  "Return the source-like string for an AST node form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The string representation of `node`'s parsed form."
  [node]
  (str (:form node)))

(defun form-sequence-string
  "Render form nodes as a single space-separated string.

  Args:
  - `nodes`: A sequence of AST nodes."
  [nodes]
  (when (not-empty? nodes)
    (reduce nodes
            (form-string (head nodes))
            (fn [rendered node]
              (str rendered " " (form-string node))))))

(defun empty-vector?
  "Test whether an AST node is an empty vector literal.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `[]`, otherwise `false`."
  [node]
  (and (= :vector (:type node))
       (empty? (:children node))))

(defun empty-map?
  "Test whether an AST node is an empty map literal.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `{}`, otherwise `false`."
  [node]
  (and (= :map (:type node))
       (empty? (:children node))))

(defun empty-fallback?
  "Test whether an AST node is an empty fallback value.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `nil`, `{}`, or `[]`, otherwise `false`."
  [node]
  (or (nil-node? node)
      (empty-map? node)
      (empty-vector? node)))

(defun thread-first-form?
  "Test whether an AST node is a `->` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(-> value form...)`, otherwise `false`."
  [node]
  (= "->" (head-name node)))

(defun thread-first-call?
  "Test whether an AST node is a callable thread-first step.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for named calls that can receive a threaded first argument."
  [node]
  (and (head-name node)
       (not (contains? ["if" "when" "unless" "cond" "case" "let" "fn" "do"
                        "quote" "->" "cond->"]
                       (head-name node)))))

(defun thread-first-transform?
  "Test whether a form threads `value` as its first argument.

  Args:
  - `node`: A `roo.ast` node map.
  - `value`: Expected threaded value node.

  Returns:
  `true` for `(call value ...)` and `(-> value form...)`, otherwise `false`."
  [{:keys [children] :as node} value]
  (if (thread-first-form? node)
    (and (< 2 (count children))
         (same-form? (nth children 1) value))
    (and (thread-first-call? node)
         (< 1 (count children))
         (same-form? (nth children 1) value))))

(defun full-if?
  "Test whether an AST node is an `if` form with an explicit else branch.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(if condition then else)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "if" (head-name node))
       (= 4 (count children))))

(defun if-else
  "Return the else branch of a full `if` form.

  Args:
  - `node`: A full `if` AST node map.

  Returns:
  The else branch AST node."
  [node]
  (nth (:children node) 3))

(defun else-child?
  "Test whether `node` is the else branch of `parent`.

  Args:
  - `parent`: A `roo.ast` node map.
  - `node`: Possible child node map.

  Returns:
  `true` when `node` is the else branch of `parent`, otherwise `false`."
  [parent node]
  (and (full-if? parent)
       (= node (if-else parent))))

(defun literal-number?
  "Test whether a node is a numeric literal.

  Args:
  - `node`: A `roo.ast` node map.
  - `value`: Optional expected numeric value.

  Returns:
  `true` for numeric nodes, or for numeric nodes with the given value when
  `value` is provided."
  [node value]
  (and (= (:type node) :number)
       (or (nil? value) (= (:form node) value))))

(defun literal-string?
  "Test whether a node is a string literal.

  Args:
  - `node`: A `roo.ast` node map.
  - `value`: Optional expected string value.

  Returns:
  `true` for string nodes, or for string nodes with the given value when
  `value` is provided."
  [node value]
  (and (= (:type node) :string)
       (or (nil? value) (= (:form node) value))))

(defun literal-string-with-len?
  "Test whether a node is a string literal with the given length.

  Args:
  - `node`: A `roo.ast` node map.
  - `length`: Expected string length.

  Returns:
  `true` when `node` is a string literal of `length` characters."
  [node length]
  (and (literal-string? node nil)
       (= length (count (str (:form node))))))

(defun zero-node?
  "Test whether an AST node is the number `0`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for the numeric literal `0`, otherwise `false`."
  [node]
  (literal-number? node 0))

(defun nil-node?
  "Test whether an AST node is the symbol `nil`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for the `nil` symbol, otherwise `false`."
  [node]
  (= "nil" (symbol-name node)))

(defun direct-symbol?
  "Test whether an AST node is a direct symbol reference.

  Args:
  - `node`: A `roo.ast` node map.
  - `name`: Expected symbol name.

  Returns:
  `true` when `node` is the symbol `name`, otherwise `false`."
  [node name]
  (= name (symbol-name node)))

(defun keyword-lookup?
  "Test whether an AST node is a keyword lookup form.

  Args:
  - `node`: A `roo.ast` node map.
  - `target-name`: Symbol name expected as the lookup target.

  Returns:
  `true` for `(:key target-name)`, otherwise `false`."
  [node target-name]
  (and (= (:type node) :list)
       (= 2 (count (:children node)))
       (keyword-name (head (:children node)))
       (= target-name (symbol-name (nth (:children node) 1)))))

(defun keyword-lookup-key-name
  "Return the key name from a keyword lookup form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The keyword name for `(:key value)`, otherwise `nil`."
  [{:keys [children] :as node}]
  (when (and (= (:type node) :list)
             (= 2 (count children)))
    (keyword-name (head children))))

(defun fn-single-param-name
  "Return the parameter name from a one-argument `fn`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The parameter name for `(fn [name] body)`, otherwise `nil`."
  [{:keys [children] :as node}]
  (when (call? node "fn" 3)
    (let [params (nth children 1)]
      (when (and (= (:type params) :vector)
                 (= 1 (count (:children params))))
        (symbol-name (head (:children params)))))))

(defun cond-test-child?
  "Test whether a node is a condition child in a `cond` form.

  Args:
  - `parent`: Parent `roo.ast` node map.
  - `node`: Possible condition child node map.

  Returns:
  `true` when `node` is in a `cond` test position, otherwise `false`."
  [{:keys [children] :as parent} node]
  (and (= "cond" (head-name parent))
       (any? (range 1 (dec (count children)))
             (fn [index]
               (and (= node (nth children index))
                    (odd? index))))))

(defun branch-predicate-position?
  "Test whether an AST node is used as a branch predicate.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for root nodes.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` when `node` is a direct `if`, `when`, `unless`, `while`, or `cond`
  predicate, otherwise `false`."
  [{:keys [children] :as parent} node]
  (case (head-name parent)
    "if" (and (< 1 (count children))
              (= node (nth children 1)))
    "when" (and (< 1 (count children))
                (= node (nth children 1)))
    "unless" (and (< 1 (count children))
                  (= node (nth children 1)))
    "while" (and (< 1 (count children))
                 (= node (nth children 1)))
    "cond" (cond-test-child? parent node)
    :default false))

(defun predicate-position?
  "Test whether an AST node is used in a boolean predicate position.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for root nodes.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` when `node` is in a conditional or boolean-combinator predicate
  position, otherwise `false`."
  [parent node]
  (case (head-name parent)
    "and" true
    "or" true
    :default (branch-predicate-position? parent node)))
