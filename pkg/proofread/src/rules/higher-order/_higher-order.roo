(ns proofread.rules.higher-order
  (:require [proofread.rules.registry :as registry]))

(def rules
  "Higher-order rule descriptors."
  (registry/descriptors
    :higher-order
    {:use-flat-map 'proofread.rules.higher-order.use-flat-map
     :use-find-first 'proofread.rules.higher-order.use-find-first
     :use-keep 'proofread.rules.higher-order.use-keep}))

(defun check
  "Find higher-order diagnostics for a parsed AST root.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (registry/check active-rules root))
