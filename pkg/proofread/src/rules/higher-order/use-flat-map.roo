(ns proofread.rules.higher-order.use-flat-map
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun candidate?
  "Test whether an AST node can use `flat-map`."
  [{:keys [children] :as node}]
  (and (= "flatten" (forms/head-name node))
       (= 2 (count children))
       (forms/map-form? (nth children 1))))

(defun check
  "Return a `use-flat-map` diagnostic for matching nodes.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `_options`: Ignored effective rule options map, or `nil`.

  Returns:
  A diagnostic map when `node` matches this rule, otherwise `nil`."
  [parent node _options]
  (when (candidate? node)
    (diagnostics/make node :use-flat-map "Use flat-map")))
