(ns proofread.rules.higher-order.use-flat-map
  (:require [proofread.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun candidate?
  "Test whether an AST node can use `flat-map`."
  [{:keys [children] :as node}]
  (and (= "flatten" (forms/head-name node))
       (= 2 (count children))
       (forms/map-form? (nth children 1))))

(defun check
  "Return a `use-flat-map` diagnostic for matching nodes."
  [parent node]
  (when (candidate? node)
    (diagnostics/make node :use-flat-map "Use flat-map")))
