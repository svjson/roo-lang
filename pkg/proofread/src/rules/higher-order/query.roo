(ns proofread.rules.higher-order.query
  (:require [proofread.forms :as forms]))

(defun map-form?
  "Test whether an AST node is a single-sequence `map` form."
  [{:keys [children] :as node}]
  (and (= "map" (forms/head-name node))
       (= 3 (count children))))

(defun keep-conditional?
  "Test whether an AST node is a conditional that can feed `keep`."
  [node]
  (case (forms/head-name node)
    "when"
    true

    "unless"
    true

    :default
    false))

