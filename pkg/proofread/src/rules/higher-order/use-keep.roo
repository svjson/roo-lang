(ns proofread.rules.higher-order.use-keep
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun map-with-conditional-body?
  "Test whether a map function conditionally returns a value."
  [{:keys [children] :as node}]
  (and (forms/map-form? node)
       (let [mapper (nth children 2)
             mapper-children (:children mapper)]
         (and (= "fn" (forms/head-name mapper))
              (= 3 (count mapper-children))
              (contains? ["when" "unless"]
                         (forms/head-name (nth mapper-children 2)))))))

(defun map-filter?
  "Test whether a map consumes a filtered sequence."
  [{:keys [children] :as node}]
  (and (forms/map-form? node)
       (forms/call? (nth children 1) "filter" 3)))

(defun candidate?
  "Test whether an AST node can use `keep`."
  [node]
  (or (map-with-conditional-body? node)
      (map-filter? node)))

(defun check
  "Return a `use-keep` diagnostic for matching nodes."
  [parent node]
  (when (candidate? node)
    (diagnostics/make node :use-keep "Use keep")))
