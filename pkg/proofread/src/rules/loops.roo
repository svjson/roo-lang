(ns proofread.rules.loops
  (:require [proofread.rules.loops.use-reduce :as use-reduce]
            [proofread.rules.loops.use-for-indexed :as use-for-indexed]
            [proofread.rules.registry :as registry]))

(def rules
  "Loop rule descriptors."
  (registry/descriptors
    :loops
    [[:use-for-indexed use-for-indexed/check]
     [:use-reduce use-reduce/check]]))

(defun check
  "Find loop diagnostics for a parsed AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (registry/check rules root))
