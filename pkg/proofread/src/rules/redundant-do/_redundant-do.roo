(ns proofread.rules.redundant-do
  (:require [proofread.rules.redundant-do.redundant-do :as redundant-do]
            [proofread.rules.registry :as registry]))

(def rules
  "Redundant-do rule descriptors."
  (registry/descriptors
    :redundant-do
    [[:redundant-do redundant-do/check]]))

(defun check
  "Find redundant `do` forms beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (registry/check rules root))
