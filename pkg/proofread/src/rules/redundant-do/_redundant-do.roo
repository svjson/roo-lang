(ns proofread.rules.redundant-do
  (:require [proofread.rules.registry :as registry]))

(def rules
  "Redundant-do rule descriptors."
  (registry/descriptors
    :redundant-do
    {:redundant-do 'proofread.rules.redundant-do.redundant-do}))

(defun check
  "Find redundant `do` forms beneath one AST root.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (registry/check active-rules root))
