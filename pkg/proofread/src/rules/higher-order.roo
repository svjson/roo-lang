(ns proofread.rules.higher-order
  (:require [proofread.rules.higher-order.use-flat-map :as use-flat-map]
            [proofread.rules.higher-order.use-find-first :as use-find-first]
            [proofread.rules.higher-order.use-keep :as use-keep]
            [proofread.rules.registry :as registry]))

(def rules
  "Higher-order rule descriptors."
  (registry/descriptors
    :higher-order
    [[:use-flat-map use-flat-map/check]
     [:use-find-first use-find-first/check]
     [:use-keep use-keep/check]]))

(defun node-diagnostic
  "Return the first higher-order diagnostic for an AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when no higher-order rule matches."
  [active-rules parent node]
  (registry/node-diagnostic active-rules parent node))

(defun check-node
  "Find higher-order diagnostics beneath one AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules parent node]
  (if (map? node)
    (concat
      (if-let [diagnostic (node-diagnostic active-rules parent node)]
        [diagnostic]
        [])
      (flat-map (:children node)
                (fn [child]
                  (check-node active-rules node child))))
    []))

(defun check-with-rules
  "Find higher-order diagnostics using selected rules.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (check-node active-rules nil root))

(defun check
  "Find higher-order diagnostics beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (check-with-rules rules root))
