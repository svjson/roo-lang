(ns proofread.rules.simple-expressions.use-for
  (:require [proofread.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun candidate?
  "Test whether an AST node can use `for`."
  [parent {:keys [children] :as node}]
  (when (forms/call? node "map" 3)
    (let [mapper (nth children 2)]
      (and (not= "flatten" (forms/head-name parent))
           (forms/call? mapper "fn" 3)
           (case (forms/head-name (nth (:children mapper) 2))
             "when" false
             "unless" false
             :default true)))))

(defun check
  "Return a `use-for` diagnostic for matching nodes."
  [parent node]
  (when (candidate? parent node)
    (diagnostics/make node :use-for "Use for")))
