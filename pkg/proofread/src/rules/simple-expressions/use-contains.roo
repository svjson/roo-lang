(ns proofread.rules.simple-expressions.use-contains
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun index-of-form?
  "Test whether an AST node is an `(index-of value needle)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for three-child `index-of` calls, otherwise `false`."
  [node]
  (forms/call? node "index-of" 3))

(defun presence-check?
  "Test whether an AST node checks value nil-ness.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `nil?` and `some?` calls, otherwise `false`."
  [node]
  (contains? ["nil?" "some?"] (forms/head-name node)))

(defun equality-against-param?
  "Test whether an equality compares directly against a parameter.

  Args:
  - `node`: A `roo.ast` node map.
  - `param-name`: Parameter name string.

  Returns:
  `true` for `(= value param-name)` or `(= param-name value)`, otherwise
  `false`."
  [{:keys [children] :as node} param-name]
  (and (forms/call? node "=" 3)
       (or (and (forms/direct-symbol? (nth children 1) param-name)
                (not (forms/direct-symbol? (nth children 2) param-name)))
           (and (not (forms/direct-symbol? (nth children 1) param-name))
                (forms/direct-symbol? (nth children 2) param-name)))))

(defun equality-membership-predicate?
  "Test whether an inline predicate is a simple membership equality.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(fn [candidate] (= value candidate))`, otherwise `false`."
  [{:keys [children] :as node}]
  (when-let [param-name (forms/fn-single-param-name node)]
    (equality-against-param? (nth children 2) param-name)))

(defun any-equality-membership?
  "Test whether `any?` performs a simple equality membership scan.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(any? values (fn [value] (= needle value)))`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (forms/call? node "any?" 3)
       (equality-membership-predicate? (nth children 2))))

(defun any-equality-membership-reversed?
  "Test whether `any?` performs a simple equality membership scan with reversed args.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(any? (fn [value] (= value needle)) values)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (forms/call? node "any?" 3)
       (equality-membership-predicate? (nth children 1))))

(defun check
  "Report membership checks that should use `contains?`.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map when `node` should use `contains?`, otherwise `nil`."
  [parent node]
  (when (or (and (presence-check? parent)
                 (index-of-form? node))
            (any-equality-membership? node)
            (any-equality-membership-reversed? node))
    (diagnostics/make node :use-contains? "Use contains?")))
