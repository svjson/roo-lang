(ns proofread.rules.simple-expressions.use-nil
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun nil-comparison?
  "Test whether an AST node compares a value to `nil`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(= nil value)` and `(= value nil)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (forms/call? node "=" 3)
       (or (forms/nil-node? (nth children 1))
           (forms/nil-node? (nth children 2)))))

(defun nil-comparison-value
  "Return the non-nil side of a nil comparison."
  [{:keys [children] :as node}]
  (if (forms/nil-node? (nth children 1))
    (nth children 2)
    (nth children 1)))

(defun replacement
  "Return the replacement for `(= nil value)`."
  [node]
  (str "(nil? " (forms/form-string (nil-comparison-value node)) ")"))

(defun check
  "Report equality checks against `nil`.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map when `node` should use `nil?`, otherwise `nil`."
  [parent node]
  (when (nil-comparison? node)
    (diagnostics/make-suggesting
      node
      :use-nil?
      "Use nil?"
      [(diagnostics/rewrite node "Rewrite as nil?" (replacement node))])))
