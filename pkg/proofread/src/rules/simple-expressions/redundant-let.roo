(ns proofread.rules.simple-expressions.redundant-let
  (:require [proofread.inspect.bindings :as bindings]
            [proofread.rules.diagnostics :as diagnostics]))

(defun check
  "Return a `redundant-let` diagnostic for single-binding lets.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `options`: Effective rule options map, or `nil`.

  Returns:
  A diagnostic map when `node` contains a redundant let, otherwise `nil`."
  [parent node options]
  (when-let [items (bindings/let-bindings node)]
    (when (and (= 2 (count items))
               (bindings/single-use-simple-binding? items
                                                    0
                                                    (bindings/let-body-forms node)
                                                    options))
      (diagnostics/make node :redundant-let "Inline redundant let"))))
