(ns proofread.rules.simple-expressions
  (:require [proofread.rules.registry :as registry]))

(def rules
  "Simple-expression rule descriptors."
  (registry/descriptors
    :simple-expressions
    {:use-head 'proofread.rules.simple-expressions.use-head
     :use-slice 'proofread.rules.simple-expressions.use-slice
     :flatten-struct-operations 'proofread.rules.simple-expressions.flatten-struct-operations
     :use-clamp 'proofread.rules.simple-expressions.use-clamp
     :use-for 'proofread.rules.simple-expressions.use-for
     :use-empty? 'proofread.rules.simple-expressions.use-empty
     :use-not-empty? 'proofread.rules.simple-expressions.use-not-empty
     :use-not= 'proofread.rules.simple-expressions.use-not-equal
     :use-nil? 'proofread.rules.simple-expressions.use-nil
     :use-contains? 'proofread.rules.simple-expressions.use-contains
     :use-any? 'proofread.rules.simple-expressions.use-any
     :use-some? 'proofread.rules.simple-expressions.use-some
     :use-string-starts-with? 'proofread.rules.simple-expressions.use-string-starts-with
     :use-string? 'proofread.rules.simple-expressions.use-string
     :use-type-predicate 'proofread.rules.simple-expressions.use-type-predicate
     :use-update 'proofread.rules.simple-expressions.use-update
     :redundant-some? 'proofread.rules.simple-expressions.redundant-some
     :use-argument-destructuring 'proofread.rules.simple-expressions.use-argument-destructuring
     :redundant-let 'proofread.rules.simple-expressions.redundant-let
     :redundant-let-binding 'proofread.rules.simple-expressions.redundant-let-binding
     :redundant-let-rebind 'proofread.rules.simple-expressions.redundant-let-rebind
     :redundant-empty-default 'proofread.rules.simple-expressions.redundant-empty-default
     :use-get-with-default 'proofread.rules.simple-expressions.use-get-with-default
     :use-get-in-with-default 'proofread.rules.simple-expressions.use-get-in-with-default
     :use-keyword-lookup 'proofread.rules.simple-expressions.use-keyword-lookup
     :redundant-map-check 'proofread.rules.simple-expressions.redundant-map-check
     :use-append 'proofread.rules.simple-expressions.use-append
     :use-select-keys 'proofread.rules.simple-expressions.use-select-keys}))

(defun check
  "Find simple-expression diagnostics beneath one AST root.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (registry/check active-rules root))
