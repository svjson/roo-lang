(ns proofread.rules.simple-expressions.use-some
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun nil-check?
  "Test whether an AST node is a `(nil? value)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for one-argument `nil?` calls, otherwise `false`."
  [node]
  (forms/call? node "nil?" 2))

(defun not-nil-check?
  "Test whether an AST node negates a `nil?` check.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(not (nil? value))`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (forms/call? node "not" 2)
       (nil-check? (nth children 1))))

(defun replacement
  "Return the replacement for `(not (nil? value))`.

  Args:
  - `node`: A negated nil-check AST node.

  Returns:
  Source text for the `some?` rewrite."
  [{:keys [children]}]
  (let [value-node (nth (:children (nth children 1)) 1)]
    (str "(some? " (forms/form-string value-node) ")")))

(defun check
  "Report negated `nil?` checks.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map when `node` should use `some?`, otherwise `nil`."
  [parent node]
  (when (not-nil-check? node)
    (diagnostics/make-suggesting
      node
      :use-some?
      "Use some?"
      [(diagnostics/rewrite node "Rewrite as some?" (replacement node))])))
