(ns proofread.rules.simple-expressions.use-get-with-default
  (:require [proofread.inspect.expressions :as expressions]
            [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun get-form?
  "Test whether an AST node is a two-argument `get` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(get value key)`, otherwise `false`."
  [node]
  (forms/call? node "get" 3))

(defun replacement
  "Return the replacement for `or` plus `get` usage."
  [node]
  (let [get-form (nth (:children node) 1)]
    (str "(get " (forms/form-string (nth (:children get-form) 1)) " "
         (forms/form-string (nth (:children get-form) 2)) " "
         (forms/form-string (nth (:children node) 2)) ")")))

(defun check
  "Report `(or (get value key) default)` forms with simple terminal defaults.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `_options`: Ignored effective rule options map, or `nil`.

  Returns:
  A diagnostic map when `node` should use `get` with a default, otherwise
  `nil`."
  [parent {:keys [children] :as node} _options]
  (when (and (forms/call? node "or" 3)
             (get-form? (nth children 1))
             (or (expressions/literal? (nth children 2))
                 (= :symbol (:type (nth children 2)))))
    (diagnostics/make-suggesting
      node
      :use-get-with-default
      "Use get with default"
      [(diagnostics/rewrite node
                            "Rewrite as get with default"
                            (replacement node))])))
