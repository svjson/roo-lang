(ns proofread.rules.simple-expressions.use-not-equal
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun not-equals-negation?
  "Test whether an AST node negates an equality call.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(not (= left right))`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (forms/call? node "not" 2)
       (= "=" (forms/head-name (nth children 1)))))

(defun replacement
  "Return the replacement for `(not (= left right))`."
  [{:keys [children]}]
  (let [negated (nth children 1)]
    (str "(not= "
         (forms/form-string (nth (:children negated) 1))
         " "
         (forms/form-string (nth (:children negated) 2))
         ")")))

(defun check
  "Report negated equality checks.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map when `node` should use `not=`, otherwise `nil`."
  [parent node]
  (when (not-equals-negation? node)
    (diagnostics/make-suggesting
      node
      :use-not=
      "Use not="
      [(diagnostics/rewrite node "Rewrite as not=" (replacement node))])))
