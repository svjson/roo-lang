(ns proofread.rules.simple-expressions.use-argument-destructuring
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(def default-options
  "Default options for use-argument-destructuring."
  {:allow-renamed-keyword-lookups true})

(defun matching-binding?
  "Test whether a let binding can move into an argument destructuring form.

  Args:
  - `bindings`: Let-binding vector children.
  - `param-name`: Function parameter name.
  - `options`: Rule options.

  Returns:
  `true` when the binding maps a keyword lookup on `param-name` to a new symbol,
  according to rule options."
  [bindings param-name options]
  (when (= 2 (count bindings))
    (let [binding-name (forms/symbol-name (head bindings))
          value (nth bindings 1)]
      (and (forms/keyword-lookup? value param-name)
           (or (= binding-name (forms/keyword-lookup-key-name value))
               (:allow-renamed-keyword-lookups options))))))

(defun defun-body-index
  "Return the first body child index for a `defun` form."
  [{:keys [children] :as node}]
  (when (= "defun" (forms/head-name node))
    (case (:type (nth children 2))
      :string 4
      :default 3)))

(defun destructurable-let?
  "Test whether a `let` binds a keyword lookup from any parameter."
  [{:keys [children] :as node} params options]
  (and (= "let" (forms/head-name node))
       (any? (:children params)
             (fn [param]
               (when-let [param-name (forms/symbol-name param)]
                 (matching-binding? (:children (nth children 1))
                                   param-name
                                   options))))))

(defun candidate?
  "Test whether an immediate function-body `let` should be argument destructuring."
  [parent node options]
  (or (and (forms/call? parent "fn" 3)
           (= node (nth (:children parent) 2))
           (destructurable-let? node (nth (:children parent) 1) options))
      (when-let [body-index (defun-body-index parent)]
        (and (= (+ body-index 1) (count (:children parent)))
             (= node (nth (:children parent) body-index))
             (destructurable-let? node
                                 (nth (:children parent) (dec body-index))
                                 options)))))

(defun check-with-options
  "Return a `use-argument-destructuring` diagnostic using configured rule options.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `options`: Rule options map.

  Returns:
  A diagnostic map when `node` should use argument destructuring, otherwise `nil`."
  [parent node options]
  (let [effective-options (merge default-options
                                (or options {}))]
    (when (candidate? parent node effective-options)
      (diagnostics/make node
                        :use-argument-destructuring
                        "Use argument destructuring"))))

(defun check
  "Return a `use-argument-destructuring` diagnostic for matching nodes."
  [parent node]
  (check-with-options parent node default-options))
