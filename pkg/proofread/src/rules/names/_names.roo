(ns proofread.rules.names
  (:require [proofread.rules.registry :as registry]))

(def rules
  "Name rule descriptors."
  (registry/descriptors
    :names
    {:kebab-case-name 'proofread.rules.names.kebab-case-name
     :kebab-case-filename 'proofread.rules.names.kebab-case-filename}))

(defun check
  "Find name diagnostics beneath one AST root.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (registry/check (registry/scoped active-rules :node) root))

(defun check-file
  "Find name diagnostics for one source file.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `file`: Checked Roo file path.

  Returns:
  A vector of diagnostic maps."
  [active-rules file]
  (keep (registry/scoped active-rules :file)
        (fn [rule]
          (@> (:module rule) (check file)))))
