(ns proofread.rules.names.kebab-case-name
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun non-kebab-name?
  "Test whether an identifier should use kebab-case."
  [node]
  (when-let [name (forms/symbol-name node)]
    (and (not= "_" name)
         (contains? name '_'))))

(defun check
  "Return a `kebab-case-name` diagnostic for matching nodes.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `_options`: Ignored effective rule options map, or `nil`.

  Returns:
  A diagnostic map when `node` matches this rule, otherwise `nil`."
  [parent node _options]
  (when (non-kebab-name? node)
    (diagnostics/make node :kebab-case-name "Use kebab-case names")))
