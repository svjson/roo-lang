(ns proofread.rules.loops
  (:require [proofread.rules.registry :as registry]))

(def rules
  "Loop rule descriptors."
  (registry/descriptors
    :loops
    {:use-for-indexed 'proofread.rules.loops.use-for-indexed
     :use-reduce 'proofread.rules.loops.use-reduce}))

(defun check
  "Find loop diagnostics for a parsed AST root.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (registry/check active-rules root))
