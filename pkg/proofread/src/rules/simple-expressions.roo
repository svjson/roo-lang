(ns proofread.rules.simple-expressions
  (:require [proofread.inspect.expressions :as expressions]
            [proofread.rules.simple-expressions.redundant-empty-fallback :as redundant-empty-fallback]
            [proofread.rules.simple-expressions.redundant-let :as redundant-let]
            [proofread.rules.simple-expressions.redundant-let-binding :as redundant-let-binding]
            [proofread.rules.simple-expressions.redundant-let-rebind :as redundant-let-rebind]
            [proofread.rules.simple-expressions.redundant-map-check :as redundant-map-check]
            [proofread.rules.simple-expressions.redundant-some :as redundant-some]
            [proofread.rules.simple-expressions.use-any :as use-any]
            [proofread.rules.simple-expressions.use-argument-destructuring :as use-argument-destructuring]
            [proofread.rules.simple-expressions.use-clamp :as use-clamp]
            [proofread.rules.simple-expressions.use-contains :as use-contains]
            [proofread.rules.simple-expressions.use-empty :as use-empty]
            [proofread.rules.simple-expressions.use-for :as use-for]
            [proofread.rules.simple-expressions.use-get-in-with-default :as use-get-in-with-default]
            [proofread.rules.simple-expressions.use-get-with-default :as use-get-with-default]
            [proofread.rules.simple-expressions.use-head :as use-head]
            [proofread.rules.simple-expressions.use-keyword-lookup :as use-keyword-lookup]
            [proofread.rules.simple-expressions.use-nil :as use-nil]
            [proofread.rules.simple-expressions.use-not-empty :as use-not-empty]
            [proofread.rules.simple-expressions.use-not-equal :as use-not-equal]
            [proofread.rules.simple-expressions.use-select-keys :as use-select-keys]
            [proofread.rules.simple-expressions.use-some :as use-some]
            [proofread.rules.simple-expressions.use-string :as use-string]
            [proofread.rules.simple-expressions.use-type-predicate :as use-type-predicate]
            [proofread.rules.simple-expressions.use-update :as use-update]
            [proofread.rules.registry :as registry]))

(def rules
  "Simple-expression rule descriptors."
  (registry/descriptors
    :simple-expressions
    [[:use-head use-head/check]
     [:use-argument-destructuring use-argument-destructuring/check]
     [:use-clamp use-clamp/check]
     [:use-for use-for/check]
     [:use-empty? use-empty/check]
     [:use-not-empty? use-not-empty/check]
     [:use-not= use-not-equal/check]
     [:use-nil? use-nil/check]
     [:use-contains? use-contains/check]
     [:use-any? use-any/check]
     [:use-some? use-some/check]
     [:use-string? use-string/check]
     [:use-type-predicate use-type-predicate/check]
     [:use-update use-update/check]
     [:redundant-some? redundant-some/check]
     [:redundant-let
      redundant-let/check
      {:default-options expressions/default-options
       :check-with-options redundant-let/check-with-options}]
     [:redundant-let-binding
      redundant-let-binding/check
      {:default-options expressions/default-options
       :check-with-options redundant-let-binding/check-with-options}]
     [:redundant-let-rebind redundant-let-rebind/check]
     [:redundant-empty-fallback redundant-empty-fallback/check]
     [:use-get-with-default use-get-with-default/check]
     [:use-get-in-with-default use-get-in-with-default/check]
     [:use-keyword-lookup use-keyword-lookup/check]
     [:redundant-map-check redundant-map-check/check]
     [:use-select-keys use-select-keys/check]]))

(defun node-diagnostic
  "Return the first simple-expression diagnostic for an AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when no simple-expression rule matches."
  [active-rules parent node]
  (registry/node-diagnostic active-rules parent node))

(defun check-node
  "Find simple-expression diagnostics beneath one AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules parent node]
  (if (map? node)
    (concat
      (if-let [diagnostic (node-diagnostic active-rules parent node)]
        [diagnostic]
        [])
      (flat-map (:children node)
                (fn [child]
                  (check-node active-rules node child))))
    []))

(defun check-with-rules
  "Find simple-expression diagnostics using selected rules.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (check-node active-rules nil root))

(defun check
  "Find simple-expression diagnostics beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (check-with-rules rules root))
