(ns proofread.rules.simple-expressions
  (:require [proofread.rules.simple-expressions.redundant-empty-fallback :as redundant-empty-fallback]
            [proofread.rules.simple-expressions.redundant-map-check :as redundant-map-check]
            [proofread.rules.simple-expressions.redundant-some :as redundant-some]
            [proofread.rules.simple-expressions.use-any :as use-any]
            [proofread.rules.simple-expressions.use-contains :as use-contains]
            [proofread.rules.simple-expressions.use-empty :as use-empty]
            [proofread.rules.simple-expressions.use-get-with-default :as use-get-with-default]
            [proofread.rules.simple-expressions.use-head :as use-head]
            [proofread.rules.simple-expressions.use-keyword-lookup :as use-keyword-lookup]
            [proofread.rules.simple-expressions.use-nil :as use-nil]
            [proofread.rules.simple-expressions.use-not-empty :as use-not-empty]
            [proofread.rules.simple-expressions.use-not-equal :as use-not-equal]
            [proofread.rules.simple-expressions.use-select-keys :as use-select-keys]
            [proofread.rules.simple-expressions.use-some :as use-some]
            [proofread.rules.simple-expressions.use-string :as use-string]))

(def checks
  "Simple-expression rule check functions."
  [use-head/check
   use-empty/check
   use-not-empty/check
   use-not-equal/check
   use-nil/check
   use-contains/check
   use-any/check
   use-some/check
   use-string/check
   redundant-some/check
   redundant-empty-fallback/check
   use-get-with-default/check
   use-keyword-lookup/check
   redundant-map-check/check
   use-select-keys/check])

(defun node-diagnostic
  "Return the first simple-expression diagnostic for an AST node.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when no simple-expression rule matches."
  [parent node]
  (head (keep checks
              (fn [check]
                (check parent node)))))

(defun check-node
  "Find simple-expression diagnostics beneath one AST node.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [parent node]
  (if (map? node)
    (concat
      (if-let [diagnostic (node-diagnostic parent node)]
        [diagnostic]
        [])
      (flat-map (:children node)
                (fn [child]
                  (check-node node child))))
    []))

(defun check
  "Find simple-expression diagnostics beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (check-node nil root))
