(ns proofread.rules.simple-expressions
  (:require [proofread.forms :as forms]
            [roo.string :as string]))

(defun zero-node?
  "Test whether an AST node is the number `0`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for the numeric literal `0`, otherwise `false`."
  [node]
  (and (= (:type node) :number)
       (= (:form node) 0)))

(defun nil-node?
  "Test whether an AST node is the symbol `nil`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for the `nil` symbol, otherwise `false`."
  [node]
  (= "nil" (forms/symbol-name node)))

(defun count-form?
  "Test whether an AST node is a `(count value)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for two-child `count` calls, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "count" (forms/head-name node))
       (= 2 (count children))))

(defun empty-count-comparison?
  "Test whether an AST node compares a count to zero.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(= 0 (count value))` and `(= (count value) 0)`, otherwise
  `false`."
  [{:keys [children] :as node}]
  (and (= "=" (forms/head-name node))
       (= 3 (count children))
       (or (and (zero-node? (nth children 1))
                (count-form? (nth children 2)))
           (and (count-form? (nth children 1))
                (zero-node? (nth children 2))))))

(defun not-empty-count-comparison?
  "Test whether an AST node compares a count as greater than zero.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(< 0 (count value))` and `(> (count value) 0)`, otherwise
  `false`."
  [{:keys [children] :as node}]
  (and (= 3 (count children))
       (or (and (= "<" (forms/head-name node))
                (zero-node? (nth children 1))
                (count-form? (nth children 2)))
           (and (= ">" (forms/head-name node))
                (count-form? (nth children 1))
                (zero-node? (nth children 2))))))

(defun not-empty-negation?
  "Test whether an AST node negates an `empty?` call.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(not (empty? value))`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "not" (forms/head-name node))
       (= 2 (count children))
       (= "empty?" (forms/head-name (nth children 1)))))

(defun not-equals-negation?
  "Test whether an AST node negates an equality call.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(not (= left right))`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "not" (forms/head-name node))
       (= 2 (count children))
       (= "=" (forms/head-name (nth children 1)))))

(defun nil-comparison?
  "Test whether an AST node compares a value to `nil`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(= nil value)` and `(= value nil)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "=" (forms/head-name node))
       (= 3 (count children))
       (or (nil-node? (nth children 1))
           (nil-node? (nth children 2)))))

(defun nil-check?
  "Test whether an AST node is a `(nil? value)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for one-argument `nil?` calls, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "nil?" (forms/head-name node))
       (= 2 (count children))))

(defun not-nil-check?
  "Test whether an AST node negates a `nil?` check.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(not (nil? value))`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "not" (forms/head-name node))
       (= 2 (count children))
       (nil-check? (nth children 1))))

(defun some-check?
  "Test whether an AST node is a `(some? value)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for one-argument `some?` calls, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "some?" (forms/head-name node))
       (= 2 (count children))))

(defun non-predicate-name?
  "Test whether a name is not predicate-shaped.

  Args:
  - `name`: Symbol or keyword name string.

  Returns:
  `true` when `name` is not empty, not predicate-suffixed, and not a boolean or
  nil literal name."
  [name]
  (and (not (blank? name))
       (not (contains? ["nil" "true" "false"] name))
       (not (string/ends-with? name "?"))))

(defun find-index-form?
  "Test whether an AST node is a `(find-index value predicate)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for three-child `find-index` calls, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "find-index" (forms/head-name node))
       (= 3 (count children))))

(defun find-first-form?
  "Test whether an AST node is a `(find-first value predicate)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for three-child `find-first` calls, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "find-first" (forms/head-name node))
       (= 3 (count children))))

(defun index-of-form?
  "Test whether an AST node is an `(index-of value needle)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for three-child `index-of` calls, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "index-of" (forms/head-name node))
       (= 3 (count children))))

(defun presence-check?
  "Test whether an AST node checks value nil-ness.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `nil?` and `some?` calls, otherwise `false`."
  [node]
  (contains? ["nil?" "some?"] (forms/head-name node)))

(defun throwaway-find-index?
  "Test whether `find-index` is used only as a presence check.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` for `find-index` calls beneath presence checks, otherwise `false`."
  [parent node]
  (and (presence-check? parent)
       (find-index-form? node)))

(defun throwaway-find-first?
  "Test whether `find-first` is used only as a presence check.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` for `find-first` calls beneath presence checks, otherwise `false`."
  [parent node]
  (and (presence-check? parent)
       (find-first-form? node)))

(defun throwaway-index-of?
  "Test whether `index-of` is used only as a presence check.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` for `index-of` calls beneath presence checks, otherwise `false`."
  [parent node]
  (and (presence-check? parent)
       (index-of-form? node)))

(defun empty-vector?
  "Test whether an AST node is an empty vector literal.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `[]`, otherwise `false`."
  [node]
  (and (= :vector (:type node))
       (empty? (:children node))))

(defun empty-fallback?
  "Test whether an AST node is an `(or value [])` fallback.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(or value [])`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "or" (forms/head-name node))
       (= 3 (count children))
       (empty-vector? (nth children 2))))

(defun nil-tolerant-seq-call?
  "Test whether a call treats nil input as an empty sequence.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for sequence calls whose first argument can be `nil`, otherwise
  `false`."
  [{:keys [children] :as node}]
  (and (< 1 (count children))
       (contains? ["any?" "count" "empty?" "filter" "find-first" "find-index" "flat-map" "keep" "map" "not-empty?" "remove"]
                  (forms/head-name node))))

(defun redundant-empty-fallback?
  "Test whether a call defensively falls back to an empty sequence.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for calls like `(keep (or values []) f)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (nil-tolerant-seq-call? node)
       (empty-fallback? (nth children 1))))

(defun get-form?
  "Test whether an AST node is a two-argument `get` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(get value key)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "get" (forms/head-name node))
       (= 3 (count children))))

(defun defaulted-get-fallback?
  "Test whether an AST node defaults a `get` with `or`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(or (get value key) default)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (= "or" (forms/head-name node))
       (= 3 (count children))
       (get-form? (nth children 1))))

(defun get-default-child?
  "Test whether `node` is the `get` child in a defaulted `or` form.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` for the `(get value key)` child in `(or (get value key) default)`,
  otherwise `false`."
  [{:keys [children] :as parent} node]
  (and (defaulted-get-fallback? parent)
       (= node (nth children 1))))

(defun keyword-get?
  "Test whether an AST node gets a literal keyword key.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(get value :key)`, otherwise `false`."
  [{:keys [children] :as node}]
  (and (get-form? node)
       (= :keyword (:type (nth children 2)))))

(defun map-check?
  "Test whether an AST node is a `(map? value)` form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The checked symbol name for `(map? name)`, otherwise `nil`."
  [{:keys [children] :as node}]
  (when (and (= "map?" (forms/head-name node))
             (= 2 (count children)))
    (forms/symbol-name (nth children 1))))

(defun keyword-lookup?
  "Test whether an AST node is a keyword lookup form.

  Args:
  - `node`: A `roo.ast` node map.
  - `target-name`: Symbol name expected as the lookup target.

  Returns:
  `true` for `(:key target-name)`, otherwise `false`."
  [node target-name]
  (and (= (:type node) :list)
       (= 2 (count (:children node)))
       (forms/keyword-name (head (:children node)))
       (= target-name (forms/symbol-name (nth (:children node) 1)))))

(defun keyword-lookup-key-name
  "Return the key name from a keyword lookup form.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  The keyword name for `(:key value)`, otherwise `nil`."
  [{:keys [children] :as node}]
  (when (and (= (:type node) :list)
             (= 2 (count children)))
    (forms/keyword-name (head children))))

(defun lookup-comparison?
  "Test whether an AST node compares a keyword lookup against another value.

  Args:
  - `node`: A `roo.ast` node map.
  - `target-name`: Symbol name expected as the lookup target.

  Returns:
  `true` for equality comparisons involving `(:key target-name)`, otherwise
  `false`."
  [{:keys [children] :as node} target-name]
  (and (= "=" (forms/head-name node))
       (= 3 (count children))
       (or (keyword-lookup? (nth children 1) target-name)
           (keyword-lookup? (nth children 2) target-name))))

(defun lookup-access?
  "Test whether an AST node directly accesses a target through keyword lookup.

  Args:
  - `node`: A `roo.ast` node map.
  - `target-name`: Symbol name expected as the lookup target.

  Returns:
  `true` for direct keyword lookups or equality comparisons using them,
  otherwise `false`."
  [node target-name]
  (or (keyword-lookup? node target-name)
      (lookup-comparison? node target-name)))

(defun redundant-map-check?
  "Test whether an `and` form contains a redundant `map?` guard.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for `(and (map? value) (:key value) ...)` and equality checks against
  keyword lookups on `value`, otherwise `false`."
  [{:keys [children] :as node}]
  (when (and (= "and" (forms/head-name node))
             (< 1 (count children)))
    (when-let [target-name (map-check? (nth children 1))]
      (any? (tail (tail children))
            (fn [child]
              (lookup-access? child target-name))))))

(defun select-keys-entry-target
  "Return the source symbol name for a select-keys map entry.

  Args:
  - `key-node`: Map key node.
  - `value-node`: Map value node.

  Returns:
  The lookup target symbol name for `:key (:key target)`, otherwise `nil`."
  [key-node value-node]
  (when (= (:type key-node) :keyword)
    (let [value-children (:children value-node)]
      (when (and (= (:type value-node) :list)
                 (= 2 (count value-children))
                 (= (:form key-node) (:form (head value-children))))
        (forms/symbol-name (nth value-children 1))))))

(defun select-keys-target
  "Return the shared source symbol for select-keys candidate entries.

  Args:
  - `children`: Map child nodes.
  - `index`: Current key index.
  - `target-name`: Previously seen source symbol name, or `nil`.

  Returns:
  The shared source symbol name when all entries match, otherwise `nil`."
  [children index target-name]
  (if (>= index (count children))
    target-name
    (when-let [entry-target (select-keys-entry-target (nth children index)
                                                      (nth children (+ index 1)))]
      (when (or (nil? target-name)
                (= target-name entry-target))
        (select-keys-target children (+ index 2) entry-target)))))

(defun select-keys-candidate?
  "Test whether a map literal should be `select-keys`.

  Args:
  - `node`: A `roo.ast` node map.

  Returns:
  `true` for map literals such as `{:a (:a value) :b (:b value) :c (:c value)}`."
  [{:keys [children] :as node}]
  (and (= (:type node) :map)
       (< 5 (count children))
       (select-keys-target children 0 nil)))

(defun cond-test-child?
  "Test whether a node is a condition child in a `cond` form.

  Args:
  - `parent`: Parent `roo.ast` node map.
  - `node`: Possible condition child node map.

  Returns:
  `true` when `node` is in a `cond` test position, otherwise `false`."
  [{:keys [children] :as parent} node]
  (and (= "cond" (forms/head-name parent))
       (any? (range 1 (dec (count children)))
             (fn [index]
               (and (= node (nth children index))
                    (odd? index))))))

(defun branch-predicate-position?
  "Test whether an AST node is used as a branch predicate.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for root nodes.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` when `node` is a direct `if`, `when`, `unless`, `while`, or `cond`
  predicate, otherwise `false`."
  [{:keys [children] :as parent} node]
  (case (forms/head-name parent)
    "if" (and (< 1 (count children))
              (= node (nth children 1)))
    "when" (and (< 1 (count children))
                (= node (nth children 1)))
    "unless" (and (< 1 (count children))
                  (= node (nth children 1)))
    "while" (and (< 1 (count children))
                 (= node (nth children 1)))
    "cond" (cond-test-child? parent node)
    :default false))

(defun predicate-position?
  "Test whether an AST node is used in a boolean predicate position.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for root nodes.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` when `node` is in a conditional or boolean-combinator predicate
  position, otherwise `false`."
  [parent node]
  (case (forms/head-name parent)
    "and" true
    "or" true
    :default (branch-predicate-position? parent node)))

(defun redundant-some-check?
  "Test whether `some?` redundantly wraps a value in branch position.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for root nodes.
  - `node`: Current `roo.ast` node map.

  Returns:
  `true` for redundant non-predicate symbol and keyword lookup checks in branch
  predicate positions, otherwise `false`."
  [parent {:keys [children] :as node}]
  (and (branch-predicate-position? parent node)
       (some-check? node)
       (or (non-predicate-name? (forms/symbol-name (nth children 1)))
           (non-predicate-name? (keyword-lookup-key-name (nth children 1))))))

(defun diagnostic
  "Build a simple-expression diagnostic for an AST node.

  Args:
  - `node`: A `roo.ast` node map.
  - `rule`: Diagnostic rule keyword.
  - `message`: Diagnostic message.

  Returns:
  A diagnostic map."
  [node rule message]
  {:rule rule
   :severity :warning
   :source (:source node)
   :message message})

(defun simple-expression-diagnostic
  "Return the simple-expression diagnostic for an AST node.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when the node does not match a rule."
  [parent {:keys [children] :as node}]
  (cond
    (and (= "nth" (forms/head-name node))
         (= 3 (count children))
         (zero-node? (nth children 2)))
    (diagnostic node :use-head "Use head")

    (empty-count-comparison? node)
    (diagnostic node :use-empty? "Use empty?")

    (and (predicate-position? parent node)
         (or (not-empty-count-comparison? node)
             (not-empty-negation? node)))
    (diagnostic node :use-not-empty? "Use not-empty?")

    (not-equals-negation? node)
    (diagnostic node :use-not= "Use not=")

    (nil-comparison? node)
    (diagnostic node :use-nil? "Use nil?")

    (throwaway-index-of? parent node)
    (diagnostic node :use-contains? "Use contains?")

    (throwaway-find-index? parent node)
    (diagnostic node :use-any? "Use any?")

    (throwaway-find-first? parent node)
    (diagnostic node :use-any? "Use any?")

    (not-nil-check? node)
    (diagnostic node :use-some? "Use some?")

    (redundant-some-check? parent node)
    (diagnostic node :redundant-some? "Remove redundant some?")

    (redundant-empty-fallback? node)
    (diagnostic node :redundant-empty-fallback "Remove redundant empty fallback")

    (defaulted-get-fallback? node)
    (diagnostic node :use-get-with-default "Use get with default")

    (and (keyword-get? node)
         (not (get-default-child? parent node)))
    (diagnostic node :use-keyword-lookup "Use keyword lookup")

    (redundant-map-check? node)
    (diagnostic node :redundant-map-check "Remove redundant map? check")

    (select-keys-candidate? node)
    (diagnostic node :use-select-keys "Use select-keys")

    true
    nil))

(defun check-node
  "Find simple-expression diagnostics beneath one AST node.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [parent node]
  (if (map? node)
    (concat
      (if-let [node-diagnostic (simple-expression-diagnostic parent node)]
        [node-diagnostic]
        [])
      (flat-map (:children node)
                (fn [child]
                  (check-node node child))))
    []))

(defun check
  "Find simple-expression diagnostics beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (check-node nil root))
