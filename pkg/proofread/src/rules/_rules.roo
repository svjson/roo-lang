(ns proofread.rules
  (:require [proofread.config :as config]
            proofread.rules.direct-conditions
            proofread.rules.higher-order
            proofread.rules.loops
            proofread.rules.names
            proofread.rules.redundant-do
            proofread.rules.redundant-functions
            proofread.rules.simple-expressions))

(def categories
  "Ordered module maps for proofread rule category namespaces."
  [(module 'proofread.rules.direct-conditions)
   (module 'proofread.rules.higher-order)
   (module 'proofread.rules.loops)
   (module 'proofread.rules.simple-expressions)
   (module 'proofread.rules.names)
   (module 'proofread.rules.redundant-functions)
   (module 'proofread.rules.redundant-do)])

(def rules
  "Registered proofread rule descriptors in category order."
  (flat-map categories (fn [category] (get category 'rules))))

(defun enabled-rules
  "Return rule descriptors enabled by config.

  Args:
  - `active-config`: Effective proofread config.
  - `rule-descriptors`: Rule descriptor maps.

  Returns:
  Rule descriptors not disabled by config."
  [{:keys [rules] :as active-config} rule-descriptors]
  (keep rule-descriptors
        (fn [{:keys [id] :as rule}]
          (when (config/rule-enabled? active-config id)
            (assoc rule :options (config/merge-config (:default-options rule)
                                                      (:options (get rules id))))))))

(defun check-with-config
  "Run enabled proofread rules for parsed source roots.

  Args:
  - `roots`: Top-level `roo.ast` nodes.
  - `active-config`: Effective proofread config.

  Returns:
  A vector of diagnostic maps from all enabled rules."
  [roots active-config]
  (let [active-categories (for [category categories]
                            {:category category
                             :active-rules (enabled-rules active-config
                                                          (get category 'rules))})]
    (flat-map roots
              (fn [root]
                (flat-map active-categories
                          (fn [{:keys [category active-rules]}]
                            (@> category (check active-rules root))))))))

(defun check-file-with-config
  "Run enabled file-level proofread rules.

  Args:
  - `file`: Checked Roo file path.
  - `active-config`: Effective proofread config.

  Returns:
  A vector of diagnostic maps from file-level rules."
  [file active-config]
  (flat-map categories
            (fn [category]
              (if (get category 'check-file)
                (@> category
                    (check-file
                      (enabled-rules active-config (get category 'rules))
                      file))
                []))))

(defun check
  "Run all proofread rules for parsed source roots.

  Args:
  - `roots`: Top-level `roo.ast` nodes.

  Returns:
  A vector of diagnostic maps from all rules."
  [roots]
  (check-with-config roots {}))
