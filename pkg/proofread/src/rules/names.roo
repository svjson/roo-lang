(ns proofread.rules.names
  (:require [proofread.rules.names.kebab-case-filename :as kebab-case-filename]
            [proofread.rules.names.kebab-case-name :as kebab-case-name]
            [proofread.rules.registry :as registry]))

(def rules
  "Name rule descriptors."
  (registry/descriptors
    :names
    [[:kebab-case-name kebab-case-name/check]
     [:kebab-case-filename kebab-case-filename/check :file]]))

(defun node-diagnostic
  "Return the name diagnostic for an AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when no name rule matches."
  [active-rules parent node]
  (registry/node-diagnostic active-rules parent node))

(defun check-node
  "Find name diagnostics beneath one AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules parent node]
  (if (map? node)
    (concat
      (if-let [diagnostic (node-diagnostic active-rules parent node)]
        [diagnostic]
        [])
      (flat-map (:children node)
                (fn [child]
                  (check-node active-rules node child))))
    []))

(defun check-with-rules
  "Find name diagnostics using selected rules.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (check-node (registry/scoped active-rules :node) nil root))

(defun check-file-with-rules
  "Find name diagnostics for one source file.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `file`: Checked Roo file path.

  Returns:
  A vector of diagnostic maps."
  [active-rules file]
  (keep (registry/scoped active-rules :file)
        (fn [rule]
          ((:check rule) file))))

(defun check
  "Find name diagnostics beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (check-with-rules rules root))
