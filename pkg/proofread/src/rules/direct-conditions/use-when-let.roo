(ns proofread.rules.direct-conditions.use-when-let
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun let-candidate?
  "Test whether a `let` form should be `when-let`."
  [node]
  (when-let [binding-name (forms/single-binding-symbol node)
             body (forms/sole-let-body-form node)]
    (let [condition (nth (:children body) 1)]
      (or (and (= "when" (forms/head-name body))
               (= binding-name (forms/symbol-name condition)))
          (and (= "unless" (forms/head-name body))
               (forms/call? condition "nil?" 2)
               (= binding-name
                  (forms/symbol-name (nth (:children condition) 1))))))))

(defun contains-form?
  "Test whether an AST subtree contains a matching form."
  [node target]
  (and (map? node)
       (or (forms/same-form? node target)
           (any? (:children node)
                 (fn [child]
                   (contains-form? child target))))))

(defun repeated-keyword-lookup?
  "Test whether a `when` form repeats its keyword lookup condition."
  [{:keys [children] :as node}]
  (and (= "when" (forms/head-name node))
       (< 2 (count children))
       (forms/keyword-lookup-key-name (nth children 1))
       (any? (slice children 2)
             (fn [body]
               (contains-form? body (nth children 1))))))

(defun nil-else-if-let?
  "Test whether an `if-let` form should be `when-let`."
  [{:keys [children] :as node}]
  (and (= "if-let" (forms/head-name node))
       (= 4 (count children))
       (forms/nil-node? (nth children 3))))

(defun check
  "Return a `use-when-let` diagnostic for matching nodes.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `_options`: Ignored effective rule options map, or `nil`.

  Returns:
  A diagnostic map when `node` matches this rule, otherwise `nil`."
  [parent node _options]
  (when (or (let-candidate? node)
            (repeated-keyword-lookup? node)
            (nil-else-if-let? node))
    (diagnostics/make node :use-when-let "Use when-let")))
