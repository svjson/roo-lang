(ns proofread.rules.direct-conditions.use-when
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun check
  "Return a `use-when` diagnostic for matching nodes.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `_options`: Ignored effective rule options map, or `nil`.

  Returns:
  A diagnostic map when `node` matches this rule, otherwise `nil`."
  [parent {:keys [children] :as node} _options]
  (when (and (= "if" (forms/head-name node))
             (or (= 3 (count children))
                 (forms/nil-node? (nth children 3))))
    (diagnostics/make-suggesting
      node
      :use-when
      "Use when"
      [(diagnostics/rewrite node "Rewrite as when" (str "(when "
                                                        (forms/form-string (nth children 1))
                                                        " "
                                                        (forms/form-string (nth children 2))
                                                        ")"))])))
