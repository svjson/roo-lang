(ns proofread.rules.direct-conditions.use-if-let
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun candidate?
  "Test whether a `let` form should be `if-let`."
  [node]
  (when-let [binding-name (forms/single-binding-symbol node)
             body (forms/sole-let-body-form node)]
    (let [children (:children body)
          condition (nth children 1)]
      (and (= "if" (forms/head-name body))
           (or (= binding-name (forms/symbol-name condition))
               (and (= 4 (count children))
                    (forms/call? condition "nil?" 2)
                    (= binding-name
                       (forms/symbol-name (nth (:children condition) 1)))))))))

(defun check
  "Return a `use-if-let` diagnostic for matching nodes."
  [parent node]
  (when (candidate? node)
    (diagnostics/make node :use-if-let "Use if-let")))
