(ns proofread.rules.direct-conditions.use-unless
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun if-empty-then-branch?
  "Test whether an `if` form has an empty then branch."
  [{:keys [children] :as node}]
  (and (= "if" (forms/head-name node))
       (= 4 (count children))
       (forms/nil-node? (nth children 2))))

(defun when-negated-condition?
  "Test whether a `when` form negates its condition."
  [{:keys [children] :as node}]
  (and (= "when" (forms/head-name node))
       (< 2 (count children))
       (forms/call? (nth children 1) "not" 2)))

(defun replacement
  "Return a rewrite candidate for `use-unless`."
  [{:keys [children] :as node}]
  (case (forms/head-name node)
    "if" (str "(unless "
               (forms/form-string (nth children 1))
               " "
               (forms/form-string (nth children 3))
               ")")
    "when" (str "(unless "
                (forms/form-string (nth (:children (nth children 1)) 1))
                " "
                (forms/form-sequence-string (slice children 2))
                ")")))

(defun check
  "Return a `use-unless` diagnostic for matching nodes.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `_options`: Ignored effective rule options map, or `nil`.

  Returns:
  A diagnostic map when `node` matches this rule, otherwise `nil`."
  [parent {:keys [children] :as node} _options]
  (when (or (if-empty-then-branch? node)
            (when-negated-condition? node))
    (diagnostics/make-suggesting
      node
      :use-unless
      "Use unless"
      [(diagnostics/rewrite node "Rewrite as unless" (replacement node))])))
