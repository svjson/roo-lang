(ns proofread.rules.direct-conditions.flatten-if-pyramid
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]))

(defun candidate?
  "Test whether an `if` pyramid can combine repeated branches."
  [{:keys [children] :as node}]
  (and (forms/full-if? node)
       (let [then (nth children 2)
             else (nth children 3)]
         (or (and (forms/full-if? then)
                  (or (forms/same-form? (nth (:children then) 2) else)
                      (forms/same-form? (nth (:children then) 3) else)))
             (and (forms/full-if? else)
                  (or (forms/same-form? then (nth (:children else) 2))
                      (forms/same-form? then (nth (:children else) 3))))))))

(defun check
  "Return a `flatten-if-pyramid` diagnostic for matching nodes.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `_options`: Ignored effective rule options map, or `nil`.

  Returns:
  A diagnostic map when `node` matches this rule, otherwise `nil`."
  [parent node _options]
  (when (candidate? node)
    (diagnostics/make node :flatten-if-pyramid "Flatten if pyramid")))
