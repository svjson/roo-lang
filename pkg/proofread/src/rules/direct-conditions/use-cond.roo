(ns proofread.rules.direct-conditions.use-cond
  (:require [proofread.inspect.forms :as forms]
            [proofread.rules.diagnostics :as diagnostics]
            [proofread.rules.direct-conditions.use-case :as use-case]))

(defun value-if-chain?
  "Test whether an `if` chain has meaningful branch values."
  [{:keys [children] :as node}]
  (and (forms/full-if? node)
       (not (forms/nil-node? (nth children 2)))
       (let [else (forms/if-else node)]
         (if (forms/full-if? else)
           (value-if-chain? else)
           (not (forms/nil-node? else))))))

(defun candidate?
  "Test whether an `if` chain should be `cond`."
  [node]
  (and (forms/full-if? node)
       (forms/full-if? (forms/if-else node))
       (not (use-case/candidate? node))
       (value-if-chain? node)))

(defun check
  "Return a `use-cond` diagnostic for matching nodes.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.
  - `_options`: Ignored effective rule options map, or `nil`.

  Returns:
  A diagnostic map when `node` matches this rule, otherwise `nil`."
  [parent node _options]
  (when (candidate? node)
    (diagnostics/make node :use-cond "Use cond")))
