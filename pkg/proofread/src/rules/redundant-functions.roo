(ns proofread.rules.redundant-functions
  (:require [proofread.rules.redundant-functions.redundant-function :as redundant-function]))

(defun node-diagnostic
  "Return the redundant-function diagnostic for an AST node.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when no redundant-function rule matches."
  [parent node]
  (redundant-function/check parent node))

(defun check-node
  "Find redundant function diagnostics beneath one AST node.

  Args:
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [parent node]
  (if (map? node)
    (concat
      (if-let [diagnostic (node-diagnostic parent node)]
        [diagnostic]
        [])
      (flat-map (:children node)
                (fn [child]
                  (check-node node child))))
    []))

(defun check
  "Find redundant function diagnostics beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (check-node nil root))
