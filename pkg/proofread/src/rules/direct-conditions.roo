(ns proofread.rules.direct-conditions
  (:require [proofread.forms :as forms]
            [proofread.rules.direct-conditions.flatten-if-pyramid :as flatten-if-pyramid]
            [proofread.rules.direct-conditions.use-case :as use-case]
            [proofread.rules.direct-conditions.use-cond :as use-cond]
            [proofread.rules.direct-conditions.use-if-let :as use-if-let]
            [proofread.rules.direct-conditions.use-unless :as use-unless]
            [proofread.rules.direct-conditions.use-when :as use-when]
            [proofread.rules.direct-conditions.use-when-let :as use-when-let]
            [proofread.rules.registry :as registry]))

(def rules
  "Direct-condition rule descriptors."
  (registry/descriptors
    :direct-conditions
    [[:use-if-let use-if-let/check]
     [:use-when-let use-when-let/check]
     [:use-case use-case/check]
     [:flatten-if-pyramid flatten-if-pyramid/check]
     [:use-cond use-cond/check]
     [:use-when use-when/check]
     [:use-unless use-unless/check]]))

(defun covered-child?
  "Test whether a child is covered by an existing parent diagnostic."
  [active-rules parent node]
  (or (and (= node (forms/sole-let-body-form parent))
           (registry/node-diagnostic active-rules nil parent))
      (and (forms/else-child? parent node)
           (registry/node-diagnostic
             (filter active-rules
                     (fn [rule]
                       (contains? [:use-case :flatten-if-pyramid :use-cond]
                                  (:id rule))))
             nil
             parent))))

(defun node-diagnostic
  "Return the direct-condition diagnostic for an AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when the node does not match a rule."
  [active-rules parent node]
  (when (not (covered-child? active-rules parent node))
    (registry/node-diagnostic active-rules parent node)))

(defun check-node
  "Find direct-condition diagnostics beneath one AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules parent node]
  (if (map? node)
    (concat
      (if-let [diagnostic (node-diagnostic active-rules parent node)]
        [diagnostic]
        [])
      (flat-map (:children node)
                (fn [child]
                  (check-node active-rules node child))))
    []))

(defun check-with-rules
  "Find direct-condition diagnostics using selected rules.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (check-node active-rules nil root))

(defun check
  "Find direct-condition diagnostics beneath one AST root.

  Args:
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [root]
  (check-with-rules rules root))
