(ns proofread.rules.registry)

(defun descriptors
  "Build proofread rule descriptors for a category.

  Args:
  - `category`: Rule category keyword.
  - `entries`: Ordered map from rule IDs to implementation namespace symbols.

  Returns:
  Rule descriptor maps retaining live implementation modules."
  [category entries]
  (reduce-kv entries
             []
             (fn [rules id namespace]
               (let [rule-module (module namespace)]
                 (append rules
                          {:id id
                           :category category
                           :default-severity :warning
                           :default-options (when (get rule-module 'default-options)
                                              (@> rule-module (default-options)))
                           :scope (if (get rule-module 'scope)
                                    (@> rule-module (scope))
                                    :node)
                           :module rule-module})))))

(defun scoped
  "Return rule descriptors for one scope.

  Args:
  - `rules`: Rule descriptor maps.
  - `scope`: Scope keyword.

  Returns:
  Rule descriptors whose `:scope` is `scope`."
  [rules scope]
  (filter rules
          (fn [rule]
            (= scope (:scope rule)))))

(defun node-diagnostic
  "Return the first diagnostic from matching rule descriptors.

  Args:
  - `rules`: Node-scoped rule descriptors whose modules expose `check` functions
    accepting parent, node, and effective rule options.
  - `parent`: Parent `roo.ast` node map, or `nil`.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when no rule matches."
  [rules parent node]
  (head (keep rules
              (fn [rule]
                (@> (:module rule)
                    (check parent node (:options rule)))))))

(defun check-node
  "Find diagnostics beneath one AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules parent node]
  (if (map? node)
    (concat
      (if-let [diagnostic (node-diagnostic active-rules parent node)]
        [diagnostic]
        [])
      (flat-map (:children node)
                (fn [child]
                  (check-node active-rules node child))))
    []))

(defun check
  "Find diagnostics for a parsed AST root.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (check-node active-rules nil root))

(defun rule-ids
  "Return rule IDs from descriptors.

  Args:
  - `rules`: Rule descriptor maps.

  Returns:
  A vector of rule ID keywords."
  [rules]
  (map rules :id))

(defun known-rule?
  "Test whether a rule ID is registered.

  Args:
  - `rules`: Rule descriptor maps.
  - `id`: Rule keyword.

  Returns:
  `true` when `id` is present in `rules`, otherwise `false`."
  [rules id]
  (contains? (rule-ids rules) id))
