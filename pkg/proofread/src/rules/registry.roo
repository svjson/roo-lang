(ns proofread.rules.registry)

(defun descriptor
  "Build a proofread rule descriptor.

  Args:
  - `category`: Rule category keyword.
  - `entry`: Vector containing rule ID, check function, and optional scope.

  Returns:
  A rule descriptor map."
  [category entry]
  (let [options (when (map? (nth entry 2))
                  (nth entry 2))]
    {:id (head entry)
     :category category
     :default-severity :warning
     :default-options (or (:default-options options) {})
     :scope (or (:scope options)
                (when (nil? options)
                  (nth entry 2))
                :node)
     :check (nth entry 1)
     :check-with-options (:check-with-options options)}))

(defun descriptors
  "Build proofread rule descriptors for a category.

  Args:
  - `category`: Rule category keyword.
  - `entries`: Vectors containing rule ID, check function, and optional scope.

  Returns:
  Rule descriptor maps."
  [category entries]
  (for [entry entries]
    (descriptor category entry)))

(defun scoped
  "Return rule descriptors for one scope.

  Args:
  - `rules`: Rule descriptor maps.
  - `scope`: Scope keyword.

  Returns:
  Rule descriptors whose `:scope` is `scope`."
  [rules scope]
  (filter rules
          (fn [rule]
            (= scope (:scope rule)))))

(defun check-rule
  "Run one rule descriptor against an AST node.

  Args:
  - `rule`: Rule descriptor map.
  - `parent`: Parent `roo.ast` node map, or `nil`.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when the rule does not match."
  [rule parent node]
  (if-let [check (:check-with-options rule)]
    (check parent node (:options rule))
    ((:check rule) parent node)))

(defun node-diagnostic
  "Return the first diagnostic from matching rule descriptors.

  Args:
  - `rules`: Rule descriptor maps.
  - `parent`: Parent `roo.ast` node map, or `nil`.
  - `node`: Current `roo.ast` node map.

  Returns:
  A diagnostic map, or `nil` when no rule matches."
  [rules parent node]
  (head (keep rules
              (fn [rule]
                (check-rule rule parent node)))))

(defun check-node
  "Find diagnostics beneath one AST node.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `parent`: Parent `roo.ast` node map, or `nil` for a root node.
  - `node`: Current `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules parent node]
  (if (map? node)
    (concat
      (if-let [diagnostic (node-diagnostic active-rules parent node)]
        [diagnostic]
        [])
      (flat-map (:children node)
                (fn [child]
                  (check-node active-rules node child))))
    []))

(defun check
  "Find diagnostics for a parsed AST root.

  Args:
  - `active-rules`: Rule descriptors to run.
  - `root`: A top-level `roo.ast` node map.

  Returns:
  A vector of diagnostic maps."
  [active-rules root]
  (check-node active-rules nil root))

(defun rule-ids
  "Return rule IDs from descriptors.

  Args:
  - `rules`: Rule descriptor maps.

  Returns:
  A vector of rule ID keywords."
  [rules]
  (map rules :id))

(defun known-rule?
  "Test whether a rule ID is registered.

  Args:
  - `rules`: Rule descriptor maps.
  - `id`: Rule keyword.

  Returns:
  `true` when `id` is present in `rules`, otherwise `false`."
  [rules id]
  (contains? (rule-ids rules) id))
