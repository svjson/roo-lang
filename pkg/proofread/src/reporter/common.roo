(ns proofread.reporter.common)

(defun diagnostic-line
  "Format one diagnostic for CLI output.

  Args:
  - `diagnostic`: A diagnostic map from a style rule.

  Returns:
  A single warning line containing source, severity, rule, and message."
  [diagnostic]
  (str (:path (:source diagnostic))
       ":"
       (:line (:source diagnostic))
       ":"
       (:column (:source diagnostic))
       ": "
       (name (:severity diagnostic))
       " "
       (name (:rule diagnostic))
       ": "
       (:message diagnostic)))

(defun summary-text
  "Format a proofread run summary.

  Args:
  - `summary`: A map containing `:files`, `:warnings`, and `:errors` counts.

  Returns:
  A single summary line."
  [{:keys [files warnings errors]}]
  (str "proofread: " files " file"
       (case files
         1 ""
         :default "s")
       ", " warnings " warning"
       (case warnings
         1 ""
         :default "s")
       ", " errors " error"
       (case errors
         1 ""
         :default "s")))

(defun print-summary!
  "Print a proofread run summary.

  Args:
  - `summary`: A map containing `:files`, `:warnings`, and `:errors` counts.

  Returns:
  `summary`."
  [summary]
  (let [text (summary-text summary)
        separator (apply join (concat [""]
                                      (repeat (count text) "-")))]
    (prn separator)
    (prn text)
    (prn separator)
    summary))
