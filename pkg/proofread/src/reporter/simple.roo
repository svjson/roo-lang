(ns proofread.reporter.simple
  (:require [proofread.reporter.common :as rc]))

(defun report-file!
  "Print diagnostics for one checked file.

  Args:
  - `state`: Reporter state map.
  - `file-result`: Map containing `:diagnostics` for a checked file.

  Returns:
  The unchanged reporter state."
  [state file-result]
  (for [diagnostic (:diagnostics file-result)]
    (prn (rc/diagnostic-line-with-options diagnostic (:options state))))
  state)

(defun report-summary!
  "Print the final proofread summary.

  Args:
  - `state`: Reporter state map.
  - `summary`: Map containing `:files`, `:warnings`, and `:errors` counts.

  Returns:
  `summary`."
  [state summary]
  (rc/print-summary! summary))

(defun make
  "Create the default streaming proofread reporter.

  Args:
  - `files`: Files selected for the proofread run.
  - `options`: Reporter display options.

  Returns:
  A reporter map that prints diagnostics as each file is checked and prints the
  final summary at the end."
  [files options]
  {:state {:options options}
   :report-file! report-file!
   :report-summary! report-summary!})
