(ns roopl.editor-test
  (:require proof.core
            [proof.scenario :as p]
            [roopl.editor :as roopl-editor]
            [soot :as soot]
            [voodoo.editor.presentation :as presentation]
            [voodoo.text.buffer :as buffer]))

(deftest default/highlights-the-boundaries-of-a-matched-pair-at-the-cursor
  (p/given
    (buffer/make "(foo)"))

  (p/when [at-end]
    (let [before-closing (buffer/move-left at-end)
          away-from-delimiters (buffer/move-left before-closing)]
      {:at-end
       {:decorations (presentation/decorations roopl-editor/default at-end)
        :rendered (presentation/render roopl-editor/default at-end)}
       :before-closing (presentation/render roopl-editor/default before-closing)
       :away-from-delimiters
       (presentation/render roopl-editor/default away-from-delimiters)}))

  (p/then [result]
    (let [rendered (str (soot/bold "(")
                        (soot/cyan "foo")
                        (soot/bold ")"))]
      (is (= {:at-end
              {:decorations
               [{:range {:start 1 :end 4}
                 :role :roo.syntax/call-head}
                {:range {:start 0 :end 5}
                 :role :roopl/matching-delimiters}]
               :rendered {:text rendered
                          :text-before rendered}}
              :before-closing
              {:text rendered
               :text-before (str (soot/bold "(") (soot/cyan "foo"))}
              :away-from-delimiters
              {:text (str "(" (soot/cyan "foo") ")")
               :text-before (str "(" (soot/cyan "fo"))}}
             result)))))

(deftest default/styles-roo-syntax-and-composes-matching-delimiters
  (p/given
    (buffer/make
      "(defun app/run \"Run.\" [x] (when true (service/call :status/new status/current)))"))

  (p/when [text-buffer]
    (presentation/render roopl-editor/default text-buffer))

  (p/then [rendered]
    (let [text
          (str (soot/bold "(")
               (soot/magenta "defun")
               " "
               (soot/blue "app")
               (soot/paint [:bright-cyan] "/run")
               " "
               (soot/paint [:green :dim] "\"Run.\"")
               " [x] ("
               (soot/magenta "when")
               " "
               (soot/yellow "true")
               " ("
               (soot/blue "service")
               (soot/cyan "/call")
               " "
               (soot/yellow ":")
               (soot/blue "status")
               (soot/yellow "/new")
               " "
               (soot/blue "status")
               "/current))"
               (soot/bold ")"))]
      (is (= {:text text
              :text-before text}
             rendered)))))
