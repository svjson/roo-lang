{:name roopl
 :version "0.1.0"
 :description "Interactive terminal shell for Roo."
 :dependencies {inpoots "0.1.0"
                voodoo "0.1.0"}
 :load-roots ["src"]
 :namespace-roots {roopl "src"}
 :native-libraries [{:name "roopl-native"
                     :version "0.1.0"
                     :path "native"
                     :namespaces [roopl.target.runtime]}]
 :main roopl.terminal/main}
